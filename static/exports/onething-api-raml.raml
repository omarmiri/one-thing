securitySchemes:
- AdminToken:
    description: The shop's admin token, returned once by `createShop`. Keep it secret.
    type: x-custom
    describedBy:
      headers:
        x-admin-token:
          description: The shop's admin token, returned once by `createShop`. Keep it secret.
          type: string
          required: true
          displayName: x-admin-token
/api:
  /shops:
    /{slug}:
      uriParameters:
        slug:
          description: The shop's link name (current or former).
          type: string
          example: raptorrush
          required: true
          displayName: slug
      /refine:
        uriParameters: {}
        post:
          securedBy:
          - AdminToken
          description: '"Make it warmer", "shorter copy", "more premium". Gemini edits the design spec.'
          headers:
            Content-Type:
              required: true
              displayName: Content-Type
              enum:
              - application/json
          body:
            application/json:
              schema: |
                {
                  "id": "ApiShopsRefineRequest",
                  "title": "ApiShopsRefineRequest",
                  "type": "object",
                  "properties": {
                    "instruction": {
                      "example": "Make it feel more premium",
                      "type": "string",
                      "maxLength": 500
                    }
                  },
                  "required": [
                    "instruction"
                  ]
                }
              example: ''
          responses:
            '200':
              description: The new design.
              body:
                application/json:
                  schema: |
                    {
                      "id": "ApiShopsRefineResponse",
                      "title": "ApiShopsRefineResponse",
                      "type": "object",
                      "properties": {
                        "spec": {
                          "id": "DesignSpec",
                          "title": "DesignSpec",
                          "description": "What Gemini designed. OneThing's templates render it; Gemini never writes HTML.",
                          "type": "object",
                          "properties": {
                            "productType": {
                              "title": "ProductType2",
                              "type": "string",
                              "additionalProperties": false,
                              "enum": [
                                "digital",
                                "physical"
                              ]
                            },
                            "productName": {
                              "type": "string"
                            },
                            "layout": {
                              "title": "Layout",
                              "type": "string",
                              "additionalProperties": false,
                              "enum": [
                                "bold-hero",
                                "editorial",
                                "minimal",
                                "playful"
                              ]
                            },
                            "palette": {
                              "id": "Palette",
                              "title": "Palette",
                              "type": "object",
                              "properties": {
                                "background": {
                                  "example": "#14171a",
                                  "type": "string",
                                  "pattern": "^#[0-9a-fA-F]{6}$"
                                },
                                "surface": {
                                  "example": "#14171a",
                                  "type": "string",
                                  "pattern": "^#[0-9a-fA-F]{6}$"
                                },
                                "text": {
                                  "example": "#14171a",
                                  "type": "string",
                                  "pattern": "^#[0-9a-fA-F]{6}$"
                                },
                                "muted": {
                                  "example": "#14171a",
                                  "type": "string",
                                  "pattern": "^#[0-9a-fA-F]{6}$"
                                },
                                "accent": {
                                  "example": "#14171a",
                                  "type": "string",
                                  "pattern": "^#[0-9a-fA-F]{6}$"
                                },
                                "accentText": {
                                  "example": "#14171a",
                                  "type": "string",
                                  "pattern": "^#[0-9a-fA-F]{6}$"
                                }
                              },
                              "required": [
                                "background",
                                "surface",
                                "text",
                                "muted",
                                "accent",
                                "accentText"
                              ]
                            },
                            "fonts": {
                              "id": "Fonts",
                              "title": "Fonts",
                              "type": "object",
                              "properties": {
                                "heading": {
                                  "type": "string"
                                },
                                "body": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "heading",
                                "body"
                              ]
                            },
                            "headline": {
                              "type": "string"
                            },
                            "bullets": {
                              "description": "",
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            },
                            "faq": {
                              "description": "",
                              "type": "array",
                              "items": {
                                "id": "Faq",
                                "title": "Faq",
                                "type": "object",
                                "properties": {
                                  "q": {
                                    "type": "string"
                                  },
                                  "a": {
                                    "type": "string"
                                  }
                                },
                                "required": [
                                  "q",
                                  "a"
                                ]
                              }
                            },
                            "ctaLabel": {
                              "type": "string"
                            },
                            "eyebrow": {
                              "type": "string"
                            },
                            "subheadline": {
                              "type": "string"
                            },
                            "story": {
                              "type": "string"
                            },
                            "details": {
                              "description": "",
                              "type": "array",
                              "items": {
                                "id": "Detail",
                                "title": "Detail",
                                "type": "object",
                                "properties": {
                                  "label": {
                                    "type": "string"
                                  },
                                  "value": {
                                    "type": "string"
                                  }
                                },
                                "required": [
                                  "label",
                                  "value"
                                ]
                              }
                            },
                            "suggestedPriceUsd": {
                              "type": "number"
                            },
                            "suggestedShippingUsd": {
                              "type": "number"
                            },
                            "imageAlt": {
                              "type": "string"
                            },
                            "heroPrompt": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "productType",
                            "productName",
                            "layout",
                            "palette",
                            "fonts",
                            "headline",
                            "bullets",
                            "faq",
                            "ctaLabel"
                          ]
                        }
                      },
                      "required": [
                        "spec"
                      ]
                    }
            '400':
              description: Something in the request needs fixing; `error` says what.
              body:
                application/json:
                  schema: |
                    {
                      "id": "Error",
                      "title": "Error",
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "A sentence you can show to a person.",
                          "type": "string"
                        },
                        "field": {
                          "description": "The form field at fault, when there is one.",
                          "type": "string"
                        },
                        "detail": {
                          "description": "The upstream service's own message, for debugging.",
                          "type": "string"
                        }
                      },
                      "required": [
                        "error"
                      ]
                    }
            '404':
              description: No such shop, or the admin token doesn't match it.
              body:
                application/json:
                  schema: |
                    {
                      "id": "Error",
                      "title": "Error",
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "A sentence you can show to a person.",
                          "type": "string"
                        },
                        "field": {
                          "description": "The form field at fault, when there is one.",
                          "type": "string"
                        },
                        "detail": {
                          "description": "The upstream service's own message, for debugging.",
                          "type": "string"
                        }
                      },
                      "required": [
                        "error"
                      ]
                    }
            '502':
              description: Gemini, PayPal or Channel3 failed or isn't configured.
              body:
                application/json:
                  schema: |
                    {
                      "id": "Error",
                      "title": "Error",
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "A sentence you can show to a person.",
                          "type": "string"
                        },
                        "field": {
                          "description": "The form field at fault, when there is one.",
                          "type": "string"
                        },
                        "detail": {
                          "description": "The upstream service's own message, for debugging.",
                          "type": "string"
                        }
                      },
                      "required": [
                        "error"
                      ]
                    }
