        "filename"
      ]
    }
- ApiShopsMatchPhotosRequest: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiShopsMatchPhotosRequest",
      "title": "ApiShopsMatchPhotosRequest",
      "type": "object",
      "properties": {
        "colors": {
          "description": "",
          "type": "array",
          "items": {
            "id": "Color",
            "title": "Color",
            "type": "object",
            "properties": {
              "label": {
                "example": "Forest green",
                "type": "string",
                "maxLength": 30
              },
              "hex": {
                "example": "#14171a",
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              }
            },
            "required": [
              "label"
            ]
          },
          "minItems": 1,
          "maxItems": 12
        }
      },
      "required": [
        "colors"
      ]
    }
- ApiShopsMatchPhotosResponse: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiShopsMatchPhotosResponse",
      "title": "ApiShopsMatchPhotosResponse",
      "type": "object",
      "properties": {
        "matches": {
          "example": {
            "Black": "b_8f2k1",
            "Forest green": "b_q93md"
          },
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "matches"
      ]
    }
- ApiShopsOrdersShipRequest: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiShopsOrdersShipRequest",
      "title": "ApiShopsOrdersShipRequest",
      "type": "object",
      "properties": {
        "carrier": {
          "title": "Carrier",
          "type": "string",
          "additionalProperties": false,
          "enum": [
            "USPS",
            "UPS",
            "FEDEX",
            "DHL",
            "OTHER"
          ]
        },
        "trackingNumber": {
          "type": "string",
          "minLength": 4,
          "maxLength": 64
        },
        "carrierName": {
          "description": "Required when `carrier` is `OTHER`.",
          "type": "string",
          "maxLength": 60
        }
      },
      "required": [
        "carrier",
        "trackingNumber"
      ]
    }
- ApiShopsOrdersShipResponse: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiShopsOrdersShipResponse",
      "title": "ApiShopsOrdersShipResponse",
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "synced": {
          "description": "Whether PayPal accepted the tracking number.",
          "type": "boolean"
        }
      },
      "required": [
        "ok",
        "synced"
      ]
    }
- ApiShopsPaypalRequest: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiShopsPaypalRequest",
      "title": "ApiShopsPaypalRequest",
      "type": "object",
      "properties": {
        "returnUrl": {
          "description": "Platform key only. Where to send the seller after PayPal.",
          "example": "https://www.miriogames.com/market/manage/?g=7Hq2",
          "type": "string",
          "format": "uri"
        }
      }
    }
- ApiShopsPaypalResponse: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiShopsPaypalResponse",
      "title": "ApiShopsPaypalResponse",
      "type": "object",
      "properties": {
        "url": {
          "description": "PayPal's onboarding page for this shop.",
          "type": "string"
        }
      },
      "required": [
        "url"
      ]
    }
- ApiShopsPaypalResponse1: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiShopsPaypalResponse1",
      "title": "ApiShopsPaypalResponse1",
      "type": "object",
      "properties": {
        "merchantId": {
          "description": "The seller's PayPal merchant id.",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "oneOf": [
            {
              "id": "PayPalStatus",
              "title": "PayPalStatus",
              "description": "What PayPal last said about a connected seller account.",
              "type": "object",
              "properties": {
                "receivable": {
                  "description": "The account can receive payments.",
                  "type": "boolean"
                },
                "emailConfirmed": {
                  "description": "The seller has confirmed their email with PayPal.",
                  "type": "boolean"
                },
                "checkedAt": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": [
                "receivable",
                "emailConfirmed",
                "checkedAt"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "merchantId",
        "status"
      ]
    }
- ApiShopsPhotosRequest: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiShopsPhotosRequest",
      "title": "ApiShopsPhotosRequest",
      "type": "object",
      "properties": {
        "photos": {
          "description": "Photo ids, in order.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 8
        }
      },
      "required": [
        "photos"
      ]
    }
- ApiShopsRefineRequest: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiShopsRefineRequest",
      "title": "ApiShopsRefineRequest",
      "type": "object",
      "properties": {
        "instruction": {
          "example": "Make it feel more premium",
          "type": "string",
          "maxLength": 500
        }
      },
      "required": [
        "instruction"
      ]
    }
- ApiShopsRefineResponse: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiShopsRefineResponse",
      "title": "ApiShopsRefineResponse",
      "type": "object",
      "properties": {
        "spec": {
          "id": "DesignSpec",
          "title": "DesignSpec",
          "description": "What Gemini designed. OneThing's templates render it; Gemini never writes HTML.",
          "type": "object",
          "properties": {
            "productType": {
              "title": "ProductType2",
              "type": "string",
              "additionalProperties": false,
              "enum": [
                "digital",
                "physical"
              ]
            },
            "productName": {
              "type": "string"
            },
            "layout": {
              "title": "Layout",
              "type": "string",
              "additionalProperties": false,
              "enum": [
                "bold-hero",
                "editorial",
                "minimal",
                "playful"
              ]
            },
            "palette": {
              "id": "Palette",
              "title": "Palette",
              "type": "object",
              "properties": {
                "background": {
                  "example": "#14171a",
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "surface": {
                  "example": "#14171a",
