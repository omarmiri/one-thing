- ApiShopsPaypalResponse1: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiShopsPaypalResponse1",
      "title": "ApiShopsPaypalResponse1",
      "description": "The shop's PayPal connection.",
      "type": "object",
      "properties": {
        "merchantId": {
          "description": "The seller's PayPal merchant id.",
          "example": "7MZJ4QXN8K2LA",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "description": "What PayPal last said; null when nothing is connected.",
          "example": {
            "receivable": true,
            "emailConfirmed": true,
            "checkedAt": "2026-10-22T02:41:37Z"
          },
          "oneOf": [
            {
              "id": "PayPalStatus",
              "title": "PayPalStatus",
              "description": "What PayPal last said about a connected seller account.",
              "example": {
                "receivable": true,
                "emailConfirmed": true,
                "checkedAt": "2026-10-22T02:41:37Z"
              },
              "type": "object",
              "properties": {
                "receivable": {
                  "description": "The account can receive payments.",
                  "example": true,
                  "type": "boolean"
                },
                "emailConfirmed": {
                  "description": "The seller has confirmed their email with PayPal.",
                  "example": true,
                  "type": "boolean"
                },
                "checkedAt": {
                  "description": "When OneThing last asked PayPal.",
                  "example": "2026-10-22T02:41:37Z",
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": [
                "receivable",
                "emailConfirmed",
                "checkedAt"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "merchantId",
        "status"
      ]
    }
