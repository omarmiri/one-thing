- JsonRpcRequest: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "JsonRpcRequest",
      "title": "JsonRpcRequest",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "type": "string",
          "enum": [
            "2.0"
          ]
        },
        "method": {
          "title": "Method",
          "type": "string",
          "additionalProperties": false,
          "enum": [
            "initialize",
            "ping",
            "tools/list",
            "tools/call",
            "notifications/initialized"
          ]
        },
        "id": {
          "description": "Leave out for a notification.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "integer",
              "format": "int32"
            },
            {
              "type": "null"
            }
          ]
        },
        "params": {
          "description": "For `tools/call`: `{ name, arguments }`.",
          "type": "object"
        }
      },
      "required": [
        "jsonrpc",
        "method"
      ]
    }
- JsonRpcResponse: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "JsonRpcResponse",
      "title": "JsonRpcResponse",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "type": "string",
          "enum": [
            "2.0"
          ]
        },
        "id": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "integer",
              "format": "int32"
            },
            {
              "type": "null"
            }
          ]
        },
        "result": {
          "description": "For `tools/call`: `content` (the answer as JSON text), `structuredContent` (the same object) and `isError`.",
          "type": "object"
        },
        "error": {
          "id": "Error1",
          "title": "Error1",
          "type": "object",
          "properties": {
            "code": {
              "example": -32601,
              "type": "integer",
              "format": "int32"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ]
        }
      },
      "required": [
        "jsonrpc",
        "id"
      ]
    }
