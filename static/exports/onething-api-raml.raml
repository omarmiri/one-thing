securitySchemes:
- AdminToken:
    description: The shop's admin token, returned once by `createShop`. Keep it secret.
    type: x-custom
    describedBy:
      headers:
        x-admin-token:
          description: The shop's admin token, returned once by `createShop`. Keep it secret.
          type: string
          required: true
          displayName: x-admin-token
/o/{orderId}:
  uriParameters:
    orderId:
      description: The `order_id` from the MCP `create_order` tool.
      type: string
      example: pX4kR9tVb2nQ7sLe
      required: true
      displayName: orderId
  get:
    description: The `pay_url` an agent gives the buyer. It redirects to PayPal's payment page for the order, so PayPal's checkout token never passes through the agent (agent platforms hide such tokens as secrets). A paid order redirects to its thank-you page; an expired checkout goes back to the shop page.
    responses:
      '303':
        description: Redirect to PayPal, the thank-you page or the shop page.
      '404':
        description: No order with that id.
        body:
          text/plain:
            schema: |
              {
                "type": "string"
              }
/api:
  /shops:
    /{slug}:
      uriParameters:
        slug:
          description: The shop's link name (current or former).
          type: string
          example: raptorrush
          required: true
          displayName: slug
      /refine:
        uriParameters: {}
        post:
          securedBy:
          - AdminToken
          - PlatformKey
          description: '"Make it warmer", "shorter copy", "more premium". Gemini edits the design spec.'
          headers:
            Content-Type:
              required: true
              displayName: Content-Type
              enum:
              - application/json
          body:
            application/json:
              schema: |
                {
                  "id": "ApiShopsRefineRequest",
                  "title": "ApiShopsRefineRequest",
                  "example": {
                    "instruction": "Make it feel more premium"
                  },
                  "type": "object",
                  "properties": {
                    "instruction": {
                      "example": "Make it feel more premium",
                      "type": "string",
                      "maxLength": 500
                    }
                  },
                  "required": [
                    "instruction"
                  ]
                }
              example: '{"instruction":"Make it feel more premium"}'
          responses:
            '200':
              description: The new design.
              body:
                application/json:
                  schema: |
                    {
                      "id": "ApiShopsRefineResponse",
                      "title": "ApiShopsRefineResponse",
                      "example": {
                        "spec": {
                          "productType": "physical",
                          "productName": "Vintage Cream and Red Roller Skates",
                          "layout": "editorial",
                          "palette": {
                            "background": "#f6efe4",
                            "surface": "#fffaf2",
                            "text": "#2b1d14",
                            "muted": "#7a6455",
                            "accent": "#b3261e",
                            "accentText": "#ffffff"
                          },
                          "fonts": {
                            "heading": "Playfair Display",
                            "body": "Inter"
                          },
                          "eyebrow": "One pair, restored",
                          "headline": "Classic quad skates crafted with walnut burl heels",
                          "subheadline": "A vintage pair of skates featuring cream leather, bold red trim, and durable quad wheels.",
                          "story": "Each pair combines soft cream leather with distinct red accents and a sculpted walnut burl heel base.",
                          "bullets": [
                            "Handmade cream leather upper with rich red trim",
                            "Sculpted walnut burl heel structure for stability"
                          ],
                          "details": [
                            {
                              "label": "Materials",
                              "value": "Leather upper, walnut burl heel, rubber wheels"
                            }
                          ],
                          "faq": [
                            {
                              "q": "Are these suitable for outdoor skating?",
                              "a": "Yes, on indoor rink floors and paved outdoor paths."
                            }
                          ],
                          "ctaLabel": "Buy the skates",
                          "suggestedPriceUsd": 240,
                          "suggestedShippingUsd": 15,
                          "imageAlt": "Cream leather quad roller skates with red trim"
                        }
                      },
                      "type": "object",
                      "properties": {
                        "spec": {
                          "id": "DesignSpec",
                          "title": "DesignSpec",
                          "description": "What Gemini designed. OneThing's templates render it; Gemini never writes HTML.",
                          "type": "object",
                          "properties": {
                            "productType": {
                              "title": "ProductType2",
                              "type": "string",
                              "additionalProperties": false,
                              "enum": [
                                "digital",
                                "physical"
                              ]
                            },
                            "productName": {
                              "type": "string"
                            },
                            "layout": {
                              "title": "Layout",
                              "type": "string",
                              "additionalProperties": false,
                              "enum": [
                                "bold-hero",
                                "editorial",
                                "minimal",
                                "playful"
                              ]
                            },
                            "palette": {
                              "id": "Palette",
                              "title": "Palette",
                              "type": "object",
                              "properties": {
                                "background": {
                                  "example": "#14171a",
                                  "type": "string",
                                  "pattern": "^#[0-9a-fA-F]{6}$"
                                },
                                "surface": {
                                  "example": "#14171a",
                                  "type": "string",
                                  "pattern": "^#[0-9a-fA-F]{6}$"
                                },
                                "text": {
                                  "example": "#14171a",
                                  "type": "string",
                                  "pattern": "^#[0-9a-fA-F]{6}$"
                                },
                                "muted": {
                                  "example": "#14171a",
                                  "type": "string",
                                  "pattern": "^#[0-9a-fA-F]{6}$"
                                },
                                "accent": {
                                  "example": "#14171a",
                                  "type": "string",
                                  "pattern": "^#[0-9a-fA-F]{6}$"
                                },
                                "accentText": {
                                  "example": "#14171a",
                                  "type": "string",
                                  "pattern": "^#[0-9a-fA-F]{6}$"
                                }
                              },
                              "required": [
                                "background",
                                "surface",
                                "text",
                                "muted",
                                "accent",
                                "accentText"
                              ]
                            },
                            "fonts": {
                              "id": "Fonts",
                              "title": "Fonts",
                              "type": "object",
                              "properties": {
                                "heading": {
                                  "type": "string"
                                },
                                "body": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "heading",
                                "body"
                              ]
                            },
                            "headline": {
                              "type": "string"
                            },
                            "bullets": {
                              "description": "",
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            },
                            "faq": {
                              "description": "",
                              "type": "array",
                              "items": {
                                "id": "Faq",
                                "title": "Faq",
                                "type": "object",
                                "properties": {
                                  "q": {
                                    "type": "string"
                                  },
                                  "a": {
                                    "type": "string"
                                  }
                                },
                                "required": [
                                  "q",
                                  "a"
                                ]
                              }
                            },
                            "ctaLabel": {
                              "type": "string"
                            },
                            "eyebrow": {
                              "type": "string"
                            },
                            "subheadline": {
                              "type": "string"
                            },
                            "story": {
                              "type": "string"
                            },
                            "details": {
                              "description": "",
                              "type": "array",
                              "items": {
                                "id": "Detail",
                                "title": "Detail",
                                "type": "object",
                                "properties": {
                                  "label": {
                                    "type": "string"
                                  },
                                  "value": {
                                    "type": "string"
                                  }
                                },
                                "required": [
                                  "label",
                                  "value"
                                ]
                              }
                            },
                            "suggestedPriceUsd": {
                              "type": "number"
                            },
                            "suggestedShippingUsd": {
                              "type": "number"
                            },
                            "imageAlt": {
                              "type": "string"
                            },
                            "heroPrompt": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "productType",
                            "productName",
                            "layout",
                            "palette",
                            "fonts",
                            "headline",
                            "bullets",
                            "faq",
                            "ctaLabel"
                          ]
                        }
                      },
                      "required": [
                        "spec"
                      ]
                    }
                  example: '{"spec":{"productType":"physical","productName":"Vintage Cream and Red Roller Skates","layout":"editorial","palette":{"background":"#f6efe4","surface":"#fffaf2","text":"#2b1d14","muted":"#7a6455","accent":"#b3261e","accentText":"#ffffff"},"fonts":{"heading":"Playfair Display","body":"Inter"},"eyebrow":"One pair, restored","headline":"Classic quad skates crafted with walnut burl heels","subheadline":"A vintage pair of skates featuring cream leather, bold red trim, and durable quad wheels.","story":"Each pair combines soft cream leather with distinct red accents and a sculpted walnut burl heel base.","bullets":["Handmade cream leather upper with rich red trim","Sculpted walnut burl heel structure for stability"],"details":[{"label":"Materials","value":"Leather upper, walnut burl heel, rubber wheels"}],"faq":[{"q":"Are these suitable for outdoor skating?","a":"Yes, on indoor rink floors and paved outdoor paths."}],"ctaLabel":"Buy the skates","suggestedPriceUsd":240,"suggestedShippingUsd":15,"imageAlt":"Cream leather quad roller skates with red trim"}}'
            '400':
              description: Something in the request needs fixing; `error` says what.
              body:
                application/json:
                  schema: |
                    {
                      "id": "Error",
                      "title": "Error",
                      "example": {
                        "error": "Choose a photo."
                      },
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "A sentence you can show to a person.",
                          "type": "string"
                        },
                        "field": {
                          "description": "The form field at fault, when there is one.",
                          "type": "string"
                        },
                        "detail": {
                          "description": "The upstream service's own message, for debugging.",
                          "type": "string"
                        }
                      },
                      "required": [
                        "error"
                      ]
                    }
                  example: '{"error":"Choose a photo."}'
            '404':
              description: No such shop, or the admin token or API key doesn't match it.
              body:
                application/json:
                  schema: |
                    {
                      "id": "Error",
                      "title": "Error",
                      "example": {
                        "error": "Shop not found."
                      },
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "A sentence you can show to a person.",
                          "type": "string"
                        },
                        "field": {
                          "description": "The form field at fault, when there is one.",
                          "type": "string"
                        },
                        "detail": {
                          "description": "The upstream service's own message, for debugging.",
                          "type": "string"
                        }
                      },
                      "required": [
                        "error"
                      ]
                    }
                  example: '{"error":"Shop not found."}'
            '502':
              description: Gemini, PayPal or Channel3 failed or isn't configured.
              body:
                application/json:
                  schema: |
                    {
                      "id": "Error",
                      "title": "Error",
                      "example": {
                        "error": "PayPal isn't configured on this server."
                      },
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "A sentence you can show to a person.",
                          "type": "string"
                        },
                        "field": {
                          "description": "The form field at fault, when there is one.",
                          "type": "string"
                        },
                        "detail": {
                          "description": "The upstream service's own message, for debugging.",
                          "type": "string"
                        }
                      },
                      "required": [
                        "error"
                      ]
                    }
                  example: "{\"error\":\"PayPal isn't configured on this server.\"}"
            '429':
              description: Over this network's cap for the call (see **Limits**). Retry after `Retry-After` seconds.
              headers:
                Retry-After:
                  required: false
              body:
                application/json:
                  schema: |
                    {
                      "id": "Error",
                      "title": "Error",
                      "example": {
                        "error": "Too many checkouts from your network. Try again in 7 min."
                      },
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "A sentence you can show to a person.",
                          "type": "string"
                        },
                        "field": {
                          "description": "The form field at fault, when there is one.",
                          "type": "string"
                        },
                        "detail": {
                          "description": "The upstream service's own message, for debugging.",
                          "type": "string"
                        }
                      },
                      "required": [
                        "error"
                      ]
                    }
                  example: '{"error":"Too many checkouts from your network. Try again in 7 min."}'
