- PayPalStatus: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "PayPalStatus",
      "title": "PayPalStatus",
      "description": "What PayPal last said about a connected seller account.",
      "example": {
        "receivable": true,
        "emailConfirmed": true,
        "checkedAt": "2026-10-22T02:41:37Z"
      },
      "type": "object",
      "properties": {
        "receivable": {
          "description": "The account can receive payments.",
          "example": true,
          "type": "boolean"
        },
        "emailConfirmed": {
          "description": "The seller has confirmed their email with PayPal.",
          "example": true,
          "type": "boolean"
        },
        "checkedAt": {
          "description": "When OneThing last asked PayPal.",
          "example": "2026-10-22T02:41:37Z",
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "receivable",
        "emailConfirmed",
        "checkedAt"
      ]
    }
- AgentProduct: "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"id\": \"AgentProduct\",\n  \"title\": \"AgentProduct\",\n  \"description\": \"A live shop as an AI agent sees it. Recommendations have `offers`; everything else has `price` and is bought with `create_order`.\",\n  \"example\": {\n    \"show_buyer\": \"![Vintage Cream and Red Roller Skates](https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X)\\n\\n**Vintage Cream and Red Roller Skates**: $240.00. Classic quad skates crafted with walnut burl heels\\n\\n![Raptor Rush: Browser Edition](https://one-thing-ash0.onrender.com/api/blobs/R9tWc3yN6bJq1zUd)\\n\\n**Raptor Rush: Browser Edition**: $2.99. Grow from Tiny Hatchling to Giant Apex Predator\\n\\nWhich one?\",\n    \"agent_name\": \"Grok\",\n    \"shop\": \"vintageskates\",\n    \"url\": \"https://one-thing-ash0.onrender.com/vintageskates\",\n    \"name\": \"Vintage Cream and Red Roller Skates\",\n    \"kind\": \"physical\",\n    \"headline\": \"Classic quad skates crafted with walnut burl heels\",\n    \"description\": \"Vintage cream and red quad roller skates with walnut burl heels.\",\n    \"highlights\": [\n      \"Walnut burl heels\",\n      \"Restored vintage leather\"\n    ],\n    \"details\": [\n      {\n        \"label\": \"Material\",\n        \"value\": \"Leather upper, walnut burl heel, rubber wheels\"\n      }\n    ],\n    \"faq\": [\n      {\n        \"q\": \"Are these suitable for outdoor skating?\",\n        \"a\": \"Yes, on indoor rink floors and paved outdoor paths.\"\n      }\n    ],\n    \"images\": [\n      \"https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X\"\n    ],\n    \"price\": {\n      \"amount\": 240,\n      \"currency\": \"USD\",\n      \"label\": \"$240.00\"\n    },\n    \"shipping\": {\n      \"amount\": 15,\n      \"currency\": \"USD\",\n      \"ships_to\": [\n        \"US\",\n        \"CA\"\n      ]\n    },\n    \"total\": {\n      \"amount\": 240,\n      \"currency\": \"USD\",\n      \"label\": \"$240.00\"\n    },\n    \"delivery\": \"Shipped. PayPal collects the buyer's address at checkout.\",\n    \"availability\": \"in_stock\",\n    \"options\": [\n      {\n        \"name\": \"Size\",\n        \"values\": [\n          \"7\",\n          \"8\",\n          \"9\"\n        ]\n      }\n    ],\n    \"variants\": [\n      {\n        \"choice\": {\n          \"Size\": \"M\",\n          \"Color\": \"Black\"\n        },\n        \"availability\": \"in_stock (3 left)\",\n        \"order_url\": \"https://one-thing-ash0.onrender.com/vintageskates/buy?Size=9\"\n      }\n    ],\n    \"order_url\": \"https://one-thing-ash0.onrender.com/vintageskates/buy?Size=9\",\n    \"offers\": [\n      {\n        \"retailer\": \"rei.com\",\n        \"price\": 240,\n        \"currency\": \"USD\",\n        \"in_stock\": true,\n        \"url\": \"https://buy.trychannel3.com/r/abc123\"\n      }\n    ],\n    \"how_to_buy\": \"Ask the buyer which size, then open that variant's order_url and show them pay_url.\",\n    \"mcp_server\": \"https://one-thing-ash0.onrender.com/api/mcp\"\n  },\n  \"type\": \"object\",\n  \"properties\": {\n    \"shop\": {\n      \"description\": \"The link name, which the MCP tools take as `shop`.\",\n      \"example\": \"vintageskates\",\n      \"type\": \"string\"\n    },\n    \"url\": {\n      \"description\": \"The shop page, where a person can buy it too.\",\n      \"example\": \"https://one-thing-ash0.onrender.com/vintageskates\",\n      \"type\": \"string\"\n    },\n    \"name\": {\n      \"description\": \"The product's name.\",\n      \"example\": \"Vintage Cream and Red Roller Skates\",\n      \"type\": \"string\"\n    },\n    \"kind\": {\n      \"title\": \"Kind1\",\n      \"description\": \"`physical` ships, `digital` downloads or unlocks with a code, `referral` is bought at another store.\",\n      \"example\": \"physical\",\n      \"type\": \"string\",\n      \"additionalProperties\": false,\n      \"enum\": [\n        \"physical\",\n        \"digital\",\n        \"referral\"\n      ]\n    },\n    \"headline\": {\n      \"description\": \"The shop's one-line pitch.\",\n      \"example\": \"Classic quad skates crafted with walnut burl heels\",\n      \"type\": \"string\"\n    },\n    \"description\": {\n      \"description\": \"What the product is, in a few sentences.\",\n      \"example\": \"Vintage cream and red quad roller skates with walnut burl heels.\",\n      \"type\": \"string\"\n    },\n    \"highlights\": {\n      \"description\": \"The product's selling points, one per line.\",\n      \"example\": [\n        \"Walnut burl heels\",\n        \"Restored vintage leather\"\n      ],\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"details\": {\n      \"description\": \"Product facts, such as size, material or format.\",\n      \"example\": [\n        {\n          \"label\": \"Material\",\n          \"value\": \"Leather upper, walnut burl heel, rubber wheels\"\n        }\n      ],\n      \"type\": \"array\",\n      \"items\": {\n        \"id\": \"Detail\",\n        \"title\": \"Detail\",\n        \"description\": \"One product fact.\",\n        \"example\": {\n          \"label\": \"Material\",\n          \"value\": \"Leather upper, walnut burl heel, rubber wheels\"\n        },\n        \"type\": \"object\",\n        \"properties\": {\n          \"label\": {\n            \"description\": \"What the fact is about.\",\n            \"example\": \"Material\",\n            \"type\": \"string\"\n          },\n          \"value\": {\n            \"description\": \"The fact.\",\n            \"example\": \"Leather upper, walnut burl heel, rubber wheels\",\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"label\",\n          \"value\"\n        ]\n      }\n    },\n    \"faq\": {\n      \"description\": \"Questions buyers ask, answered by the seller's page.\",\n      \"example\": [\n        {\n          \"q\": \"Are these suitable for outdoor skating?\",\n          \"a\": \"Yes, on indoor rink floors and paved outdoor paths.\"\n        }\n      ],\n      \"type\": \"array\",\n      \"items\": {\n        \"id\": \"Faq\",\n        \"title\": \"Faq\",\n        \"description\": \"One question and its answer.\",\n        \"example\": {\n          \"q\": \"Are these suitable for outdoor skating?\",\n          \"a\": \"Yes, on indoor rink floors and paved outdoor paths.\"\n        },\n        \"type\": \"object\",\n        \"properties\": {\n          \"q\": {\n            \"description\": \"The question.\",\n            \"example\": \"Are these suitable for outdoor skating?\",\n            \"type\": \"string\"\n          },\n          \"a\": {\n            \"description\": \"The answer.\",\n            \"example\": \"Yes, on indoor rink floors and paved outdoor paths.\",\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"q\",\n          \"a\"\n        ]\n      }\n    },\n    \"images\": {\n      \"description\": \"Photo URLs, the cover first. Show these rather than generating or searching for images.\",\n      \"example\": [\n        \"https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X\"\n      ],\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"how_to_buy\": {\n      \"description\": \"How to buy it, written for an agent: which tool or link to use and what to ask the buyer.\",\n      \"example\": \"Ask the buyer which size, then open that variant's order_url and show them pay_url.\",\n      \"type\": \"string\"\n    },\n    \"show_buyer\": {\n      \"description\": \"A suggested reply to the buyer, in Markdown with the links already written as links: the product and its options to pick from, the pay link, or what they got with a receipt link. Buyers have the best experience when agents show it as written.\",\n      \"example\": \"![Vintage Cream and Red Roller Skates](https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X)\\n\\n**Vintage Cream and Red Roller Skates**: $240.00. Classic quad skates crafted with walnut burl heels\\n\\n![Raptor Rush: Browser Edition](https://one-thing-ash0.onrender.com/api/blobs/R9tWc3yN6bJq1zUd)\\n\\n**Raptor Rush: Browser Edition**: $2.99. Grow from Tiny Hatchling to Giant Apex Predator\\n\\nWhich one?\",\n      \"type\": \"string\"\n    },\n    \"agent_name\": {\n      \"description\": \"Who this request was credited to in the seller's stats: a recognised user agent, else the name the agent gave itself (`?agent=`, or the MCP client's name), else the user agent's first word.\",\n      \"example\": \"Grok\",\n      \"type\": \"string\"\n    },\n    \"price\": {\n      \"id\": \"AgentMoney\",\n      \"title\": \"AgentMoney\",\n      \"description\": \"An amount of money, as a number and as a label.\",\n      \"example\": {\n        \"amount\": 240,\n        \"currency\": \"USD\",\n        \"label\": \"$240.00\"\n      },\n      \"type\": \"object\",\n      \"properties\": {\n        \"amount\": {\n          \"description\": \"The amount in the currency's main unit (dollars, not cents).\",\n          \"example\": 48.5,\n          \"type\": \"number\"\n        },\n        \"currency\": {\n          \"description\": \"ISO 4217 currency code.\",\n          \"example\": \"USD\",\n          \"type\": \"string\"\n        },\n        \"label\": {\n          \"description\": \"The amount formatted for people.\",\n          \"example\": \"$48.50\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"amount\",\n        \"currency\"\n      ]\n    },\n    \"shipping\": {\n      \"description\": \"Physical products only.\",\n      \"example\": {\n        \"amount\": 15,\n        \"currency\": \"USD\",\n        \"ships_to\": [\n          \"US\",\n          \"CA\"\n        ]\n      },\n      \"oneOf\": [\n        {\n          \"id\": \"Shipping\",\n          \"title\": \"Shipping\",\n          \"description\": \"Shipping cost and destinations.\",\n          \"example\": {\n            \"amount\": 15,\n            \"currency\": \"USD\",\n            \"ships_to\": [\n              \"US\",\n              \"CA\"\n            ]\n          },\n          \"type\": \"object\",\n          \"properties\": {\n            \"amount\": {\n              \"description\": \"Shipping cost per order.\",\n              \"example\": 15,\n              \"type\": \"number\"\n            },\n            \"currency\": {\n              \"description\": \"ISO 4217 currency code.\",\n              \"example\": \"USD\",\n              \"type\": \"string\"\n            },\n            \"ships_to\": {\n              \"description\": \"Country codes; empty means anywhere PayPal ships.\",\n              \"example\": [\n                \"US\",\n                \"CA\"\n              ],\n              \"type\": \"array\",\n              \"items\": {\n                \"type\": \"string\"\n              }\n            }\n          },\n          \"required\": [\n            \"amount\",\n            \"currency\",\n            \"ships_to\"\n          ]\n        },\n        {\n          \"type\": \"null\"\n        }\n      ]\n    },\n    \"total\": {\n      \"$ref\": \"AgentMoney\"\n    },\n    \"delivery\": {\n      \"description\": \"How the buyer gets it, in plain words.\",\n      \"example\": \"Shipped. PayPal collects the buyer's address at checkout.\",\n      \"type\": \"string\"\n    },\n    \"availability\": {\n      \"description\": \"`in_stock`, `in_stock (N left)` or `sold_out`. With options, see `variants`.\",\n      \"examples\": [\n        {\n          \"Id\": \"Untitled Example1\",\n          \"Name\": null,\n          \"Value\": \"in_stock\",\n          \"ExternalValue\": null,\n          \"Description\": null\n        },\n        {\n          \"Id\": \"Untitled Example2\",\n          \"Name\": null,\n          \"Value\": \"in_stock (3 left)\",\n          \"ExternalValue\": null,\n          \"Description\": null\n        },\n        {\n          \"Id\": \"Untitled Example3\",\n          \"Name\": null,\n          \"Value\": \"sold_out\",\n          \"ExternalValue\": null,\n          \"Description\": null\n        }\n      ],\n      \"example\": \"in_stock\",\n      \"type\": \"string\"\n    },\n    \"options\": {\n      \"description\": \"Pass one value per option to `create_order`.\",\n      \"example\": [\n        {\n          \"name\": \"Size\",\n          \"values\": [\n            \"7\",\n            \"8\",\n            \"9\"\n          ]\n        }\n      ],\n      \"type\": \"array\",\n      \"items\": {\n        \"id\": \"Option1\",\n        \"title\": \"Option1\",\n        \"description\": \"One option and its values.\",\n        \"example\": {\n          \"name\": \"Size\",\n          \"values\": [\n            \"7\",\n            \"8\",\n            \"9\"\n          ]\n        },\n        \"type\": \"object\",\n        \"properties\": {\n          \"name\": {\n            \"description\": \"The option's name, which is also its query parameter on `order_url`.\",\n            \"example\": \"Vintage Cream and Red Roller Skates\",\n            \"type\": \"string\"\n          },\n          \"values\": {\n            \"description\": \"The values the buyer can pick.\",\n            \"example\": [\n              \"7\",\n              \"8\",\n              \"9\"\n            ],\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          }\n        },\n        \"required\": [\n          \"name\",\n          \"values\"\n        ]\n      }\n    },\n    \"variants\": {\n      \"description\": \"Products with options: each combination, its stock and its order link.\",\n      \"example\": [\n        {\n          \"choice\": {\n            \"Size\": \"M\",\n            \"Color\": \"Black\"\n          },\n          \"availability\": \"in_stock (3 left)\",\n          \"order_url\": \"https://one-thing-ash0.onrender.com/vintageskates/buy?Size=9\"\n        }\n      ],\n      \"type\": \"array\",\n      \"items\": {\n        \"id\": \"Variant\",\n        \"title\": \"Variant\",\n        \"description\": \"One combination of option values.\",\n        \"example\": {\n          \"choice\": {\n            \"Size\": \"M\",\n            \"Color\": \"Black\"\n          },\n          \"availability\": \"in_stock (3 left)\",\n          \"order_url\": \"https://one-thing-ash0.onrender.com/vintageskates/buy?Size=9\"\n        },\n        \"type\": \"object\",\n        \"properties\": {\n          \"choice\": {\n            \"description\": \"The buyer's pick, one value per option, keyed by option name.\",\n            \"example\": {\n              \"Size\": \"M\",\n              \"Color\": \"Black\"\n            },\n            \"type\": \"object\",\n            \"additionalProperties\": {\n              \"type\": \"string\"\n            }\n          },\n          \"availability\": {\n            \"description\": \"`in_stock`, `in_stock (N left)` or `sold_out`.\",\n            \"example\": \"in_stock (3 left)\",\n            \"type\": \"string\"\n          },\n          \"order_url\": {\n            \"description\": \"`orderByLink` for this pick. Left out when it's sold out.\",\n            \"example\": \"https://one-thing-ash0.onrender.com/vintageskates/buy?Size=9\",\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"choice\",\n          \"availability\"\n        ]\n      }\n    },\n    \"order_url\": {\n      \"description\": \"Products without options: `orderByLink`, which orders one unit with a GET. Left out when sold out. With options, each variant has its own.\",\n      \"example\": \"https://one-thing-ash0.onrender.com/vintageskates/buy?Size=9\",\n      \"type\": \"string\"\n    },\n    \"offers\": {\n      \"description\": \"Recommendations only. Bought at the retailer.\",\n      \"example\": [\n        {\n          \"retailer\": \"rei.com\",\n          \"price\": 240,\n          \"currency\": \"USD\",\n          \"in_stock\": true,\n          \"url\": \"https://buy.trychannel3.com/r/abc123\"\n        }\n      ],\n      \"type\": \"array\",\n      \"items\": {\n        \"id\": \"Offer1\",\n        \"title\": \"Offer1\",\n        \"description\": \"One store's offer.\",\n        \"example\": {\n          \"retailer\": \"rei.com\",\n          \"price\": 240,\n          \"currency\": \"USD\",\n          \"in_stock\": true,\n          \"url\": \"https://buy.trychannel3.com/r/abc123\"\n        },\n        \"type\": \"object\",\n        \"properties\": {\n          \"retailer\": {\n            \"description\": \"The store.\",\n            \"example\": \"rei.com\",\n            \"type\": \"string\"\n          },\n          \"price\": {\n            \"description\": \"The store's price.\",\n            \"example\": 240,\n            \"type\": \"number\"\n          },\n          \"currency\": {\n            \"description\": \"ISO 4217 currency code.\",\n            \"example\": \"USD\",\n            \"type\": \"string\"\n          },\n          \"in_stock\": {\n            \"description\": \"Whether the store has it in stock.\",\n            \"example\": true,\n            \"type\": \"boolean\"\n          },\n          \"url\": {\n            \"description\": \"A tracked buy link at that store.\",\n            \"example\": \"https://buy.trychannel3.com/r/abc123\",\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"retailer\",\n          \"price\",\n          \"currency\",\n          \"in_stock\",\n          \"url\"\n        ]\n      }\n    },\n    \"mcp_server\": {\n      \"description\": \"The MCP server to order through (`getAgentProduct` only).\",\n      \"example\": \"https://one-thing-ash0.onrender.com/api/mcp\",\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"shop\",\n    \"url\",\n    \"name\",\n    \"kind\",\n    \"headline\",\n    \"description\",\n    \"highlights\",\n    \"details\",\n    \"faq\",\n    \"images\",\n    \"how_to_buy\"\n  ]\n}"
- AgentShopSummary: "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"id\": \"AgentShopSummary\",\n  \"title\": \"AgentShopSummary\",\n  \"description\": \"A shop in search results.\",\n  \"example\": {\n    \"shop\": \"vintageskates\",\n    \"name\": \"Vintage Cream and Red Roller Skates\",\n    \"kind\": \"physical\",\n    \"headline\": \"Classic quad skates crafted with walnut burl heels\",\n    \"price\": \"$240.00\",\n    \"image\": \"https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X\",\n    \"url\": \"https://one-thing-ash0.onrender.com/vintageskates\"\n  },\n  \"type\": \"object\",\n  \"properties\": {\n    \"shop\": {\n      \"description\": \"The link name, for `getAgentProduct` and the MCP tools.\",\n      \"example\": \"vintageskates\",\n      \"type\": \"string\"\n    },\n    \"name\": {\n      \"description\": \"The product's name.\",\n      \"example\": \"Vintage Cream and Red Roller Skates\",\n      \"type\": \"string\"\n    },\n    \"kind\": {\n      \"title\": \"Kind2\",\n      \"description\": \"`physical`, `digital` or `referral`.\",\n      \"example\": \"physical\",\n      \"type\": \"string\",\n      \"additionalProperties\": false,\n      \"enum\": [\n        \"physical\",\n        \"digital\",\n        \"referral\"\n      ]\n    },\n    \"headline\": {\n      \"description\": \"The shop's one-line pitch.\",\n      \"example\": \"Classic quad skates crafted with walnut burl heels\",\n      \"type\": \"string\"\n    },\n    \"price\": {\n      \"description\": \"The price label, e.g. `$2.99`; null for recommendations.\",\n      \"example\": \"$240.00\",\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"image\": {\n      \"description\": \"The cover photo's URL (WebP; the retailer's image for a recommendation), or null when there's none.\",\n      \"example\": \"https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X\",\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"url\": {\n      \"description\": \"The shop page.\",\n      \"example\": \"https://one-thing-ash0.onrender.com/vintageskates\",\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"shop\",\n    \"name\",\n    \"kind\",\n    \"headline\",\n    \"price\",\n    \"image\",\n    \"url\"\n  ]\n}"
- AgentCreatedOrder: "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"id\": \"AgentCreatedOrder\",\n  \"title\": \"AgentCreatedOrder\",\n  \"description\": \"A new order, as `create_order` and `orderByLink` return it.\",\n  \"example\": {\n    \"show_buyer\": \"![Vintage Cream and Red Roller Skates](https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X)\\n\\n**Vintage Cream and Red Roller Skates**: $240.00. Classic quad skates crafted with walnut burl heels\\n\\n![Raptor Rush: Browser Edition](https://one-thing-ash0.onrender.com/api/blobs/R9tWc3yN6bJq1zUd)\\n\\n**Raptor Rush: Browser Edition**: $2.99. Grow from Tiny Hatchling to Giant Apex Predator\\n\\nWhich one?\",\n    \"agent_name\": \"Grok\",\n    \"order_id\": \"pX4kR9tVb2nQ7sLe\",\n    \"status\": \"awaiting_buyer_approval\",\n    \"total\": \"$255.00\",\n    \"options\": {\n      \"Size\": \"M\",\n      \"Color\": \"Black\"\n    },\n    \"pay_url\": \"https://one-thing-ash0.onrender.com/o/pX4kR9tVb2nQ7sLe\",\n    \"status_url\": \"https://one-thing-ash0.onrender.com/o/pX4kR9tVb2nQ7sLe/status\",\n    \"next_step\": \"Show pay_url to the buyer as a link. When they say they've paid, call get_order with order_id.\"\n  },\n  \"type\": \"object\",\n  \"properties\": {\n    \"order_id\": {\n      \"description\": \"The order's id, for `get_order` and `getAgentOrder`.\",\n      \"example\": \"pX4kR9tVb2nQ7sLe\",\n      \"type\": \"string\"\n    },\n    \"status\": {\n      \"description\": \"Always `awaiting_buyer_approval`: nothing is charged until the buyer approves at PayPal.\",\n      \"example\": \"awaiting_buyer_approval\",\n      \"type\": \"string\",\n      \"enum\": [\n        \"awaiting_buyer_approval\"\n      ]\n    },\n    \"total\": {\n      \"description\": \"The total with shipping, as a label.\",\n      \"example\": \"$255.00\",\n      \"type\": \"string\"\n    },\n    \"pay_url\": {\n      \"description\": \"Where the buyer pays (redirects to PayPal). Safe to show in chat.\",\n      \"example\": \"https://one-thing-ash0.onrender.com/o/pX4kR9tVb2nQ7sLe\",\n      \"type\": \"string\"\n    },\n    \"status_url\": {\n      \"description\": \"`getAgentOrder` for this order.\",\n      \"example\": \"https://one-thing-ash0.onrender.com/o/pX4kR9tVb2nQ7sLe/status\",\n      \"type\": \"string\"\n    },\n    \"next_step\": {\n      \"description\": \"What the agent should do next, in plain words: show `pay_url`, then check `status_url` once the buyer says they've paid.\",\n      \"example\": \"Show pay_url to the buyer as a link. When they say they've paid, call get_order with order_id.\",\n      \"type\": \"string\"\n    },\n    \"show_buyer\": {\n      \"description\": \"A suggested reply to the buyer, in Markdown with the links already written as links: the product and its options to pick from, the pay link, or what they got with a receipt link. Buyers have the best experience when agents show it as written.\",\n      \"example\": \"![Vintage Cream and Red Roller Skates](https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X)\\n\\n**Vintage Cream and Red Roller Skates**: $240.00. Classic quad skates crafted with walnut burl heels\\n\\n![Raptor Rush: Browser Edition](https://one-thing-ash0.onrender.com/api/blobs/R9tWc3yN6bJq1zUd)\\n\\n**Raptor Rush: Browser Edition**: $2.99. Grow from Tiny Hatchling to Giant Apex Predator\\n\\nWhich one?\",\n      \"type\": \"string\"\n    },\n    \"agent_name\": {\n      \"description\": \"Who this request was credited to in the seller's stats: a recognised user agent, else the name the agent gave itself (`?agent=`, or the MCP client's name), else the user agent's first word.\",\n      \"example\": \"Grok\",\n      \"type\": \"string\"\n    },\n    \"options\": {\n      \"description\": \"The buyer's pick, one value per option, keyed by option name.\",\n      \"example\": {\n        \"Size\": \"M\",\n        \"Color\": \"Black\"\n      },\n      \"type\": \"object\",\n      \"additionalProperties\": {\n        \"type\": \"string\"\n      }\n    }\n  },\n  \"required\": [\n    \"order_id\",\n    \"status\",\n    \"total\",\n    \"pay_url\",\n    \"status_url\",\n    \"next_step\"\n  ]\n}"
- AgentOrder: "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"id\": \"AgentOrder\",\n  \"title\": \"AgentOrder\",\n  \"description\": \"An order as `get_order` and `getAgentOrder` report it.\",\n  \"example\": {\n    \"show_buyer\": \"![Vintage Cream and Red Roller Skates](https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X)\\n\\n**Vintage Cream and Red Roller Skates**: $240.00. Classic quad skates crafted with walnut burl heels\\n\\n![Raptor Rush: Browser Edition](https://one-thing-ash0.onrender.com/api/blobs/R9tWc3yN6bJq1zUd)\\n\\n**Raptor Rush: Browser Edition**: $2.99. Grow from Tiny Hatchling to Giant Apex Predator\\n\\nWhich one?\",\n    \"agent_name\": \"Grok\",\n    \"order_id\": \"pX4kR9tVb2nQ7sLe\",\n    \"status\": \"awaiting_buyer_approval\",\n    \"product\": \"Vintage Cream and Red Roller Skates\",\n    \"options\": {\n      \"Size\": \"M\",\n      \"Color\": \"Black\"\n    },\n    \"amount\": {\n      \"item\": 240,\n      \"shipping\": 15,\n      \"total\": 255,\n      \"currency\": \"USD\"\n    },\n    \"total\": \"$255.00\",\n    \"pay_url\": \"https://one-thing-ash0.onrender.com/o/pX4kR9tVb2nQ7sLe\",\n    \"next_step\": \"Show pay_url to the buyer as a link. When they say they've paid, call get_order with order_id.\",\n    \"paid_at\": \"2026-10-22T02:41:37Z\",\n    \"receipt_url\": \"https://one-thing-ash0.onrender.com/vintageskates/thanks?order=pX4kR9tVb2nQ7sLe\",\n    \"delivery\": {\n      \"type\": \"access_code\",\n      \"access_code\": \"K7QF-M2XP-9HTD\",\n      \"start_url\": \"https://www.miriogames.com/raptor-rush/?code=K7QF-M2XP-9HTD\"\n    }\n  },\n  \"type\": \"object\",\n  \"properties\": {\n    \"order_id\": {\n      \"description\": \"The order's id.\",\n      \"example\": \"pX4kR9tVb2nQ7sLe\",\n      \"type\": \"string\"\n    },\n    \"status\": {\n      \"title\": \"Status2\",\n      \"description\": \"`declined`: PayPal declined it, nothing charged, the buyer can open `pay_url` again. `sold_out`: it sold out before the payment was captured. `expired`: the PayPal checkout expired; create a new order. `failed`: PayPal couldn't be reached; ask again.\",\n      \"example\": \"awaiting_buyer_approval\",\n      \"type\": \"string\",\n      \"additionalProperties\": false,\n      \"enum\": [\n        \"awaiting_buyer_approval\",\n        \"paid\",\n        \"declined\",\n        \"sold_out\",\n        \"expired\",\n        \"failed\"\n      ]\n    },\n    \"product\": {\n      \"description\": \"The product's name.\",\n      \"example\": \"Vintage Cream and Red Roller Skates\",\n      \"type\": \"string\"\n    },\n    \"amount\": {\n      \"id\": \"Amount\",\n      \"title\": \"Amount\",\n      \"description\": \"What the order costs, as numbers.\",\n      \"example\": {\n        \"item\": 240,\n        \"shipping\": 15,\n        \"total\": 255,\n        \"currency\": \"USD\"\n      },\n      \"type\": \"object\",\n      \"properties\": {\n        \"item\": {\n          \"description\": \"The product's price.\",\n          \"example\": 240,\n          \"type\": \"number\"\n        },\n        \"shipping\": {\n          \"description\": \"Shipping; 0 for digital products.\",\n          \"example\": 15,\n          \"type\": \"number\"\n        },\n        \"total\": {\n          \"description\": \"Product plus shipping: what the buyer pays.\",\n          \"example\": 255,\n          \"type\": \"number\"\n        },\n        \"currency\": {\n          \"description\": \"ISO 4217 currency code.\",\n          \"example\": \"USD\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"item\",\n        \"shipping\",\n        \"total\",\n        \"currency\"\n      ]\n    },\n    \"total\": {\n      \"description\": \"The total as a label, e.g. `$255.00`.\",\n      \"example\": \"$255.00\",\n      \"type\": \"string\"\n    },\n    \"show_buyer\": {\n      \"description\": \"A suggested reply to the buyer, in Markdown with the links already written as links: the product and its options to pick from, the pay link, or what they got with a receipt link. Buyers have the best experience when agents show it as written.\",\n      \"example\": \"![Vintage Cream and Red Roller Skates](https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X)\\n\\n**Vintage Cream and Red Roller Skates**: $240.00. Classic quad skates crafted with walnut burl heels\\n\\n![Raptor Rush: Browser Edition](https://one-thing-ash0.onrender.com/api/blobs/R9tWc3yN6bJq1zUd)\\n\\n**Raptor Rush: Browser Edition**: $2.99. Grow from Tiny Hatchling to Giant Apex Predator\\n\\nWhich one?\",\n      \"type\": \"string\"\n    },\n    \"agent_name\": {\n      \"description\": \"Who this request was credited to in the seller's stats: a recognised user agent, else the name the agent gave itself (`?agent=`, or the MCP client's name), else the user agent's first word.\",\n      \"example\": \"Grok\",\n      \"type\": \"string\"\n    },\n    \"options\": {\n      \"description\": \"The buyer's pick, one value per option, keyed by option name.\",\n      \"example\": {\n        \"Size\": \"M\",\n        \"Color\": \"Black\"\n      },\n      \"type\": \"object\",\n      \"additionalProperties\": {\n        \"type\": \"string\"\n      }\n    },\n    \"pay_url\": {\n      \"description\": \"Unpaid orders (waiting or declined). The buyer pays here; safe to show in chat.\",\n      \"example\": \"https://one-thing-ash0.onrender.com/o/pX4kR9tVb2nQ7sLe\",\n      \"type\": \"string\"\n    },\n    \"next_step\": {\n      \"description\": \"Unpaid orders. What the agent should do next, in plain words.\",\n      \"example\": \"Show pay_url to the buyer as a link. When they say they've paid, call get_order with order_id.\",\n      \"type\": \"string\"\n    },\n    \"paid_at\": {\n      \"description\": \"Paid orders. When PayPal captured the payment.\",\n      \"example\": \"2026-10-22T02:41:37Z\",\n      \"type\": \"string\",\n      \"format\": \"date-time\"\n    },\n    \"receipt_url\": {\n      \"description\": \"Paid orders. The buyer's thank-you page.\",\n      \"example\": \"https://one-thing-ash0.onrender.com/vintageskates/thanks?order=pX4kR9tVb2nQ7sLe\",\n      \"type\": \"string\"\n    },\n    \"delivery\": {\n      \"description\": \"Paid orders. What the buyer got.\",\n      \"example\": {\n        \"type\": \"access_code\",\n        \"access_code\": \"K7QF-M2XP-9HTD\",\n        \"start_url\": \"https://www.miriogames.com/raptor-rush/?code=K7QF-M2XP-9HTD\"\n      },\n      \"oneOf\": [\n        {\n          \"id\": \"AgentDeliveryAccessCode\",\n          \"title\": \"AgentDeliveryAccessCode\",\n          \"description\": \"A digital product unlocked with an access code.\",\n          \"example\": {\n            \"type\": \"access_code\",\n            \"access_code\": \"K7QF-M2XP-9HTD\",\n            \"start_url\": \"https://www.miriogames.com/raptor-rush/?code=K7QF-M2XP-9HTD\"\n          },\n          \"type\": \"object\",\n          \"properties\": {\n            \"type\": {\n              \"description\": \"Always `access_code`.\",\n              \"example\": \"access_code\",\n              \"type\": \"string\",\n              \"enum\": [\n                \"access_code\"\n              ]\n            },\n            \"access_code\": {\n              \"description\": \"The buyer's code, which unlocks the seller's app or game.\",\n              \"example\": \"K7QF-M2XP-9HTD\",\n              \"type\": \"string\"\n            },\n            \"start_url\": {\n              \"description\": \"The seller's app with the code filled in.\",\n              \"example\": \"https://www.miriogames.com/raptor-rush/?code=K7QF-M2XP-9HTD\",\n              \"type\": \"string\"\n            }\n          },\n          \"required\": [\n            \"type\",\n            \"access_code\"\n          ]\n        },\n        {\n          \"id\": \"AgentDeliveryDownload\",\n          \"title\": \"AgentDeliveryDownload\",\n          \"description\": \"A digital file to download.\",\n          \"example\": {\n            \"type\": \"download\",\n            \"download_url\": \"https://one-thing-ash0.onrender.com/api/download/dl_4mQ8sT2vX9\",\n            \"note\": \"Works 5 times over 14 days.\"\n          },\n          \"type\": \"object\",\n          \"properties\": {\n            \"type\": {\n              \"description\": \"Always `download`.\",\n              \"example\": \"download\",\n              \"type\": \"string\",\n              \"enum\": [\n                \"download\"\n              ]\n            },\n            \"download_url\": {\n              \"description\": \"A private link to the file. It works 5 times over 14 days.\",\n              \"example\": \"https://one-thing-ash0.onrender.com/api/download/dl_4mQ8sT2vX9\",\n              \"type\": \"string\"\n            },\n            \"note\": {\n              \"description\": \"How long the link lasts and how many downloads it allows, in words.\",\n              \"example\": \"Works 5 times over 14 days.\",\n              \"type\": \"string\"\n            }\n          },\n          \"required\": [\n            \"type\",\n            \"download_url\"\n          ]\n        },\n        {\n          \"id\": \"AgentDeliveryShipping\",\n          \"title\": \"AgentDeliveryShipping\",\n          \"description\": \"A physical product shipped to the buyer.\",\n          \"example\": {\n            \"type\": \"shipping\",\n            \"ship_to\": {\n              \"name\": \"Sam Rivera\",\n              \"address\": \"1 Main St, Springfield, IL, 62701, US\"\n            },\n            \"fulfillment\": \"to_ship\",\n            \"tracking\": {\n              \"carrier\": \"USPS\",\n              \"number\": \"9400111899223197428490\"\n            }\n          },\n          \"type\": \"object\",\n          \"properties\": {\n            \"type\": {\n              \"description\": \"Always `shipping`.\",\n              \"example\": \"shipping\",\n              \"type\": \"string\",\n              \"enum\": [\n                \"shipping\"\n              ]\n            },\n            \"fulfillment\": {\n              \"title\": \"Fulfillment\",\n              \"description\": \"`to_ship` until the seller adds tracking, then `shipped`.\",\n              \"example\": \"to_ship\",\n              \"type\": \"string\",\n              \"additionalProperties\": false,\n              \"enum\": [\n                \"to_ship\",\n                \"shipped\"\n              ]\n            },\n            \"ship_to\": {\n              \"id\": \"ShipTo\",\n              \"title\": \"ShipTo\",\n              \"description\": \"Where it ships, from the buyer's PayPal checkout. Null if PayPal didn't share it.\",\n              \"example\": {\n                \"name\": \"Sam Rivera\",\n                \"address\": \"1 Main St, Springfield, IL, 62701, US\"\n              },\n              \"type\": [\n                \"object\",\n                \"null\"\n              ],\n              \"properties\": {\n                \"name\": {\n                  \"description\": \"The recipient's name.\",\n                  \"example\": \"Sam Rivera\",\n                  \"type\": [\n                    \"string\",\n                    \"null\"\n                  ]\n                },\n                \"address\": {\n                  \"description\": \"The address on one line.\",\n                  \"example\": \"1 Main St, Springfield, IL, 62701, US\",\n                  \"type\": \"string\"\n                }\n              }\n            },\n            \"tracking\": {\n              \"id\": \"Tracking\",\n              \"title\": \"Tracking\",\n              \"description\": \"The carrier and tracking number once shipped; null before.\",\n              \"example\": {\n                \"carrier\": \"USPS\",\n                \"number\": \"9400111899223197428490\"\n              },\n              \"type\": [\n                \"object\",\n                \"null\"\n              ],\n              \"properties\": {\n                \"carrier\": {\n                  \"description\": \"The shipping carrier.\",\n                  \"example\": \"USPS\",\n                  \"type\": \"string\"\n                },\n                \"number\": {\n                  \"description\": \"The tracking number.\",\n                  \"example\": \"9400111899223197428490\",\n                  \"type\": \"string\"\n                }\n              }\n            }\n          },\n          \"required\": [\n            \"type\",\n            \"fulfillment\"\n          ]\n        }\n      ]\n    }\n  },\n  \"required\": [\n    \"order_id\",\n    \"status\",\n    \"product\",\n    \"amount\",\n    \"total\"\n  ]\n}"
- AgentDeliveryAccessCode: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "AgentDeliveryAccessCode",
      "title": "AgentDeliveryAccessCode",
      "description": "A digital product unlocked with an access code.",
      "example": {
        "type": "access_code",
        "access_code": "K7QF-M2XP-9HTD",
        "start_url": "https://www.miriogames.com/raptor-rush/?code=K7QF-M2XP-9HTD"
      },
      "type": "object",
      "properties": {
        "type": {
          "description": "Always `access_code`.",
          "example": "access_code",
          "type": "string",
          "enum": [
            "access_code"
          ]
        },
        "access_code": {
          "description": "The buyer's code, which unlocks the seller's app or game.",
          "example": "K7QF-M2XP-9HTD",
          "type": "string"
        },
        "start_url": {
          "description": "The seller's app with the code filled in.",
          "example": "https://www.miriogames.com/raptor-rush/?code=K7QF-M2XP-9HTD",
          "type": "string"
        }
      },
      "required": [
        "type",
        "access_code"
      ]
    }
- AgentDeliveryDownload: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "AgentDeliveryDownload",
      "title": "AgentDeliveryDownload",
      "description": "A digital file to download.",
      "example": {
        "type": "download",
        "download_url": "https://one-thing-ash0.onrender.com/api/download/dl_4mQ8sT2vX9",
        "note": "Works 5 times over 14 days."
      },
      "type": "object",
      "properties": {
        "type": {
          "description": "Always `download`.",
          "example": "download",
          "type": "string",
          "enum": [
            "download"
          ]
        },
        "download_url": {
          "description": "A private link to the file. It works 5 times over 14 days.",
          "example": "https://one-thing-ash0.onrender.com/api/download/dl_4mQ8sT2vX9",
          "type": "string"
        },
        "note": {
          "description": "How long the link lasts and how many downloads it allows, in words.",
          "example": "Works 5 times over 14 days.",
          "type": "string"
        }
      },
      "required": [
        "type",
        "download_url"
      ]
    }
- AgentDeliveryShipping: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "AgentDeliveryShipping",
      "title": "AgentDeliveryShipping",
      "description": "A physical product shipped to the buyer.",
      "example": {
        "type": "shipping",
        "ship_to": {
          "name": "Sam Rivera",
          "address": "1 Main St, Springfield, IL, 62701, US"
        },
        "fulfillment": "to_ship",
        "tracking": {
          "carrier": "USPS",
          "number": "9400111899223197428490"
        }
      },
      "type": "object",
      "properties": {
        "type": {
          "description": "Always `shipping`.",
          "example": "shipping",
          "type": "string",
          "enum": [
            "shipping"
          ]
        },
        "fulfillment": {
          "title": "Fulfillment",
          "description": "`to_ship` until the seller adds tracking, then `shipped`.",
          "example": "to_ship",
          "type": "string",
          "additionalProperties": false,
          "enum": [
            "to_ship",
            "shipped"
          ]
        },
        "ship_to": {
          "id": "ShipTo",
          "title": "ShipTo",
          "description": "Where it ships, from the buyer's PayPal checkout. Null if PayPal didn't share it.",
          "example": {
            "name": "Sam Rivera",
            "address": "1 Main St, Springfield, IL, 62701, US"
          },
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "name": {
              "description": "The recipient's name.",
              "example": "Sam Rivera",
              "type": [
                "string",
                "null"
              ]
            },
            "address": {
              "description": "The address on one line.",
              "example": "1 Main St, Springfield, IL, 62701, US",
              "type": "string"
            }
          }
        },
        "tracking": {
          "id": "Tracking",
          "title": "Tracking",
          "description": "The carrier and tracking number once shipped; null before.",
          "example": {
            "carrier": "USPS",
            "number": "9400111899223197428490"
          },
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "carrier": {
              "description": "The shipping carrier.",
              "example": "USPS",
              "type": "string"
            },
            "number": {
              "description": "The tracking number.",
              "example": "9400111899223197428490",
              "type": "string"
            }
          }
        }
      },
      "required": [
        "type",
        "fulfillment"
      ]
    }
- PlatformShop: "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"id\": \"PlatformShop\",\n  \"title\": \"PlatformShop\",\n  \"description\": \"A shop as a platform API key lists it.\",\n  \"example\": {\n    \"slug\": \"vintageskates\",\n    \"status\": \"draft\",\n    \"name\": \"Vintage Cream and Red Roller Skates\",\n    \"headline\": \"Classic quad skates crafted with walnut burl heels\",\n    \"product_type\": \"physical\",\n    \"price\": {\n      \"amount\": 240,\n      \"currency\": \"USD\",\n      \"label\": \"$240.00\"\n    },\n    \"url\": \"https://one-thing-ash0.onrender.com/vintageskates\",\n    \"cover\": \"https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X\",\n    \"paypal_connected\": true,\n    \"sales\": 12,\n    \"created_at\": \"2026-10-22T02:41:37Z\"\n  },\n  \"type\": \"object\",\n  \"properties\": {\n    \"slug\": {\n      \"description\": \"The shop's link name.\",\n      \"example\": \"vintageskates\",\n      \"type\": \"string\"\n    },\n    \"status\": {\n      \"title\": \"Status3\",\n      \"description\": \"`draft` until the seller goes live.\",\n      \"example\": \"draft\",\n      \"type\": \"string\",\n      \"additionalProperties\": false,\n      \"enum\": [\n        \"draft\",\n        \"live\"\n      ]\n    },\n    \"name\": {\n      \"description\": \"The product's name.\",\n      \"example\": \"Vintage Cream and Red Roller Skates\",\n      \"type\": \"string\"\n    },\n    \"product_type\": {\n      \"title\": \"ProductType3\",\n      \"description\": \"`physical`, `digital` or `referral`.\",\n      \"example\": \"physical\",\n      \"type\": \"string\",\n      \"additionalProperties\": false,\n      \"enum\": [\n        \"physical\",\n        \"digital\",\n        \"referral\"\n      ]\n    },\n    \"price\": {\n      \"id\": \"AgentMoney\",\n      \"title\": \"AgentMoney\",\n      \"description\": \"An amount of money, as a number and as a label.\",\n      \"example\": {\n        \"amount\": 240,\n        \"currency\": \"USD\",\n        \"label\": \"$240.00\"\n      },\n      \"type\": \"object\",\n      \"properties\": {\n        \"amount\": {\n          \"description\": \"The amount in the currency's main unit (dollars, not cents).\",\n          \"example\": 48.5,\n          \"type\": \"number\"\n        },\n        \"currency\": {\n          \"description\": \"ISO 4217 currency code.\",\n          \"example\": \"USD\",\n          \"type\": \"string\"\n        },\n        \"label\": {\n          \"description\": \"The amount formatted for people.\",\n          \"example\": \"$48.50\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"amount\",\n        \"currency\"\n      ]\n    },\n    \"url\": {\n      \"description\": \"The shop page buyers pay on.\",\n      \"example\": \"https://one-thing-ash0.onrender.com/vintageskates\",\n      \"type\": \"string\"\n    },\n    \"paypal_connected\": {\n      \"description\": \"The seller connected a PayPal account that can be paid.\",\n      \"example\": true,\n      \"type\": \"boolean\"\n    },\n    \"sales\": {\n      \"description\": \"Paid orders.\",\n      \"example\": 12,\n      \"type\": \"integer\",\n      \"format\": \"int32\"\n    },\n    \"created_at\": {\n      \"description\": \"When the shop was made.\",\n      \"example\": \"2026-10-22T02:41:37Z\",\n      \"type\": \"string\",\n      \"format\": \"date-time\"\n    },\n    \"headline\": {\n      \"description\": \"The shop's one-line pitch.\",\n      \"example\": \"Classic quad skates crafted with walnut burl heels\",\n      \"type\": \"string\"\n    },\n    \"cover\": {\n      \"description\": \"The cover image's URL.\",\n      \"example\": \"https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X\",\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    }\n  },\n  \"required\": [\n    \"slug\",\n    \"status\",\n    \"name\",\n    \"product_type\",\n    \"price\",\n    \"url\",\n    \"paypal_connected\",\n    \"sales\",\n    \"created_at\"\n  ]\n}"
- AgentMoney: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "AgentMoney",
      "title": "AgentMoney",
      "description": "An amount of money, as a number and as a label.",
      "example": {
        "amount": 240,
        "currency": "USD",
        "label": "$240.00"
      },
      "type": "object",
      "properties": {
        "amount": {
          "description": "The amount in the currency's main unit (dollars, not cents).",
          "example": 48.5,
          "type": "number"
        },
        "currency": {
          "description": "ISO 4217 currency code.",
          "example": "USD",
          "type": "string"
        },
        "label": {
          "description": "The amount formatted for people.",
          "example": "$48.50",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency"
      ]
    }
- JsonRpcRequest: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "JsonRpcRequest",
      "title": "JsonRpcRequest",
      "description": "A JSON-RPC 2.0 request to the MCP server.",
      "example": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "tools/call",
        "params": {
          "name": "get_product",
          "arguments": {
            "shop": "vintageskates"
          }
        }
      },
      "type": "object",
      "properties": {
        "jsonrpc": {
          "description": "Always `2.0`.",
          "example": "2.0",
          "type": "string",
          "enum": [
            "2.0"
          ]
        },
        "method": {
          "title": "Method",
          "description": "The MCP method. `tools/call` runs a tool; `tools/list` lists them.",
          "example": "tools/call",
          "type": "string",
          "additionalProperties": false,
          "enum": [
            "initialize",
            "ping",
            "tools/list",
            "tools/call",
            "notifications/initialized"
          ]
        },
        "id": {
          "description": "Leave out for a notification.",
          "example": "1",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "integer",
              "format": "int32"
            },
            {
              "type": "null"
            }
          ]
        },
        "params": {
          "description": "For `tools/call`: `{ name, arguments }`.",
          "example": {
            "name": "get_product",
            "arguments": {
              "shop": "vintageskates"
            }
          },
          "type": "object"
        }
      },
      "required": [
        "jsonrpc",
        "method"
      ]
    }
- JsonRpcResponse: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "JsonRpcResponse",
      "title": "JsonRpcResponse",
      "description": "A JSON-RPC 2.0 reply from the MCP server.",
      "example": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "content": [
            {
              "type": "text",
              "text": "{\"shop\": \"vintageskates\"}"
            }
          ],
          "isError": false
        }
      },
      "type": "object",
      "properties": {
        "jsonrpc": {
          "description": "Always `2.0`.",
          "example": "2.0",
          "type": "string",
          "enum": [
            "2.0"
          ]
        },
        "id": {
          "description": "The request's `id`.",
          "example": "1",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "integer",
              "format": "int32"
            },
            {
              "type": "null"
            }
          ]
        },
        "result": {
          "description": "For `tools/call`: `content` (the answer as JSON text), `structuredContent` (the same object) and `isError`.",
          "example": {
            "isError": false
          },
          "type": "object"
        },
        "error": {
          "id": "Error",
          "title": "Error",
          "description": "Present when the call failed.",
          "example": {
            "code": -32601,
            "message": "Method not found"
          },
          "type": "object",
          "properties": {
            "code": {
              "description": "The JSON-RPC error code.",
              "example": -32601,
              "type": "integer",
              "format": "int32"
            },
            "message": {
              "description": "What went wrong.",
              "example": "Method not found",
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ]
        }
      },
      "required": [
        "jsonrpc",
        "id"
      ]
    }
- Referral: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "Referral",
      "title": "Referral",
      "description": "A recommended Channel3 product. Buy links are Channel3-tracked, credited to this shop.",
      "example": {
        "productId": "ch3_7f2a9c1e",
        "title": "Trail Running Vest 5L",
        "brand": "Salomon",
        "image": "https://images.example.com/vest.jpg",
        "offers": [
          {
            "domain": "rei.com",
            "url": "https://buy.trychannel3.com/r/abc123",
            "price": 240,
            "currency": "USD",
            "inStock": true,
            "commission": 0.08
          }
        ]
      },
      "type": "object",
      "properties": {
        "productId": {
          "description": "Channel3's product id.",
          "example": "ch3_7f2a9c1e",
          "type": "string"
        },
        "title": {
          "description": "The product's name.",
          "example": "Trail Running Vest 5L",
          "type": "string"
        },
        "offers": {
          "description": "Stores that sell it, with tracked links.",
          "example": [
            {
              "domain": "rei.com",
              "url": "https://buy.trychannel3.com/r/abc123",
              "price": 240,
              "currency": "USD",
              "inStock": true,
              "commission": 0.08
            }
          ],
          "type": "array",
          "items": {
            "id": "Offer",
            "title": "Offer",
            "description": "One store's offer.",
            "example": {
              "domain": "rei.com",
              "url": "https://buy.trychannel3.com/r/abc123",
              "price": 240,
              "currency": "USD",
              "inStock": true,
              "commission": 0.08
            },
            "type": "object",
            "properties": {
              "domain": {
                "description": "The store's domain.",
                "example": "rei.com",
                "type": "string"
              },
              "url": {
                "description": "A Channel3-tracked buy link, credited to this shop.",
                "example": "https://buy.trychannel3.com/r/abc123",
                "type": "string"
              },
              "price": {
                "description": "The store's price.",
                "example": 240,
                "type": "number"
              },
              "currency": {
                "description": "ISO 4217 currency code.",
                "example": "USD",
                "type": "string"
              },
              "inStock": {
                "description": "Whether the store has it in stock.",
                "example": true,
                "type": "boolean"
              },
              "commission": {
                "description": "Maximum commission rate, 0–1 (0.08 = 8%).",
                "example": 0.08,
                "type": "number"
              }
            },
            "required": [
              "domain",
              "url",
              "price",
              "currency",
              "inStock",
              "commission"
            ]
          }
        },
        "brand": {
          "description": "The brand, when known.",
          "example": "Salomon",
          "type": [
            "string",
            "null"
          ]
        },
        "image": {
          "description": "The product image's URL.",
          "example": "https://images.example.com/vest.jpg",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "productId",
        "title",
        "offers"
      ]
    }
- ProductCard: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ProductCard",
      "title": "ProductCard",
      "description": "A Channel3 product in search results.",
      "example": {
        "id": "ch3_7f2a9c1e",
        "title": "Trail Running Vest 5L",
        "brand": "Salomon",
        "image": "https://images.example.com/vest.jpg",
        "price": 240,
        "currency": "USD",
        "retailer": "rei.com",
        "retailers": 4,
        "commission": 0.08
      },
      "type": "object",
      "properties": {
        "id": {
          "description": "Channel3's product id: pass it to `createShop` as `productId`.",
          "example": "ch3_7f2a9c1e",
          "type": "string"
        },
        "title": {
          "description": "The product's name.",
          "example": "Trail Running Vest 5L",
          "type": "string"
        },
        "image": {
          "description": "The product image's URL.",
          "example": "https://images.example.com/vest.jpg",
          "type": "string"
        },
        "price": {
          "description": "The best offer's price.",
          "example": 240,
          "type": "number"
        },
        "currency": {
          "description": "ISO 4217 currency code.",
          "example": "USD",
          "type": "string"
        },
        "retailer": {
          "description": "The store with the best offer.",
          "example": "rei.com",
          "type": "string"
        },
        "retailers": {
          "description": "How many stores sell it.",
          "example": 4,
          "type": "integer",
          "format": "int32"
        },
        "commission": {
          "description": "Best commission rate across offers, 0–1.",
          "example": 0.08,
          "type": "number"
        },
        "brand": {
          "description": "The brand, when known.",
          "example": "Salomon",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "title",
        "image",
        "price",
        "currency",
        "retailer",
        "retailers",
        "commission"
      ]
    }
- Order: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "Order",
      "title": "Order",
      "description": "An order, as the seller sees it.",
      "example": {
        "id": "pX4kR9tVb2nQ7sLe",
        "paypal_order_id": "5O190127TN364715T",
        "status": "created",
        "amount_cents": 25500,
        "shipping_cents": 1500,
        "currency": "USD",
        "buyer_email": "sam@example.com",
        "buyer_name": "Sam Rivera",
        "shipping_address": {
          "address_line_1": "1 Main St",
          "admin_area_2": "Springfield",
          "admin_area_1": "IL",
          "postal_code": "62701",
          "country_code": "US"
        },
        "capture_id": "3C679366HH908993F",
        "fulfillment_status": "none",
        "carrier": "USPS",
        "tracking_number": "9400111899223197428490",
        "tracking_synced": false,
        "downloads": 0,
        "access_code": "K7QF-M2XP-9HTD",
        "code_uses": 0,
        "code_last_used_at": "2026-10-22T02:41:37Z",
        "channel": "web",
        "agent": "Grok",
        "refund_id": "1JU08902781691411",
        "refunded_at": "2026-10-22T02:41:37Z",
        "options": {
          "Size": "9"
        },
        "paid_at": "2026-10-22T02:41:37Z",
        "created_at": "2026-10-22T02:41:37Z"
      },
      "type": "object",
      "properties": {
        "id": {
          "description": "OneThing's order id.",
          "example": "pX4kR9tVb2nQ7sLe",
          "type": "string"
        },
        "status": {
          "title": "Status4",
          "description": "`created` until paid; `failed` if PayPal declined; `refunded` after a refund.",
          "example": "created",
          "type": "string",
          "additionalProperties": false,
          "enum": [
            "created",
            "paid",
            "failed",
            "refunded"
          ]
        },
        "amount_cents": {
          "description": "The total charged, shipping included, in cents.",
          "example": 25500,
          "type": "integer",
          "format": "int32"
        },
        "currency": {
          "description": "ISO 4217 currency code.",
          "example": "USD",
          "type": "string"
        },
        "fulfillment_status": {
          "title": "FulfillmentStatus",
          "description": "`to_ship` and `shipped` for physical orders, `digital_sent` for digital ones, `none` before payment.",
          "example": "none",
          "type": "string",
          "additionalProperties": false,
          "enum": [
            "none",
            "to_ship",
            "shipped",
            "digital_sent"
          ]
        },
        "paypal_order_id": {
          "description": "PayPal's order id.",
          "example": "5O190127TN364715T",
          "type": [
            "string",
            "null"
          ]
        },
        "shipping_cents": {
          "description": "The shipping part of `amount_cents`.",
          "example": 1500,
          "type": "integer",
          "format": "int32"
        },
        "buyer_email": {
          "description": "From PayPal, once paid.",
          "example": "sam@example.com",
          "type": [
            "string",
            "null"
          ]
        },
        "buyer_name": {
          "description": "From PayPal, once paid.",
          "example": "Sam Rivera",
          "type": [
            "string",
            "null"
          ]
        },
        "shipping_address": {
          "description": "Physical orders: the address from PayPal checkout, by field.",
          "example": {
            "address_line_1": "1 Main St",
            "admin_area_2": "Springfield",
            "admin_area_1": "IL",
            "postal_code": "62701",
            "country_code": "US"
          },
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        },
        "capture_id": {
          "description": "PayPal's capture id, once paid. Refunds use it.",
          "example": "3C679366HH908993F",
          "type": [
            "string",
            "null"
          ]
        },
        "carrier": {
          "description": "Shipped orders: the carrier.",
          "example": "USPS",
          "type": [
            "string",
            "null"
          ]
        },
        "tracking_number": {
          "description": "Shipped orders: the tracking number.",
          "example": "9400111899223197428490",
          "type": [
            "string",
            "null"
          ]
        },
        "tracking_synced": {
          "description": "Whether PayPal accepted the tracking number.",
          "example": false,
          "type": "boolean"
        },
        "downloads": {
          "description": "How many times the buyer downloaded the file.",
          "example": 0,
          "type": "integer",
          "format": "int32"
        },
        "access_code": {
          "description": "Access-code products: the code this buyer got.",
          "example": "K7QF-M2XP-9HTD",
          "type": [
            "string",
            "null"
          ]
        },
        "code_uses": {
          "description": "How many times the access code was checked.",
          "example": 0,
          "type": "integer",
          "format": "int32"
        },
        "code_last_used_at": {
          "description": "When the access code was last checked with `verifyAccessCode`.",
          "example": "2026-10-22T02:41:37Z",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "channel": {
          "title": "Channel",
          "description": "`agent` for orders an AI agent placed (MCP or an order link).",
          "example": "web",
          "type": "string",
          "additionalProperties": false,
          "enum": [
            "web",
            "agent"
          ]
        },
        "agent": {
          "description": "The agent credited with an agent order, such as `Grok`.",
          "example": "Grok",
          "type": [
            "string",
            "null"
          ]
        },
        "refund_id": {
          "description": "PayPal's refund id, once refunded through OneThing.",
          "example": "1JU08902781691411",
          "type": [
            "string",
            "null"
          ]
        },
        "refunded_at": {
          "description": "When the order was refunded.",
          "example": "2026-10-22T02:41:37Z",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "options": {
          "description": "The buyer's pick, one value per option, keyed by option name (see `Choice`).",
          "example": {
            "Size": "9"
          },
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        },
        "paid_at": {
          "description": "When PayPal captured the payment.",
          "example": "2026-10-22T02:41:37Z",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "created_at": {
          "description": "When the order was made.",
          "example": "2026-10-22T02:41:37Z",
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "status",
        "amount_cents",
        "currency",
        "fulfillment_status"
      ]
    }
- WebhookEvent: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "WebhookEvent",
      "title": "WebhookEvent",
      "description": "A PayPal webhook delivery for this shop's orders.",
      "example": {
        "id": "WH-2WR32451HC0233532-67976317FL4543714",
        "event_type": "PAYMENT.CAPTURE.COMPLETED",
        "paypal_order_id": "5O190127TN364715T",
        "summary": "2.99 USD",
        "verified": true,
        "outcome": "Confirmed: order already paid",
        "received_at": "2026-10-22T02:41:37Z"
      },
      "type": "object",
      "properties": {
        "id": {
          "description": "PayPal's event id.",
          "example": "WH-2WR32451HC0233532-67976317FL4543714",
          "type": "string"
        },
        "event_type": {
          "description": "PayPal's event type.",
          "example": "PAYMENT.CAPTURE.COMPLETED",
          "type": "string"
        },
        "verified": {
          "description": "Whether PayPal confirmed the delivery's signature.",
          "example": true,
          "type": "boolean"
        },
        "outcome": {
          "description": "What OneThing did with it.",
          "example": "Confirmed: order already paid",
          "type": "string"
        },
        "received_at": {
          "description": "When it arrived.",
          "example": "2026-10-22T02:41:37Z",
          "type": "string",
          "format": "date-time"
        },
        "paypal_order_id": {
          "description": "The PayPal order it was about.",
          "example": "5O190127TN364715T",
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "description": "The amount, or PayPal's summary.",
          "example": "2.99 USD",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "event_type",
        "verified",
        "outcome",
        "received_at"
      ]
    }
- OrderEvent: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "OrderEvent",
      "title": "OrderEvent",
      "description": "What OneThing posts to the seller's Zapier hook.",
      "example": {
        "event": "order.paid",
        "shop": {
          "slug": "vintageskates",
          "name": "Vintage Cream and Red Roller Skates",
          "url": "https://one-thing-ash0.onrender.com/vintageskates"
        },
        "order": {
          "id": "pX4kR9tVb2nQ7sLe",
          "paypal_order_id": "5O190127TN364715T",
          "amount": "255.00",
          "currency": "USD",
          "buyer_name": "Sam Rivera",
          "buyer_email": "sam@example.com",
          "shipping_address": {
            "address_line_1": "1 Main St",
            "admin_area_2": "Springfield",
            "admin_area_1": "IL",
            "postal_code": "62701",
            "country_code": "US"
          },
          "fulfillment_status": "to_ship",
          "tracking_number": "9400111899223197428490",
          "carrier": "USPS"
        }
      },
      "type": "object",
      "properties": {
        "event": {
          "title": "Event",
          "description": "What happened.",
          "example": "order.paid",
          "type": "string",
          "additionalProperties": false,
          "enum": [
            "order.paid",
            "order.shipped",
            "order.refunded"
          ]
        },
        "shop": {
          "id": "Shop1",
          "title": "Shop1",
          "description": "The shop the order belongs to.",
          "example": {
            "slug": "vintageskates",
            "name": "Vintage Cream and Red Roller Skates",
            "url": "https://one-thing-ash0.onrender.com/vintageskates"
          },
          "type": "object",
          "properties": {
            "slug": {
              "description": "The shop's link name.",
              "example": "vintageskates",
              "type": "string"
            },
            "name": {
              "description": "The product's name.",
              "example": "Vintage Cream and Red Roller Skates",
              "type": "string"
            },
            "url": {
              "description": "The shop page.",
              "example": "https://one-thing-ash0.onrender.com/vintageskates",
              "type": "string"
            }
          }
        },
        "order": {
          "id": "Order1",
          "title": "Order1",
          "description": "The order.",
          "example": {
            "id": "pX4kR9tVb2nQ7sLe",
            "paypal_order_id": "5O190127TN364715T",
            "amount": "255.00",
            "currency": "USD",
            "buyer_name": "Sam Rivera",
            "buyer_email": "sam@example.com",
            "shipping_address": {
              "address_line_1": "1 Main St",
              "admin_area_2": "Springfield",
              "admin_area_1": "IL",
              "postal_code": "62701",
              "country_code": "US"
            },
            "fulfillment_status": "to_ship",
            "tracking_number": "9400111899223197428490",
            "carrier": "USPS"
          },
          "type": "object",
          "properties": {
            "id": {
              "description": "OneThing's order id.",
              "example": "pX4kR9tVb2nQ7sLe",
              "type": "string"
            },
            "paypal_order_id": {
              "description": "PayPal's order id.",
              "example": "5O190127TN364715T",
              "type": [
                "string",
                "null"
              ]
            },
            "amount": {
              "description": "The total, as a decimal string.",
              "example": "2.99",
              "type": "string"
            },
            "currency": {
              "description": "ISO 4217 currency code.",
              "example": "USD",
              "type": "string"
            },
            "buyer_name": {
              "description": "The buyer's name, from PayPal.",
              "example": "Sam Rivera",
              "type": [
                "string",
                "null"
              ]
            },
            "buyer_email": {
              "description": "The buyer's email, from PayPal.",
              "example": "sam@example.com",
              "type": [
                "string",
                "null"
              ]
            },
            "shipping_address": {
              "description": "Physical orders: the address, by field.",
              "example": {
                "address_line_1": "1 Main St",
                "admin_area_2": "Springfield",
                "admin_area_1": "IL",
                "postal_code": "62701",
                "country_code": "US"
              },
              "type": [
                "object",
                "null"
              ]
            },
            "fulfillment_status": {
              "description": "As in `Order.fulfillment_status`.",
