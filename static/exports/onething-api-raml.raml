                    }
                  example: '{"error":"Shop not found."}'
      /photos:
        uriParameters: {}
        post:
          securedBy:
          - AdminToken
          - PlatformKey
          description: Adds one or more photos after the cover. Each is turned upright, resized to at most 2000 px and stored as WebP. A shop holds up to 8 photos; buyers swipe through them on the shop page. Not for recommendations, which show the retailer's photos.
          body:
            multipart/form-data:
              formParameters:
                photo:
                  description: An image, up to 15 MB. The endpoint also accepts the field repeated, to add several in one request.
                  type: file
                  required: true
                  displayName: photo
          responses:
            '200':
              description: The shop's photos, cover first.
              body:
                application/json:
                  schema: "{\n  \"id\": \"ShopPhotos\",\n  \"title\": \"ShopPhotos\",\n  \"description\": \"The shop's photos.\",\n  \"example\": {\n    \"photos\": [\n      {\n        \"id\": \"LFRvGuTU3D8i334X\",\n        \"url\": \"/api/blobs/LFRvGuTU3D8i334X\"\n      },\n      {\n        \"id\": \"zrySajNyao6_j11x\",\n        \"url\": \"/api/blobs/zrySajNyao6_j11x\"\n      }\n    ]\n  },\n  \"type\": \"object\",\n  \"properties\": {\n    \"photos\": {\n      \"description\": \"Every photo, the cover first.\",\n      \"example\": [\n        {\n          \"id\": \"LFRvGuTU3D8i334X\",\n          \"url\": \"/api/blobs/LFRvGuTU3D8i334X\"\n        }\n      ],\n      \"type\": \"array\",\n      \"items\": {\n        \"id\": \"Photo\",\n        \"title\": \"Photo\",\n        \"description\": \"One photo.\",\n        \"example\": {\n          \"id\": \"LFRvGuTU3D8i334X\",\n          \"url\": \"/api/blobs/LFRvGuTU3D8i334X\"\n        },\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"description\": \"The photo's id, for `getImage`, `setPhotoOrder` and colour matching.\",\n            \"example\": \"LFRvGuTU3D8i334X\",\n            \"type\": \"string\"\n          },\n          \"url\": {\n            \"description\": \"Public image URL on this site.\",\n            \"example\": \"/api/blobs/LFRvGuTU3D8i334X\",\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"id\",\n          \"url\"\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"photos\"\n  ]\n}"
                  example: '{"photos":[{"id":"LFRvGuTU3D8i334X","url":"/api/blobs/LFRvGuTU3D8i334X"},{"id":"zrySajNyao6_j11x","url":"/api/blobs/zrySajNyao6_j11x"}]}'
            '400':
              description: Something in the request needs fixing; `error` says what.
              body:
                application/json:
                  schema: |
                    {
                      "id": "ErrorResponse",
                      "title": "ErrorResponse",
                      "description": "An error reply.",
                      "example": {
                        "error": "Choose a photo.",
                        "field": "photo"
                      },
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "A sentence you can show to a person.",
                          "example": "Order not found.",
                          "type": "string"
                        },
                        "field": {
                          "description": "The form field at fault, when there is one.",
                          "example": "price",
                          "type": "string"
                        },
                        "detail": {
                          "description": "The upstream service's own message, for debugging.",
                          "example": "INSTRUMENT_DECLINED",
                          "type": "string"
                        }
                      },
                      "required": [
                        "error"
                      ]
                    }
                  example: '{"error":"Choose a photo."}'
            '404':
              description: No such shop, or the admin token or API key doesn't match it.
              body:
                application/json:
                  schema: |
                    {
                      "id": "ErrorResponse",
                      "title": "ErrorResponse",
                      "description": "An error reply.",
                      "example": {
                        "error": "Choose a photo.",
                        "field": "photo"
                      },
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "A sentence you can show to a person.",
                          "example": "Order not found.",
                          "type": "string"
                        },
                        "field": {
                          "description": "The form field at fault, when there is one.",
                          "example": "price",
                          "type": "string"
                        },
                        "detail": {
                          "description": "The upstream service's own message, for debugging.",
                          "example": "INSTRUMENT_DECLINED",
                          "type": "string"
                        }
                      },
                      "required": [
                        "error"
                      ]
                    }
                  example: '{"error":"Shop not found."}'
        put:
          securedBy:
          - AdminToken
          - PlatformKey
          description: Sets the photo order; the first becomes the cover. Leaving a photo out removes it.
          headers:
            Content-Type:
              required: true
              displayName: Content-Type
              enum:
              - application/json
          body:
            application/json:
              schema: "{\n  \"id\": \"ApiShopsPhotosRequest\",\n  \"title\": \"ApiShopsPhotosRequest\",\n  \"description\": \"Every photo id, in the new order.\",\n  \"example\": {\n    \"photos\": [\n      \"zrySajNyao6_j11x\",\n      \"LFRvGuTU3D8i334X\",\n      \"SuqcgNv64HWN8H6e\"\n    ]\n  },\n  \"type\": \"object\",\n  \"properties\": {\n    \"photos\": {\n      \"description\": \"Photo ids, in order.\",\n      \"example\": [\n        \"zrySajNyao6_j11x\",\n        \"LFRvGuTU3D8i334X\"\n      ],\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"maxItems\": 8\n    }\n  },\n  \"required\": [\n    \"photos\"\n  ]\n}"
              example: '{"photos":["zrySajNyao6_j11x","LFRvGuTU3D8i334X","SuqcgNv64HWN8H6e"]}'
          responses:
            '200':
              description: The shop's photos, cover first.
              body:
                application/json:
                  schema: "{\n  \"id\": \"ShopPhotos\",\n  \"title\": \"ShopPhotos\",\n  \"description\": \"The shop's photos.\",\n  \"example\": {\n    \"photos\": [\n      {\n        \"id\": \"LFRvGuTU3D8i334X\",\n        \"url\": \"/api/blobs/LFRvGuTU3D8i334X\"\n      },\n      {\n        \"id\": \"zrySajNyao6_j11x\",\n        \"url\": \"/api/blobs/zrySajNyao6_j11x\"\n      }\n    ]\n  },\n  \"type\": \"object\",\n  \"properties\": {\n    \"photos\": {\n      \"description\": \"Every photo, the cover first.\",\n      \"example\": [\n        {\n          \"id\": \"LFRvGuTU3D8i334X\",\n          \"url\": \"/api/blobs/LFRvGuTU3D8i334X\"\n        }\n      ],\n      \"type\": \"array\",\n      \"items\": {\n        \"id\": \"Photo\",\n        \"title\": \"Photo\",\n        \"description\": \"One photo.\",\n        \"example\": {\n          \"id\": \"LFRvGuTU3D8i334X\",\n          \"url\": \"/api/blobs/LFRvGuTU3D8i334X\"\n        },\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"description\": \"The photo's id, for `getImage`, `setPhotoOrder` and colour matching.\",\n            \"example\": \"LFRvGuTU3D8i334X\",\n            \"type\": \"string\"\n          },\n          \"url\": {\n            \"description\": \"Public image URL on this site.\",\n            \"example\": \"/api/blobs/LFRvGuTU3D8i334X\",\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"id\",\n          \"url\"\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"photos\"\n  ]\n}"
                  example: '{"photos":[{"id":"LFRvGuTU3D8i334X","url":"/api/blobs/LFRvGuTU3D8i334X"},{"id":"zrySajNyao6_j11x","url":"/api/blobs/zrySajNyao6_j11x"}]}'
            '400':
              description: Something in the request needs fixing; `error` says what.
              body:
                application/json:
                  schema: |
                    {
                      "id": "ErrorResponse",
                      "title": "ErrorResponse",
                      "description": "An error reply.",
                      "example": {
                        "error": "Choose a photo.",
                        "field": "photo"
                      },
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "A sentence you can show to a person.",
                          "example": "Order not found.",
                          "type": "string"
                        },
                        "field": {
                          "description": "The form field at fault, when there is one.",
                          "example": "price",
                          "type": "string"
                        },
                        "detail": {
                          "description": "The upstream service's own message, for debugging.",
                          "example": "INSTRUMENT_DECLINED",
                          "type": "string"
                        }
                      },
                      "required": [
                        "error"
                      ]
                    }
                  example: '{"error":"Choose a photo."}'
            '404':
              description: No such shop, or the admin token or API key doesn't match it.
              body:
                application/json:
                  schema: |
                    {
                      "id": "ErrorResponse",
                      "title": "ErrorResponse",
                      "description": "An error reply.",
                      "example": {
                        "error": "Choose a photo.",
                        "field": "photo"
                      },
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "A sentence you can show to a person.",
                          "example": "Order not found.",
                          "type": "string"
                        },
                        "field": {
                          "description": "The form field at fault, when there is one.",
                          "example": "price",
                          "type": "string"
                        },
                        "detail": {
                          "description": "The upstream service's own message, for debugging.",
                          "example": "INSTRUMENT_DECLINED",
                          "type": "string"
                        }
                      },
                      "required": [
                        "error"
                      ]
                    }
                  example: '{"error":"Shop not found."}'
      /suggest:
        uriParameters: {}
        post:
          securedBy:
          - AdminToken
          - PlatformKey
          description: >
            Asks Gemini what buyers will want to choose (sizes, colours) and what they'll ask that the

            listing doesn't say (dimensions, materials). `createShop` already does this once; call it

            again after editing the product. The result is saved as the shop's `suggestions`.


            Nothing changes on the shop page until the seller confirms: save options with `updateShop`

            (`options`), and answer the questions with `updateShop` (`facts`). Not for recommendations.
          responses:
            '200':
              description: The suggestions.
              body:
                application/json:
                  schema: |
                    {
                      "id": "Suggestions",
                      "title": "Suggestions",
                      "description": "What Gemini thinks buyers will want to choose or ask. The seller confirms; nothing is applied on its own.",
                      "example": {
                        "oneOfAKind": false,
                        "options": [
                          {
                            "name": "Size",
                            "kind": "size",
                            "values": [
                              {
                                "label": "S"
                              },
                              {
                                "label": "M"
                              },
                              {
                                "label": "L"
                              }
                            ]
                          }
                        ],
                        "missingFacts": [
                          {
                            "label": "Size",
                            "question": "What size are the skates?",
                            "placeholder": "US women's 8"
                          }
                        ]
                      },
                      "type": "object",
                      "properties": {
                        "oneOfAKind": {
                          "description": "A single item (vintage, handmade), so options and stock don't apply.",
                          "example": false,
                          "type": "boolean"
                        },
                        "options": {
                          "description": "Options buyers will likely want to pick.",
                          "example": [
                            {
                              "name": "Size",
                              "kind": "size",
                              "values": [
                                {
                                  "label": "S"
                                },
                                {
                                  "label": "M"
                                },
                                {
                                  "label": "L"
                                }
                              ]
                            }
                          ],
                          "type": "array",
                          "items": {
                            "id": "Option",
                            "title": "Option",
                            "description": "A suggested option.",
                            "example": {
                              "name": "Size",
                              "kind": "size",
                              "values": [
                                {
                                  "label": "S"
                                },
                                {
                                  "label": "M"
                                },
                                {
                                  "label": "L"
                                }
                              ]
                            },
                            "type": "object",
                            "properties": {
                              "name": {
                                "description": "What the buyer is choosing.",
                                "example": "Size",
                                "type": "string",
                                "maxLength": 20
                              },
                              "kind": {
                                "title": "Kind",
                                "description": "`color` shows swatches, and the photo of the picked colour.",
                                "example": "size",
                                "type": "string",
                                "additionalProperties": false,
                                "enum": [
                                  "size",
                                  "color",
                                  "other"
                                ]
                              },
                              "values": {
                                "description": "The values to pick from.",
                                "example": [
                                  {
                                    "label": "S"
                                  },
                                  {
                                    "label": "M"
                                  },
                                  {
                                    "label": "L"
                                  }
                                ],
                                "type": "array",
                                "items": {
                                  "id": "OptionValue",
                                  "title": "OptionValue",
                                  "description": "One value of an option.",
                                  "example": {
                                    "label": "M",
                                    "hex": "#14171a",
                                    "photo": "zrySajNyao6_j11x"
                                  },
                                  "type": "object",
                                  "properties": {
                                    "label": {
                                      "description": "What the buyer sees and picks.",
                                      "example": "M",
                                      "type": "string",
                                      "maxLength": 30
                                    },
                                    "hex": {
                                      "description": "A colour as `#rrggbb`.",
                                      "example": "#14171a",
                                      "type": "string",
                                      "pattern": "^#[0-9a-fA-F]{6}$"
                                    },
                                    "photo": {
                                      "description": "Colours: the shop photo (id) that shows this colour. See `matchColorPhotos`.",
                                      "example": "zrySajNyao6_j11x",
                                      "type": "string"
                                    }
                                  },
                                  "required": [
                                    "label"
                                  ]
                                },
                                "minItems": 1,
                                "maxItems": 12
                              },
                              "fromSeller": {
                                "description": "The seller's description or photo named these values; otherwise they're a guess.",
                                "example": false,
                                "type": "boolean"
                              }
                            },
                            "required": [
                              "name",
                              "kind",
                              "values"
                            ]
                          }
                        },
                        "missingFacts": {
                          "description": "Questions buyers will ask that the listing doesn't answer yet.",
                          "example": [
                            {
                              "label": "Size",
                              "question": "What size are the skates?",
                              "placeholder": "US women's 8"
                            }
                          ],
                          "type": "array",
                          "items": {
                            "id": "MissingFact",
                            "title": "MissingFact",
                            "description": "One question to answer.",
                            "example": {
                              "label": "Size",
                              "question": "What size are the skates?",
                              "placeholder": "US women's 8"
                            },
                            "type": "object",
                            "properties": {
                              "label": {
                                "description": "The product detail it becomes.",
                                "example": "Size",
                                "type": "string"
                              },
                              "question": {
                                "description": "The question, for the seller.",
                                "example": "What size are the skates?",
                                "type": "string"
                              },
                              "placeholder": {
                                "description": "An example answer.",
                                "example": "US women's 8",
                                "type": "string"
                              }
                            },
                            "required": [
                              "label",
                              "question",
                              "placeholder"
                            ]
                          }
                        }
                      },
                      "required": [
                        "oneOfAKind",
                        "options",
                        "missingFacts"
                      ]
                    }
                  example: '{"oneOfAKind":false,"options":[{"name":"Size","kind":"size","values":[{"label":"7"},{"label":"8"},{"label":"9"}],"fromSeller":false}],"missingFacts":[{"label":"Wheel size","question":"How big are the wheels?","placeholder":"57 mm"}]}'
            '400':
              description: Something in the request needs fixing; `error` says what.
              body:
                application/json:
                  schema: |
                    {
                      "id": "ErrorResponse",
                      "title": "ErrorResponse",
                      "description": "An error reply.",
                      "example": {
                        "error": "Choose a photo.",
                        "field": "photo"
                      },
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "A sentence you can show to a person.",
                          "example": "Order not found.",
                          "type": "string"
                        },
                        "field": {
                          "description": "The form field at fault, when there is one.",
                          "example": "price",
                          "type": "string"
                        },
                        "detail": {
                          "description": "The upstream service's own message, for debugging.",
                          "example": "INSTRUMENT_DECLINED",
                          "type": "string"
                        }
                      },
                      "required": [
                        "error"
                      ]
                    }
                  example: '{"error":"Choose a photo."}'
            '404':
              description: No such shop, or the admin token or API key doesn't match it.
              body:
                application/json:
                  schema: |
                    {
                      "id": "ErrorResponse",
                      "title": "ErrorResponse",
                      "description": "An error reply.",
                      "example": {
                        "error": "Choose a photo.",
                        "field": "photo"
                      },
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "A sentence you can show to a person.",
                          "example": "Order not found.",
                          "type": "string"
                        },
                        "field": {
                          "description": "The form field at fault, when there is one.",
                          "example": "price",
                          "type": "string"
                        },
                        "detail": {
                          "description": "The upstream service's own message, for debugging.",
                          "example": "INSTRUMENT_DECLINED",
                          "type": "string"
                        }
                      },
                      "required": [
                        "error"
                      ]
                    }
                  example: '{"error":"Shop not found."}'
            '429':
              description: Over this network's cap for the call (see **Limits**). Retry after `Retry-After` seconds.
              headers:
                Retry-After:
                  required: false
              body:
                application/json:
                  schema: |
                    {
                      "id": "ErrorResponse",
                      "title": "ErrorResponse",
                      "description": "An error reply.",
                      "example": {
                        "error": "Choose a photo.",
                        "field": "photo"
                      },
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "A sentence you can show to a person.",
                          "example": "Order not found.",
                          "type": "string"
                        },
                        "field": {
                          "description": "The form field at fault, when there is one.",
                          "example": "price",
                          "type": "string"
                        },
                        "detail": {
                          "description": "The upstream service's own message, for debugging.",
                          "example": "INSTRUMENT_DECLINED",
                          "type": "string"
                        }
                      },
                      "required": [
                        "error"
                      ]
                    }
                  example: '{"error":"Too many checkouts from your network. Try again in 7 min."}'
            '502':
              description: Gemini, PayPal or Channel3 failed or isn't configured.
              body:
                application/json:
                  schema: |
                    {
                      "id": "ErrorResponse",
                      "title": "ErrorResponse",
                      "description": "An error reply.",
                      "example": {
                        "error": "Choose a photo.",
                        "field": "photo"
                      },
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "A sentence you can show to a person.",
                          "example": "Order not found.",
                          "type": "string"
                        },
                        "field": {
                          "description": "The form field at fault, when there is one.",
                          "example": "price",
                          "type": "string"
                        },
                        "detail": {
                          "description": "The upstream service's own message, for debugging.",
                          "example": "INSTRUMENT_DECLINED",
                          "type": "string"
                        }
                      },
                      "required": [
                        "error"
                      ]
                    }
                  example: "{\"error\":\"PayPal isn't configured on this server.\"}"
      /match-photos:
        uriParameters: {}
        post:
          securedBy:
          - AdminToken
          - PlatformKey
          description: Gemini looks at the shop's photos and says which one shows each colour, so buyers who pick a colour see it. Suggests only; save the matches with `setColorPhotos`. Needs at least two photos.
          headers:
            Content-Type:
              required: true
              displayName: Content-Type
              enum:
              - application/json
          body:
            application/json:
              schema: |
                {
                  "id": "ApiShopsMatchPhotosRequest",
                  "title": "ApiShopsMatchPhotosRequest",
                  "description": "The colour option's values.",
                  "example": {
                    "colors": [
                      {
                        "label": "Cream",
                        "hex": "#f3e9d2"
                      },
                      {
                        "label": "Red",
                        "hex": "#b3261e"
                      }
                    ]
                  },
                  "type": "object",
                  "properties": {
                    "colors": {
                      "description": "The colour option's values.",
                      "example": [
                        {
                          "label": "Ice Blue",
                          "hex": "#9fd3e6"
                        }
                      ],
                      "type": "array",
                      "items": {
                        "id": "Color",
                        "title": "Color",
                        "description": "One colour.",
                        "example": {
                          "label": "Ice Blue",
                          "hex": "#9fd3e6"
                        },
                        "type": "object",
                        "properties": {
                          "label": {
                            "description": "The colour's name, as buyers see it.",
                            "example": "Forest green",
                            "type": "string",
                            "maxLength": 30
                          },
                          "hex": {
                            "description": "A colour as `#rrggbb`.",
                            "example": "#14171a",
                            "type": "string",
                            "pattern": "^#[0-9a-fA-F]{6}$"
                          }
                        },
                        "required": [
                          "label"
                        ]
                      },
                      "minItems": 1,
                      "maxItems": 12
                    }
                  },
                  "required": [
                    "colors"
                  ]
                }
              example: '{"colors":[{"label":"Cream","hex":"#f3e9d2"},{"label":"Red","hex":"#b3261e"}]}'
          responses:
            '200':
              description: A photo id for each colour Gemini could match. Colours it couldn't place are left out.
              body:
                application/json:
                  schema: "{\n  \"id\": \"ApiShopsMatchPhotosResponse\",\n  \"title\": \"ApiShopsMatchPhotosResponse\",\n  \"description\": \"Gemini's matches.\",\n  \"example\": {\n    \"matches\": {\n      \"Cream\": \"LFRvGuTU3D8i334X\",\n      \"Red\": \"SuqcgNv64HWN8H6e\"\n    }\n  },\n  \"type\": \"object\",\n  \"properties\": {\n    \"matches\": {\n      \"description\": \"Colour label → photo id.\",\n      \"example\": {\n        \"Black\": \"b_8f2k1\",\n        \"Forest green\": \"b_q93md\"\n      },\n      \"type\": \"object\",\n      \"additionalProperties\": {\n        \"type\": \"string\"\n      }\n    }\n  },\n  \"required\": [\n    \"matches\"\n  ]\n}"
                  example: '{"matches":{"Cream":"LFRvGuTU3D8i334X","Red":"SuqcgNv64HWN8H6e"}}'
            '400':
              description: Something in the request needs fixing; `error` says what.
              body:
                application/json:
                  schema: |
                    {
                      "id": "ErrorResponse",
                      "title": "ErrorResponse",
                      "description": "An error reply.",
                      "example": {
                        "error": "Choose a photo.",
                        "field": "photo"
                      },
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "A sentence you can show to a person.",
                          "example": "Order not found.",
                          "type": "string"
                        },
                        "field": {
                          "description": "The form field at fault, when there is one.",
                          "example": "price",
                          "type": "string"
                        },
                        "detail": {
                          "description": "The upstream service's own message, for debugging.",
                          "example": "INSTRUMENT_DECLINED",
                          "type": "string"
                        }
                      },
                      "required": [
                        "error"
                      ]
                    }
                  example: '{"error":"Choose a photo."}'
            '404':
              description: No such shop, or the admin token or API key doesn't match it.
              body:
                application/json:
                  schema: |
                    {
                      "id": "ErrorResponse",
                      "title": "ErrorResponse",
                      "description": "An error reply.",
                      "example": {
                        "error": "Choose a photo.",
                        "field": "photo"
                      },
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "A sentence you can show to a person.",
