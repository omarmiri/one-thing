      /color-photos:
        uriParameters: {}
        put:
          securedBy:
          - AdminToken
          - PlatformKey
          description: Saves which photo shows each colour, and nothing else about the shop. Only colours already saved in the shop's options change; `null` clears a colour's photo. A photo id that isn't one of the shop's photos is ignored.
          headers:
            Content-Type:
              required: true
              displayName: Content-Type
              enum:
              - application/json
          body:
            application/json:
              schema: "{\n  \"id\": \"ApiShopsColorPhotosRequest\",\n  \"title\": \"ApiShopsColorPhotosRequest\",\n  \"description\": \"The photo for each colour.\",\n  \"example\": {\n    \"photos\": {\n      \"Cream\": \"LFRvGuTU3D8i334X\",\n      \"Red\": null\n    }\n  },\n  \"type\": \"object\",\n  \"properties\": {\n    \"photos\": {\n      \"description\": \"Colour label → photo id, or `null`.\",\n      \"example\": {\n        \"Ice Blue\": \"zrySajNyao6_j11x\",\n        \"Amber\": null\n      },\n      \"type\": \"object\",\n      \"additionalProperties\": {\n        \"type\": [\n          \"string\",\n          \"null\"\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"photos\"\n  ]\n}"
              example: '{"photos":{"Cream":"LFRvGuTU3D8i334X","Red":null}}'
          responses:
            '200':
              description: The colours that were changed.
              body:
                application/json:
                  schema: |
                    {
                      "id": "ApiShopsColorPhotosResponse",
                      "title": "ApiShopsColorPhotosResponse",
                      "description": "The colours that changed.",
                      "example": {
                        "saved": [
                          "Cream",
                          "Red"
                        ]
                      },
                      "type": "object",
                      "properties": {
                        "saved": {
                          "description": "Colour labels whose photo changed.",
                          "example": [
                            "Ice Blue",
                            "Amber"
                          ],
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      },
                      "required": [
                        "saved"
                      ]
                    }
                  example: '{"saved":["Cream","Red"]}'
            '400':
              description: Something in the request needs fixing; `error` says what.
              body:
                application/json:
                  schema: |
                    {
                      "id": "ErrorResponse",
                      "title": "ErrorResponse",
                      "description": "An error reply.",
                      "example": {
                        "error": "Choose a photo.",
                        "field": "photo"
                      },
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "A sentence you can show to a person.",
                          "example": "Order not found.",
                          "type": "string"
                        },
                        "field": {
                          "description": "The form field at fault, when there is one.",
                          "example": "price",
                          "type": "string"
                        },
                        "detail": {
                          "description": "The upstream service's own message, for debugging.",
                          "example": "INSTRUMENT_DECLINED",
                          "type": "string"
                        }
                      },
                      "required": [
                        "error"
                      ]
                    }
                  example: '{"error":"Choose a photo."}'
            '404':
              description: No such shop, or the admin token or API key doesn't match it.
              body:
                application/json:
                  schema: |
                    {
                      "id": "ErrorResponse",
                      "title": "ErrorResponse",
                      "description": "An error reply.",
                      "example": {
                        "error": "Choose a photo.",
                        "field": "photo"
                      },
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "A sentence you can show to a person.",
                          "example": "Order not found.",
                          "type": "string"
                        },
                        "field": {
                          "description": "The form field at fault, when there is one.",
                          "example": "price",
                          "type": "string"
                        },
                        "detail": {
                          "description": "The upstream service's own message, for debugging.",
                          "example": "INSTRUMENT_DECLINED",
                          "type": "string"
                        }
                      },
                      "required": [
                        "error"
                      ]
                    }
                  example: '{"error":"Shop not found."}'
      /paypal:
        uriParameters: {}
        post:
          securedBy:
          - AdminToken
          - PlatformKey
          description: >
            Starts PayPal's seller onboarding (Partner Referrals). Send the seller's browser to the

            returned `url`; they sign in to PayPal (or create a business account) and grant OneThing

            permission. PayPal brings them back to `/api/shops/<slug>/paypal/return`, which saves the

            connection and opens the manage page. From then on, sales are paid to that account.


            Without a connection, a shop can still go live with a typed `paypal_email`.


            **Platforms:** call it with your API key and a `returnUrl`, and PayPal's flow ends on your own

            page instead, as `returnUrl?paypal=connected|incomplete|cancelled|failed&shop=<slug>`. The

            URL's origin must be one registered on the key.
          headers:
            Content-Type:
              required: true
              displayName: Content-Type
              enum:
              - application/json
          body:
            application/json:
              schema: |
                {
                  "id": "ApiShopsPaypalRequest",
                  "title": "ApiShopsPaypalRequest",
                  "description": "Platform keys only: where PayPal sends the seller back.",
                  "example": {
                    "returnUrl": "https://www.miriogames.com/market/manage/?g=7Hq2"
                  },
                  "type": "object",
                  "properties": {
                    "returnUrl": {
                      "description": "Platform key only. Where to send the seller after PayPal.",
                      "example": "https://www.miriogames.com/market/manage/?g=7Hq2",
                      "type": "string",
                      "format": "uri"
                    }
                  }
                }
              example: '{"returnUrl":"https://www.miriogames.com/market/manage/?g=7Hq2"}'
          responses:
            '200':
              description: Where to send the seller.
              body:
                application/json:
                  schema: |
                    {
                      "id": "ApiShopsPaypalResponse",
                      "title": "ApiShopsPaypalResponse",
                      "description": "The onboarding link.",
                      "example": {
                        "url": "https://www.sandbox.paypal.com/bizsignup/partner/entry?referralToken=EXAMPLE"
                      },
                      "type": "object",
                      "properties": {
                        "url": {
                          "description": "PayPal's onboarding page for this shop.",
                          "example": "https://www.sandbox.paypal.com/bizsignup/partner/entry?referralToken=EXAMPLE",
                          "type": "string"
                        }
                      },
                      "required": [
                        "url"
                      ]
                    }
                  example: '{"url":"https://www.sandbox.paypal.com/bizsignup/partner/entry?referralToken=EXAMPLE"}'
            '404':
              description: No such shop, or the admin token or API key doesn't match it.
              body:
                application/json:
                  schema: |
                    {
                      "id": "ErrorResponse",
                      "title": "ErrorResponse",
                      "description": "An error reply.",
                      "example": {
                        "error": "Choose a photo.",
                        "field": "photo"
                      },
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "A sentence you can show to a person.",
                          "example": "Order not found.",
                          "type": "string"
                        },
                        "field": {
                          "description": "The form field at fault, when there is one.",
                          "example": "price",
                          "type": "string"
                        },
                        "detail": {
                          "description": "The upstream service's own message, for debugging.",
                          "example": "INSTRUMENT_DECLINED",
                          "type": "string"
                        }
                      },
                      "required": [
                        "error"
                      ]
                    }
                  example: '{"error":"Shop not found."}'
            '502':
              description: Gemini, PayPal or Channel3 failed or isn't configured.
              body:
                application/json:
                  schema: |
                    {
                      "id": "ErrorResponse",
                      "title": "ErrorResponse",
                      "description": "An error reply.",
                      "example": {
                        "error": "Choose a photo.",
                        "field": "photo"
                      },
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "A sentence you can show to a person.",
                          "example": "Order not found.",
                          "type": "string"
                        },
                        "field": {
                          "description": "The form field at fault, when there is one.",
                          "example": "price",
                          "type": "string"
                        },
                        "detail": {
                          "description": "The upstream service's own message, for debugging.",
                          "example": "INSTRUMENT_DECLINED",
                          "type": "string"
                        }
                      },
                      "required": [
                        "error"
                      ]
                    }
                  example: "{\"error\":\"PayPal isn't configured on this server.\"}"
            '503':
              description: Gemini, PayPal or Channel3 failed or isn't configured.
              body:
                application/json:
                  schema: |
                    {
                      "id": "ErrorResponse",
                      "title": "ErrorResponse",
                      "description": "An error reply.",
                      "example": {
                        "error": "Choose a photo.",
                        "field": "photo"
                      },
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "A sentence you can show to a person.",
                          "example": "Order not found.",
                          "type": "string"
                        },
                        "field": {
                          "description": "The form field at fault, when there is one.",
                          "example": "price",
                          "type": "string"
                        },
                        "detail": {
                          "description": "The upstream service's own message, for debugging.",
                          "example": "INSTRUMENT_DECLINED",
                          "type": "string"
                        }
                      },
                      "required": [
                        "error"
                      ]
                    }
                  example: "{\"error\":\"PayPal isn't configured on this server.\"}"
        get:
          securedBy:
          - AdminToken
          - PlatformKey
          description: Asks PayPal where the seller's connection stands and saves it on the shop. Also finds a connection the seller finished at PayPal without coming back.
          responses:
            '200':
              description: The connection, or nulls if there is none yet.
              body:
                application/json:
                  schema: |
                    {
                      "id": "ApiShopsPaypalResponse1",
                      "title": "ApiShopsPaypalResponse1",
                      "description": "The shop's PayPal connection.",
                      "example": {
                        "merchantId": "7MZJ4QXN8K2LA",
                        "status": {
                          "receivable": true,
                          "emailConfirmed": true,
                          "checkedAt": "2026-10-21T18:04:11Z"
                        }
                      },
                      "type": "object",
                      "properties": {
                        "merchantId": {
                          "description": "The seller's PayPal merchant id.",
                          "example": "7MZJ4QXN8K2LA",
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "status": {
                          "description": "What PayPal last said; null when nothing is connected.",
                          "example": {
                            "receivable": true,
                            "emailConfirmed": true,
                            "checkedAt": "2026-10-22T02:41:37Z"
                          },
                          "oneOf": [
                            {
                              "id": "PayPalStatus",
                              "title": "PayPalStatus",
                              "description": "What PayPal last said about a connected seller account.",
                              "example": {
                                "receivable": true,
                                "emailConfirmed": true,
                                "checkedAt": "2026-10-22T02:41:37Z"
                              },
                              "type": "object",
                              "properties": {
                                "receivable": {
                                  "description": "The account can receive payments.",
                                  "example": true,
                                  "type": "boolean"
                                },
                                "emailConfirmed": {
                                  "description": "The seller has confirmed their email with PayPal.",
                                  "example": true,
                                  "type": "boolean"
                                },
                                "checkedAt": {
                                  "description": "When OneThing last asked PayPal.",
                                  "example": "2026-10-22T02:41:37Z",
                                  "type": "string",
                                  "format": "date-time"
                                }
                              },
                              "required": [
                                "receivable",
                                "emailConfirmed",
                                "checkedAt"
                              ]
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": [
                        "merchantId",
                        "status"
                      ]
                    }
                  example: '{"merchantId":"7MZJ4QXN8K2LA","status":{"receivable":true,"emailConfirmed":true,"checkedAt":"2026-10-21T18:04:11Z"}}'
            '404':
              description: No such shop, or the admin token or API key doesn't match it.
              body:
                application/json:
                  schema: |
                    {
                      "id": "ErrorResponse",
                      "title": "ErrorResponse",
                      "description": "An error reply.",
                      "example": {
                        "error": "Choose a photo.",
                        "field": "photo"
                      },
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "A sentence you can show to a person.",
                          "example": "Order not found.",
                          "type": "string"
                        },
                        "field": {
                          "description": "The form field at fault, when there is one.",
                          "example": "price",
                          "type": "string"
                        },
                        "detail": {
                          "description": "The upstream service's own message, for debugging.",
                          "example": "INSTRUMENT_DECLINED",
                          "type": "string"
                        }
                      },
                      "required": [
                        "error"
                      ]
                    }
                  example: '{"error":"Shop not found."}'
            '502':
              description: Gemini, PayPal or Channel3 failed or isn't configured.
              body:
                application/json:
                  schema: |
                    {
                      "id": "ErrorResponse",
                      "title": "ErrorResponse",
                      "description": "An error reply.",
                      "example": {
                        "error": "Choose a photo.",
                        "field": "photo"
                      },
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "A sentence you can show to a person.",
                          "example": "Order not found.",
                          "type": "string"
                        },
                        "field": {
                          "description": "The form field at fault, when there is one.",
                          "example": "price",
                          "type": "string"
                        },
                        "detail": {
                          "description": "The upstream service's own message, for debugging.",
                          "example": "INSTRUMENT_DECLINED",
                          "type": "string"
                        }
                      },
                      "required": [
                        "error"
                      ]
                    }
                  example: "{\"error\":\"PayPal isn't configured on this server.\"}"
            '503':
              description: Gemini, PayPal or Channel3 failed or isn't configured.
              body:
                application/json:
                  schema: |
                    {
                      "id": "ErrorResponse",
                      "title": "ErrorResponse",
                      "description": "An error reply.",
                      "example": {
                        "error": "Choose a photo.",
                        "field": "photo"
                      },
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "A sentence you can show to a person.",
                          "example": "Order not found.",
                          "type": "string"
                        },
                        "field": {
                          "description": "The form field at fault, when there is one.",
                          "example": "price",
                          "type": "string"
                        },
                        "detail": {
                          "description": "The upstream service's own message, for debugging.",
                          "example": "INSTRUMENT_DECLINED",
                          "type": "string"
                        }
                      },
                      "required": [
                        "error"
                      ]
                    }
                  example: "{\"error\":\"PayPal isn't configured on this server.\"}"
        delete:
          securedBy:
          - AdminToken
          - PlatformKey
          description: Forgets the connected account. Sales go back to the shop's `paypal_email`.
          responses:
            '200':
              description: Done.
              body:
                application/json:
                  schema: |
                    {
                      "id": "Ok",
                      "title": "Ok",
                      "description": "Confirms the change.",
                      "example": {
                        "ok": true
                      },
                      "type": "object",
                      "properties": {
                        "ok": {
                          "description": "Always `true`.",
                          "example": true,
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "ok"
                      ]
                    }
                  example: '{"ok":true}'
            '404':
              description: No such shop, or the admin token or API key doesn't match it.
              body:
                application/json:
                  schema: |
                    {
                      "id": "ErrorResponse",
                      "title": "ErrorResponse",
