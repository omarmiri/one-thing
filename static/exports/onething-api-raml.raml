- ProductCard: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ProductCard",
      "title": "ProductCard",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "image": {
