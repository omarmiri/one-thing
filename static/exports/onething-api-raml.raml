            '404':
              description: No such shop, or the admin token doesn't match it.
              body:
                application/json:
                  schema: |
                    {
                      "id": "Error",
                      "title": "Error",
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "A sentence you can show to a person.",
                          "type": "string"
                        },
                        "field": {
                          "description": "The form field at fault, when there is one.",
                          "type": "string"
                        },
                        "detail": {
                          "description": "The upstream service's own message, for debugging.",
                          "type": "string"
                        }
                      },
                      "required": [
                        "error"
                      ]
                    }
      get:
        securedBy:
        - AdminToken
        description: Everything about the shop, including the AI's design spec and guesses.
        responses:
          '200':
            description: The shop.
            body:
              application/json:
                schema: |
                  {
                    "id": "Shop",
                    "title": "Shop",
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "slug": {
                        "type": "string"
                      },
