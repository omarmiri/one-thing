                        "filename"
                      ]
                    }
                  example: '{"ok":true,"filename":"raptor-rush-soundtrack.zip"}'
            '400':
              description: Something in the request needs fixing; `error` says what.
              body:
                application/json:
                  schema: |
                    {
                      "id": "Error",
