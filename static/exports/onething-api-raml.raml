      /color-photos:
        uriParameters: {}
        put:
          securedBy:
          - AdminToken
          - PlatformKey
          description: Saves which photo shows each colour, and nothing else about the shop. Only colours already saved in the shop's options change; `null` clears a colour's photo. A photo id that isn't one of the shop's photos is ignored.
          headers:
            Content-Type:
              required: true
              displayName: Content-Type
              enum:
              - application/json
          body:
            application/json:
              schema: "{\n  \"id\": \"ApiShopsColorPhotosRequest\",\n  \"title\": \"ApiShopsColorPhotosRequest\",\n  \"example\": {\n    \"photos\": {\n      \"Cream\": \"LFRvGuTU3D8i334X\",\n      \"Red\": null\n    }\n  },\n  \"type\": \"object\",\n  \"properties\": {\n    \"photos\": {\n      \"description\": \"Colour label → photo id, or `null`.\",\n      \"type\": \"object\",\n      \"additionalProperties\": {\n        \"type\": [\n          \"string\",\n          \"null\"\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"photos\"\n  ]\n}"
              example: '{"photos":{"Cream":"LFRvGuTU3D8i334X","Red":null}}'
          responses:
            '200':
              description: The colours that were changed.
              body:
                application/json:
                  schema: |
                    {
                      "id": "ApiShopsColorPhotosResponse",
                      "title": "ApiShopsColorPhotosResponse",
                      "example": {
                        "saved": [
                          "Cream",
                          "Red"
                        ]
                      },
                      "type": "object",
                      "properties": {
                        "saved": {
                          "description": "",
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      },
                      "required": [
                        "saved"
                      ]
                    }
                  example: '{"saved":["Cream","Red"]}'
            '400':
              description: Something in the request needs fixing; `error` says what.
              body:
                application/json:
                  schema: |
                    {
                      "id": "Error",
                      "title": "Error",
                      "example": {
                        "error": "Choose a photo."
                      },
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "A sentence you can show to a person.",
                          "type": "string"
                        },
                        "field": {
                          "description": "The form field at fault, when there is one.",
                          "type": "string"
                        },
                        "detail": {
                          "description": "The upstream service's own message, for debugging.",
                          "type": "string"
                        }
                      },
                      "required": [
                        "error"
                      ]
                    }
                  example: '{"error":"Choose a photo."}'
            '404':
              description: No such shop, or the admin token or API key doesn't match it.
              body:
                application/json:
                  schema: |
                    {
                      "id": "Error",
                      "title": "Error",
                      "example": {
                        "error": "Shop not found."
                      },
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "A sentence you can show to a person.",
                          "type": "string"
                        },
                        "field": {
                          "description": "The form field at fault, when there is one.",
                          "type": "string"
                        },
                        "detail": {
                          "description": "The upstream service's own message, for debugging.",
                          "type": "string"
                        }
                      },
                      "required": [
