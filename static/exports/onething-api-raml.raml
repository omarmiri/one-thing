      /photos:
        uriParameters: {}
        post:
          securedBy:
          - AdminToken
          - PlatformKey
          description: Adds one or more photos after the cover. Each is turned upright, resized to at most 2000 px and stored as WebP. A shop holds up to 8 photos; buyers swipe through them on the shop page. Not for recommendations, which show the retailer's photos.
          body:
            multipart/form-data:
              formParameters:
                photo:
                  description: An image, up to 15 MB. The endpoint also accepts the field repeated, to add several in one request.
                  type: file
                  required: true
                  displayName: photo
          responses:
            '200':
              description: The shop's photos, cover first.
              body:
                application/json:
                  schema: "{\n  \"id\": \"ShopPhotos\",\n  \"title\": \"ShopPhotos\",\n  \"example\": {\n    \"photos\": [\n      {\n        \"id\": \"LFRvGuTU3D8i334X\",\n        \"url\": \"/api/blobs/LFRvGuTU3D8i334X\"\n      },\n      {\n        \"id\": \"zrySajNyao6_j11x\",\n        \"url\": \"/api/blobs/zrySajNyao6_j11x\"\n      }\n    ]\n  },\n  \"type\": \"object\",\n  \"properties\": {\n    \"photos\": {\n      \"description\": \"\",\n      \"type\": \"array\",\n      \"items\": {\n        \"id\": \"Photo\",\n        \"title\": \"Photo\",\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"string\"\n          },\n          \"url\": {\n            \"description\": \"Public image URL on this site.\",\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"id\",\n          \"url\"\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"photos\"\n  ]\n}"
                  example: '{"photos":[{"id":"LFRvGuTU3D8i334X","url":"/api/blobs/LFRvGuTU3D8i334X"},{"id":"zrySajNyao6_j11x","url":"/api/blobs/zrySajNyao6_j11x"}]}'
            '400':
              description: Something in the request needs fixing; `error` says what.
              body:
                application/json:
                  schema: |
                    {
                      "id": "Error",
                      "title": "Error",
                      "example": {
                        "error": "Choose a photo."
                      },
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "A sentence you can show to a person.",
                          "type": "string"
                        },
                        "field": {
                          "description": "The form field at fault, when there is one.",
                          "type": "string"
                        },
                        "detail": {
                          "description": "The upstream service's own message, for debugging.",
                          "type": "string"
                        }
                      },
                      "required": [
                        "error"
                      ]
                    }
                  example: '{"error":"Choose a photo."}'
            '404':
              description: No such shop, or the admin token or API key doesn't match it.
              body:
                application/json:
                  schema: |
                    {
                      "id": "Error",
                      "title": "Error",
                      "example": {
                        "error": "Shop not found."
                      },
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "A sentence you can show to a person.",
                          "type": "string"
                        },
                        "field": {
                          "description": "The form field at fault, when there is one.",
                          "type": "string"
                        },
                        "detail": {
                          "description": "The upstream service's own message, for debugging.",
                          "type": "string"
                        }
                      },
                      "required": [
                        "error"
                      ]
                    }
                  example: '{"error":"Shop not found."}'
        put:
          securedBy:
          - AdminToken
          - PlatformKey
          description: Sets the photo order; the first becomes the cover. Leaving a photo out removes it.
          headers:
            Content-Type:
              required: true
              displayName: Content-Type
              enum:
              - application/json
          body:
            application/json:
              schema: "{\n  \"id\": \"ApiShopsPhotosRequest\",\n  \"title\": \"ApiShopsPhotosRequest\",\n  \"example\": {\n    \"photos\": [\n      \"zrySajNyao6_j11x\",\n      \"LFRvGuTU3D8i334X\",\n      \"SuqcgNv64HWN8H6e\"\n    ]\n  },\n  \"type\": \"object\",\n  \"properties\": {\n    \"photos\": {\n      \"description\": \"Photo ids, in order.\",\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"maxItems\": 8\n    }\n  },\n  \"required\": [\n    \"photos\"\n  ]\n}"
              example: '{"photos":["zrySajNyao6_j11x","LFRvGuTU3D8i334X","SuqcgNv64HWN8H6e"]}'
          responses:
            '200':
              description: The shop's photos, cover first.
              body:
                application/json:
                  schema: "{\n  \"id\": \"ShopPhotos\",\n  \"title\": \"ShopPhotos\",\n  \"example\": {\n    \"photos\": [\n      {\n        \"id\": \"LFRvGuTU3D8i334X\",\n        \"url\": \"/api/blobs/LFRvGuTU3D8i334X\"\n      },\n      {\n        \"id\": \"zrySajNyao6_j11x\",\n        \"url\": \"/api/blobs/zrySajNyao6_j11x\"\n      }\n    ]\n  },\n  \"type\": \"object\",\n  \"properties\": {\n    \"photos\": {\n      \"description\": \"\",\n      \"type\": \"array\",\n      \"items\": {\n        \"id\": \"Photo\",\n        \"title\": \"Photo\",\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"string\"\n          },\n          \"url\": {\n            \"description\": \"Public image URL on this site.\",\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"id\",\n          \"url\"\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"photos\"\n  ]\n}"
                  example: '{"photos":[{"id":"LFRvGuTU3D8i334X","url":"/api/blobs/LFRvGuTU3D8i334X"},{"id":"zrySajNyao6_j11x","url":"/api/blobs/zrySajNyao6_j11x"}]}'
            '400':
              description: Something in the request needs fixing; `error` says what.
              body:
                application/json:
                  schema: |
                    {
                      "id": "Error",
                      "title": "Error",
                      "example": {
                        "error": "Choose a photo."
                      },
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "A sentence you can show to a person.",
                          "type": "string"
                        },
                        "field": {
                          "description": "The form field at fault, when there is one.",
                          "type": "string"
                        },
                        "detail": {
                          "description": "The upstream service's own message, for debugging.",
                          "type": "string"
                        }
                      },
                      "required": [
                        "error"
                      ]
                    }
                  example: '{"error":"Choose a photo."}'
            '404':
              description: No such shop, or the admin token or API key doesn't match it.
              body:
                application/json:
                  schema: |
                    {
                      "id": "Error",
                      "title": "Error",
                      "example": {
                        "error": "Shop not found."
                      },
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "A sentence you can show to a person.",
                          "type": "string"
                        },
                        "field": {
                          "description": "The form field at fault, when there is one.",
                          "type": "string"
                        },
                        "detail": {
                          "description": "The upstream service's own message, for debugging.",
                          "type": "string"
                        }
                      },
                      "required": [
                        "error"
                      ]
                    }
                  example: '{"error":"Shop not found."}'
      /suggest:
        uriParameters: {}
        post:
          securedBy:
          - AdminToken
          - PlatformKey
          description: >
            Asks Gemini what buyers will want to choose (sizes, colours) and what they'll ask that the

            listing doesn't say (dimensions, materials). `createShop` already does this once; call it

            again after editing the product. The result is saved as the shop's `suggestions`.


            Nothing changes on the shop page until the seller confirms: save options with `updateShop`

            (`options`), and answer the questions with `updateShop` (`facts`). Not for recommendations.
          responses:
            '200':
              description: The suggestions.
              body:
                application/json:
                  schema: |
                    {
                      "id": "Suggestions",
                      "title": "Suggestions",
                      "description": "What Gemini thinks buyers will want to choose or ask. The seller confirms; nothing is applied on its own.",
                      "example": {
                        "oneOfAKind": false,
                        "options": [
                          {
                            "name": "Size",
                            "kind": "size",
                            "values": [
                              {
                                "label": "7"
                              },
                              {
                                "label": "8"
                              },
                              {
                                "label": "9"
                              }
                            ],
                            "fromSeller": false
                          }
                        ],
                        "missingFacts": [
                          {
                            "label": "Wheel size",
                            "question": "How big are the wheels?",
                            "placeholder": "57 mm"
                          }
                        ]
                      },
                      "type": "object",
                      "properties": {
                        "oneOfAKind": {
                          "description": "A single item (vintage, handmade), so options and stock don't apply.",
                          "type": "boolean"
                        },
                        "options": {
                          "description": "",
                          "type": "array",
                          "items": {
                            "id": "Option",
                            "title": "Option",
                            "type": "object",
                            "properties": {
                              "name": {
                                "example": "Size",
                                "type": "string",
                                "maxLength": 20
                              },
                              "kind": {
                                "title": "Kind",
                                "description": "`color` shows swatches, and the photo of the picked colour.",
                                "type": "string",
                                "additionalProperties": false,
                                "enum": [
                                  "size",
                                  "color",
                                  "other"
                                ]
                              },
                              "values": {
                                "description": "",
                                "type": "array",
                                "items": {
                                  "id": "OptionValue",
                                  "title": "OptionValue",
                                  "type": "object",
                                  "properties": {
                                    "label": {
                                      "example": "M",
                                      "type": "string",
                                      "maxLength": 30
                                    },
                                    "hex": {
                                      "example": "#14171a",
                                      "type": "string",
                                      "pattern": "^#[0-9a-fA-F]{6}$"
                                    },
                                    "photo": {
                                      "description": "Colours: the shop photo (id) that shows this colour. See `matchColorPhotos`.",
                                      "type": "string"
                                    }
                                  },
                                  "required": [
                                    "label"
                                  ]
                                },
                                "minItems": 1,
                                "maxItems": 12
                              },
                              "fromSeller": {
                                "description": "The seller's description or photo named these values; otherwise they're a guess.",
                                "type": "boolean"
                              }
                            },
                            "required": [
                              "name",
                              "kind",
                              "values"
                            ]
                          }
                        },
                        "missingFacts": {
                          "description": "",
                          "type": "array",
                          "items": {
                            "id": "MissingFact",
                            "title": "MissingFact",
                            "type": "object",
                            "properties": {
                              "label": {
                                "example": "Size",
                                "type": "string"
                              },
                              "question": {
                                "example": "What size are the skates?",
                                "type": "string"
                              },
                              "placeholder": {
                                "example": "US women's 8",
                                "type": "string"
                              }
                            },
                            "required": [
                              "label",
                              "question",
                              "placeholder"
                            ]
                          }
                        }
                      },
                      "required": [
                        "oneOfAKind",
                        "options",
                        "missingFacts"
                      ]
                    }
                  example: '{"oneOfAKind":false,"options":[{"name":"Size","kind":"size","values":[{"label":"7"},{"label":"8"},{"label":"9"}],"fromSeller":false}],"missingFacts":[{"label":"Wheel size","question":"How big are the wheels?","placeholder":"57 mm"}]}'
            '400':
              description: Something in the request needs fixing; `error` says what.
              body:
                application/json:
                  schema: |
                    {
                      "id": "Error",
                      "title": "Error",
                      "example": {
                        "error": "Choose a photo."
                      },
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "A sentence you can show to a person.",
                          "type": "string"
                        },
                        "field": {
                          "description": "The form field at fault, when there is one.",
                          "type": "string"
                        },
                        "detail": {
                          "description": "The upstream service's own message, for debugging.",
                          "type": "string"
                        }
                      },
                      "required": [
                        "error"
                      ]
                    }
                  example: '{"error":"Choose a photo."}'
            '404':
