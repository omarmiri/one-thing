- ApiOrdersRequest: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiOrdersRequest",
      "title": "ApiOrdersRequest",
      "type": "object",
      "properties": {
        "slug": {
          "type": "string"
        },
        "options": {
          "description": "The buyer's pick, one value per option, keyed by option name.",
          "example": {
            "Size": "M",
            "Color": "Black"
          },
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "slug"
      ]
    }
- ApiOrdersResponse: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiOrdersResponse",
      "title": "ApiOrdersResponse",
      "type": "object",
      "properties": {
        "id": {
          "description": "PayPal order id.",
          "type": "string"
        }
      },
      "required": [
        "id"
      ]
    }
- ApiPaypalClientTokenResponse: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiPaypalClientTokenResponse",
      "title": "ApiPaypalClientTokenResponse",
      "type": "object",
      "properties": {
        "clientToken": {
          "description": "Pass to `createInstance` in the PayPal JavaScript SDK v6.",
          "type": "string"
        }
      },
      "required": [
        "clientToken"
      ]
    }
- ApiPlatformShopsResponse: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiPlatformShopsResponse",
      "title": "ApiPlatformShopsResponse",
      "type": "object",
      "properties": {
        "shops": {
          "description": "",
          "type": "array",
          "items": {
            "id": "PlatformShop",
            "title": "PlatformShop",
            "type": "object",
            "properties": {
              "slug": {
                "type": "string"
              },
              "status": {
                "title": "Status",
                "type": "string",
                "additionalProperties": false,
                "enum": [
                  "draft",
                  "live"
                ]
              },
              "name": {
                "type": "string"
              },
              "product_type": {
                "title": "ProductType1",
                "type": "string",
                "additionalProperties": false,
                "enum": [
                  "physical",
                  "digital",
                  "referral"
                ]
              },
              "price": {
                "id": "AgentMoney",
                "title": "AgentMoney",
                "type": "object",
                "properties": {
                  "amount": {
                    "example": 48.5,
                    "type": "number"
                  },
                  "currency": {
                    "example": "USD",
                    "type": "string"
                  },
                  "label": {
                    "example": "$48.50",
                    "type": "string"
                  }
                },
                "required": [
                  "amount",
                  "currency"
                ]
              },
              "url": {
                "description": "The shop page buyers pay on.",
                "type": "string"
              },
              "paypal_connected": {
                "description": "The seller connected a PayPal account that can be paid.",
                "type": "boolean"
              },
              "sales": {
                "description": "Paid orders.",
                "type": "integer",
                "format": "int32"
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              },
              "headline": {
                "type": "string"
              },
              "cover": {
                "description": "The cover image's URL.",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "slug",
              "status",
              "name",
              "product_type",
              "price",
              "url",
              "paypal_connected",
              "sales",
              "created_at"
            ]
          }
        }
      },
      "required": [
        "shops"
      ]
    }
- ApiShopsColorPhotosRequest: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiShopsColorPhotosRequest",
      "title": "ApiShopsColorPhotosRequest",
      "type": "object",
      "properties": {
        "photos": {
          "description": "Colour label → photo id, or `null`.",
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "required": [
        "photos"
      ]
    }
- ApiShopsColorPhotosResponse: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiShopsColorPhotosResponse",
      "title": "ApiShopsColorPhotosResponse",
      "type": "object",
      "properties": {
        "saved": {
          "description": "",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
