                  required: false
              body:
                application/json:
                  schema: |
                    {
                      "id": "Error",
                      "title": "Error",
                      "example": {
                        "error": "Too many checkouts from your network. Try again in 7 min."
                      },
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "A sentence you can show to a person.",
                          "type": "string"
                        },
