                                },
                                "surface": {
                                  "description": "A colour as `#rrggbb`.",
                                  "example": "#14171a",
                                  "type": "string",
                                  "pattern": "^#[0-9a-fA-F]{6}$"
                                },
                                "text": {
                                  "description": "A colour as `#rrggbb`.",
                                  "example": "#14171a",
                                  "type": "string",
                                  "pattern": "^#[0-9a-fA-F]{6}$"
                                },
