      /color-photos:
        uriParameters: {}
        put:
          securedBy:
          - AdminToken
          - PlatformKey
          description: Saves which photo shows each colour, and nothing else about the shop. Only colours already saved in the shop's options change; `null` clears a colour's photo. A photo id that isn't one of the shop's photos is ignored.
          headers:
            Content-Type:
              required: true
              displayName: Content-Type
              enum:
