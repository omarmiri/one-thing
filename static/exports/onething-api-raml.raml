  /access/verify:
    post:
      description: >
        For apps and games sold with access codes. Callable from any origin (CORS `*`): it only

        answers valid or not for one shop, and counts uses. Accepts the shop's current or former

        link names, and codes typed loosely (lower case, spaces, no dashes).
      headers:
        Content-Type:
          required: true
          displayName: Content-Type
          enum:
          - application/json
      body:
        application/json:
          schema: |
            {
              "id": "ApiAccessVerifyRequest",
              "title": "ApiAccessVerifyRequest",
              "type": "object",
              "properties": {
                "shop": {
                  "description": "The shop's link name.",
                  "example": "raptorrush",
                  "type": "string"
                },
                "code": {
                  "example": "K7QF-M2XP-9HTD",
                  "type": "string"
                }
              },
              "required": [
                "shop",
                "code"
              ]
            }
          example: ''
      responses:
        '200':
          description: The answer. Invalid codes are also a 200.
          body:
            application/json:
              schema: |
                {
                  "id": "ApiAccessVerifyResponse",
                  "title": "ApiAccessVerifyResponse",
                  "type": "object",
                  "properties": {
                    "valid": {
                      "type": "boolean"
                    },
                    "product": {
                      "description": "The product name, when valid.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "valid"
                  ]
                }
  /download/{token}:
    uriParameters:
      token:
        description: The download token from a paid order's thank-you page.
        type: string
        required: true
        displayName: token
    get:
      description: A paid digital order's private link. Works 5 times within 14 days.
      responses:
        '200':
          description: The file.
        '410':
          description: Expired or used up.
          body:
            text/plain:
              schema: |
                {
                  "type": "string"
                }
  /blobs/{id}:
    uriParameters:
      id:
        description: A shop's `photo_blob` or `hero_blob`.
        type: string
        required: true
        displayName: id
    get:
      description: Public images only. Purchased files are never served here.
      responses:
        '200':
          description: The image.
          body:
            text/plain:
              schema: |
                {
                  "x-is-dynamic": true
                }
        '404':
          description: Not a public shop image.
  /account:
    /signin:
      post:
        description: Signs in with an email address or a phone number, creating the account the first time. There's no password and no verification (sandbox). The response sets the `ot_session` cookie; shops created with it belong to the account and are listed on `/account`. Signing in with an email also claims older shops whose seller email matches. In a browser, sellers can instead use Log in with PayPal (`/api/account/paypal`), which also records the PayPal account their sales are paid into.
        headers:
          Content-Type:
            required: true
            displayName: Content-Type
            enum:
            - application/json
        body:
          application/json:
            schema: |
              {
                "id": "ApiAccountSigninRequest",
                "title": "ApiAccountSigninRequest",
                "type": "object",
                "properties": {
                  "identifier": {
                    "description": "An email address, or a phone number (spaces, dashes and brackets are ignored; keep a leading +).",
                    "examples": [
                      {
                        "Id": "Untitled Example1",
                        "Name": null,
                        "Value": "maker@example.com",
                        "ExternalValue": null,
                        "Description": null
                      },
                      {
                        "Id": "Untitled Example2",
                        "Name": null,
                        "Value": "+1 555 123 4567",
                        "ExternalValue": null,
                        "Description": null
                      }
                    ],
                    "example": "maker@example.com",
                    "type": "string"
                  }
                },
                "required": [
                  "identifier"
                ]
              }
            example: ''
        responses:
          '200':
            description: Signed in. The `ot_session` cookie is set.
            headers:
              Set-Cookie:
                required: false
            body:
              application/json:
                schema: |
                  {
                    "id": "ApiAccountSigninResponse",
                    "title": "ApiAccountSigninResponse",
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "email": {
                        "description": "Lower-cased.",
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "phone": {
                        "description": "Digits, with a leading + if one was given.",
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "email",
                      "phone"
                    ]
                  }
          '400':
            description: Something in the request needs fixing; `error` says what.
            body:
              application/json:
                schema: |
                  {
                    "id": "Error",
                    "title": "Error",
                    "type": "object",
                    "properties": {
                      "error": {
                        "description": "A sentence you can show to a person.",
                        "type": "string"
                      },
                      "field": {
                        "description": "The form field at fault, when there is one.",
                        "type": "string"
                      },
                      "detail": {
                        "description": "The upstream service's own message, for debugging.",
                        "type": "string"
                      }
                    },
                    "required": [
                      "error"
                    ]
                  }
    /signout:
      post:
        description: Ends this browser's session and clears the `ot_session` cookie.
        responses:
          '200':
            description: Done.
            body:
              application/json:
                schema: |
                  {
                    "id": "Ok",
                    "title": "Ok",
                    "type": "object",
                    "properties": {
                      "ok": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "ok"
                    ]
                  }
