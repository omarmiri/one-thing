                      }
                    }
            '404':
              description: No such shop, or the admin token doesn't match it.
              body:
                application/json:
                  schema: |
                    {
                      "id": "Error",
                      "title": "Error",
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "A sentence you can show to a person.",
                          "type": "string"
                        },
                        "field": {
                          "description": "The form field at fault, when there is one.",
