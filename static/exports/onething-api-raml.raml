              description: Uploaded.
              body:
                application/json:
                  schema: |
                    {
                      "id": "ApiShopsFileResponse",
                      "title": "ApiShopsFileResponse",
                      "example": {
                        "ok": true,
                        "filename": "raptor-rush-soundtrack.zip"
                      },
                      "type": "object",
