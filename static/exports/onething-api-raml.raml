#%RAML 0.8
title: OneThing API
version: 1.0.0
documentation:
- title: OneThing API
  content: |
    OneThing turns a photo, a link or a picked product into a live one-product shop that takes

    PayPal payments, or a recommendation page that earns referral commissions through Channel3.


    **How a shop is made**

    1. `createShop`: start from a photo, a link, or a Channel3 product. Gemini guesses what it
       is, how it's delivered, the price, a short link and the page design. You get back the
       shop's link name and an **admin token**.
    2. `updateShop`: correct anything the AI guessed, then set `status: live`.

    3. Buyers pay on `https://<host>/<slug>` with PayPal. Sellers read orders and ship them.


    **Auth.** Seller endpoints take the shop's admin token in the `x-admin-token` header. Buyer

    endpoints (checkout, access-code verification, downloads) are public.


    **Access codes.** A digital product can unlock an app or game instead of shipping a file.

    Each paid order gets a code such as `K7QF-M2XP-9HTD`; your app calls `verifyAccessCode`

    before unlocking. Raptor Rush on miriogames.com is a live example.


    All money moves through PayPal (sandbox in this deployment). OneThing never holds card data.
baseUri: https://one-thing-ash0.onrender.com
securedBy: []
protocols:
- HTTPS
- HTTP
baseUriParameters: {}
schemas:
- Error: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "Error",
      "title": "Error",
      "type": "object",
      "properties": {
        "error": {
          "description": "A sentence you can show to a person.",
          "type": "string"
        },
        "field": {
          "description": "The form field at fault, when there is one.",
          "type": "string"
        },
        "detail": {
          "description": "The upstream service's own message, for debugging.",
          "type": "string"
        }
      },
      "required": [
        "error"
      ]
    }
- CreateShopForm: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "CreateShopForm",
      "title": "CreateShopForm",
      "type": "object",
      "properties": {
        "source": {
          "title": "Source",
          "type": "string",
          "additionalProperties": false,
          "enum": [
            "photo",
            "link",
            "channel3"
          ]
        },
        "photo": {
          "description": "`source=photo`: the product photo, up to 8 MB.",
          "type": "string",
          "format": "data-url"
        },
        "description": {
          "description": "`source=photo`: a sentence or two about the product. Required if there is no photo.",
          "type": "string"
        },
        "url": {
          "description": "`source=link`: a product page, or your own app or game page.",
          "type": "string",
          "format": "uri"
        },
        "productId": {
          "description": "`source=channel3`: a product id from `searchProducts`.",
          "type": "string"
        },
        "slug": {
          "description": "The link name you want. If omitted, the AI suggests one.",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string",
          "additionalProperties": false,
          "enum": [
            "auto",
            "physical",
            "digital"
          ]
        },
        "delivery": {
          "title": "Delivery",
          "description": "For digital products. If omitted, the AI guesses.",
          "type": "string",
          "additionalProperties": false,
          "enum": [
            "file",
            "access_code"
          ]
        },
        "access_url": {
          "description": "Where buyers use an access code.",
          "type": "string",
          "format": "uri"
        },
        "price": {
          "description": "USD. If omitted, the AI suggests a price.",
          "type": "number"
        },
        "shipping": {
          "type": "number"
        },
        "stock": {
          "type": "integer",
          "format": "int32"
        },
        "ship_countries": {
          "examples": [
            {
              "Id": "Untitled Example1",
              "Name": null,
              "Value": "US",
              "ExternalValue": null,
              "Description": null
            },
            {
              "Id": "Untitled Example2",
              "Name": null,
              "Value": "CA",
              "ExternalValue": null,
              "Description": null
            }
          ],
          "example": "US",
          "type": "string"
        },
        "paypal_email": {
          "type": "string",
          "format": "email"
        },
        "seller_email": {
          "type": "string",
          "format": "email"
        },
        "digital_file": {
          "type": "string",
          "format": "data-url"
        }
      },
      "required": [
        "source"
      ]
    }
- CreatedShop: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "CreatedShop",
      "title": "CreatedShop",
      "type": "object",
      "properties": {
        "slug": {
          "example": "dragonflight",
          "type": "string"
        },
        "token": {
          "description": "The admin token. Shown once; store it.",
          "type": "string"
        },
        "manageUrl": {
          "description": "The seller's private manage page (contains the token).",
          "type": "string"
        }
      },
      "required": [
        "slug",
        "token",
        "manageUrl"
      ]
    }
- ShopUpdate: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ShopUpdate",
      "title": "ShopUpdate",
      "type": "object",
      "properties": {
        "slug": {
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string",
          "additionalProperties": false,
          "enum": [
            "draft",
            "live"
          ]
        },
        "product_type": {
          "title": "ProductType",
          "description": "`referral` only for shops created from Channel3.",
          "type": "string",
          "additionalProperties": false,
          "enum": [
            "physical",
            "digital",
            "referral"
          ]
        },
        "price": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 10000.0
        },
        "shipping": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 500.0
        },
        "stock": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0.0,
          "format": "int32"
        },
        "ship_countries": {
          "type": [
            "string",
            "null"
          ]
        },
        "delivery": {
          "title": "Delivery1",
          "type": "string",
          "additionalProperties": false,
          "enum": [
            "file",
            "access_code"
          ]
        },
        "access_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "paypal_email": {
          "type": [
            "string",
            "null"
          ],
          "format": "email"
        },
        "seller_email": {
          "type": [
            "string",
            "null"
          ],
          "format": "email"
        },
        "zapier_hook_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "in_gallery": {
          "description": "Feature the shop at `/gallery` while it's live. Off by default.",
          "type": "boolean"
        }
      }
    }
- Shop: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "Shop",
      "title": "Shop",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string",
          "additionalProperties": false,
          "enum": [
            "draft",
            "live"
          ]
        },
        "product_type": {
          "title": "ProductType1",
          "type": "string",
          "additionalProperties": false,
          "enum": [
            "physical",
            "digital",
            "referral"
          ]
        },
        "price_cents": {
          "type": "integer",
          "format": "int32"
        },
        "currency": {
          "example": "USD",
          "type": "string"
        },
        "spec": {
          "id": "DesignSpec",
          "title": "DesignSpec",
          "description": "What Gemini designed. OneThing's templates render it; Gemini never writes HTML.",
          "type": "object",
          "properties": {
            "productType": {
              "title": "ProductType2",
              "type": "string",
              "additionalProperties": false,
              "enum": [
                "digital",
                "physical"
              ]
            },
            "productName": {
              "type": "string"
            },
            "layout": {
              "title": "Layout",
              "type": "string",
              "additionalProperties": false,
              "enum": [
                "bold-hero",
                "editorial",
                "minimal",
                "playful"
              ]
            },
            "palette": {
              "id": "Palette",
              "title": "Palette",
              "type": "object",
              "properties": {
                "background": {
                  "example": "#14171a",
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "surface": {
                  "example": "#14171a",
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "text": {
                  "example": "#14171a",
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "muted": {
                  "example": "#14171a",
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "accent": {
                  "example": "#14171a",
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "accentText": {
                  "example": "#14171a",
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                }
              },
              "required": [
                "background",
                "surface",
                "text",
                "muted",
                "accent",
                "accentText"
              ]
            },
            "fonts": {
              "id": "Fonts",
              "title": "Fonts",
              "type": "object",
              "properties": {
                "heading": {
                  "type": "string"
                },
                "body": {
                  "type": "string"
                }
              },
              "required": [
                "heading",
                "body"
              ]
            },
            "headline": {
              "type": "string"
            },
            "bullets": {
              "description": "",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "faq": {
              "description": "",
              "type": "array",
              "items": {
                "id": "Faq",
                "title": "Faq",
                "type": "object",
                "properties": {
                  "q": {
                    "type": "string"
                  },
                  "a": {
                    "type": "string"
                  }
                },
                "required": [
                  "q",
                  "a"
                ]
              }
            },
            "ctaLabel": {
              "type": "string"
            },
            "eyebrow": {
              "type": "string"
            },
            "subheadline": {
              "type": "string"
            },
            "story": {
              "type": "string"
            },
            "details": {
              "description": "",
              "type": "array",
              "items": {
                "id": "Detail",
                "title": "Detail",
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string"
                  }
                },
                "required": [
                  "label",
                  "value"
                ]
              }
            },
            "suggestedPriceUsd": {
              "type": "number"
            },
            "suggestedShippingUsd": {
              "type": "number"
            },
            "imageAlt": {
              "type": "string"
            },
            "heroPrompt": {
              "type": "string"
            }
          },
          "required": [
            "productType",
            "productName",
            "layout",
            "palette",
            "fonts",
            "headline",
            "bullets",
            "faq",
            "ctaLabel"
          ]
        },
        "shipping_cents": {
          "type": "integer",
          "format": "int32"
        },
        "ship_countries": {
          "type": [
            "string",
            "null"
          ]
        },
        "stock": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "delivery": {
          "title": "Delivery1",
          "type": "string",
          "additionalProperties": false,
          "enum": [
            "file",
            "access_code"
          ]
        },
        "access_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "paypal_email": {
          "type": [
            "string",
            "null"
          ]
        },
        "seller_email": {
          "type": [
            "string",
            "null"
          ]
        },
        "zapier_hook_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "in_gallery": {
          "type": "boolean"
        },
        "photo_blob": {
          "description": "Image id for `getImage`.",
          "type": [
            "string",
            "null"
          ]
        },
        "hero_blob": {
          "type": [
            "string",
            "null"
          ]
        },
        "hero_status": {
          "title": "HeroStatus",
          "type": "string",
          "additionalProperties": false,
          "enum": [
            "none",
            "pending",
            "ready",
            "failed"
          ]
        },
        "hero_error": {
          "type": [
            "string",
            "null"
          ]
        },
        "ai_source": {
          "title": "AiSource",
          "type": "string",
          "additionalProperties": false,
          "enum": [
            "gemini",
            "fallback"
          ]
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "referral": {
          "oneOf": [
            {
              "id": "Referral",
              "title": "Referral",
              "description": "A recommended Channel3 product. Buy links are Channel3-tracked, credited to this shop.",
              "type": "object",
              "properties": {
                "productId": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "offers": {
                  "description": "",
                  "type": "array",
                  "items": {
                    "id": "Offer",
                    "title": "Offer",
                    "type": "object",
                    "properties": {
                      "domain": {
                        "type": "string"
                      },
                      "url": {
                        "type": "string"
                      },
                      "price": {
                        "type": "number"
                      },
                      "currency": {
                        "type": "string"
                      },
                      "inStock": {
                        "type": "boolean"
                      },
                      "commission": {
                        "description": "Maximum commission rate, 0–1 (0.08 = 8%).",
                        "type": "number"
                      }
                    },
                    "required": [
                      "domain",
                      "url",
                      "price",
                      "currency",
                      "inStock",
                      "commission"
                    ]
                  }
                },
                "brand": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "image": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "productId",
                "title",
                "offers"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "slug",
        "status",
        "product_type",
        "price_cents",
        "currency",
        "spec"
      ]
    }
