- Order: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "Order",
      "title": "Order",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "status": {
          "title": "Status2",
          "type": "string",
          "additionalProperties": false,
          "enum": [
            "created",
            "paid",
            "failed"
          ]
        },
        "amount_cents": {
          "type": "integer",
          "format": "int32"
        },
        "currency": {
          "type": "string"
        },
        "fulfillment_status": {
          "title": "FulfillmentStatus",
          "type": "string",
          "additionalProperties": false,
          "enum": [
            "none",
            "to_ship",
            "shipped",
            "digital_sent"
          ]
        },
        "paypal_order_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "shipping_cents": {
          "type": "integer",
          "format": "int32"
        },
        "buyer_email": {
          "type": [
            "string",
            "null"
          ]
        },
        "buyer_name": {
          "type": [
            "string",
            "null"
          ]
