    /signin:
      post:
        description: Signs in with an email address or a phone number, creating the account the first time. There's no password and no verification (sandbox). The response sets the `ot_session` cookie; shops created with it belong to the account and are listed on `/account`. Signing in with an email also claims older shops whose seller email matches. In a browser, sellers can instead use Log in with PayPal (`/api/account/paypal`), which also records the PayPal account their sales are paid into.
        headers:
          Content-Type:
            required: true
            displayName: Content-Type
            enum:
            - application/json
        body:
          application/json:
            schema: |
              {
                "id": "ApiAccountSigninRequest",
                "title": "ApiAccountSigninRequest",
                "description": "The email or phone number to sign in with.",
                "examples": [
                  {
                    "Id": "email",
                    "Name": "With an email",
                    "Value": "{\"identifier\":\"maker@example.com\"}",
                    "ExternalValue": null,
                    "Description": null
                  },
                  {
                    "Id": "phone",
                    "Name": "With a phone number",
                    "Value": "{\"identifier\":\"+1 555 123 4567\"}",
                    "ExternalValue": null,
                    "Description": null
                  }
                ],
                "example": {
                  "identifier": "maker@example.com"
                },
                "type": "object",
                "properties": {
                  "identifier": {
                    "description": "An email address, or a phone number (spaces, dashes and brackets are ignored; keep a leading +).",
                    "examples": [
                      {
                        "Id": "Untitled Example1",
                        "Name": null,
                        "Value": "maker@example.com",
                        "ExternalValue": null,
                        "Description": null
                      },
                      {
                        "Id": "Untitled Example2",
                        "Name": null,
                        "Value": "+1 555 123 4567",
                        "ExternalValue": null,
                        "Description": null
                      }
                    ],
                    "example": "maker@example.com",
                    "type": "string"
                  }
                },
                "required": [
                  "identifier"
                ]
              }
            example: '{"identifier":"maker@example.com"}'
        responses:
          '200':
            description: Signed in. The `ot_session` cookie is set.
            headers:
              Set-Cookie:
                required: false
            body:
              application/json:
                schema: |
                  {
                    "id": "ApiAccountSigninResponse",
                    "title": "ApiAccountSigninResponse",
                    "description": "The signed-in account.",
                    "example": {
                      "id": "Vq3nN8cT0bLx2YwE",
                      "email": "maker@example.com",
                      "phone": null
                    },
                    "type": "object",
                    "properties": {
                      "id": {
                        "description": "The account's id.",
                        "example": "acc_Vq3nN8cT0bLx2YwE",
                        "type": "string"
                      },
                      "email": {
                        "description": "Lower-cased.",
                        "example": "maker@example.com",
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "phone": {
                        "description": "Digits, with a leading + if one was given.",
                        "example": "+15555550123",
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "email",
                      "phone"
                    ]
                  }
                example: '{"id":"Vq3nN8cT0bLx2YwE","email":"maker@example.com","phone":null}'
          '400':
            description: Something in the request needs fixing; `error` says what.
            body:
              application/json:
                schema: |
                  {
                    "id": "ErrorResponse",
                    "title": "ErrorResponse",
                    "description": "An error reply.",
                    "example": {
                      "error": "Choose a photo.",
                      "field": "photo"
                    },
                    "type": "object",
                    "properties": {
                      "error": {
                        "description": "A sentence you can show to a person.",
                        "example": "Order not found.",
                        "type": "string"
                      },
                      "field": {
                        "description": "The form field at fault, when there is one.",
                        "example": "price",
                        "type": "string"
                      },
                      "detail": {
                        "description": "The upstream service's own message, for debugging.",
                        "example": "INSTRUMENT_DECLINED",
                        "type": "string"
                      }
                    },
                    "required": [
                      "error"
                    ]
                  }
                example: '{"error":"Choose a photo."}'
    /signout:
      post:
        description: Ends this browser's session and clears the `ot_session` cookie.
        responses:
          '200':
            description: Done.
            body:
              application/json:
                schema: |
                  {
                    "id": "Ok",
                    "title": "Ok",
                    "description": "Confirms the change.",
                    "example": {
                      "ok": true
                    },
                    "type": "object",
                    "properties": {
                      "ok": {
                        "description": "Always `true`.",
                        "example": true,
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "ok"
                    ]
                  }
                example: '{"ok":true}'
    /paypal:
      get:
        description: "A link for a browser, not for code: redirects to PayPal's sign-in page. PayPal sends the seller back to `/api/account/paypal/callback`, which signs them in (creating the account the first time), records the PayPal account their sales are paid into, and redirects to `next`."
        queryParameters:
          next:
            description: A path on this site to land on afterwards. Defaults to `/account`.
            type: string
            example: /account
            required: false
            displayName: next
        responses:
          '302':
            description: To PayPal's sign-in page.
          '503':
            description: Log in with PayPal isn't switched on for this server.
            body:
              application/json:
                schema: |
                  {
                    "id": "ErrorResponse",
                    "title": "ErrorResponse",
                    "description": "An error reply.",
                    "example": {
                      "error": "Choose a photo.",
                      "field": "photo"
                    },
                    "type": "object",
                    "properties": {
                      "error": {
                        "description": "A sentence you can show to a person.",
                        "example": "Order not found.",
                        "type": "string"
                      },
                      "field": {
                        "description": "The form field at fault, when there is one.",
                        "example": "price",
                        "type": "string"
                      },
                      "detail": {
                        "description": "The upstream service's own message, for debugging.",
                        "example": "INSTRUMENT_DECLINED",
                        "type": "string"
                      }
                    },
                    "required": [
                      "error"
                    ]
                  }
  /agent:
    /shops:
      /{slug}:
        uriParameters:
          slug:
            description: The shop's link name (current or former).
            type: string
            example: vintageskates
            required: true
            displayName: slug
        /order:
          uriParameters: {}
          get:
            description: >
              Orders one unit with a GET: the MCP `create_order` tool for AI assistants that can only

              fetch URLs, such as free-tier ChatGPT or Grok. Nothing is charged. The reply has `pay_url`,

              where the buyer pays at PayPal, and `status_url` (`getAgentOrder`), which says when they

              have and what they got.


              For a product with options, pass the buyer's pick as query parameters named after the

              options (`?Size=9`, or `?Color=Ice+Blue&Size=L`); names and values are matched without

              regard to case. You rarely build this URL yourself: `getAgentProduct` and `/llms.txt`

              write it out in full (`order_url`, or `variants[].order_url`), because some assistants

              only open URLs they have been shown.


              Every request makes a new order, so open it once, after the buyer says to buy. Known

              crawlers and link previewers get a 403 (and are kept out by `robots.txt`); any other

              leaves an unpaid order at most, since stock is only taken when a payment is captured.

              Replies are `no-store` and `X-Robots-Tag: noindex, nofollow`.


              `/<slug>/buy` is the same endpoint at a short URL, and the one `order_url` uses.

              A person clicking the link in a browser (`Sec-Fetch-User: ?1`) is redirected instead; known assistants and headless browsers always get JSON. It goes straight to `pay_url`, or to the shop page when an option is missing

              or unknown.
            queryParameters:
              agent:
                description: "Optional: the agent's name (`ChatGPT`, `Gemini`, `my-shopping-bot`), so the seller's stats show which agent sent the buyer. Only used when the user agent doesn't already say."
                type: string
                example: ChatGPT
                required: false
                displayName: agent
                maxLength: '30'
              Size:
                description: An example option. The real parameter names are the product's option names from `getAgentProduct` (`options[].name`), one per option.
                type: string
                example: '9'
                required: false
                displayName: Size
            responses:
              '200':
                description: The order, waiting for the buyer to pay.
                body:
                  application/json:
                    schema: "{\n  \"id\": \"AgentCreatedOrder\",\n  \"title\": \"AgentCreatedOrder\",\n  \"description\": \"A new order, as `create_order` and `orderByLink` return it.\",\n  \"example\": {\n    \"show_buyer\": \"![Vintage Cream and Red Roller Skates](https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X)\\n\\n**Vintage Cream and Red Roller Skates**: $240.00. Classic quad skates crafted with walnut burl heels\\n\\n![Raptor Rush: Browser Edition](https://one-thing-ash0.onrender.com/api/blobs/R9tWc3yN6bJq1zUd)\\n\\n**Raptor Rush: Browser Edition**: $2.99. Grow from Tiny Hatchling to Giant Apex Predator\\n\\nWhich one?\",\n    \"agent_name\": \"Grok\",\n    \"order_id\": \"pX4kR9tVb2nQ7sLe\",\n    \"status\": \"awaiting_buyer_approval\",\n    \"total\": \"$255.00\",\n    \"options\": {\n      \"Size\": \"M\",\n      \"Color\": \"Black\"\n    },\n    \"pay_url\": \"https://one-thing-ash0.onrender.com/o/pX4kR9tVb2nQ7sLe\",\n    \"status_url\": \"https://one-thing-ash0.onrender.com/o/pX4kR9tVb2nQ7sLe/status\",\n    \"next_step\": \"Show pay_url to the buyer as a link. When they say they've paid, call get_order with order_id.\"\n  },\n  \"type\": \"object\",\n  \"properties\": {\n    \"order_id\": {\n      \"description\": \"The order's id, for `get_order` and `getAgentOrder`.\",\n      \"example\": \"pX4kR9tVb2nQ7sLe\",\n      \"type\": \"string\"\n    },\n    \"status\": {\n      \"description\": \"Always `awaiting_buyer_approval`: nothing is charged until the buyer approves at PayPal.\",\n      \"example\": \"awaiting_buyer_approval\",\n      \"type\": \"string\",\n      \"enum\": [\n        \"awaiting_buyer_approval\"\n      ]\n    },\n    \"total\": {\n      \"description\": \"The total with shipping, as a label.\",\n      \"example\": \"$255.00\",\n      \"type\": \"string\"\n    },\n    \"pay_url\": {\n      \"description\": \"Where the buyer pays (redirects to PayPal). Safe to show in chat.\",\n      \"example\": \"https://one-thing-ash0.onrender.com/o/pX4kR9tVb2nQ7sLe\",\n      \"type\": \"string\"\n    },\n    \"status_url\": {\n      \"description\": \"`getAgentOrder` for this order.\",\n      \"example\": \"https://one-thing-ash0.onrender.com/o/pX4kR9tVb2nQ7sLe/status\",\n      \"type\": \"string\"\n    },\n    \"next_step\": {\n      \"description\": \"What the agent should do next, in plain words: show `pay_url`, then check `status_url` once the buyer says they've paid.\",\n      \"example\": \"Show pay_url to the buyer as a link. When they say they've paid, call get_order with order_id.\",\n      \"type\": \"string\"\n    },\n    \"show_buyer\": {\n      \"description\": \"A suggested reply to the buyer, in Markdown with the links already written as links: the product and its options to pick from, the pay link, or what they got with a receipt link. Buyers have the best experience when agents show it as written.\",\n      \"example\": \"![Vintage Cream and Red Roller Skates](https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X)\\n\\n**Vintage Cream and Red Roller Skates**: $240.00. Classic quad skates crafted with walnut burl heels\\n\\n![Raptor Rush: Browser Edition](https://one-thing-ash0.onrender.com/api/blobs/R9tWc3yN6bJq1zUd)\\n\\n**Raptor Rush: Browser Edition**: $2.99. Grow from Tiny Hatchling to Giant Apex Predator\\n\\nWhich one?\",\n      \"type\": \"string\"\n    },\n    \"agent_name\": {\n      \"description\": \"Who this request was credited to in the seller's stats: a recognised user agent, else the name the agent gave itself (`?agent=`, or the MCP client's name), else the user agent's first word.\",\n      \"example\": \"Grok\",\n      \"type\": \"string\"\n    },\n    \"options\": {\n      \"description\": \"The buyer's pick, one value per option, keyed by option name.\",\n      \"example\": {\n        \"Size\": \"M\",\n        \"Color\": \"Black\"\n      },\n      \"type\": \"object\",\n      \"additionalProperties\": {\n        \"type\": \"string\"\n      }\n    }\n  },\n  \"required\": [\n    \"order_id\",\n    \"status\",\n    \"total\",\n    \"pay_url\",\n    \"status_url\",\n    \"next_step\"\n  ]\n}"
                    example: '{"show_buyer":"![Vintage Cream and Red Roller Skates](https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X)\n\nVintage Cream and Red Roller Skates (9): $255.00 total.\n**[Pay $255.00 with PayPal](https://one-thing-ash0.onrender.com/o/pX4kR9tVb2nQ7sLe)**\nTell me once you''ve paid and I''ll get you the shipping confirmation.","order_id":"pX4kR9tVb2nQ7sLe","status":"awaiting_buyer_approval","total":"$255.00","options":{"Size":"9"},"pay_url":"https://one-thing-ash0.onrender.com/o/pX4kR9tVb2nQ7sLe","status_url":"https://one-thing-ash0.onrender.com/o/pX4kR9tVb2nQ7sLe/status","next_step":"Show pay_url to the buyer as a link. It opens PayPal, where they pay (and enter a shipping address for physical items). When they say they''ve paid, open status_url (or with MCP, call get_order with order_id): it returns the access code, download link or shipping details."}'
              '303':
                description: A person clicked the link. Redirect to PayPal (`pay_url`), or to the shop page to pick an option.
                headers:
                  Location:
                    required: false
              '400':
                description: A missing or unknown option value, or sold out. `error` names the valid values.
                body:
                  application/json:
                    schema: |
                      {
                        "id": "ErrorResponse",
                        "title": "ErrorResponse",
                        "description": "An error reply.",
                        "example": {
                          "error": "Choose a photo.",
                          "field": "photo"
                        },
                        "type": "object",
                        "properties": {
                          "error": {
                            "description": "A sentence you can show to a person.",
                            "example": "Order not found.",
                            "type": "string"
                          },
                          "field": {
                            "description": "The form field at fault, when there is one.",
                            "example": "price",
                            "type": "string"
                          },
                          "detail": {
                            "description": "The upstream service's own message, for debugging.",
                            "example": "INSTRUMENT_DECLINED",
                            "type": "string"
                          }
                        },
                        "required": [
                          "error"
                        ]
                      }
                    example: '{"error":"Unknown Size \"12\". Size: one of 7, 8, 9."}'
              '403':
                description: A known crawler or link previewer. They don't place orders.
                body:
                  application/json:
                    schema: |
                      {
                        "id": "ErrorResponse",
                        "title": "ErrorResponse",
                        "description": "An error reply.",
                        "example": {
                          "error": "Choose a photo.",
                          "field": "photo"
                        },
                        "type": "object",
                        "properties": {
                          "error": {
                            "description": "A sentence you can show to a person.",
                            "example": "Order not found.",
                            "type": "string"
                          },
                          "field": {
                            "description": "The form field at fault, when there is one.",
                            "example": "price",
                            "type": "string"
                          },
                          "detail": {
                            "description": "The upstream service's own message, for debugging.",
                            "example": "INSTRUMENT_DECLINED",
                            "type": "string"
                          }
                        },
                        "required": [
                          "error"
                        ]
                      }
                    example: "{\"error\":\"Crawlers and link previews don't place orders. Read the product at the shop's page.\"}"
              '404':
                description: No live shop with that link name.
                body:
                  application/json:
                    schema: |
                      {
                        "id": "ErrorResponse",
                        "title": "ErrorResponse",
                        "description": "An error reply.",
                        "example": {
                          "error": "Choose a photo.",
                          "field": "photo"
                        },
                        "type": "object",
                        "properties": {
                          "error": {
                            "description": "A sentence you can show to a person.",
                            "example": "Order not found.",
                            "type": "string"
                          },
                          "field": {
                            "description": "The form field at fault, when there is one.",
                            "example": "price",
                            "type": "string"
                          },
                          "detail": {
                            "description": "The upstream service's own message, for debugging.",
                            "example": "INSTRUMENT_DECLINED",
                            "type": "string"
                          }
                        },
                        "required": [
                          "error"
                        ]
                      }
                    example: '{"error":"No live shop called \"skatez\". Try search_shops."}'
              '429':
                description: Over this network's cap for the call (see **Limits**). Retry after `Retry-After` seconds.
                headers:
                  Retry-After:
                    required: false
                body:
                  application/json:
                    schema: |
                      {
                        "id": "ErrorResponse",
                        "title": "ErrorResponse",
                        "description": "An error reply.",
                        "example": {
                          "error": "Choose a photo.",
                          "field": "photo"
                        },
                        "type": "object",
                        "properties": {
                          "error": {
                            "description": "A sentence you can show to a person.",
                            "example": "Order not found.",
                            "type": "string"
                          },
                          "field": {
                            "description": "The form field at fault, when there is one.",
                            "example": "price",
                            "type": "string"
                          },
                          "detail": {
                            "description": "The upstream service's own message, for debugging.",
                            "example": "INSTRUMENT_DECLINED",
                            "type": "string"
                          }
                        },
                        "required": [
                          "error"
                        ]
                      }
                    example: '{"error":"Too many checkouts from your network. Try again in 7 min."}'
        get:
          description: 'Everything an AI shopping agent needs to describe the product and decide to buy it: price, shipping, delivery, availability, options, images and FAQ. Public. Buying goes through the MCP server named in `mcp_server`, or the `order_url` links. Shop pages also carry the same facts as schema.org `Product` JSON-LD. A person clicking the link in a browser (`Sec-Fetch-User: ?1`) is redirected instead; known assistants and headless browsers always get JSON. It goes to the shop page, unless the link has `?view=json`.'
          queryParameters:
            agent:
              description: "Optional: the agent's name (`ChatGPT`, `Gemini`, `my-shopping-bot`), so the seller's stats show which agent sent the buyer. Only used when the user agent doesn't already say."
              type: string
              example: ChatGPT
              required: false
              displayName: agent
              maxLength: '30'
            view:
              description: '`json` keeps the JSON for a person opening the link in a browser.'
              example: json
              required: false
              displayName: view
              enum:
              - json
          responses:
            '200':
              description: The product.
              body:
                application/json:
                  schema: "{\n  \"id\": \"AgentProduct\",\n  \"title\": \"AgentProduct\",\n  \"description\": \"A live shop as an AI agent sees it. Recommendations have `offers`; everything else has `price` and is bought with `create_order`.\",\n  \"example\": {\n    \"show_buyer\": \"![Vintage Cream and Red Roller Skates](https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X)\\n\\n**Vintage Cream and Red Roller Skates**: $240.00. Classic quad skates crafted with walnut burl heels\\n\\n![Raptor Rush: Browser Edition](https://one-thing-ash0.onrender.com/api/blobs/R9tWc3yN6bJq1zUd)\\n\\n**Raptor Rush: Browser Edition**: $2.99. Grow from Tiny Hatchling to Giant Apex Predator\\n\\nWhich one?\",\n    \"agent_name\": \"Grok\",\n    \"shop\": \"vintageskates\",\n    \"url\": \"https://one-thing-ash0.onrender.com/vintageskates\",\n    \"name\": \"Vintage Cream and Red Roller Skates\",\n    \"kind\": \"physical\",\n    \"headline\": \"Classic quad skates crafted with walnut burl heels\",\n    \"description\": \"Vintage cream and red quad roller skates with walnut burl heels.\",\n    \"highlights\": [\n      \"Walnut burl heels\",\n      \"Restored vintage leather\"\n    ],\n    \"details\": [\n      {\n        \"label\": \"Material\",\n        \"value\": \"Leather upper, walnut burl heel, rubber wheels\"\n      }\n    ],\n    \"faq\": [\n      {\n        \"q\": \"Are these suitable for outdoor skating?\",\n        \"a\": \"Yes, on indoor rink floors and paved outdoor paths.\"\n      }\n    ],\n    \"images\": [\n      \"https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X\"\n    ],\n    \"price\": {\n      \"amount\": 240,\n      \"currency\": \"USD\",\n      \"label\": \"$240.00\"\n    },\n    \"shipping\": {\n      \"amount\": 15,\n      \"currency\": \"USD\",\n      \"ships_to\": [\n        \"US\",\n        \"CA\"\n      ]\n    },\n    \"total\": {\n      \"amount\": 240,\n      \"currency\": \"USD\",\n      \"label\": \"$240.00\"\n    },\n    \"delivery\": \"Shipped. PayPal collects the buyer's address at checkout.\",\n    \"availability\": \"in_stock\",\n    \"options\": [\n      {\n        \"name\": \"Size\",\n        \"values\": [\n          \"7\",\n          \"8\",\n          \"9\"\n        ]\n      }\n    ],\n    \"variants\": [\n      {\n        \"choice\": {\n          \"Size\": \"M\",\n          \"Color\": \"Black\"\n        },\n        \"availability\": \"in_stock (3 left)\",\n        \"order_url\": \"https://one-thing-ash0.onrender.com/vintageskates/buy?Size=9\"\n      }\n    ],\n    \"order_url\": \"https://one-thing-ash0.onrender.com/vintageskates/buy?Size=9\",\n    \"offers\": [\n      {\n        \"retailer\": \"rei.com\",\n        \"price\": 240,\n        \"currency\": \"USD\",\n        \"in_stock\": true,\n        \"url\": \"https://buy.trychannel3.com/r/abc123\"\n      }\n    ],\n    \"how_to_buy\": \"Ask the buyer which size, then open that variant's order_url and show them pay_url.\",\n    \"mcp_server\": \"https://one-thing-ash0.onrender.com/api/mcp\"\n  },\n  \"type\": \"object\",\n  \"properties\": {\n    \"shop\": {\n      \"description\": \"The link name, which the MCP tools take as `shop`.\",\n      \"example\": \"vintageskates\",\n      \"type\": \"string\"\n    },\n    \"url\": {\n      \"description\": \"The shop page, where a person can buy it too.\",\n      \"example\": \"https://one-thing-ash0.onrender.com/vintageskates\",\n      \"type\": \"string\"\n    },\n    \"name\": {\n      \"description\": \"The product's name.\",\n      \"example\": \"Vintage Cream and Red Roller Skates\",\n      \"type\": \"string\"\n    },\n    \"kind\": {\n      \"title\": \"Kind1\",\n      \"description\": \"`physical` ships, `digital` downloads or unlocks with a code, `referral` is bought at another store.\",\n      \"example\": \"physical\",\n      \"type\": \"string\",\n      \"additionalProperties\": false,\n      \"enum\": [\n        \"physical\",\n        \"digital\",\n        \"referral\"\n      ]\n    },\n    \"headline\": {\n      \"description\": \"The shop's one-line pitch.\",\n      \"example\": \"Classic quad skates crafted with walnut burl heels\",\n      \"type\": \"string\"\n    },\n    \"description\": {\n      \"description\": \"What the product is, in a few sentences.\",\n      \"example\": \"Vintage cream and red quad roller skates with walnut burl heels.\",\n      \"type\": \"string\"\n    },\n    \"highlights\": {\n      \"description\": \"The product's selling points, one per line.\",\n      \"example\": [\n        \"Walnut burl heels\",\n        \"Restored vintage leather\"\n      ],\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"details\": {\n      \"description\": \"Product facts, such as size, material or format.\",\n      \"example\": [\n        {\n          \"label\": \"Material\",\n          \"value\": \"Leather upper, walnut burl heel, rubber wheels\"\n        }\n      ],\n      \"type\": \"array\",\n      \"items\": {\n        \"id\": \"Detail\",\n        \"title\": \"Detail\",\n        \"description\": \"One product fact.\",\n        \"example\": {\n          \"label\": \"Material\",\n          \"value\": \"Leather upper, walnut burl heel, rubber wheels\"\n        },\n        \"type\": \"object\",\n        \"properties\": {\n          \"label\": {\n            \"description\": \"What the fact is about.\",\n            \"example\": \"Material\",\n            \"type\": \"string\"\n          },\n          \"value\": {\n            \"description\": \"The fact.\",\n            \"example\": \"Leather upper, walnut burl heel, rubber wheels\",\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"label\",\n          \"value\"\n        ]\n      }\n    },\n    \"faq\": {\n      \"description\": \"Questions buyers ask, answered by the seller's page.\",\n      \"example\": [\n        {\n          \"q\": \"Are these suitable for outdoor skating?\",\n          \"a\": \"Yes, on indoor rink floors and paved outdoor paths.\"\n        }\n      ],\n      \"type\": \"array\",\n      \"items\": {\n        \"id\": \"Faq\",\n        \"title\": \"Faq\",\n        \"description\": \"One question and its answer.\",\n        \"example\": {\n          \"q\": \"Are these suitable for outdoor skating?\",\n          \"a\": \"Yes, on indoor rink floors and paved outdoor paths.\"\n        },\n        \"type\": \"object\",\n        \"properties\": {\n          \"q\": {\n            \"description\": \"The question.\",\n            \"example\": \"Are these suitable for outdoor skating?\",\n            \"type\": \"string\"\n          },\n          \"a\": {\n            \"description\": \"The answer.\",\n            \"example\": \"Yes, on indoor rink floors and paved outdoor paths.\",\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"q\",\n          \"a\"\n        ]\n      }\n    },\n    \"images\": {\n      \"description\": \"Photo URLs, the cover first. Show these rather than generating or searching for images.\",\n      \"example\": [\n        \"https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X\"\n      ],\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"how_to_buy\": {\n      \"description\": \"How to buy it, written for an agent: which tool or link to use and what to ask the buyer.\",\n      \"example\": \"Ask the buyer which size, then open that variant's order_url and show them pay_url.\",\n      \"type\": \"string\"\n    },\n    \"show_buyer\": {\n      \"description\": \"A suggested reply to the buyer, in Markdown with the links already written as links: the product and its options to pick from, the pay link, or what they got with a receipt link. Buyers have the best experience when agents show it as written.\",\n      \"example\": \"![Vintage Cream and Red Roller Skates](https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X)\\n\\n**Vintage Cream and Red Roller Skates**: $240.00. Classic quad skates crafted with walnut burl heels\\n\\n![Raptor Rush: Browser Edition](https://one-thing-ash0.onrender.com/api/blobs/R9tWc3yN6bJq1zUd)\\n\\n**Raptor Rush: Browser Edition**: $2.99. Grow from Tiny Hatchling to Giant Apex Predator\\n\\nWhich one?\",\n      \"type\": \"string\"\n    },\n    \"agent_name\": {\n      \"description\": \"Who this request was credited to in the seller's stats: a recognised user agent, else the name the agent gave itself (`?agent=`, or the MCP client's name), else the user agent's first word.\",\n      \"example\": \"Grok\",\n      \"type\": \"string\"\n    },\n    \"price\": {\n      \"id\": \"AgentMoney\",\n      \"title\": \"AgentMoney\",\n      \"description\": \"An amount of money, as a number and as a label.\",\n      \"example\": {\n        \"amount\": 240,\n        \"currency\": \"USD\",\n        \"label\": \"$240.00\"\n      },\n      \"type\": \"object\",\n      \"properties\": {\n        \"amount\": {\n          \"description\": \"The amount in the currency's main unit (dollars, not cents).\",\n          \"example\": 48.5,\n          \"type\": \"number\"\n        },\n        \"currency\": {\n          \"description\": \"ISO 4217 currency code.\",\n          \"example\": \"USD\",\n          \"type\": \"string\"\n        },\n        \"label\": {\n          \"description\": \"The amount formatted for people.\",\n          \"example\": \"$48.50\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"amount\",\n        \"currency\"\n      ]\n    },\n    \"shipping\": {\n      \"description\": \"Physical products only.\",\n      \"example\": {\n        \"amount\": 15,\n        \"currency\": \"USD\",\n        \"ships_to\": [\n          \"US\",\n          \"CA\"\n        ]\n      },\n      \"oneOf\": [\n        {\n          \"id\": \"Shipping\",\n          \"title\": \"Shipping\",\n          \"description\": \"Shipping cost and destinations.\",\n          \"example\": {\n            \"amount\": 15,\n            \"currency\": \"USD\",\n            \"ships_to\": [\n              \"US\",\n              \"CA\"\n            ]\n          },\n          \"type\": \"object\",\n          \"properties\": {\n            \"amount\": {\n              \"description\": \"Shipping cost per order.\",\n              \"example\": 15,\n              \"type\": \"number\"\n            },\n            \"currency\": {\n              \"description\": \"ISO 4217 currency code.\",\n              \"example\": \"USD\",\n              \"type\": \"string\"\n            },\n            \"ships_to\": {\n              \"description\": \"Country codes; empty means anywhere PayPal ships.\",\n              \"example\": [\n                \"US\",\n                \"CA\"\n              ],\n              \"type\": \"array\",\n              \"items\": {\n                \"type\": \"string\"\n              }\n            }\n          },\n          \"required\": [\n            \"amount\",\n            \"currency\",\n            \"ships_to\"\n          ]\n        },\n        {\n          \"type\": \"null\"\n        }\n      ]\n    },\n    \"total\": {\n      \"$ref\": \"AgentMoney\"\n    },\n    \"delivery\": {\n      \"description\": \"How the buyer gets it, in plain words.\",\n      \"example\": \"Shipped. PayPal collects the buyer's address at checkout.\",\n      \"type\": \"string\"\n    },\n    \"availability\": {\n      \"description\": \"`in_stock`, `in_stock (N left)` or `sold_out`. With options, see `variants`.\",\n      \"examples\": [\n        {\n          \"Id\": \"Untitled Example1\",\n          \"Name\": null,\n          \"Value\": \"in_stock\",\n          \"ExternalValue\": null,\n          \"Description\": null\n        },\n        {\n          \"Id\": \"Untitled Example2\",\n          \"Name\": null,\n          \"Value\": \"in_stock (3 left)\",\n          \"ExternalValue\": null,\n          \"Description\": null\n        },\n        {\n          \"Id\": \"Untitled Example3\",\n          \"Name\": null,\n          \"Value\": \"sold_out\",\n          \"ExternalValue\": null,\n          \"Description\": null\n        }\n      ],\n      \"example\": \"in_stock\",\n      \"type\": \"string\"\n    },\n    \"options\": {\n      \"description\": \"Pass one value per option to `create_order`.\",\n      \"example\": [\n        {\n          \"name\": \"Size\",\n          \"values\": [\n            \"7\",\n            \"8\",\n            \"9\"\n          ]\n        }\n      ],\n      \"type\": \"array\",\n      \"items\": {\n        \"id\": \"Option1\",\n        \"title\": \"Option1\",\n        \"description\": \"One option and its values.\",\n        \"example\": {\n          \"name\": \"Size\",\n          \"values\": [\n            \"7\",\n            \"8\",\n            \"9\"\n          ]\n        },\n        \"type\": \"object\",\n        \"properties\": {\n          \"name\": {\n            \"description\": \"The option's name, which is also its query parameter on `order_url`.\",\n            \"example\": \"Vintage Cream and Red Roller Skates\",\n            \"type\": \"string\"\n          },\n          \"values\": {\n            \"description\": \"The values the buyer can pick.\",\n            \"example\": [\n              \"7\",\n              \"8\",\n              \"9\"\n            ],\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          }\n        },\n        \"required\": [\n          \"name\",\n          \"values\"\n        ]\n      }\n    },\n    \"variants\": {\n      \"description\": \"Products with options: each combination, its stock and its order link.\",\n      \"example\": [\n        {\n          \"choice\": {\n            \"Size\": \"M\",\n            \"Color\": \"Black\"\n          },\n          \"availability\": \"in_stock (3 left)\",\n          \"order_url\": \"https://one-thing-ash0.onrender.com/vintageskates/buy?Size=9\"\n        }\n      ],\n      \"type\": \"array\",\n      \"items\": {\n        \"id\": \"Variant\",\n        \"title\": \"Variant\",\n        \"description\": \"One combination of option values.\",\n        \"example\": {\n          \"choice\": {\n            \"Size\": \"M\",\n            \"Color\": \"Black\"\n          },\n          \"availability\": \"in_stock (3 left)\",\n          \"order_url\": \"https://one-thing-ash0.onrender.com/vintageskates/buy?Size=9\"\n        },\n        \"type\": \"object\",\n        \"properties\": {\n          \"choice\": {\n            \"description\": \"The buyer's pick, one value per option, keyed by option name.\",\n            \"example\": {\n              \"Size\": \"M\",\n              \"Color\": \"Black\"\n            },\n            \"type\": \"object\",\n            \"additionalProperties\": {\n              \"type\": \"string\"\n            }\n          },\n          \"availability\": {\n            \"description\": \"`in_stock`, `in_stock (N left)` or `sold_out`.\",\n            \"example\": \"in_stock (3 left)\",\n            \"type\": \"string\"\n          },\n          \"order_url\": {\n            \"description\": \"`orderByLink` for this pick. Left out when it's sold out.\",\n            \"example\": \"https://one-thing-ash0.onrender.com/vintageskates/buy?Size=9\",\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"choice\",\n          \"availability\"\n        ]\n      }\n    },\n    \"order_url\": {\n      \"description\": \"Products without options: `orderByLink`, which orders one unit with a GET. Left out when sold out. With options, each variant has its own.\",\n      \"example\": \"https://one-thing-ash0.onrender.com/vintageskates/buy?Size=9\",\n      \"type\": \"string\"\n    },\n    \"offers\": {\n      \"description\": \"Recommendations only. Bought at the retailer.\",\n      \"example\": [\n        {\n          \"retailer\": \"rei.com\",\n          \"price\": 240,\n          \"currency\": \"USD\",\n          \"in_stock\": true,\n          \"url\": \"https://buy.trychannel3.com/r/abc123\"\n        }\n      ],\n      \"type\": \"array\",\n      \"items\": {\n        \"id\": \"Offer1\",\n        \"title\": \"Offer1\",\n        \"description\": \"One store's offer.\",\n        \"example\": {\n          \"retailer\": \"rei.com\",\n          \"price\": 240,\n          \"currency\": \"USD\",\n          \"in_stock\": true,\n          \"url\": \"https://buy.trychannel3.com/r/abc123\"\n        },\n        \"type\": \"object\",\n        \"properties\": {\n          \"retailer\": {\n            \"description\": \"The store.\",\n            \"example\": \"rei.com\",\n            \"type\": \"string\"\n          },\n          \"price\": {\n            \"description\": \"The store's price.\",\n            \"example\": 240,\n            \"type\": \"number\"\n          },\n          \"currency\": {\n            \"description\": \"ISO 4217 currency code.\",\n            \"example\": \"USD\",\n            \"type\": \"string\"\n          },\n          \"in_stock\": {\n            \"description\": \"Whether the store has it in stock.\",\n            \"example\": true,\n            \"type\": \"boolean\"\n          },\n          \"url\": {\n            \"description\": \"A tracked buy link at that store.\",\n            \"example\": \"https://buy.trychannel3.com/r/abc123\",\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"retailer\",\n          \"price\",\n          \"currency\",\n          \"in_stock\",\n          \"url\"\n        ]\n      }\n    },\n    \"mcp_server\": {\n      \"description\": \"The MCP server to order through (`getAgentProduct` only).\",\n      \"example\": \"https://one-thing-ash0.onrender.com/api/mcp\",\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"shop\",\n    \"url\",\n    \"name\",\n    \"kind\",\n    \"headline\",\n    \"description\",\n    \"highlights\",\n    \"details\",\n    \"faq\",\n    \"images\",\n    \"how_to_buy\"\n  ]\n}"
                  example: '{"show_buyer":"![Vintage Cream and Red Roller Skates](https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X)\n\n**Vintage Cream and Red Roller Skates**: $240.00 + $15.00 shipping\nClassic quad skates crafted with walnut burl heels\nSize: 7 · 8 · 9\nWhich size?","shop":"vintageskates","url":"https://one-thing-ash0.onrender.com/vintageskates","name":"Vintage Cream and Red Roller Skates","kind":"physical","headline":"Classic quad skates crafted with walnut burl heels","description":"A vintage pair of skates featuring cream leather, bold red trim, and durable quad wheels.","highlights":["Handmade cream leather upper with rich red trim","Sculpted walnut burl heel structure for stability"],"details":[{"label":"Materials","value":"Leather upper, walnut burl heel, rubber wheels"}],"faq":[{"q":"What is the return policy?","a":"Unworn skates in original condition can be returned within 30 days of delivery."}],"images":["https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X","https://one-thing-ash0.onrender.com/api/blobs/zrySajNyao6_j11x"],"price":{"amount":240,"currency":"USD","label":"$240.00"},"shipping":{"amount":15,"currency":"USD","ships_to":["US"]},"total":{"amount":255,"currency":"USD"},"delivery":"Shipped. PayPal collects the buyer''s address at checkout.","options":[{"name":"Size","values":["7","8","9"]}],"variants":[{"choice":{"Size":"7"},"availability":"in_stock (3 left)","order_url":"https://one-thing-ash0.onrender.com/vintageskates/buy?Size=7"},{"choice":{"Size":"8"},"availability":"sold_out"},{"choice":{"Size":"9"},"availability":"in_stock (6 left)","order_url":"https://one-thing-ash0.onrender.com/vintageskates/buy?Size=9"}],"availability":"in_stock","how_to_buy":"Show show_buyer to the buyer exactly as written, photo included (it''s Markdown, so the photo displays and the links stay clickable), and keep your own words to a minimum. Once the buyer has picked and said to buy, open the order_url of their variant (or call create_order on the OneThing MCP server with shop and options). Either returns show_buyer with the pay link.","mcp_server":"https://one-thing-ash0.onrender.com/api/mcp","agent_name":"ChatGPT"}'
            '303':
              description: A person clicked the link. Redirect to the shop page (`/<slug>`).
            '404':
              description: No live shop with that link name.
              body:
                application/json:
                  schema: |
                    {
                      "id": "ErrorResponse",
                      "title": "ErrorResponse",
                      "description": "An error reply.",
                      "example": {
                        "error": "Choose a photo.",
                        "field": "photo"
                      },
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "A sentence you can show to a person.",
                          "example": "Order not found.",
                          "type": "string"
                        },
                        "field": {
                          "description": "The form field at fault, when there is one.",
                          "example": "price",
                          "type": "string"
                        },
                        "detail": {
                          "description": "The upstream service's own message, for debugging.",
                          "example": "INSTRUMENT_DECLINED",
                          "type": "string"
                        }
                      },
                      "required": [
                        "error"
                      ]
                    }
      get:
        description: "The gallery's live shops for a query: shops matching more of its words first, newest first among equals. Browsing words (\"something interesting to buy\") are ignored, and a query that matches nothing returns the newest shops with `matched: false` rather than an empty list. The GET twin of the MCP `search_shops` tool, for agents that can only fetch URLs. Public. Read a shop with `getAgentProduct`; buy through the MCP server in `mcp_server`, or send the buyer to the shop's `url`."
        queryParameters:
          q:
            description: Keywords. Leave out to list the newest shops.
            type: string
            example: skates
            required: false
            displayName: q
            maxLength: '200'
          limit:
            description: How many shops, 1–25.
            type: integer
            example: '10'
            default: '10'
            required: false
            displayName: limit
            minimum: '1'
            maximum: '25'
        responses:
          '200':
            description: The matching shops.
            body:
              application/json:
                schema: "{\n  \"id\": \"ApiAgentShopsResponse\",\n  \"title\": \"ApiAgentShopsResponse\",\n  \"description\": \"The matching shops, with a reply to show the buyer.\",\n  \"example\": {\n    \"show_buyer\": \"![Vintage Cream and Red Roller Skates](https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X)\\n\\n**Vintage Cream and Red Roller Skates**: $240.00. Classic quad skates crafted with walnut burl heels\\n\\n![Raptor Rush: Browser Edition](https://one-thing-ash0.onrender.com/api/blobs/R9tWc3yN6bJq1zUd)\\n\\n**Raptor Rush: Browser Edition**: $2.99. Grow from Tiny Hatchling to Giant Apex Predator\\n\\nWhich one?\",\n    \"shops\": [\n      {\n        \"shop\": \"vintageskates\",\n        \"name\": \"Vintage Cream and Red Roller Skates\",\n        \"kind\": \"physical\",\n        \"headline\": \"Classic quad skates crafted with walnut burl heels\",\n        \"price\": \"$240.00\",\n        \"image\": \"https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X\",\n        \"url\": \"https://one-thing-ash0.onrender.com/vintageskates\"\n      },\n      {\n        \"shop\": \"raptorrush\",\n        \"name\": \"Raptor Rush: Browser Edition\",\n        \"kind\": \"digital\",\n        \"headline\": \"Grow from Tiny Hatchling to Giant Apex Predator\",\n        \"price\": \"$2.99\",\n        \"image\": \"https://one-thing-ash0.onrender.com/api/blobs/R9tWc3yN6bJq1zUd\",\n        \"url\": \"https://one-thing-ash0.onrender.com/raptorrush\"\n      }\n    ],\n    \"matched\": true,\n    \"mcp_server\": \"https://one-thing-ash0.onrender.com/api/mcp\"\n  },\n  \"type\": \"object\",\n  \"properties\": {\n    \"show_buyer\": {\n      \"description\": \"A suggested reply to the buyer, in Markdown: each shop's cover photo as an image, its name, price and headline, then \\\"Which one?\\\". Chats that block images from other sites just leave the image lines out.\",\n      \"example\": \"![Vintage Cream and Red Roller Skates](https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X)\\n\\n**Vintage Cream and Red Roller Skates**: $240.00. Classic quad skates crafted with walnut burl heels\\n\\n![Raptor Rush: Browser Edition](https://one-thing-ash0.onrender.com/api/blobs/R9tWc3yN6bJq1zUd)\\n\\n**Raptor Rush: Browser Edition**: $2.99. Grow from Tiny Hatchling to Giant Apex Predator\\n\\nWhich one?\",\n      \"type\": \"string\"\n    },\n    \"shops\": {\n      \"description\": \"Shops, best match first.\",\n      \"example\": [\n        {\n          \"shop\": \"vintageskates\",\n          \"name\": \"Vintage Cream and Red Roller Skates\",\n          \"kind\": \"physical\",\n          \"headline\": \"Classic quad skates crafted with walnut burl heels\",\n          \"price\": \"$240.00\",\n          \"image\": \"https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X\",\n          \"url\": \"https://one-thing-ash0.onrender.com/vintageskates\"\n        }\n      ],\n      \"type\": \"array\",\n      \"items\": {\n        \"id\": \"AgentShopSummary\",\n        \"title\": \"AgentShopSummary\",\n        \"description\": \"A shop in search results.\",\n        \"example\": {\n          \"shop\": \"vintageskates\",\n          \"name\": \"Vintage Cream and Red Roller Skates\",\n          \"kind\": \"physical\",\n          \"headline\": \"Classic quad skates crafted with walnut burl heels\",\n          \"price\": \"$240.00\",\n          \"image\": \"https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X\",\n          \"url\": \"https://one-thing-ash0.onrender.com/vintageskates\"\n        },\n        \"type\": \"object\",\n        \"properties\": {\n          \"shop\": {\n            \"description\": \"The link name, for `getAgentProduct` and the MCP tools.\",\n            \"example\": \"vintageskates\",\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"description\": \"The product's name.\",\n            \"example\": \"Vintage Cream and Red Roller Skates\",\n            \"type\": \"string\"\n          },\n          \"kind\": {\n            \"title\": \"Kind2\",\n            \"description\": \"`physical`, `digital` or `referral`.\",\n            \"example\": \"physical\",\n            \"type\": \"string\",\n            \"additionalProperties\": false,\n            \"enum\": [\n              \"physical\",\n              \"digital\",\n              \"referral\"\n            ]\n          },\n          \"headline\": {\n            \"description\": \"The shop's one-line pitch.\",\n            \"example\": \"Classic quad skates crafted with walnut burl heels\",\n            \"type\": \"string\"\n          },\n          \"price\": {\n            \"description\": \"The price label, e.g. `$2.99`; null for recommendations.\",\n            \"example\": \"$240.00\",\n            \"type\": [\n              \"string\",\n              \"null\"\n            ]\n          },\n          \"image\": {\n            \"description\": \"The cover photo's URL (WebP; the retailer's image for a recommendation), or null when there's none.\",\n            \"example\": \"https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X\",\n            \"type\": [\n              \"string\",\n              \"null\"\n            ]\n          },\n          \"url\": {\n            \"description\": \"The shop page.\",\n            \"example\": \"https://one-thing-ash0.onrender.com/vintageskates\",\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"shop\",\n          \"name\",\n          \"kind\",\n          \"headline\",\n          \"price\",\n          \"image\",\n          \"url\"\n        ]\n      }\n    },\n    \"matched\": {\n      \"description\": \"False when nothing matched the query and `shops` is the newest gallery shops instead; `show_buyer` then starts by saying so.\",\n      \"example\": true,\n      \"type\": \"boolean\"\n    },\n    \"mcp_server\": {\n      \"description\": \"The MCP server to order through.\",\n      \"example\": \"https://one-thing-ash0.onrender.com/api/mcp\",\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"show_buyer\",\n    \"shops\",\n    \"matched\",\n    \"mcp_server\"\n  ]\n}"
                example: '{"show_buyer":"![Vintage Cream and Red Roller Skates](https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X)\n\n**Vintage Cream and Red Roller Skates**: $240.00. Classic quad skates crafted with walnut burl heels\n\n![Raptor Rush: Browser Edition](https://one-thing-ash0.onrender.com/api/blobs/R9tWc3yN6bJq1zUd)\n\n**Raptor Rush: Browser Edition**: $2.99. Grow from Tiny Hatchling to Giant Apex Predator\n\nWhich one?","shops":[{"shop":"vintageskates","name":"Vintage Cream and Red Roller Skates","kind":"physical","headline":"Classic quad skates crafted with walnut burl heels","price":"$240.00","image":"https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X","url":"https://one-thing-ash0.onrender.com/vintageskates"},{"shop":"raptorrush","name":"Raptor Rush: Browser Edition","kind":"digital","headline":"Grow from Tiny Hatchling to Giant Apex Predator","price":"$2.99","image":"https://one-thing-ash0.onrender.com/api/blobs/R9tWc3yN6bJq1zUd","url":"https://one-thing-ash0.onrender.com/raptorrush"}],"matched":true,"mcp_server":"https://one-thing-ash0.onrender.com/api/mcp"}'
    /orders/{orderId}:
      uriParameters:
        orderId:
          description: The `order_id` from the MCP `create_order` tool, or from a thank-you page link (`?order=`).
          type: string
          example: pX4kR9tVb2nQ7sLe
          required: true
          displayName: orderId
      get:
        description: "Where an order stands and, once paid, what the buyer got: the access code, the download link, or the shipping address and tracking. The GET twin of the MCP `get_order` tool (and the `status_url` that `create_order` returns), for agents that can only fetch URLs. Public: anyone with the order id can already open its thank-you page. If the buyer has approved at PayPal but nothing has captured the payment yet, this captures it. `/o/<order_id>/status` is the same endpoint at a short URL, and the one `status_url` uses. A person clicking the link in a browser (`Sec-Fetch-User: ?1`) is redirected instead; known assistants and headless browsers always get JSON. It goes to the order's receipt page."
        queryParameters:
          agent:
            description: "Optional: the agent's name (`ChatGPT`, `Gemini`, `my-shopping-bot`), so the seller's stats show which agent sent the buyer. Only used when the user agent doesn't already say."
            type: string
            example: ChatGPT
            required: false
            displayName: agent
            maxLength: '30'
        responses:
          '200':
            description: The order.
            body:
              application/json:
                schema: "{\n  \"id\": \"AgentOrder\",\n  \"title\": \"AgentOrder\",\n  \"description\": \"An order as `get_order` and `getAgentOrder` report it.\",\n  \"example\": {\n    \"show_buyer\": \"![Vintage Cream and Red Roller Skates](https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X)\\n\\n**Vintage Cream and Red Roller Skates**: $240.00. Classic quad skates crafted with walnut burl heels\\n\\n![Raptor Rush: Browser Edition](https://one-thing-ash0.onrender.com/api/blobs/R9tWc3yN6bJq1zUd)\\n\\n**Raptor Rush: Browser Edition**: $2.99. Grow from Tiny Hatchling to Giant Apex Predator\\n\\nWhich one?\",\n    \"agent_name\": \"Grok\",\n    \"order_id\": \"pX4kR9tVb2nQ7sLe\",\n    \"status\": \"awaiting_buyer_approval\",\n    \"product\": \"Vintage Cream and Red Roller Skates\",\n    \"options\": {\n      \"Size\": \"M\",\n      \"Color\": \"Black\"\n    },\n    \"amount\": {\n      \"item\": 240,\n      \"shipping\": 15,\n      \"total\": 255,\n      \"currency\": \"USD\"\n    },\n    \"total\": \"$255.00\",\n    \"pay_url\": \"https://one-thing-ash0.onrender.com/o/pX4kR9tVb2nQ7sLe\",\n    \"next_step\": \"Show pay_url to the buyer as a link. When they say they've paid, call get_order with order_id.\",\n    \"paid_at\": \"2026-10-22T02:41:37Z\",\n    \"receipt_url\": \"https://one-thing-ash0.onrender.com/vintageskates/thanks?order=pX4kR9tVb2nQ7sLe\",\n    \"delivery\": {\n      \"type\": \"access_code\",\n      \"access_code\": \"K7QF-M2XP-9HTD\",\n      \"start_url\": \"https://www.miriogames.com/raptor-rush/?code=K7QF-M2XP-9HTD\"\n    }\n  },\n  \"examples\": [\n    {\n      \"Id\": \"waiting\",\n      \"Name\": \"Waiting for the buyer\",\n      \"Value\": \"{\\\"order_id\\\":\\\"pX4kR9tVb2nQ7sLe\\\",\\\"status\\\":\\\"awaiting_buyer_approval\\\",\\\"product\\\":\\\"Vintage Cream and Red Roller Skates\\\",\\\"options\\\":{\\\"Size\\\":\\\"9\\\"},\\\"amount\\\":{\\\"item\\\":240,\\\"shipping\\\":15,\\\"total\\\":255,\\\"currency\\\":\\\"USD\\\"},\\\"total\\\":\\\"$255.00\\\",\\\"pay_url\\\":\\\"https://one-thing-ash0.onrender.com/o/pX4kR9tVb2nQ7sLe\\\",\\\"next_step\\\":\\\"The buyer hasn't paid yet. Give them pay_url; when they say they've paid, call get_order again.\\\"}\",\n      \"ExternalValue\": null,\n      \"Description\": null\n    },\n    {\n      \"Id\": \"code\",\n      \"Name\": \"Paid: an access code\",\n      \"Value\": \"{\\\"show_buyer\\\":\\\"Paid: Raptor Rush: Browser Edition, $2.99.\\\\nYour access code: `K7QF-M2XP-9HTD` · [Start now](https://www.miriogames.com/raptor-rush/play/?code=K7QF-M2XP-9HTD)\\\\n[Your receipt](https://one-thing-ash0.onrender.com/raptorrush/thanks?order=a9KQqS7zAY5dWv89)\\\",\\\"order_id\\\":\\\"a9KQqS7zAY5dWv89\\\",\\\"status\\\":\\\"paid\\\",\\\"product\\\":\\\"Raptor Rush: Browser Edition\\\",\\\"amount\\\":{\\\"item\\\":2.99,\\\"shipping\\\":0,\\\"total\\\":2.99,\\\"currency\\\":\\\"USD\\\"},\\\"total\\\":\\\"$2.99\\\",\\\"paid_at\\\":\\\"2026-10-22T03:12:50Z\\\",\\\"receipt_url\\\":\\\"https://one-thing-ash0.onrender.com/raptorrush/thanks?order=a9KQqS7zAY5dWv89\\\",\\\"delivery\\\":{\\\"type\\\":\\\"access_code\\\",\\\"access_code\\\":\\\"K7QF-M2XP-9HTD\\\",\\\"start_url\\\":\\\"https://www.miriogames.com/raptor-rush/play/?code=K7QF-M2XP-9HTD\\\"}}\",\n      \"ExternalValue\": null,\n      \"Description\": null\n    },\n    {\n      \"Id\": \"shipping\",\n      \"Name\": \"Paid: shipped to the buyer\",\n      \"Value\": \"{\\\"order_id\\\":\\\"pX4kR9tVb2nQ7sLe\\\",\\\"status\\\":\\\"paid\\\",\\\"product\\\":\\\"Vintage Cream and Red Roller Skates\\\",\\\"options\\\":{\\\"Size\\\":\\\"9\\\"},\\\"amount\\\":{\\\"item\\\":240,\\\"shipping\\\":15,\\\"total\\\":255,\\\"currency\\\":\\\"USD\\\"},\\\"total\\\":\\\"$255.00\\\",\\\"paid_at\\\":\\\"2026-10-22T02:41:37Z\\\",\\\"receipt_url\\\":\\\"https://one-thing-ash0.onrender.com/vintageskates/thanks?order=pX4kR9tVb2nQ7sLe\\\",\\\"delivery\\\":{\\\"type\\\":\\\"shipping\\\",\\\"ship_to\\\":{\\\"name\\\":\\\"Sam Rivera\\\",\\\"address\\\":\\\"1 Main St, Springfield, IL, 62701, US\\\"},\\\"fulfillment\\\":\\\"to_ship\\\",\\\"tracking\\\":null}}\",\n      \"ExternalValue\": null,\n      \"Description\": null\n    },\n    {\n      \"Id\": \"expired\",\n      \"Name\": \"Expired before payment\",\n      \"Value\": \"{\\\"order_id\\\":\\\"pX4kR9tVb2nQ7sLe\\\",\\\"status\\\":\\\"expired\\\",\\\"product\\\":\\\"Vintage Cream and Red Roller Skates\\\",\\\"options\\\":{\\\"Size\\\":\\\"9\\\"},\\\"amount\\\":{\\\"item\\\":240,\\\"shipping\\\":15,\\\"total\\\":255,\\\"currency\\\":\\\"USD\\\"},\\\"total\\\":\\\"$255.00\\\",\\\"next_step\\\":\\\"This checkout expired at PayPal. Nothing was charged. Call create_order for a new one.\\\"}\",\n      \"ExternalValue\": null,\n      \"Description\": null\n    }\n  ],\n  \"type\": \"object\",\n  \"properties\": {\n    \"order_id\": {\n      \"description\": \"The order's id.\",\n      \"example\": \"pX4kR9tVb2nQ7sLe\",\n      \"type\": \"string\"\n    },\n    \"status\": {\n      \"title\": \"Status2\",\n      \"description\": \"`declined`: PayPal declined it, nothing charged, the buyer can open `pay_url` again. `sold_out`: it sold out before the payment was captured. `expired`: the PayPal checkout expired; create a new order. `failed`: PayPal couldn't be reached; ask again.\",\n      \"example\": \"awaiting_buyer_approval\",\n      \"type\": \"string\",\n      \"additionalProperties\": false,\n      \"enum\": [\n        \"awaiting_buyer_approval\",\n        \"paid\",\n        \"declined\",\n        \"sold_out\",\n        \"expired\",\n        \"failed\"\n      ]\n    },\n    \"product\": {\n      \"description\": \"The product's name.\",\n      \"example\": \"Vintage Cream and Red Roller Skates\",\n      \"type\": \"string\"\n    },\n    \"amount\": {\n      \"id\": \"Amount\",\n      \"title\": \"Amount\",\n      \"description\": \"What the order costs, as numbers.\",\n      \"example\": {\n        \"item\": 240,\n        \"shipping\": 15,\n        \"total\": 255,\n        \"currency\": \"USD\"\n      },\n      \"type\": \"object\",\n      \"properties\": {\n        \"item\": {\n          \"description\": \"The product's price.\",\n          \"example\": 240,\n          \"type\": \"number\"\n        },\n        \"shipping\": {\n          \"description\": \"Shipping; 0 for digital products.\",\n          \"example\": 15,\n          \"type\": \"number\"\n        },\n        \"total\": {\n          \"description\": \"Product plus shipping: what the buyer pays.\",\n          \"example\": 255,\n          \"type\": \"number\"\n        },\n        \"currency\": {\n          \"description\": \"ISO 4217 currency code.\",\n          \"example\": \"USD\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"item\",\n        \"shipping\",\n        \"total\",\n        \"currency\"\n      ]\n    },\n    \"total\": {\n      \"description\": \"The total as a label, e.g. `$255.00`.\",\n      \"example\": \"$255.00\",\n      \"type\": \"string\"\n    },\n    \"show_buyer\": {\n      \"description\": \"A suggested reply to the buyer, in Markdown with the links already written as links: the product and its options to pick from, the pay link, or what they got with a receipt link. Buyers have the best experience when agents show it as written.\",\n      \"example\": \"![Vintage Cream and Red Roller Skates](https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X)\\n\\n**Vintage Cream and Red Roller Skates**: $240.00. Classic quad skates crafted with walnut burl heels\\n\\n![Raptor Rush: Browser Edition](https://one-thing-ash0.onrender.com/api/blobs/R9tWc3yN6bJq1zUd)\\n\\n**Raptor Rush: Browser Edition**: $2.99. Grow from Tiny Hatchling to Giant Apex Predator\\n\\nWhich one?\",\n      \"type\": \"string\"\n    },\n    \"agent_name\": {\n      \"description\": \"Who this request was credited to in the seller's stats: a recognised user agent, else the name the agent gave itself (`?agent=`, or the MCP client's name), else the user agent's first word.\",\n      \"example\": \"Grok\",\n      \"type\": \"string\"\n    },\n    \"options\": {\n      \"description\": \"The buyer's pick, one value per option, keyed by option name.\",\n      \"example\": {\n        \"Size\": \"M\",\n        \"Color\": \"Black\"\n      },\n      \"type\": \"object\",\n      \"additionalProperties\": {\n        \"type\": \"string\"\n      }\n    },\n    \"pay_url\": {\n      \"description\": \"Unpaid orders (waiting or declined). The buyer pays here; safe to show in chat.\",\n      \"example\": \"https://one-thing-ash0.onrender.com/o/pX4kR9tVb2nQ7sLe\",\n      \"type\": \"string\"\n    },\n    \"next_step\": {\n      \"description\": \"Unpaid orders. What the agent should do next, in plain words.\",\n      \"example\": \"Show pay_url to the buyer as a link. When they say they've paid, call get_order with order_id.\",\n      \"type\": \"string\"\n    },\n    \"paid_at\": {\n      \"description\": \"Paid orders. When PayPal captured the payment.\",\n      \"example\": \"2026-10-22T02:41:37Z\",\n      \"type\": \"string\",\n      \"format\": \"date-time\"\n    },\n    \"receipt_url\": {\n      \"description\": \"Paid orders. The buyer's thank-you page.\",\n      \"example\": \"https://one-thing-ash0.onrender.com/vintageskates/thanks?order=pX4kR9tVb2nQ7sLe\",\n      \"type\": \"string\"\n    },\n    \"delivery\": {\n      \"description\": \"Paid orders. What the buyer got.\",\n      \"example\": {\n        \"type\": \"access_code\",\n        \"access_code\": \"K7QF-M2XP-9HTD\",\n        \"start_url\": \"https://www.miriogames.com/raptor-rush/?code=K7QF-M2XP-9HTD\"\n      },\n      \"oneOf\": [\n        {\n          \"id\": \"AgentDeliveryAccessCode\",\n          \"title\": \"AgentDeliveryAccessCode\",\n          \"description\": \"A digital product unlocked with an access code.\",\n          \"example\": {\n            \"type\": \"access_code\",\n            \"access_code\": \"K7QF-M2XP-9HTD\",\n            \"start_url\": \"https://www.miriogames.com/raptor-rush/?code=K7QF-M2XP-9HTD\"\n          },\n          \"type\": \"object\",\n          \"properties\": {\n            \"type\": {\n              \"description\": \"Always `access_code`.\",\n              \"example\": \"access_code\",\n              \"type\": \"string\",\n              \"enum\": [\n                \"access_code\"\n              ]\n            },\n            \"access_code\": {\n              \"description\": \"The buyer's code, which unlocks the seller's app or game.\",\n              \"example\": \"K7QF-M2XP-9HTD\",\n              \"type\": \"string\"\n            },\n            \"start_url\": {\n              \"description\": \"The seller's app with the code filled in.\",\n              \"example\": \"https://www.miriogames.com/raptor-rush/?code=K7QF-M2XP-9HTD\",\n              \"type\": \"string\"\n            }\n          },\n          \"required\": [\n            \"type\",\n            \"access_code\"\n          ]\n        },\n        {\n          \"id\": \"AgentDeliveryDownload\",\n          \"title\": \"AgentDeliveryDownload\",\n          \"description\": \"A digital file to download.\",\n          \"example\": {\n            \"type\": \"download\",\n            \"download_url\": \"https://one-thing-ash0.onrender.com/api/download/dl_4mQ8sT2vX9\",\n            \"note\": \"Works 5 times over 14 days.\"\n          },\n          \"type\": \"object\",\n          \"properties\": {\n            \"type\": {\n              \"description\": \"Always `download`.\",\n              \"example\": \"download\",\n              \"type\": \"string\",\n              \"enum\": [\n                \"download\"\n              ]\n            },\n            \"download_url\": {\n              \"description\": \"A private link to the file. It works 5 times over 14 days.\",\n              \"example\": \"https://one-thing-ash0.onrender.com/api/download/dl_4mQ8sT2vX9\",\n              \"type\": \"string\"\n            },\n            \"note\": {\n              \"description\": \"How long the link lasts and how many downloads it allows, in words.\",\n              \"example\": \"Works 5 times over 14 days.\",\n              \"type\": \"string\"\n            }\n          },\n          \"required\": [\n            \"type\",\n            \"download_url\"\n          ]\n        },\n        {\n          \"id\": \"AgentDeliveryShipping\",\n          \"title\": \"AgentDeliveryShipping\",\n          \"description\": \"A physical product shipped to the buyer.\",\n          \"example\": {\n            \"type\": \"shipping\",\n            \"ship_to\": {\n              \"name\": \"Sam Rivera\",\n              \"address\": \"1 Main St, Springfield, IL, 62701, US\"\n            },\n            \"fulfillment\": \"to_ship\",\n            \"tracking\": {\n              \"carrier\": \"USPS\",\n              \"number\": \"9400111899223197428490\"\n            }\n          },\n          \"type\": \"object\",\n          \"properties\": {\n            \"type\": {\n              \"description\": \"Always `shipping`.\",\n              \"example\": \"shipping\",\n              \"type\": \"string\",\n              \"enum\": [\n                \"shipping\"\n              ]\n            },\n            \"fulfillment\": {\n              \"title\": \"Fulfillment\",\n              \"description\": \"`to_ship` until the seller adds tracking, then `shipped`.\",\n              \"example\": \"to_ship\",\n              \"type\": \"string\",\n              \"additionalProperties\": false,\n              \"enum\": [\n                \"to_ship\",\n                \"shipped\"\n              ]\n            },\n            \"ship_to\": {\n              \"id\": \"ShipTo\",\n              \"title\": \"ShipTo\",\n              \"description\": \"Where it ships, from the buyer's PayPal checkout. Null if PayPal didn't share it.\",\n              \"example\": {\n                \"name\": \"Sam Rivera\",\n                \"address\": \"1 Main St, Springfield, IL, 62701, US\"\n              },\n              \"type\": [\n                \"object\",\n                \"null\"\n              ],\n              \"properties\": {\n                \"name\": {\n                  \"description\": \"The recipient's name.\",\n                  \"example\": \"Sam Rivera\",\n                  \"type\": [\n                    \"string\",\n                    \"null\"\n                  ]\n                },\n                \"address\": {\n                  \"description\": \"The address on one line.\",\n                  \"example\": \"1 Main St, Springfield, IL, 62701, US\",\n                  \"type\": \"string\"\n                }\n              }\n            },\n            \"tracking\": {\n              \"id\": \"Tracking\",\n              \"title\": \"Tracking\",\n              \"description\": \"The carrier and tracking number once shipped; null before.\",\n              \"example\": {\n                \"carrier\": \"USPS\",\n                \"number\": \"9400111899223197428490\"\n              },\n              \"type\": [\n                \"object\",\n                \"null\"\n              ],\n              \"properties\": {\n                \"carrier\": {\n                  \"description\": \"The shipping carrier.\",\n                  \"example\": \"USPS\",\n                  \"type\": \"string\"\n                },\n                \"number\": {\n                  \"description\": \"The tracking number.\",\n                  \"example\": \"9400111899223197428490\",\n                  \"type\": \"string\"\n                }\n              }\n            }\n          },\n          \"required\": [\n            \"type\",\n            \"fulfillment\"\n          ]\n        }\n      ]\n    }\n  },\n  \"required\": [\n    \"order_id\",\n    \"status\",\n    \"product\",\n    \"amount\",\n    \"total\"\n  ]\n}"
                example: "{\"order_id\":\"pX4kR9tVb2nQ7sLe\",\"status\":\"awaiting_buyer_approval\",\"product\":\"Vintage Cream and Red Roller Skates\",\"options\":{\"Size\":\"9\"},\"amount\":{\"item\":240,\"shipping\":15,\"total\":255,\"currency\":\"USD\"},\"total\":\"$255.00\",\"pay_url\":\"https://one-thing-ash0.onrender.com/o/pX4kR9tVb2nQ7sLe\",\"next_step\":\"The buyer hasn't paid yet. Give them pay_url; when they say they've paid, call get_order again.\"}"
          '303':
            description: A person clicked the link. Redirect to the order's page (`/o/<order_id>`).
          '404':
            description: No order with that id.
            body:
              application/json:
                schema: |
                  {
                    "id": "ErrorResponse",
                    "title": "ErrorResponse",
                    "description": "An error reply.",
                    "example": {
                      "error": "Choose a photo.",
                      "field": "photo"
                    },
                    "type": "object",
                    "properties": {
                      "error": {
                        "description": "A sentence you can show to a person.",
                        "example": "Order not found.",
                        "type": "string"
                      },
                      "field": {
                        "description": "The form field at fault, when there is one.",
                        "example": "price",
                        "type": "string"
                      },
                      "detail": {
                        "description": "The upstream service's own message, for debugging.",
                        "example": "INSTRUMENT_DECLINED",
                        "type": "string"
                      }
                    },
                    "required": [
                      "error"
                    ]
                  }
