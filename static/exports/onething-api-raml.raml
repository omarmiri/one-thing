              "value"
            ]
          }
        },
        "suggestedPriceUsd": {
          "type": "number"
        },
        "suggestedShippingUsd": {
          "type": "number"
        },
        "imageAlt": {
          "type": "string"
        },
        "heroPrompt": {
          "type": "string"
        }
      },
      "required": [
