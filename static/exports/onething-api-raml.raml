      /orders:
        uriParameters: {}
        /{orderId}:
          /ship:
            uriParameters: {}
            post:
              securedBy:
              - AdminToken
              - PlatformKey
              description: Saves the tracking number and pushes it to PayPal, so the buyer sees it in PayPal.
              headers:
                Content-Type:
                  required: true
                  displayName: Content-Type
                  enum:
                  - application/json
              body:
                application/json:
                  schema: |
                    {
                      "id": "ApiShopsOrdersShipRequest",
                      "title": "ApiShopsOrdersShipRequest",
                      "description": "The carrier and tracking number.",
                      "examples": [
                        {
                          "Id": "usps",
                          "Name": "A listed carrier",
                          "Value": "{\"carrier\":\"USPS\",\"trackingNumber\":\"9400111899223817362315\"}",
                          "ExternalValue": null,
                          "Description": null
                        },
                        {
                          "Id": "other",
                          "Name": "Another carrier",
                          "Value": "{\"carrier\":\"OTHER\",\"carrierName\":\"Canada Post\",\"trackingNumber\":\"7023210039414604\"}",
                          "ExternalValue": null,
                          "Description": null
                        }
                      ],
                      "example": {
                        "carrier": "USPS",
                        "trackingNumber": "9400111899223817362315"
                      },
                      "type": "object",
                      "properties": {
                        "carrier": {
                          "title": "Carrier",
                          "description": "The carrier. `OTHER` needs `carrierName`.",
                          "example": "USPS",
                          "type": "string",
                          "additionalProperties": false,
                          "enum": [
                            "USPS",
                            "UPS",
                            "FEDEX",
                            "DHL",
                            "OTHER"
                          ]
                        },
                        "trackingNumber": {
                          "description": "The carrier's tracking number.",
                          "example": "9400111899223197428490",
                          "type": "string",
                          "minLength": 4,
                          "maxLength": 64
                        },
                        "carrierName": {
                          "description": "Required when `carrier` is `OTHER`.",
                          "example": "Canada Post",
                          "type": "string",
                          "maxLength": 60
                        }
                      },
                      "required": [
                        "carrier",
                        "trackingNumber"
                      ]
                    }
                  example: '{"carrier":"USPS","trackingNumber":"9400111899223817362315"}'
              responses:
                '200':
                  description: Shipped.
                  body:
                    application/json:
                      schema: |
                        {
                          "id": "ApiShopsOrdersShipResponse",
                          "title": "ApiShopsOrdersShipResponse",
                          "description": "The order is marked shipped.",
                          "example": {
                            "ok": true,
                            "synced": true
                          },
                          "type": "object",
                          "properties": {
                            "ok": {
                              "description": "Always `true`.",
                              "example": true,
                              "type": "boolean"
                            },
                            "synced": {
                              "description": "Whether PayPal accepted the tracking number.",
                              "example": true,
                              "type": "boolean"
                            }
                          },
                          "required": [
                            "ok",
                            "synced"
                          ]
                        }
                      example: '{"ok":true,"synced":true}'
                '400':
                  description: Something in the request needs fixing; `error` says what.
                  body:
                    application/json:
                      schema: |
                        {
                          "id": "ErrorResponse",
                          "title": "ErrorResponse",
                          "description": "An error reply.",
                          "example": {
                            "error": "Choose a photo.",
                            "field": "photo"
                          },
                          "type": "object",
                          "properties": {
                            "error": {
                              "description": "A sentence you can show to a person.",
                              "example": "Order not found.",
                              "type": "string"
                            },
                            "field": {
                              "description": "The form field at fault, when there is one.",
                              "example": "price",
                              "type": "string"
                            },
                            "detail": {
                              "description": "The upstream service's own message, for debugging.",
                              "example": "INSTRUMENT_DECLINED",
                              "type": "string"
                            }
                          },
                          "required": [
                            "error"
                          ]
                        }
                      example: '{"error":"Choose a photo."}'
                '404':
                  description: No such shop, or the admin token or API key doesn't match it.
                  body:
                    application/json:
                      schema: |
                        {
                          "id": "ErrorResponse",
                          "title": "ErrorResponse",
                          "description": "An error reply.",
                          "example": {
                            "error": "Choose a photo.",
                            "field": "photo"
                          },
                          "type": "object",
                          "properties": {
                            "error": {
                              "description": "A sentence you can show to a person.",
                              "example": "Order not found.",
                              "type": "string"
                            },
                            "field": {
                              "description": "The form field at fault, when there is one.",
                              "example": "price",
                              "type": "string"
                            },
                            "detail": {
                              "description": "The upstream service's own message, for debugging.",
                              "example": "INSTRUMENT_DECLINED",
                              "type": "string"
                            }
                          },
                          "required": [
                            "error"
                          ]
                        }
                      example: '{"error":"Shop not found."}'
          /refund:
            uriParameters: {}
            post:
              securedBy:
              - AdminToken
              - PlatformKey
              description: "Refunds the whole payment through PayPal and marks the order `refunded`. When PayPal only lets the paid account refund it (the money went to a PayPal email the seller typed in, not a connected account), the reply is a 409 with `refundInPayPal: true`. Refund it in your PayPal account, then call this again with `{\"record\": true}`, which only marks it refunded here. Sends the `order.refunded` event to the shop's Zapier hook."
              headers:
                Content-Type:
                  required: true
                  displayName: Content-Type
                  enum:
                  - application/json
              body:
                application/json:
                  schema: |
                    {
                      "id": "ApiShopsOrdersRefundRequest",
                      "title": "ApiShopsOrdersRefundRequest",
                      "description": "Optional. `record: true` records a refund made in PayPal.",
                      "examples": [
                        {
                          "Id": "refund",
                          "Name": "Refund through PayPal",
                          "Value": "{}",
                          "ExternalValue": null,
                          "Description": null
                        },
                        {
                          "Id": "record",
                          "Name": "Already refunded in PayPal",
                          "Value": "{\"record\":true}",
                          "ExternalValue": null,
                          "Description": null
                        }
                      ],
                      "example": {},
                      "type": "object",
                      "properties": {
                        "record": {
                          "description": "`true`: don't contact PayPal, just record that the seller refunded it themselves.",
                          "type": "boolean",
                          "default": false
                        }
                      }
                    }
                  example: '{}'
              responses:
                '200':
                  description: Refunded.
                  body:
                    application/json:
                      schema: |
                        {
                          "id": "ApiShopsOrdersRefundResponse",
                          "title": "ApiShopsOrdersRefundResponse",
                          "description": "The refund.",
                          "example": {
                            "ok": true,
                            "refundId": "1JU08902781691411"
                          },
                          "type": "object",
                          "properties": {
                            "ok": {
                              "description": "Always `true`.",
                              "example": true,
                              "type": "boolean"
                            },
                            "refundId": {
                              "description": "PayPal's refund id; null when `record` was used.",
                              "example": "1JU08902781691411",
                              "type": [
                                "string",
                                "null"
                              ]
                            }
                          },
                          "required": [
                            "ok"
                          ]
                        }
                      example: '{"ok":true,"refundId":"1JU08902781691411"}'
                '404':
                  description: No such shop or order, or the token doesn't match the shop.
                  body:
                    application/json:
                      schema: |
                        {
                          "id": "ErrorResponse",
                          "title": "ErrorResponse",
                          "description": "An error reply.",
                          "example": {
                            "error": "Choose a photo.",
                            "field": "photo"
                          },
                          "type": "object",
                          "properties": {
                            "error": {
                              "description": "A sentence you can show to a person.",
                              "example": "Order not found.",
                              "type": "string"
                            },
                            "field": {
                              "description": "The form field at fault, when there is one.",
                              "example": "price",
                              "type": "string"
                            },
                            "detail": {
                              "description": "The upstream service's own message, for debugging.",
                              "example": "INSTRUMENT_DECLINED",
                              "type": "string"
                            }
                          },
                          "required": [
                            "error"
                          ]
                        }
                      example: '{"error":"Order not found."}'
                '409':
                  description: Not refundable here; `error` says why.
                  body:
                    application/json:
                      schema: |
                        {
                          "id": "ApiShopsOrdersRefund409Error1",
                          "title": "ApiShopsOrdersRefund409Error1",
                          "description": "Why the order can't be refunded here.",
                          "examples": [
                            {
                              "Id": "notPaid",
                              "Name": "Not a paid order",
                              "Value": "{\"error\":\"Only paid orders can be refunded.\"}",
                              "ExternalValue": null,
                              "Description": null
                            },
                            {
                              "Id": "payee",
                              "Name": "Paid to a typed-in PayPal email",
                              "Value": "{\"error\":\"PayPal only lets the account that was paid refund this. Refund it in your PayPal account (Activity, then this payment, then Refund), then mark it refunded here.\",\"refundInPayPal\":true}",
                              "ExternalValue": null,
                              "Description": null
                            }
                          ],
                          "example": {
                            "error": "Only paid orders can be refunded."
                          },
                          "type": "object",
                          "properties": {
                            "error": {
                              "description": "A sentence you can show to a person.",
                              "example": "Order not found.",
                              "type": "string"
                            },
                            "field": {
                              "description": "The form field at fault, when there is one.",
                              "example": "price",
                              "type": "string"
                            },
                            "detail": {
                              "description": "The upstream service's own message, for debugging.",
                              "example": "INSTRUMENT_DECLINED",
                              "type": "string"
                            },
                            "refundInPayPal": {
                              "description": "Refund it in PayPal yourself, then call again with `record: true`.",
                              "example": true,
                              "type": "boolean"
                            }
                          },
                          "required": [
                            "error"
                          ]
                        }
                      example: '{"error":"Only paid orders can be refunded."}'
        get:
          securedBy:
          - AdminToken
          - PlatformKey
          description: Newest first. Checkouts that were never approved are left out.
          responses:
            '200':
              description: Orders.
              body:
                application/json:
                  schema: |
                    {
                      "description": "Orders, newest first.",
                      "example": [
                        {
                          "id": "pX4kR9tVb2nQ7sLe",
                          "paypal_order_id": "5O190127TN364715T",
                          "status": "paid",
                          "amount_cents": 25500,
                          "shipping_cents": 1500,
                          "currency": "USD",
                          "buyer_email": "buyer@example.com",
                          "buyer_name": "Sam Rivera",
                          "shipping_address": {
                            "address_line_1": "1 Main St",
                            "admin_area_2": "Springfield",
                            "admin_area_1": "IL",
                            "postal_code": "62701",
                            "country_code": "US"
                          },
                          "capture_id": "3C679366HH908993F",
