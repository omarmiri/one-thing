          "type": [
            "string",
            "null"
          ]
        },
        "buyer_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "shipping_address": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        },
        "capture_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "carrier": {
          "type": [
            "string",
            "null"
          ]
        },
        "tracking_number": {
          "type": [
            "string",
            "null"
          ]
        },
        "tracking_synced": {
          "type": "boolean"
        },
        "downloads": {
          "type": "integer",
          "format": "int32"
        },
        "access_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "code_uses": {
          "type": "integer",
          "format": "int32"
        },
        "code_last_used_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "channel": {
          "title": "Channel",
          "description": "`agent` for orders an AI agent placed (MCP or an order link).",
          "type": "string",
          "additionalProperties": false,
          "enum": [
            "web",
            "agent"
          ]
        },
        "agent": {
          "description": "The agent credited with an agent order, such as `Grok`.",
          "example": "Grok",
          "type": [
            "string",
            "null"
          ]
        },
        "refund_id": {
          "description": "PayPal's refund id, once refunded through OneThing.",
          "type": [
            "string",
            "null"
          ]
        },
        "refunded_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "options": {
          "description": "The buyer's pick, one value per option, keyed by option name (see `Choice`).",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        },
        "paid_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "status",
        "amount_cents",
        "currency",
        "fulfillment_status"
      ]
    }
