      /file:
        uriParameters: {}
        post:
          securedBy:
          - AdminToken
          - PlatformKey
          description: Uploads or replaces a digital product's file, up to 25 MB. Each paid order gets a download link for it.
          body:
            multipart/form-data:
              formParameters:
                file:
                  description: Up to 25 MB.
                  type: file
                  required: true
                  displayName: file
