nalValue\": null,\n      \"Description\": null\n    },\n    {\n      \"Id\": \"toolError\",\n      \"Name\": \"A tool error the model can read\",\n      \"Value\": \"{\\\"jsonrpc\\\":\\\"2.0\\\",\\\"id\\\":2,\\\"result\\\":{\\\"content\\\":[{\\\"type\\\":\\\"text\\\",\\\"text\\\":\\\"{\\\\n  \\\\\\\"error\\\\\\\": \\\\\\\"9 / Black is sold out.\\\\\\\"\\\\n}\\\"}],\\\"isError\\\":true}}\",\n      \"ExternalValue\": null,\n      \"Description\": null\n    }\n  ],\n  \"example\": {\n    \"jsonrpc\": \"2.0\",\n    \"id\": 1,\n    \"result\": {\n      \"content\": [\n        {\n          \"type\": \"text\",\n          \"text\": \"{\\n  \\\"show_buyer\\\": \\\"![Vintage Cream and Red Roller Skates](https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X)\\\\n\\\\n**Vintage Cream and Red Roller Skates**: $240.00. Classic quad skates crafted with walnut burl heels\\\\n\\\\nWant it?\\\",\\n  \\\"shops\\\": [\\n    {\\n      \\\"shop\\\": \\\"vintageskates\\\",\\n      \\\"name\\\": \\\"Vintage Cream and Red Roller Skates\\\",\\n      \\\"kind\\\": \\\"physical\\\",\\n      \\\"headline\\\": \\\"Classic quad skates crafted with walnut burl heels\\\",\\n      \\\"price\\\": \\\"$240.00\\\",\\n      \\\"image\\\": \\\"https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X\\\",\\n      \\\"url\\\": \\\"https://one-thing-ash0.onrender.com/vintageskates\\\"\\n    }\\n  ],\\n  \\\"agent_name\\\": \\\"Claude\\\"\\n}\"\n        }\n      ],\n      \"structuredContent\": {\n        \"show_buyer\": \"![Vintage Cream and Red Roller Skates](https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X)\\n\\n**Vintage Cream and Red Roller Skates**: $240.00. Classic quad skates crafted with walnut burl heels\\n\\nWant it?\",\n        \"shops\": [\n          {\n            \"shop\": \"vintageskates\",\n            \"name\": \"Vintage Cream and Red Roller Skates\",\n            \"kind\": \"physical\",\n            \"headline\": \"Classic quad skates crafted with walnut burl heels\",\n            \"price\": \"$240.00\",\n            \"image\": \"https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X\",\n            \"url\": \"https://one-thing-ash0.onrender.com/vintageskates\"\n          }\n        ],\n        \"agent_name\": \"Claude\"\n      },\n      \"isError\": false\n    }\n  },\n  \"oneOf\": [\n    {\n      \"id\": \"JsonRpcResponse\",\n      \"title\": \"JsonRpcResponse\",\n      \"description\": \"A JSON-RPC 2.0 reply from the MCP server.\",\n      \"example\": {\n        \"jsonrpc\": \"2.0\",\n        \"id\": 1,\n        \"result\": {\n          \"content\": [\n            {\n              \"type\": \"text\",\n              \"text\": \"{\\\"shop\\\": \\\"vintageskates\\\"}\"\n            }\n          ],\n          \"isError\": false\n        }\n      },\n      \"type\": \"object\",\n      \"properties\": {\n        \"jsonrpc\": {\n          \"description\": \"Always `2.0`.\",\n          \"example\": \"2.0\",\n          \"type\": \"string\",\n          \"enum\": [\n            \"2.0\"\n          ]\n        },\n        \"id\": {\n          \"description\": \"The request's `id`.\",\n          \"example\": \"1\",\n          \"oneOf\": [\n            {\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"integer\",\n              \"format\": \"int32\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ]\n        },\n        \"result\": {\n          \"description\": \"For `tools/call`: `content` (the answer as JSON text), `structuredContent` (the same object) and `isError`.\",\n          \"example\": {\n            \"isError\": false\n          },\n          \"type\": \"object\"\n        },\n        \"error\": {\n          \"id\": \"Error\",\n          \"title\": \"Error\",\n          \"description\": \"Present when the call failed.\",\n          \"example\": {\n            \"code\": -32601,\n            \"message\": \"Method not found\"\n          },\n          \"type\": \"object\",\n          \"properties\": {\n            \"code\": {\n              \"description\": \"The JSON-RPC error code.\",\n              \"example\": -32601,\n              \"type\": \"integer\",\n              \"format\": \"int32\"\n            },\n            \"message\": {\n              \"description\": \"What went wrong.\",\n              \"example\": \"Method not found\",\n              \"type\": \"string\"\n            }\n          },\n          \"required\": [\n            \"code\",\n            \"message\"\n          ]\n        }\n      },\n      \"required\": [\n        \"jsonrpc\",\n        \"id\"\n      ]\n    },\n    {\n      \"example\": [\n        {\n          \"jsonrpc\": \"2.0\",\n          \"id\": 1,\n          \"result\": {\n            \"content\": [\n              {\n                \"type\": \"text\",\n                \"text\": \"{\\\"shop\\\": \\\"vintageskates\\\"}\"\n              }\n            ],\n            \"isError\": false\n          }\n        }\n      ],\n      \"type\": \"array\",\n      \"items\": {\n        \"id\": \"JsonRpcResponse\",\n        \"title\": \"JsonRpcResponse\",\n        \"description\": \"A JSON-RPC 2.0 reply from the MCP server.\",\n        \"example\": {\n          \"jsonrpc\": \"2.0\",\n          \"id\": 1,\n          \"result\": {\n            \"content\": [\n              {\n                \"type\": \"text\",\n                \"text\": \"{\\\"shop\\\": \\\"vintageskates\\\"}\"\n              }\n            ],\n            \"isError\": false\n          }\n        },\n        \"type\": \"object\",\n        \"properties\": {\n          \"jsonrpc\": {\n            \"description\": \"Always `2.0`.\",\n            \"example\": \"2.0\",\n            \"type\": \"string\",\n            \"enum\": [\n              \"2.0\"\n            ]\n          },\n          \"id\": {\n            \"description\": \"The request's `id`.\",\n            \"example\": \"1\",\n            \"oneOf\": [\n   