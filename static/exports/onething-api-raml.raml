- AgentProduct: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "AgentProduct",
      "title": "AgentProduct",
      "description": "A live shop as an AI agent sees it. Recommendations have `offers`; everything else has `price` and is bought with `create_order`.",
      "type": "object",
      "properties": {
        "shop": {
          "description": "The link name, which the MCP tools take as `shop`.",
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "title": "Kind1",
          "type": "string",
          "additionalProperties": false,
          "enum": [
            "physical",
            "digital",
            "referral"
          ]
        },
        "headline": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "highlights": {
          "description": "",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "details": {
          "description": "",
          "type": "array",
          "items": {
            "id": "Detail",
            "title": "Detail",
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "label",
              "value"
            ]
          }
        },
        "faq": {
          "description": "",
          "type": "array",
          "items": {
            "id": "Faq",
            "title": "Faq",
            "type": "object",
            "properties": {
              "q": {
                "type": "string"
              },
              "a": {
                "type": "string"
              }
            },
            "required": [
              "q",
              "a"
            ]
          }
        },
        "images": {
          "description": "",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "how_to_buy": {
          "type": "string"
        },
        "price": {
          "id": "AgentMoney",
          "title": "AgentMoney",
          "type": "object",
          "properties": {
            "amount": {
              "example": 48.5,
              "type": "number"
            },
            "currency": {
              "example": "USD",
              "type": "string"
            },
            "label": {
              "example": "$48.50",
              "type": "string"
            }
          },
          "required": [
            "amount",
            "currency"
          ]
        },
        "shipping": {
          "description": "Physical products only.",
          "oneOf": [
            {
              "id": "Shipping",
              "title": "Shipping",
              "type": "object",
              "properties": {
                "amount": {
                  "type": "number"
                },
                "currency": {
                  "type": "string"
                },
                "ships_to": {
                  "description": "Country codes; empty means anywhere PayPal ships.",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "amount",
                "currency",
                "ships_to"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "total": {
          "$ref": "AgentMoney"
        },
        "delivery": {
          "example": "Shipped. PayPal collects the buyer's address at checkout.",
          "type": "string"
        },
        "availability": {
          "examples": [
            {
              "Id": "Untitled Example1",
              "Name": null,
              "Value": "in_stock",
              "ExternalValue": null,
              "Description": null
            },
            {
              "Id": "Untitled Example2",
              "Name": null,
              "Value": "in_stock (3 left)",
              "ExternalValue": null,
              "Description": null
            },
            {
              "Id": "Untitled Example3",
              "Name": null,
              "Value": "sold_out",
              "ExternalValue": null,
              "Description": null
            }
          ],
          "example": "in_stock",
          "type": "string"
        },
        "options": {
          "description": "Pass one value per option to `create_order`.",
          "type": "array",
          "items": {
            "id": "Option1",
            "title": "Option1",
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "values": {
                "description": "",
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "name",
              "values"
            ]
          }
        },
        "variants": {
          "description": "",
          "type": "array",
          "items": {
            "id": "Variant",
            "title": "Variant",
            "type": "object",
            "properties": {
              "choice": {
                "description": "The buyer's pick, one value per option, keyed by option name.",
                "example": {
                  "Size": "M",
                  "Color": "Black"
                },
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "availability": {
                "type": "string"
              }
            },
            "required": [
              "choice",
              "availability"
            ]
          }
        },
        "offers": {
          "description": "Recommendations only. Bought at the retailer.",
          "type": "array",
          "items": {
            "id": "Offer1",
            "title": "Offer1",
            "type": "object",
            "properties": {
              "retailer": {
                "type": "string"
              },
              "price": {
                "type": "number"
              },
              "currency": {
                "type": "string"
              },
              "in_stock": {
                "type": "boolean"
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "retailer",
              "price",
              "currency",
              "in_stock",
              "url"
            ]
          }
        },
        "mcp_server": {
          "description": "The MCP server to order through (`getAgentProduct` only).",
          "type": "string"
        }
      },
      "required": [
        "shop",
        "url",
        "name",
        "kind",
        "headline",
        "description",
        "highlights",
        "details",
        "faq",
        "images",
        "how_to_buy"
      ]
    }
