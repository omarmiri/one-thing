- MissingFact: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "MissingFact",
      "title": "MissingFact",
      "description": "One question to answer.",
      "example": {
        "label": "Size",
        "question": "What size are the skates?",
        "placeholder": "US women's 8"
      },
      "type": "object",
      "properties": {
        "label": {
          "description": "The product detail it becomes.",
          "example": "Size",
          "type": "string"
        },
        "question": {
          "description": "The question, for the seller.",
          "example": "What size are the skates?",
          "type": "string"
        },
        "placeholder": {
          "description": "An example answer.",
          "example": "US women's 8",
          "type": "string"
        }
      },
      "required": [
        "label",
        "question",
        "placeholder"
      ]
    }
- Offer: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "Offer",
      "title": "Offer",
      "description": "One store's offer.",
      "example": {
        "domain": "rei.com",
        "url": "https://buy.trychannel3.com/r/abc123",
        "price": 240,
        "currency": "USD",
        "inStock": true,
        "commission": 0.08
      },
      "type": "object",
      "properties": {
        "domain": {
          "description": "The store's domain.",
          "example": "rei.com",
          "type": "string"
        },
        "url": {
          "description": "A Channel3-tracked buy link, credited to this shop.",
          "example": "https://buy.trychannel3.com/r/abc123",
          "type": "string"
        },
        "price": {
          "description": "The store's price.",
          "example": 240,
          "type": "number"
        },
        "currency": {
          "description": "ISO 4217 currency code.",
          "example": "USD",
          "type": "string"
        },
        "inStock": {
          "description": "Whether the store has it in stock.",
          "example": true,
          "type": "boolean"
        },
        "commission": {
          "description": "Maximum commission rate, 0–1 (0.08 = 8%).",
          "example": 0.08,
          "type": "number"
        }
      },
      "required": [
        "domain",
        "url",
        "price",
        "currency",
        "inStock",
        "commission"
      ]
    }
- Offer1: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "Offer1",
      "title": "Offer1",
      "description": "One store's offer.",
      "example": {
        "retailer": "rei.com",
        "price": 240,
        "currency": "USD",
        "in_stock": true,
        "url": "https://buy.trychannel3.com/r/abc123"
      },
      "type": "object",
      "properties": {
        "retailer": {
          "description": "The store.",
          "example": "rei.com",
          "type": "string"
        },
        "price": {
          "description": "The store's price.",
          "example": 240,
          "type": "number"
        },
        "currency": {
          "description": "ISO 4217 currency code.",
          "example": "USD",
          "type": "string"
        },
        "in_stock": {
          "description": "Whether the store has it in stock.",
          "example": true,
          "type": "boolean"
        },
        "url": {
          "description": "A tracked buy link at that store.",
          "example": "https://buy.trychannel3.com/r/abc123",
          "type": "string"
        }
      },
      "required": [
        "retailer",
        "price",
        "currency",
        "in_stock",
        "url"
      ]
    }
- Ok: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "Ok",
      "title": "Ok",
      "description": "Confirms the change.",
      "type": "object",
      "properties": {
        "ok": {
          "description": "Always `true`.",
          "example": true,
          "type": "boolean"
        }
      },
      "required": [
        "ok"
      ]
    }
- Option: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "Option",
      "title": "Option",
      "description": "A suggested option.",
      "example": {
        "name": "Size",
        "kind": "size",
        "values": [
          {
            "label": "S"
          },
          {
            "label": "M"
          },
          {
            "label": "L"
          }
        ]
      },
      "type": "object",
      "properties": {
        "name": {
          "description": "What the buyer is choosing.",
          "example": "Size",
          "type": "string",
          "maxLength": 20
        },
        "kind": {
          "title": "Kind",
          "description": "`color` shows swatches, and the photo of the picked colour.",
          "example": "size",
          "type": "string",
          "additionalProperties": false,
          "enum": [
            "size",
            "color",
            "other"
          ]
        },
        "values": {
          "description": "The values to pick from.",
          "example": [
            {
              "label": "S"
            },
            {
              "label": "M"
            },
            {
              "label": "L"
            }
          ],
          "type": "array",
          "items": {
            "id": "OptionValue",
            "title": "OptionValue",
            "description": "One value of an option.",
            "example": {
              "label": "M",
              "hex": "#14171a",
              "photo": "zrySajNyao6_j11x"
            },
            "type": "object",
            "properties": {
              "label": {
                "description": "What the buyer sees and picks.",
                "example": "M",
                "type": "string",
                "maxLength": 30
              },
              "hex": {
                "description": "A colour as `#rrggbb`.",
                "example": "#14171a",
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "photo": {
                "description": "Colours: the shop photo (id) that shows this colour. See `matchColorPhotos`.",
                "example": "zrySajNyao6_j11x",
                "type": "string"
              }
            },
            "required": [
              "label"
            ]
          },
          "minItems": 1,
          "maxItems": 12
        },
        "fromSeller": {
          "description": "The seller's description or photo named these values; otherwise they're a guess.",
          "example": false,
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "kind",
        "values"
      ]
    }
- Option1: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "Option1",
      "title": "Option1",
      "description": "One option and its values.",
      "example": {
        "name": "Size",
        "values": [
          "7",
          "8",
          "9"
        ]
      },
      "type": "object",
      "properties": {
        "name": {
          "description": "The option's name, which is also its query parameter on `order_url`.",
          "example": "Vintage Cream and Red Roller Skates",
          "type": "string"
        },
        "values": {
          "description": "The values the buyer can pick.",
          "example": [
            "7",
            "8",
            "9"
          ],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "name",
        "values"
      ]
    }
- Order1: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "Order1",
      "title": "Order1",
      "description": "The order.",
      "example": {
        "id": "pX4kR9tVb2nQ7sLe",
        "paypal_order_id": "5O190127TN364715T",
        "amount": "255.00",
        "currency": "USD",
        "buyer_name": "Sam Rivera",
        "buyer_email": "sam@example.com",
        "shipping_address": {
          "address_line_1": "1 Main St",
          "admin_area_2": "Springfield",
          "admin_area_1": "IL",
          "postal_code": "62701",
          "country_code": "US"
        },
        "fulfillment_status": "to_ship",
        "tracking_number": "9400111899223197428490",
        "carrier": "USPS"
      },
      "type": "object",
      "properties": {
        "id": {
          "description": "OneThing's order id.",
          "example": "pX4kR9tVb2nQ7sLe",
          "type": "string"
        },
        "paypal_order_id": {
          "description": "PayPal's order id.",
          "example": "5O190127TN364715T",
          "type": [
            "string",
            "null"
          ]
        },
        "amount": {
          "description": "The total, as a decimal string.",
          "example": "2.99",
          "type": "string"
        },
        "currency": {
          "description": "ISO 4217 currency code.",
          "example": "USD",
          "type": "string"
        },
        "buyer_name": {
          "description": "The buyer's name, from PayPal.",
          "example": "Sam Rivera",
          "type": [
            "string",
            "null"
          ]
        },
        "buyer_email": {
          "description": "The buyer's email, from PayPal.",
          "example": "sam@example.com",
          "type": [
            "string",
            "null"
          ]
        },
        "shipping_address": {
          "description": "Physical orders: the address, by field.",
          "example": {
            "address_line_1": "1 Main St",
            "admin_area_2": "Springfield",
            "admin_area_1": "IL",
            "postal_code": "62701",
            "country_code": "US"
          },
          "type": [
            "object",
            "null"
          ]
        },
        "fulfillment_status": {
          "description": "As in `Order.fulfillment_status`.",
          "example": "to_ship",
          "type": "string"
        },
        "tracking_number": {
          "description": "The tracking number, once shipped.",
          "example": "9400111899223197428490",
          "type": [
            "string",
            "null"
          ]
        },
        "carrier": {
          "description": "The carrier, once shipped.",
          "example": "USPS",
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
- Palette: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "Palette",
      "title": "Palette",
      "description": "The page colours, taken from the photo. Text colours are checked for contrast.",
      "example": {
        "background": "#f7f1e8",
        "surface": "#ffffff",
        "text": "#1f1a17",
        "muted": "#6b625b",
        "accent": "#b3262d",
        "accentText": "#ffffff"
      },
      "type": "object",
      "properties": {
        "background": {
          "description": "A colour as `#rrggbb`.",
          "example": "#14171a",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "surface": {
          "description": "A colour as `#rrggbb`.",
          "example": "#14171a",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "text": {
          "description": "A colour as `#rrggbb`.",
          "example": "#14171a",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "muted": {
          "description": "A colour as `#rrggbb`.",
          "example": "#14171a",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "accent": {
          "description": "A colour as `#rrggbb`.",
          "example": "#14171a",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "accentText": {
          "description": "A colour as `#rrggbb`.",
          "example": "#14171a",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "required": [
        "background",
        "surface",
        "text",
        "muted",
        "accent",
        "accentText"
      ]
    }
- Photo: "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"id\": \"Photo\",\n  \"title\": \"Photo\",\n  \"description\": \"One photo.\",\n  \"example\": {\n    \"id\": \"LFRvGuTU3D8i334X\",\n    \"url\": \"/api/blobs/LFRvGuTU3D8i334X\"\n  },\n  \"type\": \"object\",\n  \"properties\": {\n    \"id\": {\n      \"description\": \"The photo's id, for `getImage`, `setPhotoOrder` and colour matching.\",\n      \"example\": \"LFRvGuTU3D8i334X\",\n      \"type\": \"string\"\n    },\n    \"url\": {\n      \"description\": \"Public image URL on this site.\",\n      \"example\": \"/api/blobs/LFRvGuTU3D8i334X\",\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"id\",\n    \"url\"\n  ]\n}"
- ProductType: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "title": "ProductType",
      "description": "`referral` only for shops created from Channel3.",
      "example": "physical",
      "type": "string",
      "additionalProperties": false,
      "enum": [
        "physical",
        "digital",
        "referral"
      ]
    }
- ProductType1: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "title": "ProductType1",
      "description": "`physical` ships, `digital` downloads or unlocks, `referral` recommends a Channel3 product.",
      "example": "physical",
      "type": "string",
      "additionalProperties": false,
      "enum": [
        "physical",
        "digital",
        "referral"
      ]
    }
- ProductType2: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "title": "ProductType2",
      "description": "What the AI decided the product is.",
      "example": "physical",
      "type": "string",
      "additionalProperties": false,
      "enum": [
        "digital",
        "physical"
      ]
    }
- ProductType3: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "title": "ProductType3",
      "description": "`physical`, `digital` or `referral`.",
      "example": "physical",
      "type": "string",
      "additionalProperties": false,
      "enum": [
        "physical",
        "digital",
        "referral"
      ]
    }
- Shipping: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "Shipping",
      "title": "Shipping",
      "description": "Shipping cost and destinations.",
      "example": {
        "amount": 15,
        "currency": "USD",
        "ships_to": [
          "US",
          "CA"
        ]
      },
      "type": "object",
      "properties": {
        "amount": {
          "description": "Shipping cost per order.",
          "example": 15,
          "type": "number"
        },
        "currency": {
          "description": "ISO 4217 currency code.",
          "example": "USD",
          "type": "string"
        },
        "ships_to": {
          "description": "Country codes; empty means anywhere PayPal ships.",
          "example": [
            "US",
            "CA"
          ],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "amount",
        "currency",
        "ships_to"
      ]
    }
- ShipTo: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ShipTo",
      "title": "ShipTo",
      "description": "Where it ships, from the buyer's PayPal checkout. Null if PayPal didn't share it.",
      "example": {
        "name": "Sam Rivera",
        "address": "1 Main St, Springfield, IL, 62701, US"
      },
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "name": {
          "description": "The recipient's name.",
          "example": "Sam Rivera",
          "type": [
            "string",
            "null"
          ]
        },
        "address": {
          "description": "The address on one line.",
          "example": "1 Main St, Springfield, IL, 62701, US",
          "type": "string"
        }
      }
    }
- Shop1: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "Shop1",
      "title": "Shop1",
      "description": "The shop the order belongs to.",
      "example": {
        "slug": "vintageskates",
        "name": "Vintage Cream and Red Roller Skates",
        "url": "https://one-thing-ash0.onrender.com/vintageskates"
      },
      "type": "object",
      "properties": {
        "slug": {
          "description": "The shop's link name.",
          "example": "vintageskates",
          "type": "string"
        },
        "name": {
          "description": "The product's name.",
          "example": "Vintage Cream and Red Roller Skates",
          "type": "string"
        },
        "url": {
          "description": "The shop page.",
          "example": "https://one-thing-ash0.onrender.com/vintageskates",
          "type": "string"
        }
      }
    }
- ShopPhotos: "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"id\": \"ShopPhotos\",\n  \"title\": \"ShopPhotos\",\n  \"description\": \"The shop's photos.\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"photos\": {\n      \"description\": \"Every photo, the cover first.\",\n      \"example\": [\n        {\n          \"id\": \"LFRvGuTU3D8i334X\",\n          \"url\": \"/api/blobs/LFRvGuTU3D8i334X\"\n        }\n      ],\n      \"type\": \"array\",\n      \"items\": {\n        \"id\": \"Photo\",\n        \"title\": \"Photo\",\n        \"description\": \"One photo.\",\n        \"example\": {\n          \"id\": \"LFRvGuTU3D8i334X\",\n          \"url\": \"/api/blobs/LFRvGuTU3D8i334X\"\n        },\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"description\": \"The photo's id, for `getImage`, `setPhotoOrder` and colour matching.\",\n            \"example\": \"LFRvGuTU3D8i334X\",\n            \"type\": \"string\"\n          },\n          \"url\": {\n            \"description\": \"Public image URL on this site.\",\n            \"example\": \"/api/blobs/LFRvGuTU3D8i334X\",\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"id\",\n          \"url\"\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"photos\"\n  ]\n}"
- Source: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "title": "Source",
      "description": "What the shop starts from: a photo (with an optional description), a product link, or a Channel3 product to recommend.",
      "example": "photo",
      "type": "string",
      "additionalProperties": false,
      "enum": [
        "photo",
        "link",
        "channel3"
      ]
    }
- Status: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "title": "Status",
      "description": "`live` publishes the shop; `draft` takes it down.",
      "example": "draft",
      "type": "string",
      "additionalProperties": false,
      "enum": [
        "draft",
        "live"
      ]
    }
- Status1: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "title": "Status1",
      "description": "`draft` until the seller goes live; only `live` shops take orders.",
      "example": "draft",
      "type": "string",
      "additionalProperties": false,
      "enum": [
        "draft",
        "live"
      ]
    }
- Status2: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "title": "Status2",
      "description": "`declined`: PayPal declined it, nothing charged, the buyer can open `pay_url` again. `sold_out`: it sold out before the payment was captured. `expired`: the PayPal checkout expired; create a new order. `failed`: PayPal couldn't be reached; ask again.",
      "example": "awaiting_buyer_approval",
      "type": "string",
      "additionalProperties": false,
      "enum": [
        "awaiting_buyer_approval",
        "paid",
        "declined",
        "sold_out",
        "expired",
        "failed"
      ]
    }
- Status3: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "title": "Status3",
      "description": "`draft` until the seller goes live.",
      "example": "draft",
      "type": "string",
      "additionalProperties": false,
      "enum": [
        "draft",
        "live"
      ]
    }
- Status4: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "title": "Status4",
      "description": "`created` until paid; `failed` if PayPal declined; `refunded` after a refund.",
      "example": "created",
      "type": "string",
      "additionalProperties": false,
      "enum": [
        "created",
        "paid",
        "failed",
        "refunded"
      ]
    }
- status5: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "title": "status5",
      "description": "Only shops with this status, e.g. `live` for a public catalog.",
      "type": "string",
      "additionalProperties": false,
      "enum": [
        "draft",
        "live"
      ]
    }
- Status6: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "title": "Status6",
      "description": "`pending` until the buyer approves at PayPal.",
      "example": "pending",
      "type": "string",
      "additionalProperties": false,
      "enum": [
        "pending"
      ]
    }
- Tracking: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "Tracking",
      "title": "Tracking",
      "description": "The carrier and tracking number once shipped; null before.",
      "example": {
        "carrier": "USPS",
        "number": "9400111899223197428490"
      },
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "carrier": {
          "description": "The shipping carrier.",
          "example": "USPS",
          "type": "string"
        },
        "number": {
          "description": "The tracking number.",
          "example": "9400111899223197428490",
          "type": "string"
        }
      }
    }
- Type: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "title": "Type",
      "description": "`physical` ships, `digital` is a file or an access code, `auto` lets the AI decide.",
      "type": "string",
      "additionalProperties": false,
      "enum": [
        "auto",
        "physical",
        "digital"
      ]
    }
- Variant: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "Variant",
      "title": "Variant",
      "description": "One combination of option values.",
      "example": {
        "choice": {
          "Size": "M",
          "Color": "Black"
        },
        "availability": "in_stock (3 left)",
        "order_url": "https://one-thing-ash0.onrender.com/vintageskates/buy?Size=9"
      },
      "type": "object",
      "properties": {
        "choice": {
          "description": "The buyer's pick, one value per option, keyed by option name.",
          "example": {
            "Size": "M",
            "Color": "Black"
          },
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "availability": {
          "description": "`in_stock`, `in_stock (N left)` or `sold_out`.",
          "example": "in_stock (3 left)",
          "type": "string"
        },
        "order_url": {
          "description": "`orderByLink` for this pick. Left out when it's sold out.",
          "example": "https://one-thing-ash0.onrender.com/vintageskates/buy?Size=9",
          "type": "string"
        }
      },
      "required": [
        "choice",
        "availability"
      ]
    }
- view: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "title": "view",
      "description": "`json` keeps the JSON for a person opening the link in a browser.",
      "type": "string",
      "additionalProperties": false,
      "enum": [
        "json"
      ]
    }
securitySchemes:
- AdminToken:
    description: The shop's admin token, returned once by `createShop`. Keep it secret.
    type: x-custom
    describedBy:
      headers:
        x-admin-token:
          description: The shop's admin token, returned once by `createShop`. Keep it secret.
          type: string
          required: true
          displayName: x-admin-token
/o/{orderId}:
  uriParameters:
    orderId:
      description: The `order_id` from the MCP `create_order` tool.
      type: string
      example: pX4kR9tVb2nQ7sLe
      required: true
      displayName: orderId
  get:
    description: The `pay_url` an agent gives the buyer. It redirects to PayPal's payment page for the order, so PayPal's checkout token never passes through the agent (agent platforms hide such tokens as secrets). A paid order redirects to its thank-you page; an expired checkout goes back to the shop page.
    responses:
      '303':
        description: Redirect to PayPal, the thank-you page or the shop page.
      '404':
        description: No order with that id.
        body:
          text/plain:
            schema: |
              {
                "description": "A short message.",
                "example": "Order not found.",
                "type": "string"
              }
            example: Order not found.
/api:
  /shops:
    /{slug}:
      uriParameters:
        slug:
          description: The shop's link name (current or former).
          type: string
          example: vintageskates
          required: true
          displayName: slug
      /refine:
        uriParameters: {}
        post:
          securedBy:
          - AdminToken
          - PlatformKey
          description: '"Make it warmer", "shorter copy", "more premium". Gemini edits the design spec.'
          headers:
            Content-Type:
              required: true
              displayName: Content-Type
              enum:
              - application/json
          body:
            application/json:
              schema: |
                {
                  "id": "ApiShopsRefineRequest",
                  "title": "ApiShopsRefineRequest",
                  "description": "The design change, in words.",
                  "example": {
                    "instruction": "Make it feel more premium"
                  },
                  "type": "object",
                  "properties": {
                    "instruction": {
                      "description": "What to change, e.g. \"make it feel more premium\".",
                      "example": "Make it feel more premium",
                      "type": "string",
                      "maxLength": 500
                    }
                  },
                  "required": [
                    "instruction"
                  ]
                }
              example: '{"instruction":"Make it feel more premium"}'
          responses:
            '200':
              description: The new design.
              body:
                application/json:
                  schema: |
                    {
                      "id": "ApiShopsRefineResponse",
                      "title": "ApiShopsRefineResponse",
                      "description": "The redesigned page.",
                      "example": {
                        "spec": {
                          "productType": "physical",
                          "productName": "Vintage Cream and Red Roller Skates",
                          "layout": "editorial",
                          "palette": {
                            "background": "#f6efe4",
                            "surface": "#fffaf2",
                            "text": "#2b1d14",
                            "muted": "#7a6455",
                            "accent": "#b3261e",
                            "accentText": "#ffffff"
                          },
                          "fonts": {
                            "heading": "Playfair Display",
                            "body": "Inter"
                          },
                          "eyebrow": "One pair, restored",
                          "headline": "Classic quad skates crafted with walnut burl heels",
                          "subheadline": "A vintage pair of skates featuring cream leather, bold red trim, and durable quad wheels.",
                          "story": "Each pair combines soft cream leather with distinct red accents and a sculpted walnut burl heel base.",
                          "bullets": [
                            "Handmade cream leather upper with rich red trim",
                            "Sculpted walnut burl heel structure for stability"
                          ],
                          "details": [
                            {
                              "label": "Materials",
                              "value": "Leather upper, walnut burl heel, rubber wheels"
                            }
                          ],
                          "faq": [
                            {
                              "q": "Are these suitable for outdoor skating?",
                              "a": "Yes, on indoor rink floors and paved outdoor paths."
                            }
                          ],
                          "ctaLabel": "Buy the skates",
                          "suggestedPriceUsd": 240,
                          "suggestedShippingUsd": 15,
                          "imageAlt": "Cream leather quad roller skates with red trim"
                        }
                      },
                      "type": "object",
                      "properties": {
                        "spec": {
                          "id": "DesignSpec",
                          "title": "DesignSpec",
                          "description": "What Gemini designed. OneThing's templates render it; Gemini never writes HTML.",
                          "example": {
                            "productType": "physical",
                            "productName": "Vintage Cream and Red Roller Skates",
                            "layout": "bold-hero",
                            "palette": {
                              "background": "#f7f1e8",
                              "surface": "#ffffff",
                              "text": "#1f1a17",
                              "muted": "#6b625b",
                              "accent": "#b3262d",
                              "accentText": "#ffffff"
                            },
                            "fonts": {
                              "heading": "Playfair Display",
                              "body": "Inter"
                            },
                            "eyebrow": "One pair, restored",
                            "headline": "Classic quad skates crafted with walnut burl heels",
                            "subheadline": "A vintage pair of skates with cream leather, bold red trim and quad wheels.",
                            "story": "Each pair combines soft cream leather with distinct red accents and a sculpted walnut burl heel base.",
                            "bullets": [
