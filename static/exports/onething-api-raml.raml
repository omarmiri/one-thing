              "enum": [
                "bold-hero",
                "editorial",
                "minimal",
                "playful"
              ]
            },
            "palette": {
              "id": "Palette",
              "title": "Palette",
              "type": "object",
              "properties": {
                "background": {
                  "example": "#14171a",
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "surface": {
                  "example": "#14171a",
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "text": {
                  "example": "#14171a",
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "muted": {
                  "example": "#14171a",
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "accent": {
                  "example": "#14171a",
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "accentText": {
                  "example": "#14171a",
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                }
              },
              "required": [
                "background",
                "surface",
                "text",
                "muted",
                "accent",
                "accentText"
              ]
            },
            "fonts": {
              "id": "Fonts",
              "title": "Fonts",
              "type": "object",
              "properties": {
                "heading": {
                  "type": "string"
                },
                "body": {
                  "type": "string"
                }
              },
              "required": [
                "heading",
                "body"
              ]
            },
            "headline": {
              "type": "string"
            },
            "bullets": {
              "description": "",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "faq": {
              "description": "",
              "type": "array",
              "items": {
                "id": "Faq",
                "title": "Faq",
                "type": "object",
                "properties": {
                  "q": {
                    "type": "string"
                  },
                  "a": {
                    "type": "string"
                  }
                },
                "required": [
                  "q",
                  "a"
                ]
              }
            },
            "ctaLabel": {
              "type": "string"
            },
            "eyebrow": {
              "type": "string"
            },
            "subheadline": {
              "type": "string"
            },
            "story": {
              "type": "string"
            },
            "details": {
              "description": "",
              "type": "array",
              "items": {
                "id": "Detail",
                "title": "Detail",
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string"
                  }
                },
                "required": [
                  "label",
                  "value"
                ]
              }
            },
            "suggestedPriceUsd": {
              "type": "number"
            },
            "suggestedShippingUsd": {
              "type": "number"
            },
            "imageAlt": {
              "type": "string"
            },
            "heroPrompt": {
              "type": "string"
            }
          },
          "required": [
