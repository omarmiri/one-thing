                }
              example: "{\"error\":\"PayPal isn't configured on this server.\"}"
  /paypal/client-token:
    get:
      description: >
        A browser-safe client token for the PayPal JavaScript SDK v6

        (`paypal.createInstance({ clientToken })`), bound to the requesting site's domain.

        Shop pages call this before showing the PayPal button.
      responses:
        '200':
          description: A token for this site's domain.
          body:
            application/json:
              schema: |
                {
                  "id": "ApiPaypalClientTokenResponse",
                  "title": "ApiPaypalClientTokenResponse",
                  "description": "The client token.",
                  "example": {
                    "clientToken": "eyJraWQiOiJFWEFNUExFIn0.example.client-token"
                  },
                  "type": "object",
                  "properties": {
                    "clientToken": {
                      "description": "Pass to `createInstance` in the PayPal JavaScript SDK v6.",
                      "example": "eyJraWQiOiJFWEFNUExFIn0.example.client-token",
                      "type": "string"
                    }
                  },
                  "required": [
                    "clientToken"
                  ]
                }
              example: '{"clientToken":"eyJraWQiOiJFWEFNUExFIn0.example.client-token"}'
        '502':
          description: Gemini, PayPal or Channel3 failed or isn't configured.
          body:
            application/json:
              schema: |
                {
                  "id": "ErrorResponse",
                  "title": "ErrorResponse",
                  "description": "An error reply.",
                  "example": {
                    "error": "Choose a photo.",
                    "field": "photo"
                  },
                  "type": "object",
                  "properties": {
                    "error": {
                      "description": "A sentence you can show to a person.",
                      "example": "Order not found.",
                      "type": "string"
                    },
                    "field": {
                      "description": "The form field at fault, when there is one.",
                      "example": "price",
                      "type": "string"
                    },
                    "detail": {
                      "description": "The upstream service's own message, for debugging.",
                      "example": "INSTRUMENT_DECLINED",
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              example: "{\"error\":\"PayPal isn't configured on this server.\"}"
        '503':
          description: Gemini, PayPal or Channel3 failed or isn't configured.
          body:
            application/json:
              schema: |
                {
                  "id": "ErrorResponse",
                  "title": "ErrorResponse",
                  "description": "An error reply.",
                  "example": {
                    "error": "Choose a photo.",
                    "field": "photo"
                  },
                  "type": "object",
                  "properties": {
                    "error": {
                      "description": "A sentence you can show to a person.",
                      "example": "Order not found.",
                      "type": "string"
                    },
                    "field": {
                      "description": "The form field at fault, when there is one.",
                      "example": "price",
                      "type": "string"
                    },
                    "detail": {
                      "description": "The upstream service's own message, for debugging.",
                      "example": "INSTRUMENT_DECLINED",
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              example: "{\"error\":\"PayPal isn't configured on this server.\"}"
  /orders:
    /{paypalOrderId}/capture:
      uriParameters:
        paypalOrderId:
          description: The PayPal order id that `createCheckoutOrder` returned.
          type: string
          example: 5O190127TN364715T
          required: true
          displayName: paypalOrderId
      post:
        description: >
          Call after the buyer approves. Records the sale; digital orders get a download link or access code.

          Safe to call repeatedly: before approval it answers 409, so a page can poll it while the PayPal window is open.
        responses:
          '200':
            description: Paid.
            body:
              application/json:
                schema: |
                  {
                    "id": "ApiOrdersCaptureResponse",
                    "title": "ApiOrdersCaptureResponse",
                    "description": "The paid order.",
                    "example": {
                      "orderId": "pX4kR9tVb2nQ7sLe",
                      "status": "paid"
                    },
                    "type": "object",
                    "properties": {
                      "orderId": {
                        "description": "OneThing's order id; the thank-you page is `/<slug>/thanks?order=<orderId>`.",
                        "example": "pX4kR9tVb2nQ7sLe",
                        "type": "string"
                      },
                      "status": {
                        "description": "Always `paid`.",
                        "example": "paid",
                        "type": "string",
                        "enum": [
                          "paid"
                        ]
                      }
                    },
                    "required": [
                      "orderId",
                      "status"
                    ]
                  }
                example: '{"orderId":"pX4kR9tVb2nQ7sLe","status":"paid"}'
          '402':
            description: Something in the request needs fixing; `error` says what.
            body:
              application/json:
                schema: |
                  {
                    "id": "ErrorResponse",
                    "title": "ErrorResponse",
                    "description": "An error reply.",
                    "example": {
                      "error": "Choose a photo.",
                      "field": "photo"
                    },
                    "type": "object",
                    "properties": {
                      "error": {
                        "description": "A sentence you can show to a person.",
                        "example": "Order not found.",
                        "type": "string"
                      },
                      "field": {
                        "description": "The form field at fault, when there is one.",
                        "example": "price",
                        "type": "string"
                      },
                      "detail": {
                        "description": "The upstream service's own message, for debugging.",
                        "example": "INSTRUMENT_DECLINED",
                        "type": "string"
                      }
                    },
                    "required": [
                      "error"
                    ]
                  }
                example: '{"error":"Choose a photo."}'
          '404':
            description: No such shop, or the admin token or API key doesn't match it.
            body:
              application/json:
                schema: |
                  {
                    "id": "ErrorResponse",
                    "title": "ErrorResponse",
                    "description": "An error reply.",
                    "example": {
                      "error": "Choose a photo.",
                      "field": "photo"
                    },
                    "type": "object",
                    "properties": {
                      "error": {
                        "description": "A sentence you can show to a person.",
                        "example": "Order not found.",
                        "type": "string"
                      },
                      "field": {
                        "description": "The form field at fault, when there is one.",
                        "example": "price",
                        "type": "string"
                      },
                      "detail": {
                        "description": "The upstream service's own message, for debugging.",
                        "example": "INSTRUMENT_DECLINED",
                        "type": "string"
                      }
                    },
                    "required": [
                      "error"
                    ]
                  }
                example: '{"error":"Shop not found."}'
          '409':
            description: The buyer hasn't approved the order yet.
            body:
              application/json:
                schema: |
                  {
                    "id": "ApiOrdersCapture409Error1",
                    "title": "ApiOrdersCapture409Error1",
                    "description": "Not approved yet.",
                    "example": {
                      "status": "pending"
                    },
                    "type": "object",
                    "properties": {
                      "status": {
                        "title": "Status6",
                        "description": "`pending` until the buyer approves at PayPal.",
                        "example": "pending",
                        "type": "string",
                        "additionalProperties": false,
                        "enum": [
                          "pending"
                        ]
                      }
                    }
                  }
          '410':
            description: The last unit (or the last of the buyer's combination) sold while they were paying, or the PayPal checkout expired before they paid. The payment isn't captured, so the buyer isn't charged.
            body:
              application/json:
                schema: |
                  {
                    "id": "ErrorResponse",
                    "title": "ErrorResponse",
                    "description": "An error reply.",
                    "example": {
                      "error": "Choose a photo.",
                      "field": "photo"
                    },
                    "type": "object",
                    "properties": {
                      "error": {
                        "description": "A sentence you can show to a person.",
                        "example": "Order not found.",
                        "type": "string"
                      },
                      "field": {
                        "description": "The form field at fault, when there is one.",
                        "example": "price",
                        "type": "string"
                      },
                      "detail": {
                        "description": "The upstream service's own message, for debugging.",
                        "example": "INSTRUMENT_DECLINED",
                        "type": "string"
                      }
                    },
                    "required": [
                      "error"
                    ]
                  }
          '422':
            description: The buyer's funding source was declined (`INSTRUMENT_DECLINED`); they can try another.
            body:
              application/json:
                schema: |
                  {
                    "id": "ErrorResponse",
                    "title": "ErrorResponse",
                    "description": "An error reply.",
                    "example": {
                      "error": "Choose a photo.",
                      "field": "photo"
                    },
                    "type": "object",
                    "properties": {
                      "error": {
                        "description": "A sentence you can show to a person.",
                        "example": "Order not found.",
                        "type": "string"
                      },
                      "field": {
                        "description": "The form field at fault, when there is one.",
                        "example": "price",
                        "type": "string"
                      },
                      "detail": {
                        "description": "The upstream service's own message, for debugging.",
                        "example": "INSTRUMENT_DECLINED",
                        "type": "string"
                      }
                    },
                    "required": [
                      "error"
                    ]
                  }
          '502':
            description: Gemini, PayPal or Channel3 failed or isn't configured.
            body:
              application/json:
                schema: |
                  {
                    "id": "ErrorResponse",
                    "title": "ErrorResponse",
                    "description": "An error reply.",
                    "example": {
                      "error": "Choose a photo.",
                      "field": "photo"
                    },
                    "type": "object",
                    "properties": {
                      "error": {
                        "description": "A sentence you can show to a person.",
                        "example": "Order not found.",
                        "type": "string"
                      },
                      "field": {
                        "description": "The form field at fault, when there is one.",
                        "example": "price",
                        "type": "string"
                      },
                      "detail": {
                        "description": "The upstream service's own message, for debugging.",
                        "example": "INSTRUMENT_DECLINED",
                        "type": "string"
                      }
                    },
                    "required": [
                      "error"
                    ]
                  }
                example: "{\"error\":\"PayPal isn't configured on this server.\"}"
    post:
      description: >
        Creates the PayPal order for one unit of a live shop's product. The amount always comes

        from the shop, never from the caller. Pass the returned `id` to the PayPal JS SDK.


        If the shop has buyer `options`, send one value for each. A sold-out combination answers 409.
      headers:
        Content-Type:
          required: true
          displayName: Content-Type
          enum:
          - application/json
      body:
        application/json:
          schema: |
            {
              "id": "ApiOrdersRequest",
              "title": "ApiOrdersRequest",
              "description": "The shop and the buyer's pick.",
              "examples": [
                {
                  "Id": "plain",
                  "Name": "A product without options",
                  "Value": "{\"slug\":\"raptorrush\"}",
                  "ExternalValue": null,
                  "Description": null
                },
                {
                  "Id": "options",
                  "Name": "With the buyer's size",
                  "Value": "{\"slug\":\"vintageskates\",\"options\":{\"Size\":\"9\"}}",
                  "ExternalValue": null,
                  "Description": null
                }
              ],
              "example": {
                "slug": "raptorrush"
              },
              "type": "object",
              "properties": {
                "slug": {
                  "description": "The shop's link name.",
                  "example": "vintageskates",
                  "type": "string"
                },
                "options": {
                  "description": "The buyer's pick, one value per option, keyed by option name.",
                  "example": {
                    "Size": "M",
                    "Color": "Black"
                  },
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "slug"
              ]
            }
          example: '{"slug":"raptorrush"}'
      responses:
        '200':
          description: PayPal order created.
          body:
            application/json:
              schema: |
                {
                  "id": "ApiOrdersResponse",
                  "title": "ApiOrdersResponse",
                  "description": "The PayPal order to approve.",
                  "example": {
                    "id": "5O190127TN364715T"
                  },
                  "type": "object",
                  "properties": {
                    "id": {
                      "description": "PayPal order id.",
                      "example": "5O190127TN364715T",
                      "type": "string"
                    }
                  },
                  "required": [
                    "id"
                  ]
                }
              example: '{"id":"5O190127TN364715T"}'
        '400':
          description: Something in the request needs fixing; `error` says what.
          body:
            application/json:
              schema: |
                {
                  "id": "ErrorResponse",
                  "title": "ErrorResponse",
                  "description": "An error reply.",
                  "example": {
                    "error": "Choose a photo.",
                    "field": "photo"
                  },
                  "type": "object",
                  "properties": {
                    "error": {
                      "description": "A sentence you can show to a person.",
                      "example": "Order not found.",
                      "type": "string"
                    },
                    "field": {
                      "description": "The form field at fault, when there is one.",
                      "example": "price",
                      "type": "string"
                    },
                    "detail": {
                      "description": "The upstream service's own message, for debugging.",
                      "example": "INSTRUMENT_DECLINED",
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              example: '{"error":"Choose a photo."}'
        '404':
          description: No such shop, or the admin token or API key doesn't match it.
          body:
            application/json:
              schema: |
                {
                  "id": "ErrorResponse",
                  "title": "ErrorResponse",
                  "description": "An error reply.",
                  "example": {
                    "error": "Choose a photo.",
                    "field": "photo"
                  },
                  "type": "object",
                  "properties": {
                    "error": {
                      "description": "A sentence you can show to a person.",
                      "example": "Order not found.",
                      "type": "string"
                    },
                    "field": {
                      "description": "The form field at fault, when there is one.",
                      "example": "price",
                      "type": "string"
                    },
                    "detail": {
                      "description": "The upstream service's own message, for debugging.",
                      "example": "INSTRUMENT_DECLINED",
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              example: '{"error":"Shop not found."}'
        '409':
          description: Taken or unavailable (a link name, or a sold-out product).
          body:
            application/json:
              schema: |
                {
                  "id": "ErrorResponse",
                  "title": "ErrorResponse",
                  "description": "An error reply.",
                  "example": {
                    "error": "Choose a photo.",
                    "field": "photo"
                  },
                  "type": "object",
                  "properties": {
                    "error": {
                      "description": "A sentence you can show to a person.",
                      "example": "Order not found.",
                      "type": "string"
                    },
                    "field": {
                      "description": "The form field at fault, when there is one.",
                      "example": "price",
                      "type": "string"
                    },
                    "detail": {
                      "description": "The upstream service's own message, for debugging.",
                      "example": "INSTRUMENT_DECLINED",
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              example: '{"error":"Sold out."}'
        '429':
          description: Over this network's cap for the call (see **Limits**). Retry after `Retry-After` seconds.
          headers:
            Retry-After:
              required: false
          body:
            application/json:
              schema: |
                {
                  "id": "ErrorResponse",
                  "title": "ErrorResponse",
                  "description": "An error reply.",
                  "example": {
                    "error": "Choose a photo.",
                    "field": "photo"
                  },
                  "type": "object",
                  "properties": {
                    "error": {
                      "description": "A sentence you can show to a person.",
                      "example": "Order not found.",
                      "type": "string"
                    },
                    "field": {
                      "description": "The form field at fault, when there is one.",
                      "example": "price",
                      "type": "string"
                    },
                    "detail": {
                      "description": "The upstream service's own message, for debugging.",
                      "example": "INSTRUMENT_DECLINED",
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              example: '{"error":"Too many checkouts from your network. Try again in 7 min."}'
        '502':
          description: Gemini, PayPal or Channel3 failed or isn't configured.
          body:
            application/json:
              schema: |
                {
                  "id": "ErrorResponse",
                  "title": "ErrorResponse",
                  "description": "An error reply.",
                  "example": {
                    "error": "Choose a photo.",
                    "field": "photo"
                  },
                  "type": "object",
                  "properties": {
                    "error": {
                      "description": "A sentence you can show to a person.",
                      "example": "Order not found.",
                      "type": "string"
                    },
                    "field": {
                      "description": "The form field at fault, when there is one.",
                      "example": "price",
                      "type": "string"
                    },
                    "detail": {
                      "description": "The upstream service's own message, for debugging.",
                      "example": "INSTRUMENT_DECLINED",
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              example: "{\"error\":\"PayPal isn't configured on this server.\"}"
        '503':
          description: Gemini, PayPal or Channel3 failed or isn't configured.
          body:
            application/json:
              schema: |
                {
                  "id": "ErrorResponse",
                  "title": "ErrorResponse",
                  "description": "An error reply.",
                  "example": {
                    "error": "Choose a photo.",
                    "field": "photo"
                  },
                  "type": "object",
                  "properties": {
                    "error": {
                      "description": "A sentence you can show to a person.",
                      "example": "Order not found.",
                      "type": "string"
                    },
                    "field": {
                      "description": "The form field at fault, when there is one.",
                      "example": "price",
                      "type": "string"
                    },
                    "detail": {
                      "description": "The upstream service's own message, for debugging.",
                      "example": "INSTRUMENT_DECLINED",
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              example: "{\"error\":\"PayPal isn't configured on this server.\"}"
  /access/verify:
    post:
      description: >
        For apps and games sold with access codes. Callable from any origin (CORS `*`): it only

        answers valid or not for one shop, and counts uses. Accepts the shop's current or former

        link names, and codes typed loosely (lower case, spaces, no dashes).
      headers:
        Content-Type:
          required: true
          displayName: Content-Type
          enum:
          - application/json
      body:
        application/json:
          schema: |
            {
              "id": "ApiAccessVerifyRequest",
              "title": "ApiAccessVerifyRequest",
              "description": "The shop and the code to check.",
              "example": {
                "shop": "raptorrush",
                "code": "K7QF-M2XP-9HTD"
              },
              "type": "object",
              "properties": {
                "shop": {
                  "description": "The shop's link name.",
                  "example": "raptorrush",
                  "type": "string"
                },
                "code": {
                  "description": "The access code the buyer entered. Case and dashes don't matter.",
                  "example": "K7QF-M2XP-9HTD",
                  "type": "string"
                }
              },
              "required": [
                "shop",
                "code"
              ]
            }
          example: '{"shop":"raptorrush","code":"K7QF-M2XP-9HTD"}'
      responses:
        '200':
          description: The answer. Invalid codes are also a 200.
          body:
            application/json:
              schema: |
                {
                  "id": "ApiAccessVerifyResponse",
                  "title": "ApiAccessVerifyResponse",
                  "description": "Whether the code is valid.",
                  "examples": [
                    {
                      "Id": "valid",
                      "Name": "A valid code",
                      "Value": "{\"valid\":true,\"product\":\"Raptor Rush: Browser Edition\"}",
                      "ExternalValue": null,
                      "Description": null
                    },
                    {
                      "Id": "invalid",
                      "Name": "A wrong code",
                      "Value": "{\"valid\":false}",
                      "ExternalValue": null,
                      "Description": null
                    }
                  ],
                  "example": {
                    "valid": true,
                    "product": "Raptor Rush: Browser Edition"
                  },
                  "type": "object",
                  "properties": {
                    "valid": {
                      "description": "True if the code belongs to a paid, unrefunded order for this shop.",
                      "example": true,
                      "type": "boolean"
                    },
                    "product": {
                      "description": "The product name, when valid.",
                      "example": "Vintage Cream and Red Roller Skates",
                      "type": "string"
                    }
                  },
                  "required": [
                    "valid"
                  ]
                }
              example: '{"valid":true,"product":"Raptor Rush: Browser Edition"}'
  /download/{token}:
    uriParameters:
      token:
        description: The download token from a paid order's thank-you page.
        type: string
        example: q2Vd8mLx0RkT4nYb7HcW1sPe
        required: true
        displayName: token
    get:
      description: A paid digital order's private link. Works 5 times within 14 days.
      responses:
        '200':
          description: The file.
        '410':
          description: Expired or used up.
          body:
            text/plain:
              schema: |
                {
                  "description": "Why the link no longer works.",
                  "example": "This download link has expired.",
                  "type": "string"
                }
              example: This download link has expired.
  /blobs/{id}:
    uriParameters:
      id:
        description: A shop's `photo_blob` or `hero_blob`.
        type: string
        example: 'LFRvGuTU3D8i334X'
        required: true
        displayName: id
    get:
      description: Public images only. Purchased files are never served here.
      responses:
        '200':
          description: The image.
          body:
            text/plain:
              schema: |
                {
                  "description": "The image bytes.",
                  "x-is-dynamic": true
                }
        '404':
          description: Not a public shop image.
  /mcp:
    post:
      description: >
        A [Model Context Protocol](https://modelcontextprotocol.io) server, so agents such as

        Claude can shop here. Add `https://<host>/api/mcp` to an MCP client as a Streamable HTTP

        server. It's stateless: each POST carries one JSON-RPC 2.0 message (or a batch) and gets a

        plain JSON reply, with no event stream. The `initialize` reply's `Mcp-Session-Id` header

        carries the client's `clientInfo.name`; send it back on later requests (MCP clients do)

        so the seller's stats show which agent sent the buyer. Nothing else is kept.


        Methods: `initialize`, `ping`, `tools/list`, `tools/call`, and `resources/list`,

        `resources/templates/list` and `resources/read` for the product card. Each tool carries

        `annotations` (only `create_order` isn't `readOnlyHint`). Tools:


        | Tool | Arguments | What it does |

        |---|---|---|

        | `search_shops` | `query?`, `limit?` (1–25) | Live gallery shops, best match first; no match returns the newest with `matched: false` |

        | `get_product` | `shop` | The same object as `getAgentProduct` |

        | `create_order` | `shop`, `options?` | One unit on order; returns `order_id` and `pay_url` |

        | `get_order` | `order_id` | Status and `next_step`; once paid, the receipt and `delivery` |


        **The buyer always approves.** `create_order` charges nothing: the agent shows the buyer

        `pay_url` (`/o/<order_id>`, see `openPayLink`), which opens PayPal. It's a plain link on this

        site, so agent platforms that hide PayPal's checkout tokens can still show it. When the buyer

        says they've paid, the agent calls `get_order`.


        `get_order` status is one of `awaiting_buyer_approval`, `paid`, `declined` (nothing charged;

        the buyer can open `pay_url` again), `sold_out`, `expired` (call `create_order` again) or

        `failed` (PayPal couldn't be reached; try again), with a `next_step` the agent can follow.

        A paid order carries `delivery`: `{type: access_code, access_code, start_url?}`,

        `{type: download, download_url}` or `{type: shipping, ship_to, fulfillment, tracking}`, plus

        `amount` with item, shipping and total. Orders made this way show `channel: agent` in

        `listOrders`.


        **The product card.** Hosts that draw MCP Apps UI (ChatGPT, or a client that declares the

        `io.modelcontextprotocol/ui` extension) get `search_shops`, `get_product` and

        `create_order` results as a card with the real photos, options and a Pay with PayPal button

        (`ui://onething/shop-card-v1.html`). For them `show_buyer` is a one-line note rather than

        Markdown, so the model doesn't repeat or invent what the card shows.


        Tool errors (an unknown shop, a sold-out size, over the checkout cap) come back as results

        with `isError: true`, so the model can read them and try something else.
      headers:
        Content-Type:
          required: true
          displayName: Content-Type
          enum:
          - application/json
      body:
        application/json:
          schema: |
            {
              "description": "A JSON-RPC 2.0 request or batch.",
              "examples": [
                {
                  "Id": "search",
                  "Name": "Find a shop",
                  "Value": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"search_shops\",\"arguments\":{\"query\":\"game\"}}}",
                  "ExternalValue": null,
                  "Description": null
                },
                {
                  "Id": "initialize",
                  "Name": "Start (handshake)",
                  "Value": "{\"jsonrpc\":\"2.0\",\"id\":0,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2025-06-18\",\"capabilities\":{},\"clientInfo\":{\"name\":\"my-agent\",\"version\":\"1.0\"}}}",
                  "ExternalValue": null,
                  "Description": null
                },
                {
                  "Id": "list",
                  "Name": "List the tools",
                  "Value": "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"tools/list\"}",
                  "ExternalValue": null,
                  "Description": null
                },
                {
                  "Id": "product",
                  "Name": "Read one product",
                  "Value": "{\"jsonrpc\":\"2.0\",\"id\":4,\"method\":\"tools/call\",\"params\":{\"name\":\"get_product\",\"arguments\":{\"shop\":\"vintageskates\"}}}",
                  "ExternalValue": null,
                  "Description": null
                },
                {
                  "Id": "order",
                  "Name": "Order a size and colour",
                  "Value": "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/call\",\"params\":{\"name\":\"create_order\",\"arguments\":{\"shop\":\"trailtee\",\"options\":{\"Size\":\"M\",\"Color\":\"Black\"}}}}",
                  "ExternalValue": null,
                  "Description": null
                },
                {
                  "Id": "status",
                  "Name": "Check an order",
                  "Value": "{\"jsonrpc\":\"2.0\",\"id\":5,\"method\":\"tools/call\",\"params\":{\"name\":\"get_order\",\"arguments\":{\"order_id\":\"pX4kR9tVb2nQ7sLe\"}}}",
                  "ExternalValue": null,
                  "Description": null
                }
              ],
              "example": {
                "jsonrpc": "2.0",
                "id": 1,
                "method": "tools/call",
                "params": {
                  "name": "search_shops",
                  "arguments": {
                    "query": "game"
                  }
                }
              },
              "oneOf": [
                {
                  "id": "JsonRpcRequest",
                  "title": "JsonRpcRequest",
                  "description": "A JSON-RPC 2.0 request to the MCP server.",
                  "example": {
                    "jsonrpc": "2.0",
                    "id": 1,
                    "method": "tools/call",
                    "params": {
                      "name": "get_product",
                      "arguments": {
                        "shop": "vintageskates"
                      }
                    }
                  },
                  "type": "object",
                  "properties": {
                    "jsonrpc": {
                      "description": "Always `2.0`.",
                      "example": "2.0",
                      "type": "string",
                      "enum": [
                        "2.0"
                      ]
                    },
                    "method": {
                      "title": "Method",
                      "description": "The MCP method. `tools/call` runs a tool; `tools/list` lists them.",
                      "example": "tools/call",
                      "type": "string",
                      "additionalProperties": false,
                      "enum": [
                        "initialize",
                        "ping",
                        "tools/list",
                        "tools/call",
                        "notifications/initialized"
                      ]
                    },
                    "id": {
                      "description": "Leave out for a notification.",
                      "example": "1",
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "integer",
                          "format": "int32"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "params": {
                      "description": "For `tools/call`: `{ name, arguments }`.",
                      "example": {
                        "name": "get_product",
                        "arguments": {
                          "shop": "vintageskates"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "required": [
                    "jsonrpc",
                    "method"
                  ]
                },
                {
                  "example": [
                    {
                      "jsonrpc": "2.0",
                      "id": 1,
                      "method": "tools/call",
                      "params": {
                        "name": "get_product",
                        "arguments": {
                          "shop": "vintageskates"
                        }
                      }
                    }
                  ],
                  "type": "array",
                  "items": {
                    "id": "JsonRpcRequest",
                    "title": "JsonRpcRequest",
                    "description": "A JSON-RPC 2.0 request to the MCP server.",
                    "example": {
                      "jsonrpc": "2.0",
                      "id": 1,
                      "method": "tools/call",
                      "params": {
                        "name": "get_product",
                        "arguments": {
                          "shop": "vintageskates"
                        }
                      }
                    },
                    "type": "object",
                    "properties": {
                      "jsonrpc": {
                        "description": "Always `2.0`.",
                        "example": "2.0",
                        "type": "string",
                        "enum": [
                          "2.0"
                        ]
                      },
                      "method": {
                        "title": "Method",
                        "description": "The MCP method. `tools/call` runs a tool; `tools/list` lists them.",
                        "example": "tools/call",
                        "type": "string",
                        "additionalProperties": false,
                        "enum": [
                          "initialize",
                          "ping",
                          "tools/list",
                          "tools/call",
                          "notifications/initialized"
                        ]
                      },
                      "id": {
                        "description": "Leave out for a notification.",
                        "example": "1",
                        "oneOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "integer",
                            "format": "int32"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "params": {
                        "description": "For `tools/call`: `{ name, arguments }`.",
                        "example": {
                          "name": "get_product",
                          "arguments": {
                            "shop": "vintageskates"
                          }
                        },
                        "type": "object"
                      }
                    },
                    "required": [
                      "jsonrpc",
                      "method"
                    ]
                  }
                }
              ]
            }
          example: '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"search_shops","arguments":{"query":"game"}}}'
      responses:
        '200':
          description: The JSON-RPC reply (an array for a batch).
          body:
            application/json:
