- Order: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "Order",
      "title": "Order",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "status": {
          "title": "Status3",
          "type": "string",
          "additionalProperties": false,
          "enum": [
            "created",
            "paid",
            "failed"
          ]
        },
        "amount_cents": {
          "type": "integer",
          "format": "int32"
        },
        "currency": {
          "type": "string"
        },
        "fulfillment_status": {
          "title": "FulfillmentStatus",
          "type": "string",
          "additionalProperties": false,
          "enum": [
            "none",
            "to_ship",
            "shipped",
            "digital_sent"
          ]
        },
        "paypal_order_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "shipping_cents": {
          "type": "integer",
          "format": "int32"
        },
        "buyer_email": {
          "type": [
            "string",
            "null"
          ]
        },
        "buyer_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "shipping_address": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        },
        "capture_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "carrier": {
          "type": [
            "string",
            "null"
          ]
        },
        "tracking_number": {
          "type": [
            "string",
            "null"
          ]
        },
        "tracking_synced": {
          "type": "boolean"
        },
        "downloads": {
          "type": "integer",
          "format": "int32"
        },
        "access_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "code_uses": {
          "type": "integer",
          "format": "int32"
        },
        "channel": {
          "title": "Channel",
          "description": "`agent` for orders an AI agent placed through the MCP server.",
          "type": "string",
          "additionalProperties": false,
          "enum": [
            "web",
            "agent"
          ]
        },
        "options": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "oneOf": [
              {
                "example": {
                  "Size": "M",
                  "Color": "Black"
                },
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "paid_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "status",
        "amount_cents",
        "currency",
        "fulfillment_status"
      ]
    }
- WebhookEvent: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "WebhookEvent",
      "title": "WebhookEvent",
      "type": "object",
      "properties": {
        "id": {
          "description": "PayPal's event id.",
          "type": "string"
        },
        "event_type": {
          "example": "PAYMENT.CAPTURE.COMPLETED",
          "type": "string"
        },
        "verified": {
          "description": "Whether PayPal confirmed the delivery's signature.",
          "type": "boolean"
        },
        "outcome": {
          "example": "Confirmed: order already paid",
          "type": "string"
        },
        "received_at": {
          "type": "string",
          "format": "date-time"
        },
        "paypal_order_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "example": "2.99 USD",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "event_type",
        "verified",
        "outcome",
        "received_at"
      ]
    }
- OrderEvent: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "OrderEvent",
      "title": "OrderEvent",
      "type": "object",
      "properties": {
        "event": {
          "title": "Event",
          "type": "string",
          "additionalProperties": false,
          "enum": [
            "order.paid",
            "order.shipped"
          ]
        },
        "shop": {
          "id": "Shop1",
          "title": "Shop1",
          "type": "object",
          "properties": {
            "slug": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          }
        },
        "order": {
          "id": "Order1",
          "title": "Order1",
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "paypal_order_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "amount": {
              "example": "2.99",
              "type": "string"
            },
            "currency": {
              "type": "string"
            },
            "buyer_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "buyer_email": {
              "type": [
                "string",
                "null"
              ]
            },
            "shipping_address": {
              "type": [
                "object",
                "null"
              ]
            },
            "fulfillment_status": {
              "type": "string"
            },
            "tracking_number": {
              "type": [
                "string",
                "null"
              ]
            },
            "carrier": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      },
      "required": [
        "event",
        "shop",
        "order"
      ]
    }
- AiSource: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "title": "AiSource",
      "type": "string",
      "additionalProperties": false,
      "enum": [
        "gemini",
        "fallback"
      ]
    }
- ApiAccessVerifyRequest: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiAccessVerifyRequest",
      "title": "ApiAccessVerifyRequest",
      "type": "object",
      "properties": {
        "shop": {
          "description": "The shop's link name.",
          "example": "raptorrush",
          "type": "string"
        },
        "code": {
          "example": "K7QF-M2XP-9HTD",
          "type": "string"
        }
      },
      "required": [
        "shop",
        "code"
      ]
    }
- ApiAccessVerifyResponse: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiAccessVerifyResponse",
      "title": "ApiAccessVerifyResponse",
      "type": "object",
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "product": {
          "description": "The product name, when valid.",
          "type": "string"
        }
      },
      "required": [
        "valid"
      ]
    }
- ApiAccountSigninRequest: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiAccountSigninRequest",
      "title": "ApiAccountSigninRequest",
      "type": "object",
      "properties": {
        "identifier": {
          "description": "An email address, or a phone number (spaces, dashes and brackets are ignored; keep a leading +).",
          "examples": [
            {
              "Id": "Untitled Example1",
              "Name": null,
              "Value": "maker@example.com",
              "ExternalValue": null,
              "Description": null
            },
            {
              "Id": "Untitled Example2",
              "Name": null,
              "Value": "+1 555 123 4567",
              "ExternalValue": null,
              "Description": null
            }
          ],
          "example": "maker@example.com",
          "type": "string"
        }
      },
      "required": [
        "identifier"
      ]
    }
- ApiAccountSigninResponse: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiAccountSigninResponse",
      "title": "ApiAccountSigninResponse",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "email": {
          "description": "Lower-cased.",
          "type": [
            "string",
            "null"
          ]
        },
        "phone": {
          "description": "Digits, with a leading + if one was given.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "email",
        "phone"
      ]
    }
- ApiChannel3SearchResponse: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiChannel3SearchResponse",
      "title": "ApiChannel3SearchResponse",
      "type": "object",
      "properties": {
        "products": {
          "description": "",
          "type": "array",
          "items": {
            "id": "ProductCard",
            "title": "ProductCard",
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "image": {
                "type": "string"
              },
              "price": {
                "type": "number"
              },
              "currency": {
                "type": "string"
              },
              "retailer": {
                "description": "The store with the best offer.",
                "type": "string"
              },
              "retailers": {
                "type": "integer",
                "format": "int32"
              },
              "commission": {
                "description": "Best commission rate across offers, 0–1.",
                "type": "number"
              },
              "brand": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "id",
              "title",
              "image",
              "price",
              "currency",
              "retailer",
              "retailers",
              "commission"
            ]
          }
        }
      },
      "required": [
        "products"
      ]
    }
- ApiOrdersCapture409Error1: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiOrdersCapture409Error1",
      "title": "ApiOrdersCapture409Error1",
      "type": "object",
