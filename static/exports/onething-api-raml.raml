          "description": "Colour label → photo id.",
          "example": {
            "Black": "b_8f2k1",
            "Forest green": "b_q93md"
          },
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "matches"
      ]
    }
- ApiShopsOrdersRefund409Error1: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiShopsOrdersRefund409Error1",
      "title": "ApiShopsOrdersRefund409Error1",
      "description": "Why the order can't be refunded here.",
      "type": "object",
      "properties": {
        "error": {
          "description": "A sentence you can show to a person.",
          "example": "Order not found.",
          "type": "string"
        },
        "field": {
          "description": "The form field at fault, when there is one.",
          "example": "price",
          "type": "string"
        },
        "detail": {
          "description": "The upstream service's own message, for debugging.",
          "example": "INSTRUMENT_DECLINED",
          "type": "string"
        },
        "refundInPayPal": {
          "description": "Refund it in PayPal yourself, then call again with `record: true`.",
          "example": true,
          "type": "boolean"
        }
      },
      "required": [
        "error"
      ]
    }
- ApiShopsOrdersRefundRequest: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiShopsOrdersRefundRequest",
      "title": "ApiShopsOrdersRefundRequest",
      "description": "How to refund.",
      "type": "object",
      "properties": {
        "record": {
          "description": "`true`: don't contact PayPal, just record that the seller refunded it themselves.",
          "type": "boolean",
          "default": false
        }
      }
    }
- ApiShopsOrdersRefundResponse: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiShopsOrdersRefundResponse",
      "title": "ApiShopsOrdersRefundResponse",
      "description": "The refund.",
      "type": "object",
      "properties": {
        "ok": {
          "description": "Always `true`.",
          "example": true,
          "type": "boolean"
        },
        "refundId": {
          "description": "PayPal's refund id; null when `record` was used.",
          "example": "1JU08902781691411",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "ok"
      ]
    }
- ApiShopsOrdersShipRequest: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiShopsOrdersShipRequest",
      "title": "ApiShopsOrdersShipRequest",
      "description": "The shipment's tracking.",
      "type": "object",
      "properties": {
        "carrier": {
          "title": "Carrier",
          "description": "The carrier. `OTHER` needs `carrierName`.",
          "example": "USPS",
          "type": "string",
          "additionalProperties": false,
          "enum": [
            "USPS",
            "UPS",
            "FEDEX",
            "DHL",
            "OTHER"
          ]
        },
        "trackingNumber": {
          "description": "The carrier's tracking number.",
          "example": "9400111899223197428490",
          "type": "string",
          "minLength": 4,
          "maxLength": 64
        },
        "carrierName": {
          "description": "Required when `carrier` is `OTHER`.",
          "example": "Canada Post",
          "type": "string",
          "maxLength": 60
        }
      },
      "required": [
        "carrier",
        "trackingNumber"
      ]
    }
- ApiShopsOrdersShipResponse: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiShopsOrdersShipResponse",
      "title": "ApiShopsOrdersShipResponse",
      "description": "The order is marked shipped.",
      "type": "object",
      "properties": {
        "ok": {
          "description": "Always `true`.",
          "example": true,
          "type": "boolean"
        },
        "synced": {
          "description": "Whether PayPal accepted the tracking number.",
          "example": true,
          "type": "boolean"
        }
      },
      "required": [
        "ok",
        "synced"
      ]
    }
- ApiShopsPaypalRequest: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiShopsPaypalRequest",
      "title": "ApiShopsPaypalRequest",
      "description": "Where to come back to.",
      "type": "object",
      "properties": {
        "returnUrl": {
