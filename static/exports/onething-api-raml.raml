          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "description": "The shop page.",
          "type": "string"
        }
      },
      "required": [
        "shop",
        "name",
        "kind",
        "headline",
        "price",
        "image",
        "url"
      ]
    }
- AgentCreatedOrder: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "AgentCreatedOrder",
      "title": "AgentCreatedOrder",
      "description": "A new order, as `create_order` and `orderByLink` return it.",
      "type": "object",
      "properties": {
        "order_id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "awaiting_buyer_approval"
          ]
        },
        "total": {
          "description": "The total with shipping, as a label.",
          "type": "string"
        },
        "pay_url": {
          "description": "Where the buyer pays (redirects to PayPal). Safe to show in chat.",
          "type": "string"
        },
        "status_url": {
          "description": "`getAgentOrder` for this order.",
          "type": "string"
        },
        "next_step": {
          "type": "string"
        },
        "show_buyer": {
          "description": "A suggested reply to the buyer, in Markdown with the links already written as links: the product and its options to pick from, the pay link, or what they got with a receipt link. Buyers have the best experience when agents show it as written.",
          "type": "string"
        },
        "agent_name": {
          "description": "Who this request was credited to in the seller's stats: a recognised user agent, else the name the agent gave itself (`?agent=`, or the MCP client's name), else the user agent's first word.",
          "type": "string"
        },
        "options": {
          "description": "The buyer's pick, one value per option, keyed by option name.",
          "example": {
            "Size": "M",
            "Color": "Black"
          },
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "order_id",
        "status",
        "total",
        "pay_url",
        "status_url",
        "next_step"
      ]
    }
- AgentOrder: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "AgentOrder",
      "title": "AgentOrder",
      "description": "An order as `get_order` and `getAgentOrder` report it.",
      "type": "object",
      "properties": {
        "order_id": {
          "type": "string"
        },
        "status": {
          "title": "Status2",
          "description": "`declined`: PayPal declined it, nothing charged, the buyer can open `pay_url` again. `sold_out`: it sold out before the payment was captured. `expired`: the PayPal checkout expired; create a new order. `failed`: PayPal couldn't be reached; ask again.",
          "type": "string",
          "additionalProperties": false,
          "enum": [
            "awaiting_buyer_approval",
            "paid",
            "declined",
            "sold_out",
            "expired",
            "failed"
          ]
        },
        "product": {
          "type": "string"
        },
        "amount": {
          "id": "Amount",
          "title": "Amount",
          "type": "object",
          "properties": {
            "item": {
              "type": "number"
            },
            "shipping": {
              "type": "number"
            },
            "total": {
              "type": "number"
            },
            "currency": {
              "type": "string"
            }
          },
          "required": [
            "item",
            "shipping",
            "total",
            "currency"
          ]
        },
        "total": {
          "description": "The total as a label, e.g. `$255.00`.",
          "type": "string"
        },
        "show_buyer": {
          "description": "A suggested reply to the buyer, in Markdown with the links already written as links: the product and its options to pick from, the pay link, or what they got with a receipt link. Buyers have the best experience when agents show it as written.",
          "type": "string"
        },
        "agent_name": {
          "description": "Who this request was credited to in the seller's stats: a recognised user agent, else the name the agent gave itself (`?agent=`, or the MCP client's name), else the user agent's first word.",
          "type": "string"
        },
        "options": {
          "description": "The buyer's pick, one value per option, keyed by option name.",
          "example": {
            "Size": "M",
            "Color": "Black"
          },
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "pay_url": {
          "description": "Unpaid orders (waiting or declined). The buyer pays here; safe to show in chat.",
          "type": "string"
        },
        "next_step": {
          "description": "Unpaid orders. What the agent should do next, in plain words.",
          "type": "string"
        },
        "paid_at": {
          "type": "string",
          "format": "date-time"
        },
        "receipt_url": {
          "description": "Paid orders. The buyer's thank-you page.",
          "type": "string"
        },
        "delivery": {
          "description": "Paid orders. What the buyer got.",
          "oneOf": [
            {
              "id": "AgentDeliveryAccessCode",
              "title": "AgentDeliveryAccessCode",
              "description": "A digital product unlocked with an access code.",
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "access_code"
                  ]
                },
                "access_code": {
                  "type": "string"
                },
                "start_url": {
                  "description": "The seller's app with the code filled in.",
                  "type": "string"
                }
              },
              "required": [
                "type",
                "access_code"
              ]
