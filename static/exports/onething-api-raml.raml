                              "body"
                            ]
                          },
                          "headline": {
                            "type": "string"
                          },
                          "bullets": {
                            "description": "",
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "faq": {
                            "description": "",
                            "type": "array",
                            "items": {
                              "id": "Faq",
                              "title": "Faq",
                              "type": "object",
                              "properties": {
                                "q": {
                                  "type": "string"
                                },
                                "a": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "q",
                                "a"
                              ]
                            }
                          },
                          "ctaLabel": {
                            "type": "string"
                          },
                          "eyebrow": {
                            "type": "string"
                          },
                          "subheadline": {
                            "type": "string"
                          },
                          "story": {
                            "type": "string"
                          },
                          "details": {
                            "description": "",
                            "type": "array",
                            "items": {
                              "id": "Detail",
                              "title": "Detail",
                              "type": "object",
                              "properties": {
                                "label": {
                                  "type": "string"
                                },
                                "value": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "label",
                                "value"
                              ]
                            }
                          },
                          "suggestedPriceUsd": {
                            "type": "number"
                          },
                          "suggestedShippingUsd": {
                            "type": "number"
                          },
                          "imageAlt": {
                            "type": "string"
                          },
                          "heroPrompt": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "productType",
                          "productName",
                          "layout",
                          "palette",
                          "fonts",
                          "headline",
                          "bullets",
                          "faq",
                          "ctaLabel"
                        ]
                      },
                      "shipping_cents": {
                        "type": "integer",
                        "format": "int32"
                      },
                      "ship_countries": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "stock": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "format": "int32"
                      },
                      "delivery": {
                        "title": "Delivery1",
                        "type": "string",
                        "additionalProperties": false,
                        "enum": [
                          "file",
                          "access_code"
                        ]
                      },
                      "access_url": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "paypal_email": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "seller_email": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "zapier_hook_url": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "in_gallery": {
                        "type": "boolean"
                      },
                      "photo_blob": {
                        "description": "Image id for `getImage`.",
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "hero_blob": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "hero_status": {
                        "title": "HeroStatus",
                        "type": "string",
                        "additionalProperties": false,
                        "enum": [
                          "none",
                          "pending",
                          "ready",
                          "failed"
                        ]
                      },
                      "hero_error": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "ai_source": {
                        "title": "AiSource",
                        "type": "string",
                        "additionalProperties": false,
                        "enum": [
                          "gemini",
                          "fallback"
                        ]
                      },
                      "source_url": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "referral": {
                        "oneOf": [
                          {
                            "id": "Referral",
                            "title": "Referral",
                            "description": "A recommended Channel3 product. Buy links are Channel3-tracked, credited to this shop.",
                            "type": "object",
                            "properties": {
                              "productId": {
                                "type": "string"
                              },
                              "title": {
                                "type": "string"
                              },
                              "offers": {
                                "description": "",
                                "type": "array",
                                "items": {
                                  "id": "Offer",
                                  "title": "Offer",
                                  "type": "object",
                                  "properties": {
                                    "domain": {
                                      "type": "string"
                                    },
                                    "url": {
                                      "type": "string"
                                    },
                                    "price": {
                                      "type": "number"
                                    },
                                    "currency": {
                                      "type": "string"
                                    },
                                    "inStock": {
                                      "type": "boolean"
                                    },
                                    "commission": {
                                      "description": "Maximum commission rate, 0–1 (0.08 = 8%).",
                                      "type": "number"
                                    }
                                  },
                                  "required": [
                                    "domain",
                                    "url",
                                    "price",
                                    "currency",
                                    "inStock",
                                    "commission"
                                  ]
                                }
                              },
                              "brand": {
                                "type": [
                                  "string",
                                  "null"
                                ]
                              },
                              "image": {
                                "type": [
                                  "string",
                                  "null"
                                ]
                              }
                            },
                            "required": [
                              "productId",
                              "title",
                              "offers"
                            ]
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "created_at": {
                        "type": "string",
                        "format": "date-time"
                      }
                    },
                    "required": [
                      "id",
                      "slug",
                      "status",
                      "product_type",
                      "price_cents",
                      "currency",
                      "spec"
                    ]
                  }
          '404':
            description: No such shop, or the admin token doesn't match it.
            body:
              application/json:
                schema: |
                  {
                    "id": "Error",
                    "title": "Error",
                    "type": "object",
                    "properties": {
                      "error": {
                        "description": "A sentence you can show to a person.",
                        "type": "string"
                      },
                      "field": {
                        "description": "The form field at fault, when there is one.",
                        "type": "string"
                      },
                      "detail": {
                        "description": "The upstream service's own message, for debugging.",
                        "type": "string"
                      }
                    },
                    "required": [
                      "error"
                    ]
                  }
      patch:
        securedBy:
        - AdminToken
        description: >
          Changes only the fields you send. Renaming `slug` keeps the old link working (it

          redirects). Set `status: live` to publish; a digital product needs its file (or, for

          access codes, `access_url`) first.
        headers:
          Content-Type:
            required: true
            displayName: Content-Type
            enum:
            - application/json
        body:
          application/json:
            schema: |
              {
                "id": "ShopUpdate",
                "title": "ShopUpdate",
                "type": "object",
                "properties": {
                  "slug": {
                    "type": "string"
                  },
                  "status": {
                    "title": "Status",
                    "type": "string",
                    "additionalProperties": false,
                    "enum": [
                      "draft",
                      "live"
                    ]
                  },
                  "product_type": {
                    "title": "ProductType",
                    "description": "`referral` only for shops created from Channel3.",
                    "type": "string",
                    "additionalProperties": false,
                    "enum": [
                      "physical",
                      "digital",
                      "referral"
                    ]
                  },
                  "price": {
                    "type": "number",
                    "minimum": 0.5,
                    "maximum": 10000.0
                  },
                  "shipping": {
                    "type": "number",
                    "minimum": 0.0,
                    "maximum": 500.0
                  },
                  "stock": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0.0,
                    "format": "int32"
                  },
                  "ship_countries": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "delivery": {
                    "title": "Delivery1",
                    "type": "string",
                    "additionalProperties": false,
                    "enum": [
                      "file",
                      "access_code"
                    ]
                  },
                  "access_url": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "uri"
                  },
                  "paypal_email": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "email"
                  },
                  "seller_email": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "email"
                  },
                  "zapier_hook_url": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "uri"
                  },
                  "in_gallery": {
                    "description": "Feature the shop at `/gallery` while it's live. Off by default.",
                    "type": "boolean"
                  }
                }
              }
            example: ''
        responses:
          '200':
            description: Saved.
            body:
              application/json:
                schema: |
                  {
                    "id": "ApiShopsResponse",
                    "title": "ApiShopsResponse",
                    "type": "object",
                    "properties": {
                      "ok": {
                        "type": "boolean"
                      },
                      "slug": {
                        "description": "The shop's link name after this change.",
                        "type": "string"
                      }
                    },
                    "required": [
                      "ok",
                      "slug"
                    ]
                  }
          '400':
            description: Something in the request needs fixing; `error` says what.
            body:
              application/json:
                schema: |
                  {
                    "id": "Error",
                    "title": "Error",
                    "type": "object",
                    "properties": {
                      "error": {
                        "description": "A sentence you can show to a person.",
                        "type": "string"
                      },
                      "field": {
                        "description": "The form field at fault, when there is one.",
                        "type": "string"
                      },
                      "detail": {
                        "description": "The upstream service's own message, for debugging.",
                        "type": "string"
                      }
                    },
                    "required": [
                      "error"
                    ]
                  }
          '404':
            description: No such shop, or the admin token doesn't match it.
            body:
              application/json:
                schema: |
                  {
                    "id": "Error",
                    "title": "Error",
                    "type": "object",
                    "properties": {
                      "error": {
                        "description": "A sentence you can show to a person.",
                        "type": "string"
                      },
                      "field": {
                        "description": "The form field at fault, when there is one.",
                        "type": "string"
                      },
                      "detail": {
                        "description": "The upstream service's own message, for debugging.",
                        "type": "string"
                      }
                    },
                    "required": [
                      "error"
                    ]
                  }
    post:
      description: >
        Starts a draft shop from one of three sources. Gemini designs the page and guesses the

        setup; check it with `getShop`, adjust with `updateShop`, then go live.


        Sent with a session cookie from `signIn`, the shop belongs to that account, which also

        becomes its seller email (and PayPal email, after Log in with PayPal) unless you give one.


        - `source=photo`: a `photo` and/or a `description` of your own product.

        - `source=link`: a `url`. If Channel3 recognises it as a store's product page, the shop
          becomes a recommendation (`product_type: referral`); otherwise the page is read and you
          sell the product yourself with PayPal.
        - `source=channel3`: a `productId` from `searchProducts` (a recommendation).


        Takes 15–40 seconds. Hero art, if available, is generated afterwards (`hero_status`).
      body:
        multipart/form-data:
          formParameters:
            source:
              required: true
              displayName: source
              enum:
              - photo
              - link
              - channel3
            photo:
              description: '`source=photo`: the product photo, up to 8 MB.'
              type: file
              required: false
              displayName: photo
            description:
              description: '`source=photo`: a sentence or two about the product. Required if there is no photo.'
              type: string
              required: false
              displayName: description
            url:
              description: '`source=link`: a product page, or your own app or game page.'
              type: string
              required: false
              displayName: url
            productId:
              description: '`source=channel3`: a product id from `searchProducts`.'
              type: string
              required: false
              displayName: productId
            slug:
              description: The link name you want. If omitted, the AI suggests one.
              type: string
              required: false
              displayName: slug
            type:
              default: auto
              required: false
              displayName: type
              enum:
              - auto
              - physical
              - digital
            delivery:
              description: For digital products. If omitted, the AI guesses.
              required: false
              displayName: delivery
              enum:
              - file
              - access_code
            access_url:
              description: Where buyers use an access code.
              type: string
              required: false
              displayName: access_url
            price:
              description: USD. If omitted, the AI suggests a price.
              type: number
              required: false
              displayName: price
            shipping:
              type: number
              required: false
              displayName: shipping
            stock:
              type: integer
              required: false
              displayName: stock
            ship_countries:
              type: string
              required: false
              displayName: ship_countries
            paypal_email:
              type: string
              required: false
              displayName: paypal_email
            seller_email:
              type: string
              required: false
              displayName: seller_email
            digital_file:
              type: file
              required: false
              displayName: digital_file
      responses:
        '200':
          description: Draft created.
          body:
            application/json:
              schema: |
                {
                  "id": "CreatedShop",
                  "title": "CreatedShop",
                  "type": "object",
                  "properties": {
                    "slug": {
                      "example": "dragonflight",
                      "type": "string"
                    },
                    "token": {
                      "description": "The admin token. Shown once; store it.",
                      "type": "string"
                    },
                    "manageUrl": {
                      "description": "The seller's private manage page (contains the token).",
                      "type": "string"
                    }
                  },
                  "required": [
                    "slug",
                    "token",
                    "manageUrl"
                  ]
                }
        '400':
          description: Something in the request needs fixing; `error` says what.
          body:
            application/json:
              schema: |
                {
                  "id": "Error",
                  "title": "Error",
                  "type": "object",
                  "properties": {
                    "error": {
                      "description": "A sentence you can show to a person.",
                      "type": "string"
                    },
                    "field": {
                      "description": "The form field at fault, when there is one.",
                      "type": "string"
                    },
                    "detail": {
                      "description": "The upstream service's own message, for debugging.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
        '409':
          description: Taken or unavailable (a link name, or a sold-out product).
          body:
            application/json:
              schema: |
                {
                  "id": "Error",
                  "title": "Error",
                  "type": "object",
                  "properties": {
                    "error": {
                      "description": "A sentence you can show to a person.",
                      "type": "string"
                    },
                    "field": {
                      "description": "The form field at fault, when there is one.",
                      "type": "string"
                    },
                    "detail": {
                      "description": "The upstream service's own message, for debugging.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
        '502':
          description: Gemini, PayPal or Channel3 failed or isn't configured.
          body:
            application/json:
              schema: |
                {
                  "id": "Error",
                  "title": "Error",
                  "type": "object",
                  "properties": {
                    "error": {
                      "description": "A sentence you can show to a person.",
                      "type": "string"
                    },
                    "field": {
                      "description": "The form field at fault, when there is one.",
                      "type": "string"
                    },
                    "detail": {
                      "description": "The upstream service's own message, for debugging.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
  /slugs/check:
    get:
      description: Normalises a proposed link name and says whether a new shop can use it.
      queryParameters:
        name:
          description: Anything; it is normalised (`Raptor Rush` becomes `raptor-rush`).
          type: string
          required: true
          displayName: name
      responses:
        '200':
          description: The normalised name and whether it can be used.
          body:
            application/json:
              schema: |
                {
                  "id": "ApiSlugsCheckResponse",
                  "title": "ApiSlugsCheckResponse",
                  "type": "object",
                  "properties": {
                    "slug": {
                      "type": "string"
                    },
                    "available": {
                      "type": "boolean"
                    },
                    "problem": {
                      "description": "Why not, when unavailable.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "slug",
                    "available"
                  ]
                }
  /channel3/search:
    get:
      description: Searches 100M+ products from 25k+ stores through Channel3. Pass a result's `id` to `createShop` with `source=channel3`.
      queryParameters:
        q:
          description: What to look for, in plain words.
          type: string
          example: gifts for trail runners under $60
          required: true
          displayName: q
          maxLength: '200'
      responses:
        '200':
          description: Up to 12 products.
          body:
            application/json:
              schema: |
                {
                  "id": "ApiChannel3SearchResponse",
                  "title": "ApiChannel3SearchResponse",
                  "type": "object",
                  "properties": {
                    "products": {
                      "description": "",
                      "type": "array",
                      "items": {
                        "id": "ProductCard",
                        "title": "ProductCard",
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "title": {
                            "type": "string"
                          },
                          "image": {
                            "type": "string"
                          },
                          "price": {
                            "type": "number"
                          },
                          "currency": {
                            "type": "string"
                          },
                          "retailer": {
                            "description": "The store with the best offer.",
                            "type": "string"
                          },
                          "retailers": {
                            "type": "integer",
                            "format": "int32"
                          },
                          "commission": {
                            "description": "Best commission rate across offers, 0–1.",
                            "type": "number"
                          },
                          "brand": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        },
                        "required": [
                          "id",
                          "title",
                          "image",
                          "price",
                          "currency",
                          "retailer",
                          "retailers",
                          "commission"
                        ]
                      }
                    }
                  },
                  "required": [
                    "products"
                  ]
                }
        '502':
          description: Gemini, PayPal or Channel3 failed or isn't configured.
          body:
            application/json:
              schema: |
                {
                  "id": "Error",
                  "title": "Error",
                  "type": "object",
                  "properties": {
                    "error": {
                      "description": "A sentence you can show to a person.",
                      "type": "string"
                    },
                    "field": {
                      "description": "The form field at fault, when there is one.",
                      "type": "string"
                    },
                    "detail": {
                      "description": "The upstream service's own message, for debugging.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
        '503':
          description: Gemini, PayPal or Channel3 failed or isn't configured.
          body:
            application/json:
              schema: |
                {
                  "id": "Error",
                  "title": "Error",
                  "type": "object",
                  "properties": {
                    "error": {
                      "description": "A sentence you can show to a person.",
                      "type": "string"
                    },
                    "field": {
                      "description": "The form field at fault, when there is one.",
                      "type": "string"
                    },
                    "detail": {
                      "description": "The upstream service's own message, for debugging.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
  /paypal/client-token:
    get:
      description: >
        A browser-safe client token for the PayPal JavaScript SDK v6

        (`paypal.createInstance({ clientToken })`), bound to the requesting site's domain.

        Shop pages call this before showing the PayPal button.
      responses:
        '200':
          description: A token for this site's domain.
          body:
            application/json:
              schema: |
                {
                  "id": "ApiPaypalClientTokenResponse",
                  "title": "ApiPaypalClientTokenResponse",
                  "type": "object",
                  "properties": {
                    "clientToken": {
                      "description": "Pass to `createInstance` in the PayPal JavaScript SDK v6.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "clientToken"
                  ]
                }
        '502':
          description: Gemini, PayPal or Channel3 failed or isn't configured.
          body:
            application/json:
              schema: |
                {
                  "id": "Error",
                  "title": "Error",
                  "type": "object",
                  "properties": {
                    "error": {
                      "description": "A sentence you can show to a person.",
                      "type": "string"
                    },
                    "field": {
                      "description": "The form field at fault, when there is one.",
                      "type": "string"
                    },
                    "detail": {
                      "description": "The upstream service's own message, for debugging.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
        '503':
          description: Gemini, PayPal or Channel3 failed or isn't configured.
          body:
            application/json:
              schema: |
                {
                  "id": "Error",
                  "title": "Error",
                  "type": "object",
                  "properties": {
                    "error": {
                      "description": "A sentence you can show to a person.",
                      "type": "string"
                    },
                    "field": {
                      "description": "The form field at fault, when there is one.",
                      "type": "string"
                    },
                    "detail": {
                      "description": "The upstream service's own message, for debugging.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
  /orders:
    /{paypalOrderId}/capture:
      uriParameters:
        paypalOrderId:
          description: The PayPal order id that `createCheckoutOrder` returned.
          type: string
          required: true
          displayName: paypalOrderId
      post:
        description: >
          Call after the buyer approves. Records the sale; digital orders get a download link or access code.

          Safe to call repeatedly: before approval it answers 409, so a page can poll it while the PayPal window is open.
        responses:
          '200':
            description: Paid.
            body:
              application/json:
                schema: |
                  {
                    "id": "ApiOrdersCaptureResponse",
                    "title": "ApiOrdersCaptureResponse",
                    "type": "object",
                    "properties": {
                      "orderId": {
                        "description": "OneThing's order id; the thank-you page is `/<slug>/thanks?order=<orderId>`.",
                        "type": "string"
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "paid"
                        ]
                      }
                    },
                    "required": [
                      "orderId",
                      "status"
                    ]
                  }
          '402':
            description: Something in the request needs fixing; `error` says what.
            body:
              application/json:
                schema: |
                  {
                    "id": "Error",
                    "title": "Error",
                    "type": "object",
                    "properties": {
                      "error": {
                        "description": "A sentence you can show to a person.",
                        "type": "string"
                      },
                      "field": {
                        "description": "The form field at fault, when there is one.",
                        "type": "string"
                      },
                      "detail": {
                        "description": "The upstream service's own message, for debugging.",
                        "type": "string"
                      }
                    },
                    "required": [
                      "error"
                    ]
                  }
          '404':
            description: No such shop, or the admin token doesn't match it.
            body:
              application/json:
                schema: |
                  {
                    "id": "Error",
                    "title": "Error",
                    "type": "object",
                    "properties": {
                      "error": {
                        "description": "A sentence you can show to a person.",
                        "type": "string"
                      },
                      "field": {
                        "description": "The form field at fault, when there is one.",
                        "type": "string"
                      },
                      "detail": {
                        "description": "The upstream service's own message, for debugging.",
                        "type": "string"
                      }
                    },
                    "required": [
                      "error"
                    ]
                  }
          '409':
            description: The buyer hasn't approved the order yet.
            body:
              application/json:
                schema: |
                  {
                    "id": "ApiOrdersCapture409Error1",
                    "title": "ApiOrdersCapture409Error1",
                    "type": "object",
                    "properties": {
                      "status": {
                        "title": "Status3",
                        "type": "string",
                        "additionalProperties": false,
                        "enum": [
                          "pending"
                        ]
                      }
                    }
                  }
          '422':
            description: The buyer's funding source was declined (`INSTRUMENT_DECLINED`); they can try another.
            body:
              application/json:
                schema: |
                  {
                    "id": "Error",
                    "title": "Error",
                    "type": "object",
                    "properties": {
                      "error": {
                        "description": "A sentence you can show to a person.",
                        "type": "string"
                      },
                      "field": {
                        "description": "The form field at fault, when there is one.",
                        "type": "string"
                      },
                      "detail": {
                        "description": "The upstream service's own message, for debugging.",
                        "type": "string"
                      }
                    },
                    "required": [
                      "error"
                    ]
                  }
          '502':
            description: Gemini, PayPal or Channel3 failed or isn't configured.
            body:
              application/json:
                schema: |
                  {
                    "id": "Error",
                    "title": "Error",
                    "type": "object",
                    "properties": {
                      "error": {
                        "description": "A sentence you can show to a person.",
                        "type": "string"
                      },
                      "field": {
                        "description": "The form field at fault, when there is one.",
                        "type": "string"
                      },
                      "detail": {
                        "description": "The upstream service's own message, for debugging.",
                        "type": "string"
                      }
                    },
                    "required": [
                      "error"
                    ]
                  }
    post:
      description: >
        Creates the PayPal order for one unit of a live shop's product. The amount always comes

        from the shop, never from the caller. Pass the returned `id` to the PayPal JS SDK.
      headers:
        Content-Type:
          required: true
          displayName: Content-Type
          enum:
          - application/json
      body:
        application/json:
          schema: |
            {
              "id": "ApiOrdersRequest",
              "title": "ApiOrdersRequest",
              "type": "object",
              "properties": {
                "slug": {
                  "type": "string"
                }
              },
              "required": [
                "slug"
              ]
            }
          example: ''
      responses:
        '200':
          description: PayPal order created.
