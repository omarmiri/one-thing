- ShopOption: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ShopOption",
      "title": "ShopOption",
      "description": "Something the buyer picks, such as a size or a colour. The shop still sells one product.",
      "type": "object",
      "properties": {
        "name": {
          "example": "Size",
          "type": "string",
          "maxLength": 20
        },
        "kind": {
          "title": "Kind",
          "description": "`color` shows swatches, and the photo of the picked colour.",
          "type": "string",
          "additionalProperties": false,
          "enum": [
            "size",
            "color",
            "other"
          ]
        },
        "values": {
          "description": "",
          "type": "array",
          "items": {
            "id": "OptionValue",
            "title": "OptionValue",
            "type": "object",
            "properties": {
              "label": {
                "example": "M",
                "type": "string",
                "maxLength": 30
              },
              "hex": {
                "example": "#14171a",
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "photo": {
                "description": "Colours: the shop photo (id) that shows this colour. See `matchColorPhotos`.",
                "type": "string"
              }
            },
            "required": [
              "label"
            ]
          },
          "minItems": 1,
          "maxItems": 12
        }
      },
      "required": [
        "name",
        "kind",
        "values"
      ]
    }
- OptionValue: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "OptionValue",
      "title": "OptionValue",
      "type": "object",
      "properties": {
        "label": {
          "example": "M",
          "type": "string",
