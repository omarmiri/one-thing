      /suggest:
        uriParameters: {}
        post:
          securedBy:
          - AdminToken
          - PlatformKey
          description: >
            Asks Gemini what buyers will want to choose (sizes, colours) and what they'll ask that the

            listing doesn't say (dimensions, materials). `createShop` already does this once; call it

            again after editing the product. The result is saved as the shop's `suggestions`.


            Nothing changes on the shop page until the seller confirms: save options with `updateShop`

            (`options`), and answer the questions with `updateShop` (`facts`). Not for recommendations.
          responses:
            '200':
              description: The suggestions.
              body:
                application/json:
                  schema: |
                    {
                      "id": "Suggestions",
                      "title": "Suggestions",
                      "description": "What Gemini thinks buyers will want to choose or ask. The seller confirms; nothing is applied on its own.",
                      "type": "object",
                      "properties": {
                        "oneOfAKind": {
                          "description": "A single item (vintage, handmade), so options and stock don't apply.",
                          "type": "boolean"
                        },
                        "options": {
                          "description": "",
                          "type": "array",
                          "items": {
                            "id": "Option",
                            "title": "Option",
                            "type": "object",
                            "properties": {
                              "name": {
                                "example": "Size",
                                "type": "string",
                                "maxLength": 20
                              },
                              "kind": {
                                "title": "Kind",
                                "description": "`color` shows swatches, and the photo of the picked colour.",
                                "type": "string",
                                "additionalProperties": false,
                                "enum": [
                                  "size",
                                  "color",
                                  "other"
                                ]
                              },
                              "values": {
                                "description": "",
                                "type": "array",
                                "items": {
                                  "id": "OptionValue",
                                  "title": "OptionValue",
                                  "type": "object",
                                  "properties": {
                                    "label": {
                                      "example": "M",
                                      "type": "string",
                                      "maxLength": 30
                                    },
                                    "hex": {
                                      "example": "#14171a",
                                      "type": "string",
                                      "pattern": "^#[0-9a-fA-F]{6}$"
                                    },
                                    "photo": {
                                      "description": "Colours: the shop photo (id) that shows this colour. See `matchColorPhotos`.",
                                      "type": "string"
                                    }
                                  },
                                  "required": [
                                    "label"
                                  ]
                                },
                                "minItems": 1,
                                "maxItems": 12
                              },
                              "fromSeller": {
                                "description": "The seller's description or photo named these values; otherwise they're a guess.",
                                "type": "boolean"
                              }
                            },
                            "required": [
                              "name",
                              "kind",
                              "values"
                            ]
                          }
                        },
                        "missingFacts": {
                          "description": "",
                          "type": "array",
                          "items": {
                            "id": "MissingFact",
                            "title": "MissingFact",
                            "type": "object",
                            "properties": {
                              "label": {
                                "example": "Size",
                                "type": "string"
                              },
                              "question": {
                                "example": "What size are the skates?",
                                "type": "string"
                              },
                              "placeholder": {
                                "example": "US women's 8",
                                "type": "string"
                              }
                            },
                            "required": [
                              "label",
                              "question",
                              "placeholder"
                            ]
                          }
                        }
                      },
                      "required": [
                        "oneOfAKind",
                        "options",
                        "missingFacts"
                      ]
                    }
            '400':
              description: Something in the request needs fixing; `error` says what.
              body:
                application/json:
                  schema: |
                    {
                      "id": "Error",
                      "title": "Error",
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "A sentence you can show to a person.",
                          "type": "string"
                        },
                        "field": {
                          "description": "The form field at fault, when there is one.",
                          "type": "string"
                        },
                        "detail": {
                          "description": "The upstream service's own message, for debugging.",
                          "type": "string"
                        }
                      },
                      "required": [
                        "error"
                      ]
                    }
            '404':
              description: No such shop, or the admin token or API key doesn't match it.
              body:
                application/json:
                  schema: |
                    {
                      "id": "Error",
                      "title": "Error",
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "A sentence you can show to a person.",
                          "type": "string"
                        },
                        "field": {
                          "description": "The form field at fault, when there is one.",
                          "type": "string"
                        },
                        "detail": {
                          "description": "The upstream service's own message, for debugging.",
                          "type": "string"
                        }
                      },
                      "required": [
                        "error"
                      ]
                    }
            '502':
              description: Gemini, PayPal or Channel3 failed or isn't configured.
              body:
                application/json:
                  schema: |
                    {
                      "id": "Error",
                      "title": "Error",
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "A sentence you can show to a person.",
                          "type": "string"
                        },
                        "field": {
                          "description": "The form field at fault, when there is one.",
                          "type": "string"
                        },
                        "detail": {
                          "description": "The upstream service's own message, for debugging.",
                          "type": "string"
                        }
                      },
                      "required": [
                        "error"
                      ]
                    }
      /match-photos:
        uriParameters: {}
        post:
          securedBy:
          - AdminToken
          - PlatformKey
          description: Gemini looks at the shop's photos and says which one shows each colour, so buyers who pick a colour see it. Suggests only; save the matches with `setColorPhotos`. Needs at least two photos.
          headers:
            Content-Type:
              required: true
              displayName: Content-Type
              enum:
              - application/json
          body:
            application/json:
              schema: |
                {
                  "id": "ApiShopsMatchPhotosRequest",
                  "title": "ApiShopsMatchPhotosRequest",
                  "type": "object",
                  "properties": {
                    "colors": {
                      "description": "",
                      "type": "array",
                      "items": {
                        "id": "Color",
                        "title": "Color",
                        "type": "object",
                        "properties": {
                          "label": {
                            "example": "Forest green",
                            "type": "string",
                            "maxLength": 30
                          },
                          "hex": {
                            "example": "#14171a",
                            "type": "string",
                            "pattern": "^#[0-9a-fA-F]{6}$"
                          }
                        },
                        "required": [
                          "label"
                        ]
                      },
                      "minItems": 1,
                      "maxItems": 12
                    }
                  },
                  "required": [
                    "colors"
                  ]
                }
              example: ''
          responses:
            '200':
              description: A photo id for each colour Gemini could match. Colours it couldn't place are left out.
              body:
                application/json:
                  schema: |
                    {
                      "id": "ApiShopsMatchPhotosResponse",
                      "title": "ApiShopsMatchPhotosResponse",
                      "type": "object",
                      "properties": {
                        "matches": {
                          "example": {
                            "Black": "b_8f2k1",
                            "Forest green": "b_q93md"
                          },
                          "type": "object",
                          "additionalProperties": {
                            "type": "string"
                          }
                        }
                      },
                      "required": [
                        "matches"
                      ]
                    }
            '400':
              description: Something in the request needs fixing; `error` says what.
              body:
                application/json:
                  schema: |
                    {
                      "id": "Error",
                      "title": "Error",
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "A sentence you can show to a person.",
                          "type": "string"
                        },
                        "field": {
                          "description": "The form field at fault, when there is one.",
                          "type": "string"
                        },
                        "detail": {
                          "description": "The upstream service's own message, for debugging.",
                          "type": "string"
                        }
                      },
                      "required": [
                        "error"
                      ]
                    }
            '404':
              description: No such shop, or the admin token or API key doesn't match it.
              body:
                application/json:
                  schema: |
                    {
                      "id": "Error",
