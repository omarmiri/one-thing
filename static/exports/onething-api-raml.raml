  /platform/shops:
    get:
      securedBy:
      - PlatformKey
      description: "Every shop the API key's account owns, newest first, with what a catalog page needs: name, price, cover, link, whether PayPal is connected and how many sales it has."
      queryParameters:
        status:
          description: Only shops with this status, e.g. `live` for a public catalog.
          example: live
          required: false
          displayName: status
          enum:
          - draft
          - live
      responses:
        '200':
          description: The shops.
          body:
            application/json:
              schema: "{\n  \"id\": \"ApiPlatformShopsResponse\",\n  \"title\": \"ApiPlatformShopsResponse\",\n  \"description\": \"The account's shops.\",\n  \"example\": {\n    \"shops\": [\n      {\n        \"slug\": \"raptorrush\",\n        \"status\": \"live\",\n        \"name\": \"Raptor Rush: Browser Edition\",\n        \"headline\": \"Grow from Tiny Hatchling to Giant Apex Predator\",\n        \"product_type\": \"digital\",\n        \"price\": {\n          \"amount\": 2.99,\n          \"currency\": \"USD\"\n        },\n        \"url\": \"https://one-thing-ash0.onrender.com/raptorrush\",\n        \"cover\": \"https://one-thing-ash0.onrender.com/api/blobs/KchAi9jwZzo76SKh\",\n        \"paypal_connected\": true,\n        \"sales\": 12,\n        \"created_at\": \"2026-10-12T20:31:44Z\"\n      }\n    ]\n  },\n  \"type\": \"object\",\n  \"properties\": {\n    \"shops\": {\n      \"description\": \"Shops, newest first.\",\n      \"example\": [\n        {\n          \"slug\": \"vintageskates\",\n          \"status\": \"draft\",\n          \"name\": \"Vintage Cream and Red Roller Skates\",\n          \"headline\": \"Classic quad skates crafted with walnut burl heels\",\n          \"product_type\": \"physical\",\n          \"price\": {\n            \"amount\": 240,\n            \"currency\": \"USD\",\n            \"label\": \"$240.00\"\n          },\n          \"url\": \"https://one-thing-ash0.onrender.com/vintageskates\",\n          \"cover\": \"https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X\",\n          \"paypal_connected\": true,\n          \"sales\": 12,\n          \"created_at\": \"2026-10-22T02:41:37Z\"\n        }\n      ],\n      \"type\": \"array\",\n      \"items\": {\n        \"id\": \"PlatformShop\",\n        \"title\": \"PlatformShop\",\n        \"description\": \"A shop as a platform API key lists it.\",\n        \"example\": {\n          \"slug\": \"vintageskates\",\n          \"status\": \"draft\",\n          \"name\": \"Vintage Cream and Red Roller Skates\",\n          \"headline\": \"Classic quad skates crafted with walnut burl heels\",\n          \"product_type\": \"physical\",\n          \"price\": {\n            \"amount\": 240,\n            \"currency\": \"USD\",\n            \"label\": \"$240.00\"\n          },\n          \"url\": \"https://one-thing-ash0.onrender.com/vintageskates\",\n          \"cover\": \"https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X\",\n          \"paypal_connected\": true,\n          \"sales\": 12,\n          \"created_at\": \"2026-10-22T02:41:37Z\"\n        },\n        \"type\": \"object\",\n        \"properties\": {\n          \"slug\": {\n            \"description\": \"The shop's link name.\",\n            \"example\": \"vintageskates\",\n            \"type\": \"string\"\n          },\n          \"status\": {\n            \"title\": \"Status3\",\n            \"description\": \"`draft` until the seller goes live.\",\n            \"example\": \"draft\",\n            \"type\": \"string\",\n            \"additionalProperties\": false,\n            \"enum\": [\n              \"draft\",\n              \"live\"\n            ]\n          },\n          \"name\": {\n            \"description\": \"The product's name.\",\n            \"example\": \"Vintage Cream and Red Roller Skates\",\n            \"type\": \"string\"\n          },\n          \"product_type\": {\n            \"title\": \"ProductType3\",\n            \"description\": \"`physical`, `digital` or `referral`.\",\n            \"example\": \"physical\",\n            \"type\": \"string\",\n            \"additionalProperties\": false,\n            \"enum\": [\n              \"physical\",\n              \"digital\",\n              \"referral\"\n            ]\n          },\n          \"price\": {\n            \"id\": \"AgentMoney\",\n            \"title\": \"AgentMoney\",\n            \"description\": \"An amount of money, as a number and as a label.\",\n            \"example\": {\n              \"amount\": 240,\n              \"currency\": \"USD\",\n              \"label\": \"$240.00\"\n            },\n            \"type\": \"object\",\n            \"properties\": {\n              \"amount\": {\n                \"description\": \"The amount in the currency's main unit (dollars, not cents).\",\n                \"example\": 48.5,\n                \"type\": \"number\"\n              },\n              \"currency\": {\n                \"description\": \"ISO 4217 currency code.\",\n                \"example\": \"USD\",\n                \"type\": \"string\"\n              },\n              \"label\": {\n                \"description\": \"The amount formatted for people.\",\n                \"example\": \"$48.50\",\n                \"type\": \"string\"\n              }\n            },\n            \"required\": [\n              \"amount\",\n              \"currency\"\n            ]\n          },\n          \"url\": {\n            \"description\": \"The shop page buyers pay on.\",\n            \"example\": \"https://one-thing-ash0.onrender.com/vintageskates\",\n            \"type\": \"string\"\n          },\n          \"paypal_connected\": {\n            \"description\": \"The seller connected a PayPal account that can be paid.\",\n            \"example\": true,\n            \"type\": \"boolean\"\n          },\n          \"sales\": {\n            \"description\": \"Paid orders.\",\n            \"example\": 12,\n            \"type\": \"integer\",\n            \"format\": \"int32\"\n          },\n          \"created_at\": {\n            \"description\": \"When the shop was made.\",\n            \"example\": \"2026-10-22T02:41:37Z\",\n            \"type\": \"string\",\n            \"format\": \"date-time\"\n          },\n          \"headline\": {\n            \"description\": \"The shop's one-line pitch.\",\n            \"example\": \"Classic quad skates crafted with walnut burl heels\",\n            \"type\": \"string\"\n          },\n          \"cover\": {\n            \"description\": \"The cover image's URL.\",\n            \"example\": \"https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X\",\n            \"type\": [\n              \"string\",\n              \"null\"\n            ]\n          }\n        },\n        \"required\": [\n          \"slug\",\n          \"status\",\n          \"name\",\n          \"product_type\",\n          \"price\",\n          \"url\",\n          \"paypal_connected\",\n          \"sales\",\n          \"created_at\"\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"shops\"\n  ]\n}"
              example: '{"shops":[{"slug":"raptorrush","status":"live","name":"Raptor Rush: Browser Edition","headline":"Grow from Tiny Hatchling to Giant Apex Predator","product_type":"digital","price":{"amount":2.99,"currency":"USD"},"url":"https://one-thing-ash0.onrender.com/raptorrush","cover":"https://one-thing-ash0.onrender.com/api/blobs/KchAi9jwZzo76SKh","paypal_connected":true,"sales":12,"created_at":"2026-10-12T20:31:44Z"}]}'
        '401':
          description: No API key, or it's wrong or revoked.
          body:
            application/json:
              schema: |
                {
                  "id": "ErrorResponse",
                  "title": "ErrorResponse",
                  "description": "An error reply.",
                  "example": {
                    "error": "Choose a photo.",
                    "field": "photo"
                  },
                  "type": "object",
                  "properties": {
                    "error": {
                      "description": "A sentence you can show to a person.",
                      "example": "Order not found.",
                      "type": "string"
                    },
                    "field": {
                      "description": "The form field at fault, when there is one.",
                      "example": "price",
                      "type": "string"
                    },
                    "detail": {
                      "description": "The upstream service's own message, for debugging.",
                      "example": "INSTRUMENT_DECLINED",
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
