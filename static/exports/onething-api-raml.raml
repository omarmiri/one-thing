                      ]
                    }
                  example: '{"error":"Shop not found."}'
      /paypal:
        uriParameters: {}
        post:
          securedBy:
          - AdminToken
          - PlatformKey
          description: >
            Starts PayPal's seller onboarding (Partner Referrals). Send the seller's browser to the

            returned `url`; they sign in to PayPal (or create a business account) and grant OneThing

            permission. PayPal brings them back to `/api/shops/<slug>/paypal/return`, which saves the

            connection and opens the manage page. From then on, sales are paid to that account.


            Without a connection, a shop can still go live with a typed `paypal_email`.


            **Platforms:** call it with your API key and a `returnUrl`, and PayPal's flow ends on your own

            page instead, as `returnUrl?paypal=connected|incomplete|cancelled|failed&shop=<slug>`. The

            URL's origin must be one registered on the key.
          headers:
            Content-Type:
              required: true
              displayName: Content-Type
              enum:
              - application/json
          body:
            application/json:
              schema: |
                {
                  "id": "ApiShopsPaypalRequest",
                  "title": "ApiShopsPaypalRequest",
                  "example": {
                    "returnUrl": "https://www.miriogames.com/market/manage/?g=7Hq2"
                  },
                  "type": "object",
                  "properties": {
                    "returnUrl": {
                      "description": "Platform key only. Where to send the seller after PayPal.",
                      "example": "https://www.miriogames.com/market/manage/?g=7Hq2",
                      "type": "string",
                      "format": "uri"
                    }
                  }
                }
              example: '{"returnUrl":"https://www.miriogames.com/market/manage/?g=7Hq2"}'
          responses:
            '200':
              description: Where to send the seller.
              body:
                application/json:
                  schema: |
                    {
                      "id": "ApiShopsPaypalResponse",
                      "title": "ApiShopsPaypalResponse",
                      "example": {
                        "url": "https://www.sandbox.paypal.com/bizsignup/partner/entry?referralToken=EXAMPLE"
                      },
                      "type": "object",
                      "properties": {
                        "url": {
                          "description": "PayPal's onboarding page for this shop.",
                          "type": "string"
                        }
                      },
                      "required": [
                        "url"
                      ]
                    }
                  example: '{"url":"https://www.sandbox.paypal.com/bizsignup/partner/entry?referralToken=EXAMPLE"}'
            '404':
              description: No such shop, or the admin token or API key doesn't match it.
              body:
                application/json:
                  schema: |
                    {
                      "id": "Error",
                      "title": "Error",
                      "example": {
                        "error": "Shop not found."
                      },
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "A sentence you can show to a person.",
                          "type": "string"
                        },
                        "field": {
                          "description": "The form field at fault, when there is one.",
                          "type": "string"
                        },
                        "detail": {
                          "description": "The upstream service's own message, for debugging.",
                          "type": "string"
                        }
                      },
                      "required": [
                        "error"
                      ]
                    }
                  example: '{"error":"Shop not found."}'
            '502':
              description: Gemini, PayPal or Channel3 failed or isn't configured.
              body:
                application/json:
                  schema: |
                    {
                      "id": "Error",
                      "title": "Error",
                      "example": {
                        "error": "PayPal isn't configured on this server."
                      },
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "A sentence you can show to a person.",
                          "type": "string"
                        },
                        "field": {
                          "description": "The form field at fault, when there is one.",
                          "type": "string"
                        },
                        "detail": {
                          "description": "The upstream service's own message, for debugging.",
                          "type": "string"
                        }
                      },
                      "required": [
                        "error"
                      ]
                    }
                  example: "{\"error\":\"PayPal isn't configured on this server.\"}"
            '503':
              description: Gemini, PayPal or Channel3 failed or isn't configured.
              body:
                application/json:
                  schema: |
                    {
                      "id": "Error",
                      "title": "Error",
                      "example": {
                        "error": "PayPal isn't configured on this server."
                      },
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "A sentence you can show to a person.",
                          "type": "string"
                        },
                        "field": {
                          "description": "The form field at fault, when there is one.",
                          "type": "string"
                        },
                        "detail": {
                          "description": "The upstream service's own message, for debugging.",
                          "type": "string"
                        }
                      },
                      "required": [
                        "error"
                      ]
                    }
                  example: "{\"error\":\"PayPal isn't configured on this server.\"}"
        get:
          securedBy:
          - AdminToken
          - PlatformKey
          description: Asks PayPal where the seller's connection stands and saves it on the shop. Also finds a connection the seller finished at PayPal without coming back.
          responses:
            '200':
              description: The connection, or nulls if there is none yet.
              body:
                application/json:
                  schema: |
                    {
                      "id": "ApiShopsPaypalResponse1",
                      "title": "ApiShopsPaypalResponse1",
                      "example": {
                        "merchantId": "7MZJ4QXN8K2LA",
                        "status": {
                          "receivable": true,
                          "emailConfirmed": true,
                          "checkedAt": "2026-10-21T18:04:11Z"
                        }
                      },
                      "type": "object",
                      "properties": {
                        "merchantId": {
                          "description": "The seller's PayPal merchant id.",
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "status": {
                          "oneOf": [
                            {
                              "id": "PayPalStatus",
                              "title": "PayPalStatus",
                              "description": "What PayPal last said about a connected seller account.",
                              "type": "object",
                              "properties": {
                                "receivable": {
                                  "description": "The account can receive payments.",
                                  "type": "boolean"
                                },
                                "emailConfirmed": {
                                  "description": "The seller has confirmed their email with PayPal.",
                                  "type": "boolean"
                                },
                                "checkedAt": {
                                  "type": "string",
                                  "format": "date-time"
                                }
                              },
                              "required": [
                                "receivable",
                                "emailConfirmed",
                                "checkedAt"
                              ]
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": [
                        "merchantId",
                        "status"
                      ]
                    }
                  example: '{"merchantId":"7MZJ4QXN8K2LA","status":{"receivable":true,"emailConfirmed":true,"checkedAt":"2026-10-21T18:04:11Z"}}'
            '404':
              description: No such shop, or the admin token or API key doesn't match it.
              body:
                application/json:
                  schema: |
                    {
                      "id": "Error",
                      "title": "Error",
                      "example": {
                        "error": "Shop not found."
                      },
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "A sentence you can show to a person.",
                          "type": "string"
                        },
                        "field": {
                          "description": "The form field at fault, when there is one.",
                          "type": "string"
                        },
                        "detail": {
                          "description": "The upstream service's own message, for debugging.",
                          "type": "string"
                        }
                      },
                      "required": [
                        "error"
                      ]
                    }
                  example: '{"error":"Shop not found."}'
            '502':
              description: Gemini, PayPal or Channel3 failed or isn't configured.
              body:
                application/json:
                  schema: |
                    {
                      "id": "Error",
                      "title": "Error",
                      "example": {
                        "error": "PayPal isn't configured on this server."
                      },
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "A sentence you can show to a person.",
                          "type": "string"
                        },
                        "field": {
                          "description": "The form field at fault, when there is one.",
                          "type": "string"
                        },
                        "detail": {
                          "description": "The upstream service's own message, for debugging.",
                          "type": "string"
                        }
                      },
                      "required": [
                        "error"
                      ]
                    }
                  example: "{\"error\":\"PayPal isn't configured on this server.\"}"
            '503':
              description: Gemini, PayPal or Channel3 failed or isn't configured.
              body:
                application/json:
                  schema: |
                    {
                      "id": "Error",
                      "title": "Error",
                      "example": {
                        "error": "PayPal isn't configured on this server."
                      },
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "A sentence you can show to a person.",
                          "type": "string"
                        },
                        "field": {
                          "description": "The form field at fault, when there is one.",
                          "type": "string"
                        },
                        "detail": {
                          "description": "The upstream service's own message, for debugging.",
                          "type": "string"
                        }
                      },
                      "required": [
                        "error"
                      ]
                    }
                  example: "{\"error\":\"PayPal isn't configured on this server.\"}"
        delete:
          securedBy:
          - AdminToken
          - PlatformKey
          description: Forgets the connected account. Sales go back to the shop's `paypal_email`.
          responses:
            '200':
              description: Done.
              body:
                application/json:
                  schema: |
                    {
                      "id": "Ok",
                      "title": "Ok",
                      "example": {
                        "ok": true
                      },
                      "type": "object",
                      "properties": {
                        "ok": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "ok"
                      ]
                    }
                  example: '{"ok":true}'
            '404':
              description: No such shop, or the admin token or API key doesn't match it.
              body:
                application/json:
                  schema: |
                    {
                      "id": "Error",
