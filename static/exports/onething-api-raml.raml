                              "editorial",
                              "minimal",
                              "playful"
                            ]
                          },
                          "palette": {
                            "id": "Palette",
                            "title": "Palette",
                            "type": "object",
                            "properties": {
                              "background": {
                                "example": "#14171a",
                                "type": "string",
                                "pattern": "^#[0-9a-fA-F]{6}$"
                              },
                              "surface": {
                                "example": "#14171a",
                                "type": "string",
                                "pattern": "^#[0-9a-fA-F]{6}$"
                              },
                              "text": {
                                "example": "#14171a",
                                "type": "string",
                                "pattern": "^#[0-9a-fA-F]{6}$"
                              },
                              "muted": {
                                "example": "#14171a",
                                "type": "string",
                                "pattern": "^#[0-9a-fA-F]{6}$"
                              },
                              "accent": {
                                "example": "#14171a",
                                "type": "string",
                                "pattern": "^#[0-9a-fA-F]{6}$"
                              },
                              "accentText": {
                                "example": "#14171a",
                                "type": "string",
                                "pattern": "^#[0-9a-fA-F]{6}$"
                              }
                            },
                            "required": [
