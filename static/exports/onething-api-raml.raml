          ]
        },
        "headline": {
          "type": "string"
        },
        "bullets": {
          "description": "",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "faq": {
          "description": "",
          "type": "array",
          "items": {
            "id": "Faq",
            "title": "Faq",
            "type": "object",
            "properties": {
              "q": {
                "type": "string"
              },
              "a": {
                "type": "string"
              }
            },
            "required": [
              "q",
              "a"
            ]
          }
        },
        "ctaLabel": {
          "type": "string"
        },
        "eyebrow": {
          "type": "string"
        },
        "subheadline": {
          "type": "string"
        },
        "story": {
          "type": "string"
        },
        "details": {
          "description": "",
          "type": "array",
          "items": {
            "id": "Detail",
            "title": "Detail",
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
