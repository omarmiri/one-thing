      /orders:
        uriParameters: {}
        /{orderId}/ship:
          uriParameters:
            orderId:
              description: OneThing's order id (`Order.id`).
              type: string
              required: true
              displayName: orderId
          post:
            securedBy:
            - AdminToken
            - PlatformKey
            description: Saves the tracking number and pushes it to PayPal, so the buyer sees it in PayPal.
            headers:
              Content-Type:
                required: true
                displayName: Content-Type
                enum:
                - application/json
            body:
              application/json:
                schema: |
                  {
                    "id": "ApiShopsOrdersShipRequest",
                    "title": "ApiShopsOrdersShipRequest",
                    "type": "object",
                    "properties": {
                      "carrier": {
                        "title": "Carrier",
                        "type": "string",
                        "additionalProperties": false,
                        "enum": [
                          "USPS",
                          "UPS",
                          "FEDEX",
                          "DHL",
                          "OTHER"
                        ]
                      },
                      "trackingNumber": {
                        "type": "string",
                        "minLength": 4,
                        "maxLength": 64
                      },
                      "carrierName": {
                        "description": "Required when `carrier` is `OTHER`.",
                        "type": "string",
                        "maxLength": 60
                      }
                    },
                    "required": [
                      "carrier",
                      "trackingNumber"
                    ]
                  }
                example: ''
            responses:
              '200':
                description: Shipped.
                body:
                  application/json:
                    schema: |
                      {
                        "id": "ApiShopsOrdersShipResponse",
                        "title": "ApiShopsOrdersShipResponse",
                        "type": "object",
                        "properties": {
                          "ok": {
                            "type": "boolean"
                          },
                          "synced": {
                            "description": "Whether PayPal accepted the tracking number.",
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "ok",
                          "synced"
                        ]
                      }
              '400':
                description: Something in the request needs fixing; `error` says what.
                body:
                  application/json:
                    schema: |
                      {
                        "id": "Error",
                        "title": "Error",
                        "type": "object",
                        "properties": {
                          "error": {
                            "description": "A sentence you can show to a person.",
                            "type": "string"
                          },
                          "field": {
                            "description": "The form field at fault, when there is one.",
                            "type": "string"
                          },
                          "detail": {
                            "description": "The upstream service's own message, for debugging.",
                            "type": "string"
                          }
                        },
                        "required": [
                          "error"
                        ]
                      }
              '404':
                description: No such shop, or the admin token or API key doesn't match it.
                body:
                  application/json:
                    schema: |
                      {
                        "id": "Error",
                        "title": "Error",
                        "type": "object",
                        "properties": {
                          "error": {
                            "description": "A sentence you can show to a person.",
                            "type": "string"
                          },
                          "field": {
                            "description": "The form field at fault, when there is one.",
                            "type": "string"
                          },
                          "detail": {
                            "description": "The upstream service's own message, for debugging.",
                            "type": "string"
                          }
                        },
                        "required": [
                          "error"
                        ]
                      }
        get:
          securedBy:
          - AdminToken
          - PlatformKey
          description: Newest first. Checkouts that were never approved are left out.
          responses:
            '200':
              description: Orders.
              body:
                application/json:
                  schema: |
                    {
                      "description": "",
                      "type": "array",
                      "items": {
                        "id": "Order",
                        "title": "Order",
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "status": {
                            "title": "Status3",
                            "type": "string",
                            "additionalProperties": false,
                            "enum": [
                              "created",
                              "paid",
                              "failed"
                            ]
                          },
                          "amount_cents": {
                            "type": "integer",
                            "format": "int32"
                          },
                          "currency": {
                            "type": "string"
                          },
                          "fulfillment_status": {
                            "title": "FulfillmentStatus",
                            "type": "string",
                            "additionalProperties": false,
                            "enum": [
                              "none",
                              "to_ship",
                              "shipped",
                              "digital_sent"
                            ]
                          },
                          "paypal_order_id": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "shipping_cents": {
                            "type": "integer",
                            "format": "int32"
                          },
                          "buyer_email": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "buyer_name": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "shipping_address": {
                            "type": [
                              "object",
                              "null"
                            ],
                            "additionalProperties": {
                              "type": "string"
                            }
                          },
                          "capture_id": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "carrier": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "tracking_number": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "tracking_synced": {
                            "type": "boolean"
                          },
                          "downloads": {
                            "type": "integer",
                            "format": "int32"
                          },
                          "access_code": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "code_uses": {
                            "type": "integer",
                            "format": "int32"
                          },
                          "channel": {
                            "title": "Channel",
                            "description": "`agent` for orders an AI agent placed through the MCP server.",
                            "type": "string",
                            "additionalProperties": false,
                            "enum": [
                              "web",
                              "agent"
                            ]
                          },
                          "options": {
                            "type": [
                              "object",
                              "null"
                            ],
                            "additionalProperties": {
                              "oneOf": [
                                {
                                  "example": {
                                    "Size": "M",
                                    "Color": "Black"
                                  },
                                  "type": "object",
                                  "additionalProperties": {
                                    "type": "string"
                                  }
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            }
                          },
                          "paid_at": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "format": "date-time"
                          },
                          "created_at": {
                            "type": "string",
                            "format": "date-time"
                          }
                        },
                        "required": [
                          "id",
                          "status",
                          "amount_cents",
                          "currency",
                          "fulfillment_status"
                        ]
                      }
                    }
            '404':
              description: No such shop, or the admin token or API key doesn't match it.
              body:
                application/json:
                  schema: |
                    {
                      "id": "Error",
                      "title": "Error",
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "A sentence you can show to a person.",
                          "type": "string"
                        },
                        "field": {
                          "description": "The form field at fault, when there is one.",
                          "type": "string"
                        },
                        "detail": {
                          "description": "The upstream service's own message, for debugging.",
                          "type": "string"
                        }
                      },
                      "required": [
                        "error"
                      ]
                    }
      /webhooks:
        uriParameters: {}
        get:
          securedBy:
          - AdminToken
          - PlatformKey
          description: The last 50 PayPal webhook deliveries about this shop's orders, with signature results.
          responses:
            '200':
              description: Events, newest first.
              body:
                application/json:
                  schema: |
                    {
                      "description": "",
                      "type": "array",
                      "items": {
                        "id": "WebhookEvent",
                        "title": "WebhookEvent",
                        "type": "object",
                        "properties": {
                          "id": {
                            "description": "PayPal's event id.",
                            "type": "string"
                          },
                          "event_type": {
                            "example": "PAYMENT.CAPTURE.COMPLETED",
                            "type": "string"
                          },
                          "verified": {
                            "description": "Whether PayPal confirmed the delivery's signature.",
                            "type": "boolean"
                          },
                          "outcome": {
                            "example": "Confirmed: order already paid",
                            "type": "string"
                          },
                          "received_at": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "paypal_order_id": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "summary": {
                            "example": "2.99 USD",
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        },
                        "required": [
                          "id",
                          "event_type",
                          "verified",
                          "outcome",
                          "received_at"
                        ]
                      }
                    }
            '404':
              description: No such shop, or the admin token or API key doesn't match it.
              body:
                application/json:
                  schema: |
                    {
                      "id": "Error",
                      "title": "Error",
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "A sentence you can show to a person.",
                          "type": "string"
                        },
                        "field": {
                          "description": "The form field at fault, when there is one.",
                          "type": "string"
                        },
                        "detail": {
                          "description": "The upstream service's own message, for debugging.",
                          "type": "string"
                        }
                      },
                      "required": [
                        "error"
                      ]
                    }
      get:
        securedBy:
        - AdminToken
        - PlatformKey
        description: Everything about the shop, including the AI's design spec and guesses.
        responses:
          '200':
            description: The shop.
            body:
              application/json:
                schema: |
                  {
                    "id": "Shop",
                    "title": "Shop",
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "slug": {
                        "type": "string"
                      },
                      "status": {
                        "title": "Status",
                        "type": "string",
                        "additionalProperties": false,
                        "enum": [
                          "draft",
                          "live"
                        ]
                      },
                      "product_type": {
                        "title": "ProductType1",
                        "type": "string",
                        "additionalProperties": false,
                        "enum": [
                          "physical",
                          "digital",
                          "referral"
                        ]
                      },
                      "price_cents": {
                        "type": "integer",
                        "format": "int32"
                      },
                      "currency": {
                        "example": "USD",
                        "type": "string"
                      },
                      "spec": {
                        "id": "DesignSpec",
                        "title": "DesignSpec",
                        "description": "What Gemini designed. OneThing's templates render it; Gemini never writes HTML.",
                        "type": "object",
                        "properties": {
                          "productType": {
                            "title": "ProductType2",
                            "type": "string",
                            "additionalProperties": false,
                            "enum": [
                              "digital",
                              "physical"
                            ]
                          },
                          "productName": {
                            "type": "string"
                          },
                          "layout": {
                            "title": "Layout",
                            "type": "string",
                            "additionalProperties": false,
                            "enum": [
                              "bold-hero",
                              "editorial",
                              "minimal",
                              "playful"
                            ]
                          },
                          "palette": {
                            "id": "Palette",
                            "title": "Palette",
                            "type": "object",
                            "properties": {
                              "background": {
                                "example": "#14171a",
                                "type": "string",
                                "pattern": "^#[0-9a-fA-F]{6}$"
                              },
                              "surface": {
                                "example": "#14171a",
                                "type": "string",
                                "pattern": "^#[0-9a-fA-F]{6}$"
                              },
                              "text": {
                                "example": "#14171a",
                                "type": "string",
                                "pattern": "^#[0-9a-fA-F]{6}$"
                              },
                              "muted": {
                                "example": "#14171a",
                                "type": "string",
                                "pattern": "^#[0-9a-fA-F]{6}$"
                              },
                              "accent": {
                                "example": "#14171a",
                                "type": "string",
                                "pattern": "^#[0-9a-fA-F]{6}$"
                              },
                              "accentText": {
                                "example": "#14171a",
                                "type": "string",
                                "pattern": "^#[0-9a-fA-F]{6}$"
                              }
                            },
                            "required": [
                              "background",
                              "surface",
                              "text",
                              "muted",
                              "accent",
                              "accentText"
                            ]
                          },
                          "fonts": {
                            "id": "Fonts",
                            "title": "Fonts",
                            "type": "object",
                            "properties": {
                              "heading": {
                                "type": "string"
                              },
                              "body": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "heading",
                              "body"
                            ]
                          },
                          "headline": {
                            "type": "string"
                          },
                          "bullets": {
                            "description": "",
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "faq": {
                            "description": "",
                            "type": "array",
                            "items": {
                              "id": "Faq",
                              "title": "Faq",
                              "type": "object",
                              "properties": {
                                "q": {
                                  "type": "string"
                                },
                                "a": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "q",
                                "a"
                              ]
                            }
                          },
                          "ctaLabel": {
                            "type": "string"
                          },
                          "eyebrow": {
                            "type": "string"
                          },
                          "subheadline": {
                            "type": "string"
                          },
                          "story": {
                            "type": "string"
                          },
                          "details": {
                            "description": "",
                            "type": "array",
                            "items": {
                              "id": "Detail",
                              "title": "Detail",
                              "type": "object",
                              "properties": {
                                "label": {
                                  "type": "string"
                                },
                                "value": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "label",
                                "value"
                              ]
                            }
                          },
                          "suggestedPriceUsd": {
                            "type": "number"
                          },
                          "suggestedShippingUsd": {
                            "type": "number"
                          },
                          "imageAlt": {
                            "type": "string"
                          },
                          "heroPrompt": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "productType",
                          "productName",
                          "layout",
                          "palette",
                          "fonts",
                          "headline",
                          "bullets",
                          "faq",
                          "ctaLabel"
                        ]
                      },
                      "shipping_cents": {
                        "type": "integer",
                        "format": "int32"
                      },
                      "ship_countries": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "stock": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "format": "int32"
                      },
                      "delivery": {
                        "title": "Delivery1",
                        "type": "string",
                        "additionalProperties": false,
                        "enum": [
                          "file",
                          "access_code"
                        ]
                      },
                      "access_url": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "paypal_email": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "seller_email": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "paypal_merchant_id": {
                        "description": "The connected PayPal account (`connectPayPal`). Sales go here when it can receive payments.",
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "paypal_status": {
                        "oneOf": [
                          {
                            "id": "PayPalStatus",
                            "title": "PayPalStatus",
                            "description": "What PayPal last said about a connected seller account.",
                            "type": "object",
                            "properties": {
                              "receivable": {
                                "description": "The account can receive payments.",
                                "type": "boolean"
                              },
                              "emailConfirmed": {
                                "description": "The seller has confirmed their email with PayPal.",
                                "type": "boolean"
                              },
                              "checkedAt": {
                                "type": "string",
                                "format": "date-time"
                              }
                            },
                            "required": [
                              "receivable",
                              "emailConfirmed",
                              "checkedAt"
                            ]
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "zapier_hook_url": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "in_gallery": {
                        "type": "boolean"
                      },
                      "account_id": {
                        "description": "The seller account that owns the shop, if it was made while signed in.",
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "options": {
                        "description": "",
                        "type": "array",
                        "items": {
                          "id": "ShopOption",
                          "title": "ShopOption",
                          "description": "Something the buyer picks, such as a size or a colour. The shop still sells one product.",
                          "type": "object",
                          "properties": {
                            "name": {
                              "example": "Size",
                              "type": "string",
                              "maxLength": 20
                            },
                            "kind": {
                              "title": "Kind",
                              "description": "`color` shows swatches, and the photo of the picked colour.",
                              "type": "string",
                              "additionalProperties": false,
                              "enum": [
                                "size",
                                "color",
                                "other"
                              ]
                            },
                            "values": {
                              "description": "",
                              "type": "array",
                              "items": {
                                "id": "OptionValue",
                                "title": "OptionValue",
                                "type": "object",
                                "properties": {
                                  "label": {
                                    "example": "M",
                                    "type": "string",
                                    "maxLength": 30
                                  },
                                  "hex": {
                                    "example": "#14171a",
                                    "type": "string",
                                    "pattern": "^#[0-9a-fA-F]{6}$"
                                  },
                                  "photo": {
                                    "description": "Colours: the shop photo (id) that shows this colour. See `matchColorPhotos`.",
                                    "type": "string"
                                  }
                                },
                                "required": [
                                  "label"
                                ]
                              },
                              "minItems": 1,
                              "maxItems": 12
                            }
                          },
                          "required": [
                            "name",
                            "kind",
                            "values"
                          ]
                        }
                      },
                      "option_stock": {
                        "description": "Stock per combination, keyed by its values in option order joined with ` / ` (e.g. `M / Black`). A missing key or `null` means unlimited; `0` is sold out.",
                        "example": {
                          "M / Black": 4,
                          "L / Black": 0
                        },
                        "type": "object",
                        "additionalProperties": {
                          "type": [
                            "integer",
                            "null"
                          ],
                          "format": "int32"
                        },
                        "minimum": 0.0
                      },
                      "suggestions": {
                        "oneOf": [
                          {
                            "id": "Suggestions",
                            "title": "Suggestions",
                            "description": "What Gemini thinks buyers will want to choose or ask. The seller confirms; nothing is applied on its own.",
                            "type": "object",
                            "properties": {
                              "oneOfAKind": {
                                "description": "A single item (vintage, handmade), so options and stock don't apply.",
                                "type": "boolean"
                              },
                              "options": {
                                "description": "",
                                "type": "array",
                                "items": {
                                  "id": "Option",
                                  "title": "Option",
                                  "type": "object",
                                  "properties": {
                                    "name": {
                                      "example": "Size",
                                      "type": "string",
                                      "maxLength": 20
                                    },
                                    "kind": {
                                      "$ref": "ShopOption#/properties/kind"
                                    },
                                    "values": {
                                      "description": "",
                                      "type": "array",
                                      "items": {
                                        "$ref": "OptionValue"
                                      },
                                      "minItems": 1,
                                      "maxItems": 12
                                    },
                                    "fromSeller": {
                                      "description": "The seller's description or photo named these values; otherwise they're a guess.",
                                      "type": "boolean"
                                    }
                                  },
                                  "required": [
                                    "name",
                                    "kind",
                                    "values"
                                  ]
                                }
                              },
                              "missingFacts": {
                                "description": "",
                                "type": "array",
                                "items": {
                                  "id": "MissingFact",
                                  "title": "MissingFact",
                                  "type": "object",
                                  "properties": {
                                    "label": {
                                      "example": "Size",
                                      "type": "string"
                                    },
                                    "question": {
                                      "example": "What size are the skates?",
                                      "type": "string"
                                    },
                                    "placeholder": {
                                      "example": "US women's 8",
                                      "type": "string"
                                    }
                                  },
                                  "required": [
                                    "label",
                                    "question",
                                    "placeholder"
                                  ]
                                }
                              }
                            },
                            "required": [
                              "oneOfAKind",
                              "options",
                              "missingFacts"
                            ]
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "photo_blob": {
                        "description": "Image id for `getImage`. The cover photo.",
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "gallery_blobs": {
                        "description": "The other photos, in order.",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "hero_blob": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "hero_status": {
                        "title": "HeroStatus",
                        "type": "string",
                        "additionalProperties": false,
                        "enum": [
                          "none",
                          "pending",
                          "ready",
                          "failed"
                        ]
                      },
                      "hero_error": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "ai_source": {
                        "title": "AiSource",
                        "type": "string",
                        "additionalProperties": false,
                        "enum": [
                          "gemini",
                          "fallback"
                        ]
                      },
                      "source_url": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "referral": {
                        "oneOf": [
                          {
                            "id": "Referral",
                            "title": "Referral",
                            "description": "A recommended Channel3 product. Buy links are Channel3-tracked, credited to this shop.",
                            "type": "object",
                            "properties": {
                              "productId": {
                                "type": "string"
                              },
                              "title": {
                                "type": "string"
                              },
                              "offers": {
                                "description": "",
                                "type": "array",
                                "items": {
                                  "id": "Offer",
                                  "title": "Offer",
                                  "type": "object",
                                  "properties": {
                                    "domain": {
                                      "type": "string"
                                    },
                                    "url": {
                                      "type": "string"
                                    },
                                    "price": {
                                      "type": "number"
                                    },
                                    "currency": {
                                      "type": "string"
                                    },
                                    "inStock": {
                                      "type": "boolean"
                                    },
                                    "commission": {
                                      "description": "Maximum commission rate, 0–1 (0.08 = 8%).",
                                      "type": "number"
                                    }
                                  },
                                  "required": [
                                    "domain",
                                    "url",
                                    "price",
                                    "currency",
                                    "inStock",
                                    "commission"
                                  ]
                                }
                              },
                              "brand": {
                                "type": [
                                  "string",
                                  "null"
                                ]
                              },
                              "image": {
                                "type": [
                                  "string",
                                  "null"
                                ]
                              }
                            },
                            "required": [
                              "productId",
                              "title",
                              "offers"
                            ]
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "created_at": {
                        "type": "string",
                        "format": "date-time"
                      }
                    },
                    "required": [
                      "id",
                      "slug",
                      "status",
                      "product_type",
                      "price_cents",
                      "currency",
                      "spec"
                    ]
                  }
          '404':
            description: No such shop, or the admin token or API key doesn't match it.
            body:
              application/json:
                schema: |
                  {
                    "id": "Error",
                    "title": "Error",
                    "type": "object",
                    "properties": {
                      "error": {
                        "description": "A sentence you can show to a person.",
                        "type": "string"
                      },
                      "field": {
                        "description": "The form field at fault, when there is one.",
                        "type": "string"
                      },
                      "detail": {
                        "description": "The upstream service's own message, for debugging.",
                        "type": "string"
                      }
                    },
                    "required": [
                      "error"
                    ]
                  }
      patch:
        securedBy:
        - AdminToken
        - PlatformKey
        description: >
          Changes only the fields you send. Renaming `slug` keeps the old link working (it

          redirects). Set `status: live` to publish; a digital product needs its file (or, for

          access codes, `access_url`) first.
        headers:
          Content-Type:
            required: true
            displayName: Content-Type
            enum:
            - application/json
        body:
          application/json:
            schema: |
              {
                "id": "ShopUpdate",
                "title": "ShopUpdate",
                "type": "object",
                "properties": {
                  "slug": {
                    "type": "string"
                  },
                  "status": {
                    "title": "Status",
                    "type": "string",
                    "additionalProperties": false,
                    "enum": [
                      "draft",
                      "live"
                    ]
                  },
                  "product_type": {
                    "title": "ProductType",
                    "description": "`referral` only for shops created from Channel3.",
                    "type": "string",
                    "additionalProperties": false,
                    "enum": [
                      "physical",
                      "digital",
                      "referral"
                    ]
                  },
                  "price": {
                    "type": "number",
                    "minimum": 0.5,
                    "maximum": 10000.0
                  },
                  "shipping": {
                    "type": "number",
                    "minimum": 0.0,
                    "maximum": 500.0
                  },
                  "stock": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0.0,
                    "format": "int32"
                  },
                  "ship_countries": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "delivery": {
                    "title": "Delivery1",
                    "type": "string",
                    "additionalProperties": false,
                    "enum": [
                      "file",
                      "access_code"
                    ]
                  },
                  "access_url": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "uri"
                  },
                  "paypal_email": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "email"
                  },
                  "seller_email": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "email"
                  },
                  "zapier_hook_url": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "uri"
                  },
                  "in_gallery": {
                    "description": "Feature the shop at `/gallery` while it's live. Off by default.",
                    "type": "boolean"
                  },
                  "options": {
                    "description": "What the buyer picks (physical products only), replacing the current options; `[]` removes them. With options, stock is counted per combination in `option_stock` and the shop's own `stock` is cleared. At most 60 combinations.",
                    "type": "array",
                    "items": {
                      "id": "ShopOption",
                      "title": "ShopOption",
                      "description": "Something the buyer picks, such as a size or a colour. The shop still sells one product.",
                      "type": "object",
                      "properties": {
                        "name": {
                          "example": "Size",
                          "type": "string",
                          "maxLength": 20
                        },
                        "kind": {
                          "title": "Kind",
                          "description": "`color` shows swatches, and the photo of the picked colour.",
                          "type": "string",
                          "additionalProperties": false,
                          "enum": [
                            "size",
                            "color",
                            "other"
                          ]
                        },
                        "values": {
                          "description": "",
                          "type": "array",
                          "items": {
                            "id": "OptionValue",
                            "title": "OptionValue",
                            "type": "object",
                            "properties": {
                              "label": {
                                "example": "M",
                                "type": "string",
                                "maxLength": 30
                              },
                              "hex": {
                                "example": "#14171a",
                                "type": "string",
                                "pattern": "^#[0-9a-fA-F]{6}$"
                              },
                              "photo": {
                                "description": "Colours: the shop photo (id) that shows this colour. See `matchColorPhotos`.",
                                "type": "string"
                              }
                            },
                            "required": [
                              "label"
                            ]
                          },
                          "minItems": 1,
                          "maxItems": 12
                        }
                      },
                      "required": [
                        "name",
                        "kind",
                        "values"
                      ]
                    },
                    "maxItems": 3
                  },
                  "option_stock": {
                    "description": "Stock per combination, keyed by its values in option order joined with ` / ` (e.g. `M / Black`). A missing key or `null` means unlimited; `0` is sold out.",
                    "example": {
                      "M / Black": 4,
                      "L / Black": 0
                    },
                    "type": "object",
                    "additionalProperties": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "format": "int32"
                    },
                    "minimum": 0.0
                  },
                  "facts": {
                    "description": "Answers to the \"buyers will ask\" questions in `suggestions.missingFacts`. Each becomes a product detail on the page (replacing one with the same label) and drops off the list.",
                    "type": "array",
                    "items": {
                      "id": "Fact",
                      "title": "Fact",
                      "type": "object",
                      "properties": {
                        "label": {
                          "example": "Size",
                          "type": "string",
                          "maxLength": 30
                        },
                        "value": {
                          "example": "US women's 8",
                          "type": "string",
                          "maxLength": 100
                        }
                      },
                      "required": [
                        "label",
                        "value"
                      ]
                    },
                    "maxItems": 5
                  }
                }
              }
            example: ''
        responses:
          '200':
            description: Saved.
            body:
              application/json:
                schema: |
                  {
                    "id": "ApiShopsResponse",
                    "title": "ApiShopsResponse",
                    "type": "object",
                    "properties": {
                      "ok": {
                        "type": "boolean"
                      },
                      "slug": {
                        "description": "The shop's link name after this change.",
                        "type": "string"
                      }
                    },
                    "required": [
                      "ok",
                      "slug"
                    ]
                  }
          '400':
            description: Something in the request needs fixing; `error` says what.
            body:
              application/json:
                schema: |
                  {
                    "id": "Error",
                    "title": "Error",
                    "type": "object",
                    "properties": {
                      "error": {
                        "description": "A sentence you can show to a person.",
                        "type": "string"
                      },
                      "field": {
                        "description": "The form field at fault, when there is one.",
                        "type": "string"
                      },
                      "detail": {
                        "description": "The upstream service's own message, for debugging.",
                        "type": "string"
                      }
                    },
                    "required": [
                      "error"
                    ]
                  }
          '404':
            description: No such shop, or the admin token or API key doesn't match it.
            body:
              application/json:
                schema: |
                  {
                    "id": "Error",
                    "title": "Error",
                    "type": "object",
                    "properties": {
                      "error": {
                        "description": "A sentence you can show to a person.",
                        "type": "string"
                      },
                      "field": {
                        "description": "The form field at fault, when there is one.",
                        "type": "string"
                      },
                      "detail": {
                        "description": "The upstream service's own message, for debugging.",
                        "type": "string"
                      }
                    },
                    "required": [
                      "error"
                    ]
                  }
    post:
      securedBy:
      - null
      - PlatformKey
      description: >
        Starts a draft shop from one of three sources. Gemini designs the page and guesses the

        setup; check it with `getShop`, adjust with `updateShop`, then go live.


        Sent with a session cookie from `signIn`, the shop belongs to that account, which also

        becomes its seller email (and PayPal email, after Log in with PayPal) unless you give one.


        - `source=photo`: a `photo` and/or a `description` of your own product.

        - `source=link`: a `url`. If Channel3 recognises it as a store's product page, the shop
          becomes a recommendation (`product_type: referral`); otherwise the page is read and you
          sell the product yourself with PayPal.
        - `source=channel3`: a `productId` from `searchProducts` (a recommendation).


        Takes 15–40 seconds. Hero art, if available, is generated afterwards (`hero_status`).


        **Platforms:** sent with a platform API key, the shop belongs to the key's account, so the

        key can manage it from then on (no need to keep the admin token). It's made for one of the

        platform's sellers, so it inherits nothing from the account: set `paypal_email` or call

        `connectPayPal` for that seller.
      body:
        multipart/form-data:
          formParameters:
            source:
              required: true
              displayName: source
              enum:
              - photo
              - link
              - channel3
            photo:
              description: '`source=photo`: the product photo, up to 8 MB.'
              type: file
              required: false
              displayName: photo
            description:
              description: '`source=photo`: a sentence or two about the product. Required if there is no photo.'
              type: string
              required: false
              displayName: description
            url:
              description: '`source=link`: a product page, or your own app or game page.'
              type: string
              required: false
              displayName: url
            productId:
              description: '`source=channel3`: a product id from `searchProducts`.'
              type: string
              required: false
              displayName: productId
            slug:
              description: The link name you want. If omitted, the AI suggests one.
              type: string
              required: false
              displayName: slug
            type:
              default: auto
              required: false
              displayName: type
              enum:
              - auto
              - physical
              - digital
            delivery:
              description: For digital products. If omitted, the AI guesses.
              required: false
              displayName: delivery
              enum:
              - file
              - access_code
            access_url:
              description: Where buyers use an access code.
              type: string
              required: false
              displayName: access_url
            price:
              description: USD. If omitted, the AI suggests a price.
              type: number
              required: false
              displayName: price
            shipping:
              type: number
              required: false
              displayName: shipping
            stock:
              type: integer
              required: false
              displayName: stock
            ship_countries:
              type: string
              required: false
              displayName: ship_countries
            paypal_email:
              type: string
              required: false
              displayName: paypal_email
            seller_email:
              type: string
              required: false
              displayName: seller_email
            digital_file:
              type: file
              required: false
              displayName: digital_file
      responses:
        '200':
          description: Draft created.
          body:
            application/json:
              schema: |
                {
                  "id": "CreatedShop",
                  "title": "CreatedShop",
                  "type": "object",
                  "properties": {
                    "slug": {
                      "example": "dragonflight",
                      "type": "string"
                    },
                    "token": {
                      "description": "The admin token. Shown once; store it.",
                      "type": "string"
                    },
                    "manageUrl": {
                      "description": "The seller's private manage page (contains the token).",
                      "type": "string"
                    }
                  },
                  "required": [
                    "slug",
                    "token",
                    "manageUrl"
                  ]
                }
        '400':
          description: Something in the request needs fixing; `error` says what.
          body:
            application/json:
              schema: |
                {
                  "id": "Error",
                  "title": "Error",
                  "type": "object",
                  "properties": {
                    "error": {
                      "description": "A sentence you can show to a person.",
                      "type": "string"
                    },
                    "field": {
                      "description": "The form field at fault, when there is one.",
                      "type": "string"
                    },
                    "detail": {
                      "description": "The upstream service's own message, for debugging.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
        '409':
          description: Taken or unavailable (a link name, or a sold-out product).
          body:
            application/json:
              schema: |
                {
                  "id": "Error",
                  "title": "Error",
                  "type": "object",
                  "properties": {
                    "error": {
                      "description": "A sentence you can show to a person.",
                      "type": "string"
                    },
                    "field": {
                      "description": "The form field at fault, when there is one.",
                      "type": "string"
                    },
                    "detail": {
                      "description": "The upstream service's own message, for debugging.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
        '502':
          description: Gemini, PayPal or Channel3 failed or isn't configured.
          body:
            application/json:
              schema: |
                {
                  "id": "Error",
                  "title": "Error",
                  "type": "object",
                  "properties": {
                    "error": {
                      "description": "A sentence you can show to a person.",
                      "type": "string"
                    },
                    "field": {
                      "description": "The form field at fault, when there is one.",
                      "type": "string"
                    },
                    "detail": {
                      "description": "The upstream service's own message, for debugging.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
  /slugs/check:
    get:
      description: Normalises a proposed link name and says whether a new shop can use it.
      queryParameters:
        name:
          description: Anything; it is normalised (`Raptor Rush` becomes `raptor-rush`).
          type: string
          required: true
          displayName: name
      responses:
        '200':
          description: The normalised name and whether it can be used.
          body:
            application/json:
              schema: |
                {
                  "id": "ApiSlugsCheckResponse",
                  "title": "ApiSlugsCheckResponse",
                  "type": "object",
                  "properties": {
                    "slug": {
                      "type": "string"
                    },
                    "available": {
                      "type": "boolean"
                    },
                    "problem": {
                      "description": "Why not, when unavailable.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "slug",
                    "available"
                  ]
                }
  /channel3/search:
    get:
      description: Searches 100M+ products from 25k+ stores through Channel3. Pass a result's `id` to `createShop` with `source=channel3`.
      queryParameters:
        q:
          description: What to look for, in plain words.
          type: string
          example: gifts for trail runners under $60
          required: true
          displayName: q
          maxLength: '200'
      responses:
        '200':
          description: Up to 12 products.
          body:
            application/json:
              schema: |
                {
                  "id": "ApiChannel3SearchResponse",
                  "title": "ApiChannel3SearchResponse",
                  "type": "object",
                  "properties": {
                    "products": {
                      "description": "",
                      "type": "array",
                      "items": {
                        "id": "ProductCard",
                        "title": "ProductCard",
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "title": {
                            "type": "string"
                          },
                          "image": {
                            "type": "string"
                          },
                          "price": {
                            "type": "number"
                          },
                          "currency": {
                            "type": "string"
                          },
                          "retailer": {
                            "description": "The store with the best offer.",
                            "type": "string"
                          },
                          "retailers": {
                            "type": "integer",
                            "format": "int32"
                          },
                          "commission": {
                            "description": "Best commission rate across offers, 0–1.",
                            "type": "number"
                          },
                          "brand": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        },
                        "required": [
                          "id",
                          "title",
                          "image",
                          "price",
                          "currency",
                          "retailer",
                          "retailers",
                          "commission"
                        ]
                      }
                    }
                  },
                  "required": [
                    "products"
                  ]
                }
        '502':
          description: Gemini, PayPal or Channel3 failed or isn't configured.
          body:
            application/json:
              schema: |
                {
                  "id": "Error",
                  "title": "Error",
                  "type": "object",
                  "properties": {
                    "error": {
                      "description": "A sentence you can show to a person.",
                      "type": "string"
                    },
                    "field": {
                      "description": "The form field at fault, when there is one.",
                      "type": "string"
                    },
                    "detail": {
                      "description": "The upstream service's own message, for debugging.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
        '503':
          description: Gemini, PayPal or Channel3 failed or isn't configured.
          body:
            application/json:
              schema: |
                {
                  "id": "Error",
                  "title": "Error",
                  "type": "object",
                  "properties": {
                    "error": {
                      "description": "A sentence you can show to a person.",
                      "type": "string"
                    },
                    "field": {
                      "description": "The form field at fault, when there is one.",
                      "type": "string"
                    },
                    "detail": {
                      "description": "The upstream service's own message, for debugging.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
  /paypal/client-token:
    get:
      description: >
        A browser-safe client token for the PayPal JavaScript SDK v6

        (`paypal.createInstance({ clientToken })`), bound to the requesting site's domain.

        Shop pages call this before showing the PayPal button.
      responses:
        '200':
          description: A token for this site's domain.
          body:
            application/json:
              schema: |
                {
                  "id": "ApiPaypalClientTokenResponse",
                  "title": "ApiPaypalClientTokenResponse",
                  "type": "object",
                  "properties": {
                    "clientToken": {
                      "description": "Pass to `createInstance` in the PayPal JavaScript SDK v6.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "clientToken"
                  ]
                }
        '502':
          description: Gemini, PayPal or Channel3 failed or isn't configured.
          body:
            application/json:
              schema: |
                {
                  "id": "Error",
                  "title": "Error",
                  "type": "object",
                  "properties": {
                    "error": {
                      "description": "A sentence you can show to a person.",
                      "type": "string"
                    },
                    "field": {
                      "description": "The form field at fault, when there is one.",
                      "type": "string"
                    },
                    "detail": {
                      "description": "The upstream service's own message, for debugging.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
        '503':
          description: Gemini, PayPal or Channel3 failed or isn't configured.
          body:
            application/json:
              schema: |
                {
                  "id": "Error",
                  "title": "Error",
                  "type": "object",
                  "properties": {
                    "error": {
                      "description": "A sentence you can show to a person.",
                      "type": "string"
                    },
                    "field": {
                      "description": "The form field at fault, when there is one.",
                      "type": "string"
                    },
                    "detail": {
                      "description": "The upstream service's own message, for debugging.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
  /orders:
    /{paypalOrderId}/capture:
      uriParameters:
        paypalOrderId:
          description: The PayPal order id that `createCheckoutOrder` returned.
          type: string
          required: true
          displayName: paypalOrderId
      post:
        description: >
          Call after the buyer approves. Records the sale; digital orders get a download link or access code.

          Safe to call repeatedly: before approval it answers 409, so a page can poll it while the PayPal window is open.
        responses:
          '200':
            description: Paid.
            body:
              application/json:
                schema: |
                  {
                    "id": "ApiOrdersCaptureResponse",
                    "title": "ApiOrdersCaptureResponse",
                    "type": "object",
                    "properties": {
                      "orderId": {
                        "description": "OneThing's order id; the thank-you page is `/<slug>/thanks?order=<orderId>`.",
                        "type": "string"
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "paid"
                        ]
                      }
                    },
                    "required": [
                      "orderId",
                      "status"
                    ]
                  }
          '402':
            description: Something in the request needs fixing; `error` says what.
            body:
              application/json:
                schema: |
                  {
                    "id": "Error",
                    "title": "Error",
                    "type": "object",
                    "properties": {
                      "error": {
                        "description": "A sentence you can show to a person.",
                        "type": "string"
                      },
                      "field": {
                        "description": "The form field at fault, when there is one.",
                        "type": "string"
                      },
                      "detail": {
                        "description": "The upstream service's own message, for debugging.",
                        "type": "string"
                      }
                    },
                    "required": [
                      "error"
                    ]
                  }
          '404':
            description: No such shop, or the admin token or API key doesn't match it.
            body:
              application/json:
                schema: |
                  {
                    "id": "Error",
                    "title": "Error",
                    "type": "object",
                    "properties": {
                      "error": {
                        "description": "A sentence you can show to a person.",
                        "type": "string"
                      },
                      "field": {
                        "description": "The form field at fault, when there is one.",
                        "type": "string"
                      },
                      "detail": {
                        "description": "The upstream service's own message, for debugging.",
                        "type": "string"
                      }
                    },
                    "required": [
                      "error"
                    ]
                  }
          '409':
            description: The buyer hasn't approved the order yet.
            body:
              application/json:
                schema: |
                  {
                    "id": "ApiOrdersCapture409Error1",
                    "title": "ApiOrdersCapture409Error1",
                    "type": "object",
                    "properties": {
                      "status": {
                        "title": "Status5",
                        "type": "string",
                        "additionalProperties": false,
                        "enum": [
                          "pending"
                        ]
                      }
                    }
                  }
          '410':
            description: The last unit (or the last of the buyer's combination) sold while they were paying. The payment isn't captured, so the buyer isn't charged.
            body:
              application/json:
                schema: |
                  {
                    "id": "Error",
                    "title": "Error",
                    "type": "object",
                    "properties": {
                      "error": {
                        "description": "A sentence you can show to a person.",
                        "type": "string"
                      },
                      "field": {
                        "description": "The form field at fault, when there is one.",
                        "type": "string"
                      },
                      "detail": {
                        "description": "The upstream service's own message, for debugging.",
                        "type": "string"
                      }
                    },
                    "required": [
                      "error"
                    ]
                  }
          '422':
            description: The buyer's funding source was declined (`INSTRUMENT_DECLINED`); they can try another.
            body:
              application/json:
                schema: |
                  {
                    "id": "Error",
                    "title": "Error",
                    "type": "object",
                    "properties": {
                      "error": {
                        "description": "A sentence you can show to a person.",
                        "type": "string"
                      },
                      "field": {
                        "description": "The form field at fault, when there is one.",
                        "type": "string"
                      },
                      "detail": {
                        "description": "The upstream service's own message, for debugging.",
                        "type": "string"
                      }
                    },
                    "required": [
                      "error"
                    ]
                  }
          '502':
            description: Gemini, PayPal or Channel3 failed or isn't configured.
            body:
              application/json:
                schema: |
                  {
                    "id": "Error",
                    "title": "Error",
                    "type": "object",
                    "properties": {
                      "error": {
                        "description": "A sentence you can show to a person.",
                        "type": "string"
                      },
                      "field": {
                        "description": "The form field at fault, when there is one.",
                        "type": "string"
                      },
                      "detail": {
                        "description": "The upstream service's own message, for debugging.",
                        "type": "string"
                      }
                    },
                    "required": [
                      "error"
                    ]
                  }
    post:
      description: >
        Creates the PayPal order for one unit of a live shop's product. The amount always comes

        from the shop, never from the caller. Pass the returned `id` to the PayPal JS SDK.


        If the shop has buyer `options`, send one value for each. A sold-out combination answers 409.
      headers:
        Content-Type:
          required: true
          displayName: Content-Type
          enum:
          - application/json
      body:
        application/json:
          schema: |
            {
              "id": "ApiOrdersRequest",
              "title": "ApiOrdersRequest",
              "type": "object",
              "properties": {
                "slug": {
                  "type": "string"
                },
                "options": {
                  "description": "The buyer's pick, one value per option, keyed by option name.",
                  "example": {
                    "Size": "M",
                    "Color": "Black"
                  },
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "slug"
              ]
            }
          example: ''
      responses:
        '200':
          description: PayPal order created.
          body:
            application/json:
              schema: |
                {
                  "id": "ApiOrdersResponse",
                  "title": "ApiOrdersResponse",
                  "type": "object",
                  "properties": {
                    "id": {
                      "description": "PayPal order id.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "id"
                  ]
                }
        '400':
          description: Something in the request needs fixing; `error` says what.
          body:
            application/json:
              schema: |
                {
                  "id": "Error",
                  "title": "Error",
                  "type": "object",
                  "properties": {
                    "error": {
                      "description": "A sentence you can show to a person.",
                      "type": "string"
                    },
                    "field": {
                      "description": "The form field at fault, when there is one.",
                      "type": "string"
                    },
                    "detail": {
                      "description": "The upstream service's own message, for debugging.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
        '404':
          description: No such shop, or the admin token or API key doesn't match it.
          body:
            application/json:
              schema: |
                {
                  "id": "Error",
                  "title": "Error",
                  "type": "object",
                  "properties": {
                    "error": {
                      "description": "A sentence you can show to a person.",
                      "type": "string"
                    },
                    "field": {
                      "description": "The form field at fault, when there is one.",
                      "type": "string"
                    },
                    "detail": {
                      "description": "The upstream service's own message, for debugging.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
        '409':
          description: Taken or unavailable (a link name, or a sold-out product).
          body:
            application/json:
              schema: |
                {
                  "id": "Error",
                  "title": "Error",
                  "type": "object",
                  "properties": {
                    "error": {
                      "description": "A sentence you can show to a person.",
                      "type": "string"
                    },
                    "field": {
                      "description": "The form field at fault, when there is one.",
                      "type": "string"
                    },
                    "detail": {
                      "description": "The upstream service's own message, for debugging.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
        '502':
          description: Gemini, PayPal or Channel3 failed or isn't configured.
          body:
            application/json:
              schema: |
                {
                  "id": "Error",
                  "title": "Error",
                  "type": "object",
                  "properties": {
                    "error": {
                      "description": "A sentence you can show to a person.",
                      "type": "string"
                    },
                    "field": {
                      "description": "The form field at fault, when there is one.",
                      "type": "string"
                    },
                    "detail": {
                      "description": "The upstream service's own message, for debugging.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
        '503':
          description: Gemini, PayPal or Channel3 failed or isn't configured.
          body:
            application/json:
              schema: |
                {
                  "id": "Error",
                  "title": "Error",
                  "type": "object",
                  "properties": {
                    "error": {
                      "description": "A sentence you can show to a person.",
                      "type": "string"
                    },
                    "field": {
                      "description": "The form field at fault, when there is one.",
                      "type": "string"
                    },
                    "detail": {
                      "description": "The upstream service's own message, for debugging.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
  /access/verify:
    post:
      description: >
        For apps and games sold with access codes. Callable from any origin (CORS `*`): it only

        answers valid or not for one shop, and counts uses. Accepts the shop's current or former

        link names, and codes typed loosely (lower case, spaces, no dashes).
      headers:
        Content-Type:
          required: true
          displayName: Content-Type
          enum:
          - application/json
      body:
        application/json:
          schema: |
            {
              "id": "ApiAccessVerifyRequest",
              "title": "ApiAccessVerifyRequest",
              "type": "object",
              "properties": {
                "shop": {
                  "description": "The shop's link name.",
                  "example": "raptorrush",
                  "type": "string"
                },
                "code": {
                  "example": "K7QF-M2XP-9HTD",
                  "type": "string"
                }
              },
              "required": [
                "shop",
                "code"
              ]
            }
          example: ''
      responses:
        '200':
          description: The answer. Invalid codes are also a 200.
          body:
            application/json:
              schema: |
                {
                  "id": "ApiAccessVerifyResponse",
                  "title": "ApiAccessVerifyResponse",
                  "type": "object",
                  "properties": {
                    "valid": {
                      "type": "boolean"
                    },
                    "product": {
                      "description": "The product name, when valid.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "valid"
                  ]
                }
  /download/{token}:
    uriParameters:
      token:
        description: The download token from a paid order's thank-you page.
        type: string
        required: true
        displayName: token
    get:
      description: A paid digital order's private link. Works 5 times within 14 days.
      responses:
        '200':
          description: The file.
        '410':
          description: Expired or used up.
          body:
            text/plain:
              schema: |
                {
                  "type": "string"
                }
  /blobs/{id}:
    uriParameters:
      id:
        description: A shop's `photo_blob` or `hero_blob`.
        type: string
        required: true
        displayName: id
    get:
      description: Public images only. Purchased files are never served here.
      responses:
        '200':
          description: The image.
          body:
            text/plain:
              schema: |
                {
                  "x-is-dynamic": true
                }
        '404':
          description: Not a public shop image.
  /agent/shops/{slug}:
    uriParameters:
      slug:
        description: The shop's link name (current or former).
        type: string
        example: raptorrush
        required: true
        displayName: slug
    get:
      description: 'Everything an AI shopping agent needs to describe the product and decide to buy it: price, shipping, delivery, availability, options, images and FAQ. Public. Buying goes through the MCP server named in `mcp_server`. Shop pages also carry the same facts as schema.org `Product` JSON-LD.'
      responses:
        '200':
          description: The product.
          body:
            application/json:
              schema: |
                {
                  "id": "AgentProduct",
                  "title": "AgentProduct",
                  "description": "A live shop as an AI agent sees it. Recommendations have `offers`; everything else has `price` and is bought with `create_order`.",
                  "type": "object",
                  "properties": {
                    "shop": {
                      "description": "The link name, which the MCP tools take as `shop`.",
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "kind": {
                      "title": "Kind1",
                      "type": "string",
                      "additionalProperties": false,
                      "enum": [
                        "physical",
                        "digital",
                        "referral"
                      ]
                    },
                    "headline": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "highlights": {
                      "description": "",
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "details": {
                      "description": "",
                      "type": "array",
                      "items": {
                        "id": "Detail",
                        "title": "Detail",
                        "type": "object",
                        "properties": {
                          "label": {
                            "type": "string"
                          },
                          "value": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "label",
                          "value"
                        ]
                      }
                    },
                    "faq": {
                      "description": "",
                      "type": "array",
                      "items": {
                        "id": "Faq",
                        "title": "Faq",
                        "type": "object",
                        "properties": {
                          "q": {
                            "type": "string"
                          },
                          "a": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "q",
                          "a"
                        ]
                      }
                    },
                    "images": {
                      "description": "",
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "how_to_buy": {
                      "type": "string"
                    },
                    "price": {
                      "id": "AgentMoney",
                      "title": "AgentMoney",
                      "type": "object",
                      "properties": {
                        "amount": {
                          "example": 48.5,
                          "type": "number"
                        },
                        "currency": {
                          "example": "USD",
                          "type": "string"
                        },
                        "label": {
                          "example": "$48.50",
                          "type": "string"
                        }
                      },
                      "required": [
                        "amount",
                        "currency"
                      ]
                    },
                    "shipping": {
                      "description": "Physical products only.",
                      "oneOf": [
                        {
                          "id": "Shipping",
                          "title": "Shipping",
                          "type": "object",
                          "properties": {
                            "amount": {
                              "type": "number"
                            },
                            "currency": {
                              "type": "string"
                            },
                            "ships_to": {
                              "description": "Country codes; empty means anywhere PayPal ships.",
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            }
                          },
                          "required": [
                            "amount",
                            "currency",
                            "ships_to"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "total": {
                      "$ref": "AgentMoney"
                    },
                    "delivery": {
                      "example": "Shipped. PayPal collects the buyer's address at checkout.",
                      "type": "string"
                    },
                    "availability": {
                      "examples": [
                        {
                          "Id": "Untitled Example1",
                          "Name": null,
                          "Value": "in_stock",
                          "ExternalValue": null,
                          "Description": null
                        },
                        {
                          "Id": "Untitled Example2",
                          "Name": null,
                          "Value": "in_stock (3 left)",
                          "ExternalValue": null,
                          "Description": null
                        },
                        {
                          "Id": "Untitled Example3",
                          "Name": null,
                          "Value": "sold_out",
                          "ExternalValue": null,
                          "Description": null
                        }
                      ],
                      "example": "in_stock",
                      "type": "string"
                    },
                    "options": {
                      "description": "Pass one value per option to `create_order`.",
                      "type": "array",
                      "items": {
                        "id": "Option1",
                        "title": "Option1",
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "values": {
                            "description": "",
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "required": [
                          "name",
                          "values"
                        ]
                      }
                    },
                    "variants": {
                      "description": "",
                      "type": "array",
                      "items": {
                        "id": "Variant",
                        "title": "Variant",
                        "type": "object",
                        "properties": {
                          "choice": {
                            "description": "The buyer's pick, one value per option, keyed by option name.",
                            "example": {
                              "Size": "M",
                              "Color": "Black"
                            },
                            "type": "object",
                            "additionalProperties": {
                              "type": "string"
                            }
                          },
                          "availability": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "choice",
                          "availability"
                        ]
                      }
                    },
                    "offers": {
                      "description": "Recommendations only. Bought at the retailer.",
                      "type": "array",
                      "items": {
                        "id": "Offer1",
                        "title": "Offer1",
                        "type": "object",
                        "properties": {
                          "retailer": {
                            "type": "string"
                          },
                          "price": {
                            "type": "number"
                          },
                          "currency": {
                            "type": "string"
                          },
                          "in_stock": {
                            "type": "boolean"
                          },
                          "url": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "retailer",
                          "price",
                          "currency",
                          "in_stock",
                          "url"
                        ]
                      }
                    },
                    "mcp_server": {
                      "description": "The MCP server to order through (`getAgentProduct` only).",
                      "type": "string"
                    }
                  },
                  "required": [
                    "shop",
                    "url",
                    "name",
                    "kind",
                    "headline",
                    "description",
                    "highlights",
                    "details",
                    "faq",
                    "images",
                    "how_to_buy"
                  ]
                }
        '404':
          description: No live shop with that link name.
          body:
            application/json:
              schema: |
                {
                  "id": "Error",
                  "title": "Error",
                  "type": "object",
                  "properties": {
                    "error": {
                      "description": "A sentence you can show to a person.",
                      "type": "string"
                    },
                    "field": {
                      "description": "The form field at fault, when there is one.",
                      "type": "string"
                    },
                    "detail": {
                      "description": "The upstream service's own message, for debugging.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
  /mcp:
    post:
      description: >
        A [Model Context Protocol](https://modelcontextprotocol.io) server, so agents such as

        Claude can shop here. Add `https://<host>/api/mcp` to an MCP client as a Streamable HTTP

        server. It's stateless: each POST carries one JSON-RPC 2.0 message (or a batch) and gets a

        plain JSON reply, with no session and no event stream.


        Methods: `initialize`, `ping`, `tools/list`, `tools/call`. Tools:


        | Tool | Arguments | What it does |

        |---|---|---|

        | `search_shops` | `query?`, `limit?` (1–25) | Live gallery shops whose name or headline has every word |

        | `get_product` | `shop` | The same object as `getAgentProduct` |

        | `create_order` | `shop`, `options?` | One unit on order; returns `order_id` and `approve_url` |

        | `get_order` | `order_id` | `awaiting_buyer_approval` or `paid`, with the receipt link once paid |


        **The buyer always approves.** `create_order` charges nothing: the agent gives the buyer

        `approve_url`, they pay at PayPal, and the agent polls `get_order`. Orders made this way

        show `channel: agent` in `listOrders`.


        Tool errors (an unknown shop, a sold-out size) come back as results with `isError: true`,

        so the model can read them and try something else.
      headers:
        Content-Type:
          required: true
          displayName: Content-Type
          enum:
          - application/json
      body:
        application/json:
          schema: |
            {
              "examples": [
                {
                  "Id": "search",
                  "Name": "Find a shop",
                  "Value": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"search_shops\",\"arguments\":{\"query\":\"game\"}}}",
                  "ExternalValue": null,
                  "Description": null
                },
                {
                  "Id": "order",
                  "Name": "Order a size and colour",
                  "Value": "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/call\",\"params\":{\"name\":\"create_order\",\"arguments\":{\"shop\":\"trailtee\",\"options\":{\"Size\":\"M\",\"Color\":\"Black\"}}}}",
                  "ExternalValue": null,
                  "Description": null
                }
              ],
              "example": {
                "jsonrpc": "2.0",
                "id": 1,
                "method": "tools/call",
                "params": {
                  "name": "search_shops",
                  "arguments": {
                    "query": "game"
                  }
                }
              },
              "oneOf": [
                {
                  "id": "JsonRpcRequest",
                  "title": "JsonRpcRequest",
                  "type": "object",
                  "properties": {
                    "jsonrpc": {
                      "type": "string",
                      "enum": [
                        "2.0"
                      ]
                    },
                    "method": {
                      "title": "Method",
                      "type": "string",
                      "additionalProperties": false,
                      "enum": [
                        "initialize",
                        "ping",
                        "tools/list",
                        "tools/call",
                        "notifications/initialized"
                      ]
                    },
                    "id": {
                      "description": "Leave out for a notification.",
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "integer",
                          "format": "int32"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "params": {
                      "description": "For `tools/call`: `{ name, arguments }`.",
                      "type": "object"
                    }
                  },
                  "required": [
                    "jsonrpc",
                    "method"
                  ]
                },
                {
                  "type": "array",
                  "items": {
                    "id": "JsonRpcRequest",
                    "title": "JsonRpcRequest",
                    "type": "object",
                    "properties": {
                      "jsonrpc": {
                        "type": "string",
                        "enum": [
                          "2.0"
                        ]
                      },
                      "method": {
                        "title": "Method",
                        "type": "string",
                        "additionalProperties": false,
                        "enum": [
                          "initialize",
                          "ping",
                          "tools/list",
                          "tools/call",
                          "notifications/initialized"
                        ]
                      },
                      "id": {
                        "description": "Leave out for a notification.",
                        "oneOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "integer",
                            "format": "int32"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "params": {
                        "description": "For `tools/call`: `{ name, arguments }`.",
                        "type": "object"
                      }
                    },
                    "required": [
                      "jsonrpc",
                      "method"
                    ]
                  }
                }
              ]
            }
          example: '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"search_shops","arguments":{"query":"game"}}}'
      responses:
        '200':
          description: The JSON-RPC reply (an array for a batch).
          body:
            application/json:
              schema: |
                {
                  "x-is-dynamic": true,
                  "oneOf": [
                    {
                      "id": "JsonRpcResponse",
                      "title": "JsonRpcResponse",
                      "type": "object",
                      "properties": {
                        "jsonrpc": {
                          "type": "string",
                          "enum": [
                            "2.0"
                          ]
                        },
                        "id": {
                          "oneOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "integer",
                              "format": "int32"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "result": {
                          "description": "For `tools/call`: `content` (the answer as JSON text), `structuredContent` (the same object) and `isError`.",
                          "type": "object"
                        },
                        "error": {
                          "id": "Error1",
                          "title": "Error1",
                          "type": "object",
                          "properties": {
                            "code": {
                              "example": -32601,
                              "type": "integer",
                              "format": "int32"
                            },
                            "message": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "code",
                            "message"
                          ]
                        }
                      },
                      "required": [
                        "jsonrpc",
                        "id"
                      ]
                    },
                    {
                      "type": "array",
                      "items": {
                        "id": "JsonRpcResponse",
                        "title": "JsonRpcResponse",
                        "type": "object",
                        "properties": {
                          "jsonrpc": {
                            "type": "string",
                            "enum": [
                              "2.0"
                            ]
                          },
                          "id": {
                            "oneOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "integer",
                                "format": "int32"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "result": {
                            "description": "For `tools/call`: `content` (the answer as JSON text), `structuredContent` (the same object) and `isError`.",
                            "type": "object"
                          },
                          "error": {
                            "id": "Error1",
                            "title": "Error1",
                            "type": "object",
                            "properties": {
                              "code": {
                                "example": -32601,
                                "type": "integer",
                                "format": "int32"
                              },
                              "message": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "code",
                              "message"
                            ]
                          }
                        },
                        "required": [
                          "jsonrpc",
                          "id"
                        ]
                      }
                    }
                  ]
                }
        '202':
          description: Only notifications were sent; there's nothing to reply.
        '400':
          description: Not JSON (JSON-RPC parse error `-32700`).
          body:
            application/json:
              schema: |
                {
                  "id": "JsonRpcResponse",
                  "title": "JsonRpcResponse",
                  "type": "object",
                  "properties": {
                    "jsonrpc": {
                      "type": "string",
                      "enum": [
                        "2.0"
                      ]
                    },
                    "id": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "integer",
                          "format": "int32"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "result": {
                      "description": "For `tools/call`: `content` (the answer as JSON text), `structuredContent` (the same object) and `isError`.",
                      "type": "object"
                    },
                    "error": {
                      "id": "Error1",
                      "title": "Error1",
                      "type": "object",
                      "properties": {
                        "code": {
                          "example": -32601,
                          "type": "integer",
                          "format": "int32"
                        },
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "code",
                        "message"
                      ]
                    }
                  },
                  "required": [
                    "jsonrpc",
                    "id"
                  ]
                }
  /platform/shops:
    get:
      securedBy:
      - PlatformKey
      description: "Every shop the API key's account owns, newest first, with what a catalog page needs: name, price, cover, link, whether PayPal is connected and how many sales it has."
      queryParameters:
        status:
          description: Only shops with this status, e.g. `live` for a public catalog.
          required: false
          displayName: status
          enum:
          - draft
          - live
      responses:
        '200':
          description: The shops.
          body:
            application/json:
              schema: |
                {
                  "id": "ApiPlatformShopsResponse",
                  "title": "ApiPlatformShopsResponse",
                  "type": "object",
                  "properties": {
                    "shops": {
                      "description": "",
                      "type": "array",
                      "items": {
                        "id": "PlatformShop",
                        "title": "PlatformShop",
                        "type": "object",
                        "properties": {
                          "slug": {
                            "type": "string"
                          },
                          "status": {
                            "title": "Status",
                            "type": "string",
                            "additionalProperties": false,
                            "enum": [
                              "draft",
                              "live"
                            ]
                          },
                          "name": {
                            "type": "string"
                          },
                          "product_type": {
                            "title": "ProductType1",
                            "type": "string",
                            "additionalProperties": false,
                            "enum": [
                              "physical",
                              "digital",
                              "referral"
                            ]
                          },
                          "price": {
                            "id": "AgentMoney",
                            "title": "AgentMoney",
                            "type": "object",
                            "properties": {
                              "amount": {
                                "example": 48.5,
                                "type": "number"
                              },
                              "currency": {
                                "example": "USD",
                                "type": "string"
                              },
                              "label": {
                                "example": "$48.50",
                                "type": "string"
                              }
                            },
                            "required": [
                              "amount",
                              "currency"
                            ]
                          },
                          "url": {
                            "description": "The shop page buyers pay on.",
                            "type": "string"
                          },
                          "paypal_connected": {
                            "description": "The seller connected a PayPal account that can be paid.",
                            "type": "boolean"
                          },
                          "sales": {
                            "description": "Paid orders.",
                            "type": "integer",
                            "format": "int32"
                          },
                          "created_at": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "headline": {
                            "type": "string"
                          },
                          "cover": {
                            "description": "The cover image's URL.",
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        },
                        "required": [
                          "slug",
                          "status",
                          "name",
                          "product_type",
                          "price",
                          "url",
                          "paypal_connected",
                          "sales",
                          "created_at"
                        ]
                      }
                    }
                  },
                  "required": [
                    "shops"
                  ]
                }
        '401':
          description: No API key, or it's wrong or revoked.
          body:
            application/json:
              schema: |
                {
                  "id": "Error",
                  "title": "Error",
                  "type": "object",
                  "properties": {
                    "error": {
                      "description": "A sentence you can show to a person.",
                      "type": "string"
                    },
                    "field": {
                      "description": "The form field at fault, when there is one.",
                      "type": "string"
                    },
                    "detail": {
                      "description": "The upstream service's own message, for debugging.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
  /account:
    /signin:
      post:
        description: Signs in with an email address or a phone number, creating the account the first time. There's no password and no verification (sandbox). The response sets the `ot_session` cookie; shops created with it belong to the account and are listed on `/account`. Signing in with an email also claims older shops whose seller email matches. In a browser, sellers can instead use Log in with PayPal (`/api/account/paypal`), which also records the PayPal account their sales are paid into.
        headers:
          Content-Type:
            required: true
            displayName: Content-Type
            enum:
            - application/json
        body:
          application/json:
            schema: |
              {
                "id": "ApiAccountSigninRequest",
                "title": "ApiAccountSigninRequest",
                "type": "object",
                "properties": {
                  "identifier": {
                    "description": "An email address, or a phone number (spaces, dashes and brackets are ignored; keep a leading +).",
                    "examples": [
                      {
                        "Id": "Untitled Example1",
                        "Name": null,
                        "Value": "maker@example.com",
                        "ExternalValue": null,
                        "Description": null
                      },
                      {
                        "Id": "Untitled Example2",
                        "Name": null,
                        "Value": "+1 555 123 4567",
                        "ExternalValue": null,
                        "Description": null
                      }
                    ],
                    "example": "maker@example.com",
                    "type": "string"
                  }
                },
                "required": [
                  "identifier"
                ]
              }
            example: ''
        responses:
          '200':
            description: Signed in. The `ot_session` cookie is set.
            headers:
              Set-Cookie:
                required: false
            body:
              application/json:
                schema: |
                  {
                    "id": "ApiAccountSigninResponse",
                    "title": "ApiAccountSigninResponse",
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "email": {
                        "description": "Lower-cased.",
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "phone": {
                        "description": "Digits, with a leading + if one was given.",
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "email",
                      "phone"
                    ]
                  }
          '400':
            description: Something in the request needs fixing; `error` says what.
            body:
              application/json:
                schema: |
                  {
                    "id": "Error",
                    "title": "Error",
                    "type": "object",
                    "properties": {
                      "error": {
                        "description": "A sentence you can show to a person.",
                        "type": "string"
                      },
                      "field": {
                        "description": "The form field at fault, when there is one.",
                        "type": "string"
                      },
                      "detail": {
                        "description": "The upstream service's own message, for debugging.",
                        "type": "string"
                      }
                    },
                    "required": [
                      "error"
                    ]
                  }
    /signout:
      post:
        description: Ends this browser's session and clears the `ot_session` cookie.
        responses:
          '200':
            description: Done.
            body:
              application/json:
                schema: |
                  {
                    "id": "Ok",
                    "title": "Ok",
                    "type": "object",
                    "properties": {
                      "ok": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "ok"
                    ]
                  }
    /paypal:
      get:
        description: "A link for a browser, not for code: redirects to PayPal's sign-in page. PayPal sends the seller back to `/api/account/paypal/callback`, which signs them in (creating the account the first time), records the PayPal account their sales are paid into, and redirects to `next`."
        queryParameters:
          next:
            description: A path on this site to land on afterwards. Defaults to `/account`.
            type: string
            example: /new
            required: false
            displayName: next
        responses:
          '302':
            description: To PayPal's sign-in page.
          '503':
            description: Log in with PayPal isn't switched on for this server.
            body:
              application/json:
                schema: |
                  {
                    "id": "Error",
                    "title": "Error",
                    "type": "object",
                    "properties": {
                      "error": {
                        "description": "A sentence you can show to a person.",
                        "type": "string"
                      },
                      "field": {
                        "description": "The form field at fault, when there is one.",
                        "type": "string"
                      },
                      "detail": {
                        "description": "The upstream service's own message, for debugging.",
                        "type": "string"
                      }
                    },
                    "required": [
                      "error"
                    ]
                  }
