- ApiShopsFileResponse: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiShopsFileResponse",
      "title": "ApiShopsFileResponse",
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "filename": {
          "type": "string"
        }
      },
      "required": [
