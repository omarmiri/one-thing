        },
        "photo": {
          "description": "Colours: the shop photo (id) that shows this colour. See `matchColorPhotos`.",
          "type": "string"
        }
      },
      "required": [
        "label"
      ]
    }
- Suggestions: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "Suggestions",
      "title": "Suggestions",
      "description": "What Gemini thinks buyers will want to choose or ask. The seller confirms; nothing is applied on its own.",
      "type": "object",
      "properties": {
        "oneOfAKind": {
          "description": "A single item (vintage, handmade), so options and stock don't apply.",
          "type": "boolean"
        },
        "options": {
          "description": "",
          "type": "array",
          "items": {
            "id": "Option",
            "title": "Option",
            "type": "object",
            "properties": {
              "name": {
                "example": "Size",
                "type": "string",
                "maxLength": 20
              },
              "kind": {
                "title": "Kind",
                "description": "`color` shows swatches, and the photo of the picked colour.",
                "type": "string",
                "additionalProperties": false,
                "enum": [
                  "size",
                  "color",
                  "other"
                ]
              },
              "values": {
                "description": "",
                "type": "array",
                "items": {
                  "id": "OptionValue",
                  "title": "OptionValue",
                  "type": "object",
                  "properties": {
                    "label": {
                      "example": "M",
                      "type": "string",
                      "maxLength": 30
                    },
                    "hex": {
                      "example": "#14171a",
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}$"
                    },
                    "photo": {
                      "description": "Colours: the shop photo (id) that shows this colour. See `matchColorPhotos`.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "label"
                  ]
                },
                "minItems": 1,
                "maxItems": 12
              },
              "fromSeller": {
                "description": "The seller's description or photo named these values; otherwise they're a guess.",
                "type": "boolean"
              }
            },
            "required": [
              "name",
              "kind",
              "values"
            ]
          }
        },
        "missingFacts": {
          "description": "",
          "type": "array",
          "items": {
            "id": "MissingFact",
            "title": "MissingFact",
            "type": "object",
            "properties": {
              "label": {
                "example": "Size",
                "type": "string"
              },
              "question": {
                "example": "What size are the skates?",
                "type": "string"
              },
              "placeholder": {
                "example": "US women's 8",
                "type": "string"
              }
            },
            "required": [
              "label",
              "question",
              "placeholder"
            ]
          }
        }
      },
      "required": [
        "oneOfAKind",
        "options",
        "missingFacts"
      ]
    }
