- ShopOption: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ShopOption",
      "title": "ShopOption",
      "description": "Something the buyer picks, such as a size or a colour. The shop still sells one product.",
      "type": "object",
      "properties": {
        "name": {
          "example": "Size",
          "type": "string",
          "maxLength": 20
        },
        "kind": {
          "title": "Kind",
          "description": "`color` shows swatches, and the photo of the picked colour.",
          "type": "string",
          "additionalProperties": false,
          "enum": [
            "size",
            "color",
            "other"
          ]
        },
        "values": {
          "description": "",
          "type": "array",
          "items": {
            "id": "OptionValue",
            "title": "OptionValue",
            "type": "object",
            "properties": {
              "label": {
                "example": "M",
                "type": "string",
                "maxLength": 30
              },
              "hex": {
                "example": "#14171a",
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "photo": {
                "description": "Colours: the shop photo (id) that shows this colour. See `matchColorPhotos`.",
                "type": "string"
              }
            },
            "required": [
              "label"
            ]
          },
          "minItems": 1,
          "maxItems": 12
        }
      },
      "required": [
        "name",
        "kind",
        "values"
      ]
    }
- OptionValue: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "OptionValue",
      "title": "OptionValue",
      "type": "object",
      "properties": {
        "label": {
          "example": "M",
          "type": "string",
          "maxLength": 30
        },
        "hex": {
          "example": "#14171a",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "photo": {
          "description": "Colours: the shop photo (id) that shows this colour. See `matchColorPhotos`.",
          "type": "string"
        }
      },
      "required": [
        "label"
      ]
    }
- Suggestions: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "Suggestions",
      "title": "Suggestions",
      "description": "What Gemini thinks buyers will want to choose or ask. The seller confirms; nothing is applied on its own.",
      "type": "object",
      "properties": {
        "oneOfAKind": {
          "description": "A single item (vintage, handmade), so options and stock don't apply.",
          "type": "boolean"
        },
        "options": {
          "description": "",
          "type": "array",
          "items": {
            "id": "Option",
            "title": "Option",
            "type": "object",
            "properties": {
              "name": {
                "example": "Size",
                "type": "string",
                "maxLength": 20
              },
              "kind": {
                "title": "Kind",
                "description": "`color` shows swatches, and the photo of the picked colour.",
                "type": "string",
                "additionalProperties": false,
                "enum": [
                  "size",
                  "color",
                  "other"
                ]
              },
              "values": {
                "description": "",
                "type": "array",
                "items": {
                  "id": "OptionValue",
                  "title": "OptionValue",
                  "type": "object",
                  "properties": {
                    "label": {
                      "example": "M",
                      "type": "string",
                      "maxLength": 30
                    },
                    "hex": {
                      "example": "#14171a",
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}$"
                    },
                    "photo": {
                      "description": "Colours: the shop photo (id) that shows this colour. See `matchColorPhotos`.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "label"
                  ]
                },
                "minItems": 1,
                "maxItems": 12
              },
              "fromSeller": {
                "description": "The seller's description or photo named these values; otherwise they're a guess.",
                "type": "boolean"
              }
            },
            "required": [
              "name",
              "kind",
              "values"
            ]
          }
        },
        "missingFacts": {
          "description": "",
          "type": "array",
          "items": {
            "id": "MissingFact",
            "title": "MissingFact",
            "type": "object",
            "properties": {
              "label": {
                "example": "Size",
                "type": "string"
              },
              "question": {
                "example": "What size are the skates?",
                "type": "string"
              },
              "placeholder": {
                "example": "US women's 8",
                "type": "string"
              }
            },
            "required": [
              "label",
              "question",
              "placeholder"
            ]
          }
        }
      },
      "required": [
        "oneOfAKind",
        "options",
        "missingFacts"
      ]
    }
- PayPalStatus: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "PayPalStatus",
      "title": "PayPalStatus",
      "description": "What PayPal last said about a connected seller account.",
      "type": "object",
      "properties": {
        "receivable": {
          "description": "The account can receive payments.",
          "type": "boolean"
        },
        "emailConfirmed": {
          "description": "The seller has confirmed their email with PayPal.",
          "type": "boolean"
        },
        "checkedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "receivable",
        "emailConfirmed",
        "checkedAt"
      ]
    }
- AgentProduct: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "AgentProduct",
      "title": "AgentProduct",
      "description": "A live shop as an AI agent sees it. Recommendations have `offers`; everything else has `price` and is bought with `create_order`.",
      "type": "object",
      "properties": {
        "shop": {
          "description": "The link name, which the MCP tools take as `shop`.",
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "title": "Kind1",
          "type": "string",
          "additionalProperties": false,
          "enum": [
            "physical",
            "digital",
            "referral"
          ]
        },
        "headline": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "highlights": {
          "description": "",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "details": {
          "description": "",
          "type": "array",
          "items": {
            "id": "Detail",
            "title": "Detail",
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "label",
              "value"
            ]
          }
        },
        "faq": {
          "description": "",
          "type": "array",
          "items": {
            "id": "Faq",
            "title": "Faq",
            "type": "object",
            "properties": {
              "q": {
                "type": "string"
              },
              "a": {
                "type": "string"
              }
            },
            "required": [
              "q",
              "a"
            ]
          }
        },
        "images": {
          "description": "",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "how_to_buy": {
          "type": "string"
        },
        "show_buyer": {
          "description": "A suggested reply to the buyer, in Markdown with the links already written as links: the product and its options to pick from, the pay link, or what they got with a receipt link. Buyers have the best experience when agents show it as written.",
          "type": "string"
        },
        "agent_name": {
          "description": "Who this request was credited to in the seller's stats: a recognised user agent, else the name the agent gave itself (`?agent=`, or the MCP client's name), else the user agent's first word.",
          "type": "string"
        },
        "price": {
          "id": "AgentMoney",
          "title": "AgentMoney",
          "type": "object",
          "properties": {
            "amount": {
              "example": 48.5,
              "type": "number"
            },
            "currency": {
              "example": "USD",
              "type": "string"
            },
            "label": {
              "example": "$48.50",
              "type": "string"
            }
          },
          "required": [
            "amount",
            "currency"
          ]
        },
        "shipping": {
          "description": "Physical products only.",
          "oneOf": [
            {
              "id": "Shipping",
              "title": "Shipping",
              "type": "object",
              "properties": {
                "amount": {
                  "type": "number"
                },
                "currency": {
                  "type": "string"
                },
                "ships_to": {
                  "description": "Country codes; empty means anywhere PayPal ships.",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "amount",
                "currency",
                "ships_to"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "total": {
          "$ref": "AgentMoney"
        },
        "delivery": {
          "example": "Shipped. PayPal collects the buyer's address at checkout.",
          "type": "string"
        },
        "availability": {
          "examples": [
            {
              "Id": "Untitled Example1",
              "Name": null,
              "Value": "in_stock",
              "ExternalValue": null,
              "Description": null
            },
            {
              "Id": "Untitled Example2",
              "Name": null,
              "Value": "in_stock (3 left)",
              "ExternalValue": null,
              "Description": null
            },
            {
              "Id": "Untitled Example3",
              "Name": null,
              "Value": "sold_out",
              "ExternalValue": null,
              "Description": null
            }
          ],
          "example": "in_stock",
          "type": "string"
        },
        "options": {
          "description": "Pass one value per option to `create_order`.",
          "type": "array",
          "items": {
            "id": "Option1",
            "title": "Option1",
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "values": {
                "description": "",
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "name",
              "values"
            ]
          }
        },
        "variants": {
          "description": "",
          "type": "array",
          "items": {
            "id": "Variant",
            "title": "Variant",
            "type": "object",
            "properties": {
              "choice": {
                "description": "The buyer's pick, one value per option, keyed by option name.",
                "example": {
                  "Size": "M",
                  "Color": "Black"
                },
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "availability": {
                "type": "string"
              },
              "order_url": {
                "description": "`orderByLink` for this pick. Left out when it's sold out.",
                "type": "string"
              }
            },
            "required": [
              "choice",
              "availability"
            ]
          }
        },
        "order_url": {
          "description": "Products without options: `orderByLink`, which orders one unit with a GET. Left out when sold out. With options, each variant has its own.",
          "type": "string"
        },
        "offers": {
          "description": "Recommendations only. Bought at the retailer.",
          "type": "array",
          "items": {
            "id": "Offer1",
            "title": "Offer1",
            "type": "object",
            "properties": {
              "retailer": {
                "type": "string"
              },
              "price": {
                "type": "number"
              },
              "currency": {
                "type": "string"
              },
              "in_stock": {
                "type": "boolean"
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "retailer",
              "price",
              "currency",
              "in_stock",
              "url"
            ]
          }
        },
        "mcp_server": {
          "description": "The MCP server to order through (`getAgentProduct` only).",
          "type": "string"
        }
      },
      "required": [
        "shop",
        "url",
        "name",
        "kind",
        "headline",
        "description",
        "highlights",
        "details",
        "faq",
        "images",
        "how_to_buy"
      ]
    }
- AgentShopSummary: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "AgentShopSummary",
      "title": "AgentShopSummary",
      "type": "object",
      "properties": {
        "shop": {
          "description": "The link name, for `getAgentProduct` and the MCP tools.",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "title": "Kind1",
          "type": "string",
          "additionalProperties": false,
          "enum": [
            "physical",
            "digital",
            "referral"
          ]
        },
        "headline": {
          "type": "string"
        },
        "price": {
          "description": "The price label, e.g. `$2.99`; null for recommendations.",
          "type": [
            "string",
            "null"
          ]
        },
