      /match-photos:
        uriParameters: {}
        post:
          securedBy:
          - AdminToken
          - PlatformKey
          description: Gemini looks at the shop's photos and says which one shows each colour, so buyers who pick a colour see it. Suggests only; save the matches with `setColorPhotos`. Needs at least two photos.
          headers:
            Content-Type:
              required: true
              displayName: Content-Type
              enum:
              - application/json
          body:
            application/json:
              schema: |
                {
                  "id": "ApiShopsMatchPhotosRequest",
                  "title": "ApiShopsMatchPhotosRequest",
                  "example": {
                    "colors": [
                      {
                        "label": "Cream",
                        "hex": "#f3e9d2"
                      },
                      {
                        "label": "Red",
                        "hex": "#b3261e"
                      }
                    ]
                  },
                  "type": "object",
                  "properties": {
                    "colors": {
                      "description": "",
                      "type": "array",
                      "items": {
                        "id": "Color",
                        "title": "Color",
                        "type": "object",
                        "properties": {
                          "label": {
                            "example": "Forest green",
                            "type": "string",
                            "maxLength": 30
                          },
                          "hex": {
                            "example": "#14171a",
                            "type": "string",
                            "pattern": "^#[0-9a-fA-F]{6}$"
                          }
                        },
                        "required": [
                          "label"
                        ]
                      },
                      "minItems": 1,
                      "maxItems": 12
                    }
                  },
                  "required": [
                    "colors"
                  ]
                }
              example: '{"colors":[{"label":"Cream","hex":"#f3e9d2"},{"label":"Red","hex":"#b3261e"}]}'
          responses:
            '200':
              description: A photo id for each colour Gemini could match. Colours it couldn't place are left out.
              body:
                application/json:
                  schema: "{\n  \"id\": \"ApiShopsMatchPhotosResponse\",\n  \"title\": \"ApiShopsMatchPhotosResponse\",\n  \"example\": {\n    \"matches\": {\n      \"Cream\": \"LFRvGuTU3D8i334X\",\n      \"Red\": \"SuqcgNv64HWN8H6e\"\n    }\n  },\n  \"type\": \"object\",\n  \"properties\": {\n    \"matches\": {\n      \"example\": {\n        \"Black\": \"b_8f2k1\",\n        \"Forest green\": \"b_q93md\"\n      },\n      \"type\": \"object\",\n      \"additionalProperties\": {\n        \"type\": \"string\"\n      }\n    }\n  },\n  \"required\": [\n    \"matches\"\n  ]\n}"
                  example: '{"matches":{"Cream":"LFRvGuTU3D8i334X","Red":"SuqcgNv64HWN8H6e"}}'
            '400':
              description: Something in the request needs fixing; `error` says what.
              body:
                application/json:
                  schema: |
                    {
                      "id": "Error",
                      "title": "Error",
                      "example": {
                        "error": "Choose a photo."
                      },
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "A sentence you can show to a person.",
                          "type": "string"
                        },
                        "field": {
                          "description": "The form field at fault, when there is one.",
                          "type": "string"
                        },
                        "detail": {
                          "description": "The upstream service's own message, for debugging.",
                          "type": "string"
                        }
                      },
                      "required": [
                        "error"
                      ]
                    }
                  example: '{"error":"Choose a photo."}'
            '404':
              description: No such shop, or the admin token or API key doesn't match it.
              body:
                application/json:
                  schema: |
                    {
                      "id": "Error",
                      "title": "Error",
                      "example": {
                        "error": "Shop not found."
                      },
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "A sentence you can show to a person.",
