- ShopOption: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ShopOption",
      "title": "ShopOption",
      "description": "Something the buyer picks, such as a size or a colour. The shop still sells one product.",
      "example": {
        "name": "Size",
        "kind": "size",
        "values": [
          {
            "label": "S"
          },
          {
            "label": "M"
          },
          {
            "label": "L"
          }
        ]
      },
      "type": "object",
      "properties": {
        "name": {
          "description": "What the buyer is choosing.",
          "example": "Size",
          "type": "string",
          "maxLength": 20
        },
        "kind": {
          "title": "Kind",
          "description": "`color` shows swatches, and the photo of the picked colour.",
          "example": "size",
          "type": "string",
          "additionalProperties": false,
          "enum": [
            "size",
            "color",
            "other"
          ]
        },
        "values": {
          "description": "The values to pick from.",
          "example": [
            {
              "label": "S"
            },
            {
              "label": "M"
            },
            {
              "label": "L"
            }
          ],
          "type": "array",
          "items": {
            "id": "OptionValue",
            "title": "OptionValue",
            "description": "One value of an option.",
            "example": {
              "label": "M",
              "hex": "#14171a",
              "photo": "zrySajNyao6_j11x"
            },
            "type": "object",
            "properties": {
              "label": {
                "description": "What the buyer sees and picks.",
                "example": "M",
                "type": "string",
                "maxLength": 30
              },
              "hex": {
                "description": "A colour as `#rrggbb`.",
                "example": "#14171a",
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "photo": {
                "description": "Colours: the shop photo (id) that shows this colour. See `matchColorPhotos`.",
                "example": "zrySajNyao6_j11x",
                "type": "string"
              }
            },
            "required": [
              "label"
            ]
          },
          "minItems": 1,
          "maxItems": 12
        }
      },
      "required": [
        "name",
        "kind",
        "values"
      ]
    }
