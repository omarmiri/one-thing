                          "type": "string"
                        },
                        "field": {
                          "description": "The form field at fault, when there is one.",
                          "example": "price",
                          "type": "string"
                        },
                        "detail": {
                          "description": "The upstream service's own message, for debugging.",
                          "example": "INSTRUMENT_DECLINED",
                          "type": "string"
                        }
                      },
                      "required": [
                        "error"
                      ]
                    }
                  example: '{"error":"Shop not found."}'
            '429':
              description: Over this network's cap for the call (see **Limits**). Retry after `Retry-After` seconds.
              headers:
                Retry-After:
                  required: false
              body:
                application/json:
                  schema: |
                    {
                      "id": "ErrorResponse",
                      "title": "ErrorResponse",
                      "description": "An error reply.",
                      "example": {
                        "error": "Choose a photo.",
                        "field": "photo"
                      },
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "A sentence you can show to a person.",
                          "example": "Order not found.",
                          "type": "string"
                        },
                        "field": {
                          "description": "The form field at fault, when there is one.",
                          "example": "price",
                          "type": "string"
                        },
                        "detail": {
                          "description": "The upstream service's own message, for debugging.",
                          "example": "INSTRUMENT_DECLINED",
                          "type": "string"
                        }
                      },
                      "required": [
                        "error"
                      ]
                    }
                  example: '{"error":"Too many checkouts from your network. Try again in 7 min."}'
            '502':
              description: Gemini, PayPal or Channel3 failed or isn't configured.
              body:
                application/json:
                  schema: |
                    {
                      "id": "ErrorResponse",
                      "title": "ErrorResponse",
                      "description": "An error reply.",
