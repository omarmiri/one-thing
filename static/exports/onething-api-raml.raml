      /orders:
        uriParameters: {}
        /{orderId}/ship:
          uriParameters:
            orderId:
              description: OneThing's order id (`Order.id`).
              type: string
              required: true
              displayName: orderId
          post:
            securedBy:
            - AdminToken
            description: Saves the tracking number and pushes it to PayPal, so the buyer sees it in PayPal.
            headers:
              Content-Type:
                required: true
                displayName: Content-Type
                enum:
                - application/json
            body:
              application/json:
                schema: |
                  {
                    "id": "ApiShopsOrdersShipRequest",
                    "title": "ApiShopsOrdersShipRequest",
                    "type": "object",
                    "properties": {
                      "carrier": {
                        "title": "Carrier",
                        "type": "string",
                        "additionalProperties": false,
                        "enum": [
                          "USPS",
                          "UPS",
                          "FEDEX",
                          "DHL",
                          "OTHER"
                        ]
                      },
                      "trackingNumber": {
                        "type": "string",
                        "minLength": 4,
                        "maxLength": 64
                      },
                      "carrierName": {
                        "description": "Required when `carrier` is `OTHER`.",
                        "type": "string",
                        "maxLength": 60
                      }
                    },
                    "required": [
                      "carrier",
                      "trackingNumber"
                    ]
                  }
                example: ''
            responses:
              '200':
                description: Shipped.
                body:
                  application/json:
                    schema: |
                      {
                        "id": "ApiShopsOrdersShipResponse",
                        "title": "ApiShopsOrdersShipResponse",
                        "type": "object",
                        "properties": {
                          "ok": {
                            "type": "boolean"
                          },
                          "synced": {
                            "description": "Whether PayPal accepted the tracking number.",
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "ok",
                          "synced"
                        ]
                      }
              '400':
                description: Something in the request needs fixing; `error` says what.
                body:
                  application/json:
                    schema: |
                      {
                        "id": "Error",
                        "title": "Error",
                        "type": "object",
                        "properties": {
                          "error": {
                            "description": "A sentence you can show to a person.",
                            "type": "string"
                          },
                          "field": {
                            "description": "The form field at fault, when there is one.",
                            "type": "string"
                          },
                          "detail": {
                            "description": "The upstream service's own message, for debugging.",
                            "type": "string"
                          }
                        },
                        "required": [
                          "error"
                        ]
                      }
              '404':
                description: No such shop, or the admin token doesn't match it.
                body:
                  application/json:
                    schema: |
                      {
                        "id": "Error",
                        "title": "Error",
                        "type": "object",
                        "properties": {
                          "error": {
                            "description": "A sentence you can show to a person.",
                            "type": "string"
                          },
                          "field": {
                            "description": "The form field at fault, when there is one.",
                            "type": "string"
                          },
                          "detail": {
                            "description": "The upstream service's own message, for debugging.",
                            "type": "string"
                          }
                        },
                        "required": [
                          "error"
                        ]
                      }
        get:
          securedBy:
          - AdminToken
          description: Newest first. Checkouts that were never approved are left out.
          responses:
            '200':
              description: Orders.
              body:
                application/json:
                  schema: |
                    {
                      "description": "",
