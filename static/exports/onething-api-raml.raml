      get:
        securedBy:
        - AdminToken
        - PlatformKey
        description: Everything about the shop, including the AI's design spec and guesses.
        responses:
          '200':
            description: The shop.
            body:
              application/json:
                schema: "{\n  \"id\": \"Shop\",\n  \"title\": \"Shop\",\n  \"description\": \"A shop, as its seller sees it.\",\n  \"example\": {\n    \"id\": \"Hn2c8QvL0xTzR4pW\",\n    \"slug\": \"vintageskates\",\n    \"status\": \"live\",\n    \"product_type\": \"physical\",\n    \"price_cents\": 24000,\n    \"currency\": \"USD\",\n    \"shipping_cents\": 1500,\n    \"ship_countries\": \"US\",\n    \"stock\": null,\n    \"delivery\": \"file\",\n    \"access_url\": null,\n    \"paypal_email\": \"seller@example.com\",\n    \"seller_email\": \"seller@example.com\",\n    \"paypal_merchant_id\": \"7MZJ4QXN8K2LA\",\n    \"paypal_status\": {\n      \"receivable\": true,\n      \"emailConfirmed\": true,\n      \"checkedAt\": \"2026-10-21T18:04:11Z\"\n    },\n    \"zapier_hook_url\": null,\n    \"in_gallery\": true,\n    \"account_id\": \"Vq3nN8cT0bLx2YwE\",\n    \"options\": [\n      {\n        \"name\": \"Size\",\n        \"kind\": \"size\",\n        \"values\": [\n          {\n            \"label\": \"7\"\n          },\n          {\n            \"label\": \"8\"\n          },\n          {\n            \"label\": \"9\"\n          }\n        ]\n      }\n    ],\n    \"option_stock\": {\n      \"7\": 3,\n      \"8\": 0,\n      \"9\": 6\n    },\n    \"suggestions\": null,\n    \"photo_blob\": \"LFRvGuTU3D8i334X\",\n    \"gallery_blobs\": [\n      \"zrySajNyao6_j11x\",\n      \"SuqcgNv64HWN8H6e\"\n    ],\n    \"hero_blob\": null,\n    \"hero_status\": \"none\",\n    \"hero_error\": null,\n    \"ai_source\": \"gemini\",\n    \"source_url\": null,\n    \"referral\": null,\n    \"spec\": {\n      \"productType\": \"physical\",\n      \"productName\": \"Vintage Cream and Red Roller Skates\",\n      \"layout\": \"editorial\",\n      \"palette\": {\n        \"background\": \"#f6efe4\",\n        \"surface\": \"#fffaf2\",\n        \"text\": \"#2b1d14\",\n        \"muted\": \"#7a6455\",\n        \"accent\": \"#b3261e\",\n        \"accentText\": \"#ffffff\"\n      },\n      \"fonts\": {\n        \"heading\": \"Playfair Display\",\n        \"body\": \"Inter\"\n      },\n      \"eyebrow\": \"One pair, restored\",\n      \"headline\": \"Classic quad skates crafted with walnut burl heels\",\n      \"subheadline\": \"A vintage pair of skates featuring cream leather, bold red trim, and durable quad wheels.\",\n      \"story\": \"Each pair combines soft cream leather with distinct red accents and a sculpted walnut burl heel base.\",\n      \"bullets\": [\n        \"Handmade cream leather upper with rich red trim\",\n        \"Sculpted walnut burl heel structure for stability\"\n      ],\n      \"details\": [\n        {\n          \"label\": \"Materials\",\n          \"value\": \"Leather upper, walnut burl heel, rubber wheels\"\n        }\n      ],\n      \"faq\": [\n        {\n          \"q\": \"Are these suitable for outdoor skating?\",\n          \"a\": \"Yes, on indoor rink floors and paved outdoor paths.\"\n        }\n      ],\n      \"ctaLabel\": \"Buy the skates\",\n      \"suggestedPriceUsd\": 240,\n      \"suggestedShippingUsd\": 15,\n      \"imageAlt\": \"Cream leather quad roller skates with red trim\"\n    },\n    \"created_at\": \"2026-10-19T15:22:08Z\"\n  },\n  \"type\": \"object\",\n  \"properties\": {\n    \"id\": {\n      \"description\": \"OneThing's internal shop id.\",\n      \"example\": \"shp_8Hc2LmQ4\",\n      \"type\": \"string\"\n    },\n    \"slug\": {\n      \"description\": \"The shop's link name.\",\n      \"example\": \"vintageskates\",\n      \"type\": \"string\"\n    },\n    \"status\": {\n      \"title\": \"Status1\",\n      \"description\": \"`draft` until the seller goes live; only `live` shops take orders.\",\n      \"example\": \"draft\",\n      \"type\": \"string\",\n      \"additionalProperties\": false,\n      \"enum\": [\n        \"draft\",\n        \"live\"\n      ]\n    },\n    \"product_type\": {\n      \"title\": \"ProductType1\",\n      \"description\": \"`physical` ships, `digital` downloads or unlocks, `referral` recommends a Channel3 product.\",\n      \"example\": \"physical\",\n      \"type\": \"string\",\n      \"additionalProperties\": false,\n      \"enum\": [\n        \"physical\",\n        \"digital\",\n        \"referral\"\n      ]\n    },\n    \"price_cents\": {\n      \"description\": \"The price in cents.\",\n      \"example\": 24000,\n      \"type\": \"integer\",\n      \"format\": \"int32\"\n    },\n    \"currency\": {\n      \"description\": \"ISO 4217 currency code.\",\n      \"example\": \"USD\",\n      \"type\": \"string\"\n    },\n    \"spec\": {\n      \"id\": \"DesignSpec\",\n      \"title\": \"DesignSpec\",\n      \"description\": \"What Gemini designed. OneThing's templates render it; Gemini never writes HTML.\",\n      \"example\": {\n        \"productType\": \"physical\",\n        \"productName\": \"Vintage Cream and Red Roller Skates\",\n        \"layout\": \"bold-hero\",\n        \"palette\": {\n          \"background\": \"#f7f1e8\",\n          \"surface\": \"#ffffff\",\n          \"text\": \"#1f1a17\",\n          \"muted\": \"#6b625b\",\n          \"accent\": \"#b3262d\",\n          \"accentText\": \"#ffffff\"\n        },\n        \"fonts\": {\n          \"heading\": \"Playfair Display\",\n          \"body\": \"Inter\"\n        },\n        \"eyebrow\": \"One pair, restored\",\n        \"headline\": \"Classic quad skates crafted with walnut burl heels\",\n        \"subheadline\": \"A vintage pair of skates with cream leather, bold red trim and quad wheels.\",\n        \"story\": \"Each pair combines soft cream leather with distinct red accents and a sculpted walnut burl heel base.\",\n        \"bullets\": [\n          \"Walnut burl heels\",\n          \"Restored vintage leather\"\n        ],\n        \"details\": [\n          {\n            \"label\": \"Material\",\n            \"value\": \"Leather upper, walnut burl heel, rubber wheels\"\n          }\n        ],\n        \"faq\": [\n          {\n            \"q\": \"Are these suitable for outdoor skating?\",\n            \"a\": \"Yes, on indoor rink floors and paved outdoor paths.\"\n          }\n        ],\n        \"ctaLabel\": \"Buy the skates\",\n        \"suggestedPriceUsd\": 240,\n        \"suggestedShippingUsd\": 15,\n        \"imageAlt\": \"Cream leather quad roller skates with red trim\",\n        \"heroPrompt\": \"Cream roller skates on a sunlit boardwalk, in warm cream and red tones\"\n      },\n      \"type\": \"object\",\n      \"properties\": {\n        \"productType\": {\n          \"title\": \"ProductType2\",\n          \"description\": \"What the AI decided the product is.\",\n          \"example\": \"physical\",\n          \"type\": \"string\",\n          \"additionalProperties\": false,\n          \"enum\": [\n            \"digital\",\n            \"physical\"\n          ]\n        },\n        \"productName\": {\n          \"description\": \"The product's name.\",\n          \"example\": \"Vintage Cream and Red Roller Skates\",\n          \"type\": \"string\"\n        },\n        \"layout\": {\n          \"title\": \"Layout\",\n          \"description\": \"The page template: `bold-hero` (image first, punchy), `editorial` (magazine), `minimal` (quiet, lots of space) or `playful`.\",\n          \"example\": \"bold-hero\",\n          \"type\": \"string\",\n          \"additionalProperties\": false,\n          \"enum\": [\n            \"bold-hero\",\n            \"editorial\",\n            \"minimal\",\n            \"playful\"\n          ]\n        },\n        \"palette\": {\n          \"id\": \"Palette\",\n          \"title\": \"Palette\",\n          \"description\": \"The page colours, taken from the photo. Text colours are checked for contrast.\",\n          \"example\": {\n            \"background\": \"#f7f1e8\",\n            \"surface\": \"#ffffff\",\n            \"text\": \"#1f1a17\",\n            \"muted\": \"#6b625b\",\n            \"accent\": \"#b3262d\",\n            \"accentText\": \"#ffffff\"\n          },\n          \"type\": \"object\",\n          \"properties\": {\n            \"background\": {\n              \"description\": \"A colour as `#rrggbb`.\",\n              \"example\": \"#14171a\",\n              \"type\": \"string\",\n              \"pattern\": \"^#[0-9a-fA-F]{6}$\"\n            },\n            \"surface\": {\n              \"description\": \"A colour as `#rrggbb`.\",\n              \"example\": \"#14171a\",\n              \"type\": \"string\",\n              \"pattern\": \"^#[0-9a-fA-F]{6}$\"\n            },\n            \"text\": {\n              \"description\": \"A colour as `#rrggbb`.\",\n              \"example\": \"#14171a\",\n              \"type\": \"string\",\n              \"pattern\": \"^#[0-9a-fA-F]{6}$\"\n            },\n            \"muted\": {\n              \"description\": \"A colour as `#rrggbb`.\",\n              \"example\": \"#14171a\",\n              \"type\": \"string\",\n              \"pattern\": \"^#[0-9a-fA-F]{6}$\"\n            },\n            \"accent\": {\n              \"description\": \"A colour as `#rrggbb`.\",\n              \"example\": \"#14171a\",\n              \"type\": \"string\",\n              \"pattern\": \"^#[0-9a-fA-F]{6}$\"\n            },\n            \"accentText\": {\n              \"description\": \"A colour as `#rrggbb`.\",\n              \"example\": \"#14171a\",\n              \"type\": \"string\",\n              \"pattern\": \"^#[0-9a-fA-F]{6}$\"\n            }\n          },\n          \"required\": [\n            \"background\",\n            \"surface\",\n            \"text\",\n            \"muted\",\n            \"accent\",\n            \"accentText\"\n          ]\n        },\n        \"fonts\": {\n          \"id\": \"Fonts\",\n          \"title\": \"Fonts\",\n          \"description\": \"Google Fonts for the page.\",\n          \"example\": {\n            \"heading\": \"Playfair Display\",\n            \"body\": \"Inter\"\n          },\n          \"type\": \"object\",\n          \"properties\": {\n            \"heading\": {\n              \"description\": \"The headings font.\",\n              \"example\": \"Playfair Display\",\n              \"type\": \"string\"\n            },\n            \"body\": {\n              \"description\": \"The body text font.\",\n              \"example\": \"Inter\",\n              \"type\": \"string\"\n            }\n          },\n          \"required\": [\n            \"heading\",\n            \"body\"\n          ]\n        },\n        \"headline\": {\n          \"description\": \"The page's main headline.\",\n          \"example\": \"Classic quad skates crafted with walnut burl heels\",\n          \"type\": \"string\"\n        },\n        \"bullets\": {\n          \"description\": \"Short selling points.\",\n          \"example\": [\n            \"Walnut burl heels\",\n            \"Restored vintage leather\"\n          ],\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\"\n          }\n        },\n        \"faq\": {\n          \"description\": \"Questions buyers will ask, with answers.\",\n          \"example\": [\n            {\n              \"q\": \"Are these suitable for outdoor skating?\",\n              \"a\": \"Yes, on indoor rink floors and paved outdoor paths.\"\n            }\n          ],\n          \"type\": \"array\",\n          \"items\": {\n            \"id\": \"Faq\",\n            \"title\": \"Faq\",\n            \"description\": \"One question and its answer.\",\n            \"example\": {\n              \"q\": \"Are these suitable for outdoor skating?\",\n              \"a\": \"Yes, on indoor rink floors and paved outdoor paths.\"\n            },\n            \"type\": \"object\",\n            \"properties\": {\n              \"q\": {\n                \"description\": \"The question.\",\n                \"example\": \"Are these suitable for outdoor skating?\",\n                \"type\": \"string\"\n              },\n              \"a\": {\n                \"description\": \"The answer.\",\n                \"example\": \"Yes, on indoor rink floors and paved outdoor paths.\",\n                \"type\": \"string\"\n              }\n            },\n            \"required\": [\n              \"q\",\n              \"a\"\n            ]\n          }\n        },\n        \"ctaLabel\": {\n          \"description\": \"The buy button's text.\",\n          \"example\": \"Buy the skates\",\n          \"type\": \"string\"\n        },\n        \"eyebrow\": {\n          \"description\": \"A short label above the headline.\",\n          \"example\": \"One pair, restored\",\n          \"type\": \"string\"\n        },\n        \"subheadline\": {\n          \"description\": \"A line under the headline.\",\n          \"example\": \"A vintage pair of skates with cream leather, bold red trim and quad wheels.\",\n          \"type\": \"string\"\n        },\n        \"story\": {\n          \"description\": \"A short paragraph about the product.\",\n          \"example\": \"Each pair combines soft cream leather with distinct red accents and a sculpted walnut burl heel base.\",\n          \"type\": \"string\"\n        },\n        \"details\": {\n          \"description\": \"Product facts shown on the page.\",\n          \"example\": [\n            {\n              \"label\": \"Material\",\n              \"value\": \"Leather upper, walnut burl heel, rubber wheels\"\n            }\n          ],\n          \"type\": \"array\",\n          \"items\": {\n            \"id\": \"Detail\",\n            \"title\": \"Detail\",\n            \"description\": \"One product fact.\",\n            \"example\": {\n              \"label\": \"Material\",\n              \"value\": \"Leather upper, walnut burl heel, rubber wheels\"\n            },\n            \"type\": \"object\",\n            \"properties\": {\n              \"label\": {\n                \"description\": \"What the fact is about.\",\n                \"example\": \"Material\",\n                \"type\": \"string\"\n              },\n              \"value\": {\n                \"description\": \"The fact.\",\n                \"example\": \"Leather upper, walnut burl heel, rubber wheels\",\n                \"type\": \"string\"\n              }\n            },\n            \"required\": [\n              \"label\",\n              \"value\"\n            ]\n          }\n        },\n        \"suggestedPriceUsd\": {\n          \"description\": \"The AI's price suggestion, in USD.\",\n          \"example\": 240,\n          \"type\": \"number\"\n        },\n        \"suggestedShippingUsd\": {\n          \"description\": \"The AI's shipping suggestion, in USD.\",\n          \"example\": 15,\n          \"type\": \"number\"\n        },\n        \"imageAlt\": {\n          \"description\": \"Alt text for the product photo.\",\n          \"example\": \"Cream leather quad roller skates with red trim\",\n          \"type\": \"string\"\n        },\n        \"heroPrompt\": {\n          \"description\": \"The prompt used to generate hero art for the page.\",\n          \"example\": \"Cream roller skates on a sunlit boardwalk, in warm cream and red tones\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"productType\",\n        \"productName\",\n        \"layout\",\n        \"palette\",\n        \"fonts\",\n        \"headline\",\n        \"bullets\",\n        \"faq\",\n        \"ctaLabel\"\n      ]\n    },\n    \"shipping_cents\": {\n      \"description\": \"Shipping per order, in cents.\",\n      \"example\": 1500,\n      \"type\": \"integer\",\n      \"format\": \"int32\"\n    },\n    \"ship_countries\": {\n      \"description\": \"Comma-separated ISO country codes; null or empty means anywhere PayPal ships.\",\n      \"example\": \"US,CA\",\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"stock\": {\n      \"description\": \"How many are left; null for unlimited. With options, see `option_stock`.\",\n      \"example\": 7,\n      \"type\": [\n        \"integer\",\n        \"null\"\n      ],\n      \"format\": \"int32\"\n    },\n    \"delivery\": {\n      \"title\": \"Delivery2\",\n      \"description\": \"Digital products: `file` (a download) or `access_code` (a code that unlocks an app or game).\",\n      \"example\": \"file\",\n      \"type\": \"string\",\n      \"additionalProperties\": false,\n      \"enum\": [\n        \"file\",\n        \"access_code\"\n      ]\n    },\n    \"access_url\": {\n      \"description\": \"Access-code products: where buyers enter their code.\",\n      \"example\": \"https://www.miriogames.com/raptor-rush/\",\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"paypal_email\": {\n      \"description\": \"The PayPal account paid when no account is connected.\",\n      \"example\": \"seller@example.com\",\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"seller_email\": {\n      \"description\": \"Where order notifications go.\",\n      \"example\": \"seller@example.com\",\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"paypal_merchant_id\": {\n      \"description\": \"The connected PayPal account (`connectPayPal`). Sales go here when it can receive payments.\",\n      \"example\": \"7MZJ4QXN8K2LA\",\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"paypal_status\": {\n      \"description\": \"What PayPal last said about the connected account; null when none is connected.\",\n      \"example\": {\n        \"receivable\": true,\n        \"emailConfirmed\": true,\n        \"checkedAt\": \"2026-10-22T02:41:37Z\"\n      },\n      \"oneOf\": [\n        {\n          \"id\": \"PayPalStatus\",\n          \"title\": \"PayPalStatus\",\n          \"description\": \"What PayPal last said about a connected seller account.\",\n          \"example\": {\n            \"receivable\": true,\n            \"emailConfirmed\": true,\n            \"checkedAt\": \"2026-10-22T02:41:37Z\"\n          },\n          \"type\": \"object\",\n          \"properties\": {\n            \"receivable\": {\n              \"description\": \"The account can receive payments.\",\n              \"example\": true,\n              \"type\": \"boolean\"\n            },\n            \"emailConfirmed\": {\n              \"description\": \"The seller has confirmed their email with PayPal.\",\n              \"example\": true,\n              \"type\": \"boolean\"\n            },\n            \"checkedAt\": {\n              \"description\": \"When OneThing last asked PayPal.\",\n              \"example\": \"2026-10-22T02:41:37Z\",\n              \"type\": \"string\",\n              \"format\": \"date-time\"\n            }\n          },\n          \"required\": [\n            \"receivable\",\n            \"emailConfirmed\",\n            \"checkedAt\"\n          ]\n        },\n        {\n          \"type\": \"null\"\n        }\n      ]\n    },\n    \"zapier_hook_url\": {\n      \"description\": \"A Zapier Catch Hook that gets an `OrderEvent` for each paid, shipped or refunded order.\",\n      \"example\": \"https://hooks.zapier.com/hooks/catch/123456/abcdef/\",\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"in_gallery\": {\n      \"description\": \"Whether the shop is featured at `/gallery` while live.\",\n      \"example\": true,\n      \"type\": \"boolean\"\n    },\n    \"account_id\": {\n      \"description\": \"The seller account that owns the shop, if it was made while signed in.\",\n      \"example\": \"acc_Vq3nN8cT0bLx2YwE\",\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"options\": {\n      \"description\": \"What the buyer picks, such as size or colour.\",\n      \"example\": [\n        {\n          \"name\": \"Size\",\n          \"kind\": \"size\",\n          \"values\": [\n            {\n              \"label\": \"S\"\n            },\n            {\n              \"label\": \"M\"\n            },\n            {\n              \"label\": \"L\"\n            }\n          ]\n        }\n      ],\n      \"type\": \"array\",\n      \"items\": {\n        \"id\": \"ShopOption\",\n        \"title\": \"ShopOption\",\n        \"description\": \"Something the buyer picks, such as a size or a colour. The shop still sells one product.\",\n        \"example\": {\n          \"name\": \"Size\",\n          \"kind\": \"size\",\n          \"values\": [\n            {\n              \"label\": \"S\"\n            },\n            {\n              \"label\": \"M\"\n            },\n            {\n              \"label\": \"L\"\n            }\n          ]\n        },\n        \"type\": \"object\",\n        \"properties\": {\n          \"name\": {\n            \"description\": \"What the buyer is choosing.\",\n            \"example\": \"Size\",\n            \"type\": \"string\",\n            \"maxLength\": 20\n          },\n          \"kind\": {\n            \"title\": \"Kind\",\n            \"description\": \"`color` shows swatches, and the photo of the picked colour.\",\n            \"example\": \"size\",\n            \"type\": \"string\",\n            \"additionalProperties\": false,\n            \"enum\": [\n              \"size\",\n              \"color\",\n              \"other\"\n            ]\n          },\n          \"values\": {\n            \"description\": \"The values to pick from.\",\n            \"example\": [\n              {\n                \"label\": \"S\"\n              },\n              {\n                \"label\": \"M\"\n              },\n              {\n                \"label\": \"L\"\n              }\n            ],\n            \"type\": \"array\",\n            \"items\": {\n              \"id\": \"OptionValue\",\n              \"title\": \"OptionValue\",\n              \"description\": \"One value of an option.\",\n              \"example\": {\n                \"label\": \"M\",\n                \"hex\": \"#14171a\",\n                \"photo\": \"zrySajNyao6_j11x\"\n              },\n              \"type\": \"object\",\n              \"properties\": {\n                \"label\": {\n                  \"description\": \"What the buyer sees and picks.\",\n                  \"example\": \"M\",\n                  \"type\": \"string\",\n                  \"maxLength\": 30\n                },\n                \"hex\": {\n                  \"description\": \"A colour as `#rrggbb`.\",\n                  \"example\": \"#14171a\",\n                  \"type\": \"string\",\n                  \"pattern\": \"^#[0-9a-fA-F]{6}$\"\n                },\n                \"photo\": {\n                  \"description\": \"Colours: the shop photo (id) that shows this colour. See `matchColorPhotos`.\",\n                  \"example\": \"zrySajNyao6_j11x\",\n                  \"type\": \"string\"\n                }\n              },\n              \"required\": [\n                \"label\"\n              ]\n            },\n            \"minItems\": 1,\n            \"maxItems\": 12\n          }\n        },\n        \"required\": [\n          \"name\",\n          \"kind\",\n          \"values\"\n        ]\n      }\n    },\n    \"option_stock\": {\n      \"description\": \"Stock per combination, keyed by its values in option order joined with ` / ` (e.g. `M / Black`). A missing key or `null` means unlimited; `0` is sold out.\",\n      \"example\": {\n        \"M / Black\": 4,\n        \"L / Black\": 0\n      },\n      \"type\": \"object\",\n      \"additionalProperties\": {\n        \"type\": [\n          \"integer\",\n          \"null\"\n        ],\n        \"format\": \"int32\"\n      },\n      \"minimum\": 0.0\n    },\n    \"suggestions\": {\n      \"description\": \"What the AI thinks buyers will pick or ask; null once handled.\",\n      \"example\": {\n        \"oneOfAKind\": false,\n        \"options\": [\n          {\n            \"name\": \"Size\",\n            \"kind\": \"size\",\n            \"values\": [\n              {\n                \"label\": \"S\"\n              },\n              {\n                \"label\": \"M\"\n              },\n              {\n                \"label\": \"L\"\n              }\n            ]\n          }\n        ],\n        \"missingFacts\": [\n          {\n            \"label\": \"Size\",\n            \"question\": \"What size are the skates?\",\n            \"placeholder\": \"US women's 8\"\n          }\n        ]\n      },\n      \"oneOf\": [\n        {\n          \"id\": \"Suggestions\",\n          \"title\": \"Suggestions\",\n          \"description\": \"What Gemini thinks buyers will want to choose or ask. The seller confirms; nothing is applied on its own.\",\n          \"example\": {\n            \"oneOfAKind\": false,\n            \"options\": [\n              {\n                \"name\": \"Size\",\n                \"kind\": \"size\",\n                \"values\": [\n                  {\n                    \"label\": \"S\"\n                  },\n                  {\n                    \"label\": \"M\"\n                  },\n                  {\n                    \"label\": \"L\"\n                  }\n                ]\n              }\n            ],\n            \"missingFacts\": [\n              {\n                \"label\": \"Size\",\n                \"question\": \"What size are the skates?\",\n                \"placeholder\": \"US women's 8\"\n              }\n            ]\n          },\n          \"type\": \"object\",\n          \"properties\": {\n            \"oneOfAKind\": {\n              \"description\": \"A single item (vintage, handmade), so options and stock don't apply.\",\n              \"example\": false,\n              \"type\": \"boolean\"\n            },\n            \"options\": {\n              \"description\": \"Options buyers will likely want to pick.\",\n              \"example\": [\n                {\n                  \"name\": \"Size\",\n                  \"kind\": \"size\",\n                  \"values\": [\n                    {\n                      \"label\": \"S\"\n                    },\n                    {\n                      \"label\": \"M\"\n                    },\n                    {\n                      \"label\": \"L\"\n                    }\n                  ]\n                }\n              ],\n              \"type\": \"array\",\n              \"items\": {\n                \"id\": \"Option\",\n                \"title\": \"Option\",\n                \"description\": \"A suggested option.\",\n                \"example\": {\n                  \"name\": \"Size\",\n                  \"kind\": \"size\",\n                  \"values\": [\n                    {\n                      \"label\": \"S\"\n                    },\n                    {\n                      \"label\": \"M\"\n                    },\n                    {\n                      \"label\": \"L\"\n                    }\n                  ]\n                },\n                \"type\": \"object\",\n                \"properties\": {\n                  \"name\": {\n                    \"description\": \"What the buyer is choosing.\",\n                    \"example\": \"Size\",\n                    \"type\": \"string\",\n                    \"maxLength\": 20\n                  },\n                  \"kind\": {\n                    \"$ref\": \"ShopOption#/properties/kind\"\n                  },\n                  \"values\": {\n                    \"description\": \"The values to pick from.\",\n                    \"example\": [\n                      {\n                        \"label\": \"S\"\n                      },\n                      {\n                        \"label\": \"M\"\n                      },\n                      {\n                        \"label\": \"L\"\n                      }\n                    ],\n                    \"type\": \"array\",\n                    \"items\": {\n                      \"$ref\": \"OptionValue\"\n                    },\n                    \"minItems\": 1,\n                    \"maxItems\": 12\n                  },\n                  \"fromSeller\": {\n                    \"description\": \"The seller's description or photo named these values; otherwise they're a guess.\",\n                    \"example\": false,\n                    \"type\": \"boolean\"\n                  }\n                },\n                \"required\": [\n                  \"name\",\n                  \"kind\",\n                  \"values\"\n                ]\n              }\n            },\n            \"missingFacts\": {\n              \"description\": \"Questions buyers will ask that the listing doesn't answer yet.\",\n              \"example\": [\n                {\n                  \"label\": \"Size\",\n                  \"question\": \"What size are the skates?\",\n                  \"placeholder\": \"US women's 8\"\n                }\n              ],\n              \"type\": \"array\",\n              \"items\": {\n                \"id\": \"MissingFact\",\n                \"title\": \"MissingFact\",\n                \"description\": \"One question to answer.\",\n                \"example\": {\n                  \"label\": \"Size\",\n                  \"question\": \"What size are the skates?\",\n                  \"placeholder\": \"US women's 8\"\n                },\n                \"type\": \"object\",\n                \"properties\": {\n                  \"label\": {\n                    \"description\": \"The product detail it becomes.\",\n                    \"example\": \"Size\",\n                    \"type\": \"string\"\n                  },\n                  \"question\": {\n                    \"description\": \"The question, for the seller.\",\n                    \"example\": \"What size are the skates?\",\n                    \"type\": \"string\"\n                  },\n                  \"placeholder\": {\n                    \"description\": \"An example answer.\",\n                    \"example\": \"US women's 8\",\n                    \"type\": \"string\"\n                  }\n                },\n                \"required\": [\n                  \"label\",\n                  \"question\",\n                  \"placeholder\"\n                ]\n              }\n            }\n          },\n          \"required\": [\n            \"oneOfAKind\",\n            \"options\",\n            \"missingFacts\"\n          ]\n        },\n        {\n          \"type\": \"null\"\n        }\n      ]\n    },\n    \"photo_blob\": {\n      \"description\": \"Image id for `getImage`. The cover photo.\",\n      \"example\": \"LFRvGuTU3D8i334X\",\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"gallery_blobs\": {\n      \"description\": \"The other photos, in order.\",\n      \"example\": [\n        \"zrySajNyao6_j11x\",\n        \"SuqcgNv64HWN8H6e\"\n      ],\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"hero_blob\": {\n      \"description\": \"Image id of the AI hero art, when there is one.\",\n      \"example\": \"Hn2Kd8sQp4LmZ0vX\",\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"hero_status\": {\n      \"title\": \"HeroStatus\",\n      \"description\": \"Hero art: `pending` while generating, then `ready` or `failed`; `none` if not requested.\",\n      \"example\": \"none\",\n      \"type\": \"string\",\n      \"additionalProperties\": false,\n      \"enum\": [\n        \"none\",\n        \"pending\",\n        \"ready\",\n        \"failed\"\n      ]\n    },\n    \"hero_error\": {\n      \"description\": \"Why hero art failed, when it did.\",\n      \"example\": \"No image model on this key returned an image.\",\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"ai_source\": {\n      \"title\": \"AiSource\",\n      \"description\": \"Who designed the page: `gemini`, or `fallback` when Gemini wasn't available and a plain template was used.\",\n      \"example\": \"gemini\",\n      \"type\": \"string\",\n      \"additionalProperties\": false,\n      \"enum\": [\n        \"gemini\",\n        \"fallback\"\n      ]\n    },\n    \"source_url\": {\n      \"description\": \"The product link the shop was made from, if any.\",\n      \"example\": \"https://example.com/products/roller-skates\",\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"referral\": {\n      \"description\": \"Recommendation shops: the Channel3 product; null otherwise.\",\n      \"example\": {\n        \"productId\": \"ch3_7f2a9c1e\",\n        \"title\": \"Trail Running Vest 5L\",\n        \"brand\": \"Salomon\",\n        \"image\": \"https://images.example.com/vest.jpg\",\n        \"offers\": [\n          {\n            \"domain\": \"rei.com\",\n            \"url\": \"https://buy.trychannel3.com/r/abc123\",\n            \"price\": 240,\n            \"currency\": \"USD\",\n            \"inStock\": true,\n            \"commission\": 0.08\n          }\n        ]\n      },\n      \"oneOf\": [\n        {\n          \"id\": \"Referral\",\n          \"title\": \"Referral\",\n          \"description\": \"A recommended Channel3 product. Buy links are Channel3-tracked, credited to this shop.\",\n          \"example\": {\n            \"productId\": \"ch3_7f2a9c1e\",\n            \"title\": \"Trail Running Vest 5L\",\n            \"brand\": \"Salomon\",\n            \"image\": \"https://images.example.com/vest.jpg\",\n            \"offers\": [\n              {\n                \"domain\": \"rei.com\",\n                \"url\": \"https://buy.trychannel3.com/r/abc123\",\n                \"price\": 240,\n                \"currency\": \"USD\",\n                \"inStock\": true,\n                \"commission\": 0.08\n              }\n            ]\n          },\n          \"type\": \"object\",\n          \"properties\": {\n            \"productId\": {\n              \"description\": \"Channel3's product id.\",\n              \"example\": \"ch3_7f2a9c1e\",\n              \"type\": \"string\"\n            },\n            \"title\": {\n              \"description\": \"The product's name.\",\n              \"example\": \"Trail Running Vest 5L\",\n              \"type\": \"string\"\n            },\n            \"offers\": {\n              \"description\": \"Stores that sell it, with tracked links.\",\n              \"example\": [\n                {\n                  \"domain\": \"rei.com\",\n                  \"url\": \"https://buy.trychannel3.com/r/abc123\",\n                  \"price\": 240,\n                  \"currency\": \"USD\",\n                  \"inStock\": true,\n                  \"commission\": 0.08\n                }\n              ],\n              \"type\": \"array\",\n              \"items\": {\n                \"id\": \"Offer\",\n                \"title\": \"Offer\",\n                \"description\": \"One store's offer.\",\n                \"example\": {\n                  \"domain\": \"rei.com\",\n                  \"url\": \"https://buy.trychannel3.com/r/abc123\",\n                  \"price\": 240,\n                  \"currency\": \"USD\",\n                  \"inStock\": true,\n                  \"commission\": 0.08\n                },\n                \"type\": \"object\",\n                \"properties\": {\n                  \"domain\": {\n                    \"description\": \"The store's domain.\",\n                    \"example\": \"rei.com\",\n                    \"type\": \"string\"\n                  },\n                  \"url\": {\n                    \"description\": \"A Channel3-tracked buy link, credited to this shop.\",\n                    \"example\": \"https://buy.trychannel3.com/r/abc123\",\n                    \"type\": \"string\"\n                  },\n                  \"price\": {\n                    \"description\": \"The store's price.\",\n                    \"example\": 240,\n                    \"type\": \"number\"\n                  },\n                  \"currency\": {\n                    \"description\": \"ISO 4217 currency code.\",\n                    \"example\": \"USD\",\n                    \"type\": \"string\"\n                  },\n                  \"inStock\": {\n                    \"description\": \"Whether the store has it in stock.\",\n                    \"example\": true,\n                    \"type\": \"boolean\"\n                  },\n                  \"commission\": {\n                    \"description\": \"Maximum commission rate, 0–1 (0.08 = 8%).\",\n                    \"example\": 0.08,\n                    \"type\": \"number\"\n                  }\n                },\n                \"required\": [\n                  \"domain\",\n                  \"url\",\n                  \"price\",\n                  \"currency\",\n                  \"inStock\",\n                  \"commission\"\n                ]\n              }\n            },\n            \"brand\": {\n              \"description\": \"The brand, when known.\",\n              \"example\": \"Salomon\",\n              \"type\": [\n                \"string\",\n                \"null\"\n              ]\n            },\n            \"image\": {\n              \"description\": \"The product image's URL.\",\n              \"example\": \"https://images.example.com/vest.jpg\",\n              \"type\": [\n                \"string\",\n                \"null\"\n              ]\n            }\n          },\n          \"required\": [\n            \"productId\",\n            \"title\",\n            \"offers\"\n          ]\n        },\n        {\n          \"type\": \"null\"\n        }\n      ]\n    },\n    \"created_at\": {\n      \"description\": \"When the shop was made.\",\n      \"example\": \"2026-10-22T02:41:37Z\",\n      \"type\": \"string\",\n      \"format\": \"date-time\"\n    }\n  },\n  \"required\": [\n    \"id\",\n    \"slug\",\n    \"status\",\n    \"product_type\",\n    \"price_cents\",\n    \"currency\",\n    \"spec\"\n  ]\n}"
                example: '{"id":"Hn2c8QvL0xTzR4pW","slug":"vintageskates","status":"live","product_type":"physical","price_cents":24000,"currency":"USD","shipping_cents":1500,"ship_countries":"US","stock":null,"delivery":"file","access_url":null,"paypal_email":"seller@example.com","seller_email":"seller@example.com","paypal_merchant_id":"7MZJ4QXN8K2LA","paypal_status":{"receivable":true,"emailConfirmed":true,"checkedAt":"2026-10-21T18:04:11Z"},"zapier_hook_url":null,"in_gallery":true,"account_id":"Vq3nN8cT0bLx2YwE","options":[{"name":"Size","kind":"size","values":[{"label":"7"},{"label":"8"},{"label":"9"}]}],"option_stock":{"7":3,"8":0,"9":6},"suggestions":null,"photo_blob":"LFRvGuTU3D8i334X","gallery_blobs":["zrySajNyao6_j11x","SuqcgNv64HWN8H6e"],"hero_blob":null,"hero_status":"none","hero_error":null,"ai_source":"gemini","source_url":null,"referral":null,"spec":{"productType":"physical","productName":"Vintage Cream and Red Roller Skates","layout":"editorial","palette":{"background":"#f6efe4","surface":"#fffaf2","text":"#2b1d14","muted":"#7a6455","accent":"#b3261e","accentText":"#ffffff"},"fonts":{"heading":"Playfair Display","body":"Inter"},"eyebrow":"One pair, restored","headline":"Classic quad skates crafted with walnut burl heels","subheadline":"A vintage pair of skates featuring cream leather, bold red trim, and durable quad wheels.","story":"Each pair combines soft cream leather with distinct red accents and a sculpted walnut burl heel base.","bullets":["Handmade cream leather upper with rich red trim","Sculpted walnut burl heel structure for stability"],"details":[{"label":"Materials","value":"Leather upper, walnut burl heel, rubber wheels"}],"faq":[{"q":"Are these suitable for outdoor skating?","a":"Yes, on indoor rink floors and paved outdoor paths."}],"ctaLabel":"Buy the skates","suggestedPriceUsd":240,"suggestedShippingUsd":15,"imageAlt":"Cream leather quad roller skates with red trim"},"created_at":"2026-10-19T15:22:08Z"}'
          '404':
            description: No such shop, or the admin token or API key doesn't match it.
            body:
              application/json:
                schema: |
                  {
                    "id": "ErrorResponse",
                    "title": "ErrorResponse",
                    "description": "An error reply.",
                    "example": {
                      "error": "Choose a photo.",
                      "field": "photo"
                    },
                    "type": "object",
                    "properties": {
                      "error": {
                        "description": "A sentence you can show to a person.",
                        "example": "Order not found.",
                        "type": "string"
                      },
                      "field": {
                        "description": "The form field at fault, when there is one.",
                        "example": "price",
                        "type": "string"
                      },
                      "detail": {
                        "description": "The upstream service's own message, for debugging.",
                        "example": "INSTRUMENT_DECLINED",
                        "type": "string"
                      }
                    },
                    "required": [
                      "error"
                    ]
                  }
                example: '{"error":"Shop not found."}'
      patch:
        securedBy:
        - AdminToken
        - PlatformKey
        description: >
          Changes only the fields you send. Renaming `slug` keeps the old link working (it

          redirects). Set `status: live` to publish; a digital product needs its file (or, for

          access codes, `access_url`) first.
        headers:
          Content-Type:
            required: true
            displayName: Content-Type
            enum:
            - application/json
        body:
          application/json:
            schema: |
              {
                "id": "ShopUpdate",
                "title": "ShopUpdate",
                "description": "The fields to change; anything left out stays as it is.",
                "example": {
                  "slug": "vintageskates",
                  "status": "draft",
                  "product_type": "physical",
                  "price": 240,
                  "shipping": 15,
                  "stock": 7,
                  "ship_countries": "US,CA",
                  "delivery": "file",
                  "access_url": "https://www.miriogames.com/raptor-rush/",
                  "paypal_email": "seller@example.com",
                  "seller_email": "seller@example.com",
                  "zapier_hook_url": "https://hooks.zapier.com/hooks/catch/123456/abcdef/",
                  "in_gallery": true,
                  "options": [
                    {
                      "name": "Size",
                      "kind": "size",
                      "values": [
                        {
                          "label": "S"
                        },
                        {
                          "label": "M"
                        },
                        {
                          "label": "L"
                        }
                      ]
                    }
                  ],
                  "option_stock": {
                    "M / Black": 4,
                    "L / Black": 0
                  },
                  "facts": [
                    {
                      "label": "Size",
                      "value": "US women's 8"
                    }
                  ]
                },
                "examples": [
                  {
                    "Id": "golive",
                    "Name": "Go live",
                    "Value": "{\"status\":\"live\"}",
                    "ExternalValue": null,
                    "Description": null
                  },
                  {
                    "Id": "edit",
                    "Name": "Fix the AI's guesses",
                    "Value": "{\"price\":240,\"shipping\":15,\"ship_countries\":\"US,CA\",\"in_gallery\":true}",
                    "ExternalValue": null,
                    "Description": null
                  },
                  {
                    "Id": "sizes",
                    "Name": "Sizes with stock per size",
                    "Value": "{\"options\":[{\"name\":\"Size\",\"kind\":\"size\",\"values\":[{\"label\":\"7\"},{\"label\":\"8\"},{\"label\":\"9\"}]}],\"option_stock\":{\"7\":3,\"8\":0,\"9\":6}}",
                    "ExternalValue": null,
                    "Description": null
                  },
                  {
                    "Id": "facts",
                    "Name": "Answer what buyers will ask",
                    "Value": "{\"facts\":[{\"label\":\"Wheel size\",\"value\":\"57 mm\"}]}",
                    "ExternalValue": null,
                    "Description": null
                  }
                ],
                "type": "object",
                "properties": {
                  "slug": {
                    "description": "A new link name. The old one keeps redirecting.",
                    "example": "vintageskates",
                    "type": "string"
                  },
                  "status": {
                    "title": "Status",
                    "description": "`live` publishes the shop; `draft` takes it down.",
                    "example": "draft",
                    "type": "string",
                    "additionalProperties": false,
                    "enum": [
                      "draft",
                      "live"
                    ]
                  },
                  "product_type": {
                    "title": "ProductType",
                    "description": "`referral` only for shops created from Channel3.",
                    "example": "physical",
                    "type": "string",
                    "additionalProperties": false,
                    "enum": [
                      "physical",
                      "digital",
                      "referral"
                    ]
                  },
                  "price": {
                    "description": "The price in USD.",
                    "example": 240,
                    "type": "number",
                    "minimum": 0.5,
                    "maximum": 10000.0
                  },
                  "shipping": {
                    "description": "Shipping per order, in USD.",
                    "example": 15,
                    "type": "number",
                    "minimum": 0.0,
                    "maximum": 500.0
                  },
                  "stock": {
                    "description": "How many are for sale; null for unlimited.",
                    "example": 7,
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0.0,
                    "format": "int32"
                  },
                  "ship_countries": {
                    "description": "Comma-separated ISO country codes; null or empty means anywhere PayPal ships.",
                    "example": "US,CA",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "delivery": {
                    "title": "Delivery1",
                    "description": "Digital products: `file` or `access_code`.",
                    "example": "file",
                    "type": "string",
                    "additionalProperties": false,
                    "enum": [
                      "file",
                      "access_code"
                    ]
                  },
                  "access_url": {
                    "description": "Access-code products: where buyers enter their code.",
                    "example": "https://www.miriogames.com/raptor-rush/",
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "uri"
                  },
                  "paypal_email": {
                    "description": "The PayPal account paid when no account is connected.",
                    "example": "seller@example.com",
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "email"
                  },
                  "seller_email": {
                    "description": "Where order notifications go.",
                    "example": "seller@example.com",
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "email"
                  },
                  "zapier_hook_url": {
                    "description": "A Zapier Catch Hook for order events; null removes it.",
                    "example": "https://hooks.zapier.com/hooks/catch/123456/abcdef/",
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "uri"
                  },
                  "in_gallery": {
                    "description": "Feature the shop at `/gallery` while it's live. Off by default.",
                    "example": true,
                    "type": "boolean"
                  },
                  "options": {
                    "description": "What the buyer picks (physical products only), replacing the current options; `[]` removes them. With options, stock is counted per combination in `option_stock` and the shop's own `stock` is cleared. At most 60 combinations.",
                    "example": [
                      {
                        "name": "Size",
                        "kind": "size",
                        "values": [
                          {
                            "label": "S"
                          },
                          {
                            "label": "M"
                          },
                          {
                            "label": "L"
                          }
                        ]
                      }
                    ],
                    "type": "array",
                    "items": {
                      "id": "ShopOption",
                      "title": "ShopOption",
                      "description": "Something the buyer picks, such as a size or a colour. The shop still sells one product.",
                      "example": {
                        "name": "Size",
                        "kind": "size",
                        "values": [
                          {
                            "label": "S"
                          },
                          {
                            "label": "M"
                          },
                          {
                            "label": "L"
                          }
                        ]
                      },
                      "type": "object",
                      "properties": {
                        "name": {
                          "description": "What the buyer is choosing.",
                          "example": "Size",
                          "type": "string",
                          "maxLength": 20
                        },
                        "kind": {
                          "title": "Kind",
                          "description": "`color` shows swatches, and the photo of the picked colour.",
                          "example": "size",
                          "type": "string",
                          "additionalProperties": false,
                          "enum": [
                            "size",
                            "color",
                            "other"
                          ]
                        },
                        "values": {
                          "description": "The values to pick from.",
                          "example": [
                            {
                              "label": "S"
                            },
                            {
                              "label": "M"
                            },
                            {
                              "label": "L"
                            }
                          ],
                          "type": "array",
                          "items": {
                            "id": "OptionValue",
                            "title": "OptionValue",
                            "description": "One value of an option.",
                            "example": {
                              "label": "M",
                              "hex": "#14171a",
                              "photo": "zrySajNyao6_j11x"
                            },
                            "type": "object",
                            "properties": {
                              "label": {
                                "description": "What the buyer sees and picks.",
                                "example": "M",
                                "type": "string",
                                "maxLength": 30
                              },
                              "hex": {
                                "description": "A colour as `#rrggbb`.",
                                "example": "#14171a",
                                "type": "string",
                                "pattern": "^#[0-9a-fA-F]{6}$"
                              },
                              "photo": {
                                "description": "Colours: the shop photo (id) that shows this colour. See `matchColorPhotos`.",
                                "example": "zrySajNyao6_j11x",
                                "type": "string"
                              }
                            },
                            "required": [
                              "label"
                            ]
                          },
                          "minItems": 1,
                          "maxItems": 12
                        }
                      },
                      "required": [
                        "name",
                        "kind",
                        "values"
                      ]
                    },
                    "maxItems": 3
                  },
                  "option_stock": {
                    "description": "Stock per combination, keyed by its values in option order joined with ` / ` (e.g. `M / Black`). A missing key or `null` means unlimited; `0` is sold out.",
                    "example": {
                      "M / Black": 4,
                      "L / Black": 0
                    },
                    "type": "object",
                    "additionalProperties": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "format": "int32"
                    },
                    "minimum": 0.0
                  },
                  "facts": {
                    "description": "Answers to the \"buyers will ask\" questions in `suggestions.missingFacts`. Each becomes a product detail on the page (replacing one with the same label) and drops off the list.",
                    "example": [
                      {
                        "label": "Size",
                        "value": "US women's 8"
                      }
                    ],
                    "type": "array",
                    "items": {
                      "id": "Fact",
                      "title": "Fact",
                      "description": "One answered question.",
                      "example": {
                        "label": "Size",
                        "value": "US women's 8"
                      },
                      "type": "object",
                      "properties": {
                        "label": {
                          "description": "The detail's label.",
                          "example": "Size",
                          "type": "string",
                          "maxLength": 30
                        },
                        "value": {
                          "description": "The answer.",
                          "example": "US women's 8",
                          "type": "string",
                          "maxLength": 100
                        }
                      },
                      "required": [
                        "label",
                        "value"
                      ]
                    },
                    "maxItems": 5
                  }
                }
              }
            example: '{"status":"live"}'
        responses:
          '200':
            description: Saved.
            body:
              application/json:
                schema: |
                  {
                    "id": "ApiShopsResponse",
                    "title": "ApiShopsResponse",
                    "description": "The shop was saved.",
                    "example": {
                      "ok": true,
                      "slug": "vintageskates"
                    },
                    "type": "object",
                    "properties": {
                      "ok": {
                        "description": "Always `true`.",
                        "example": true,
                        "type": "boolean"
                      },
                      "slug": {
                        "description": "The shop's link name after this change.",
                        "example": "vintageskates",
                        "type": "string"
                      }
                    },
                    "required": [
                      "ok",
                      "slug"
                    ]
                  }
                example: '{"ok":true,"slug":"vintageskates"}'
          '400':
            description: Something in the request needs fixing; `error` says what.
            body:
              application/json:
                schema: |
                  {
                    "id": "ErrorResponse",
                    "title": "ErrorResponse",
                    "description": "An error reply.",
                    "example": {
                      "error": "Choose a photo.",
                      "field": "photo"
                    },
                    "type": "object",
                    "properties": {
                      "error": {
                        "description": "A sentence you can show to a person.",
                        "example": "Order not found.",
                        "type": "string"
                      },
                      "field": {
                        "description": "The form field at fault, when there is one.",
                        "example": "price",
                        "type": "string"
                      },
                      "detail": {
                        "description": "The upstream service's own message, for debugging.",
                        "example": "INSTRUMENT_DECLINED",
                        "type": "string"
                      }
                    },
                    "required": [
                      "error"
                    ]
                  }
                example: '{"error":"Choose a photo."}'
          '404':
            description: No such shop, or the admin token or API key doesn't match it.
            body:
              application/json:
                schema: |
                  {
                    "id": "ErrorResponse",
                    "title": "ErrorResponse",
                    "description": "An error reply.",
                    "example": {
                      "error": "Choose a photo.",
                      "field": "photo"
                    },
                    "type": "object",
                    "properties": {
                      "error": {
                        "description": "A sentence you can show to a person.",
                        "example": "Order not found.",
                        "type": "string"
                      },
                      "field": {
                        "description": "The form field at fault, when there is one.",
                        "example": "price",
                        "type": "string"
                      },
                      "detail": {
                        "description": "The upstream service's own message, for debugging.",
                        "example": "INSTRUMENT_DECLINED",
                        "type": "string"
                      }
                    },
                    "required": [
                      "error"
                    ]
                  }
                example: '{"error":"Shop not found."}'
    post:
      securedBy:
      - null
      - PlatformKey
      description: >
        Starts a draft shop from one of three sources. Gemini designs the page and guesses the

        setup; check it with `getShop`, adjust with `updateShop`, then go live.


        Sent with a session cookie from `signIn`, the shop belongs to that account, which also

        becomes its seller email (and PayPal email, after Log in with PayPal) unless you give one.


        - `source=photo`: a `photo` and/or a `description` of your own product.

        - `source=link`: a `url`. If Channel3 recognises it as a store's product page, the shop
          becomes a recommendation (`product_type: referral`); otherwise the page is read and you
          sell the product yourself with PayPal.
        - `source=channel3`: a `productId` from `searchProducts` (a recommendation).


        Takes 15–40 seconds. Hero art, if available, is generated afterwards (`hero_status`).


        **Platforms:** sent with a platform API key, the shop belongs to the key's account, so the

        key can manage it from then on (no need to keep the admin token). It's made for one of the

        platform's sellers, so it inherits nothing from the account: set `paypal_email` or call

        `connectPayPal` for that seller.
      body:
        multipart/form-data:
          formParameters:
            source:
              description: 'What the shop starts from: a photo (with an optional description), a product link, or a Channel3 product to recommend.'
              required: true
              displayName: source
              enum:
              - photo
              - link
              - channel3
            photo:
              description: '`source=photo`: the product photo, up to 8 MB.'
              type: file
              required: false
              displayName: photo
            description:
              description: '`source=photo`: a sentence or two about the product. Required if there is no photo.'
              type: string
              example: Vintage cream and red quad roller skates with walnut burl heels.
              required: false
              displayName: description
            url:
              description: '`source=link`: a product page, or your own app or game page.'
              type: string
              example: https://one-thing-ash0.onrender.com/vintageskates
              required: false
              displayName: url
            productId:
              description: '`source=channel3`: a product id from `searchProducts`.'
              type: string
              example: ch3_7f2a9c1e
              required: false
              displayName: productId
            slug:
              description: The link name you want. If omitted, the AI suggests one.
              type: string
              example: vintageskates
              required: false
              displayName: slug
            type:
              description: '`physical` ships, `digital` is a file or an access code, `auto` lets the AI decide.'
              default: auto
              required: false
              displayName: type
              enum:
              - auto
              - physical
              - digital
            delivery:
              description: For digital products. If omitted, the AI guesses.
              required: false
              displayName: delivery
              enum:
              - file
              - access_code
            access_url:
              description: Where buyers use an access code.
              type: string
              example: https://www.miriogames.com/raptor-rush/
              required: false
              displayName: access_url
            price:
              description: USD. If omitted, the AI suggests a price.
              type: number
              example: '240'
              required: false
              displayName: price
            shipping:
              description: 'Physical products: shipping per order, in USD. If omitted, the AI suggests it.'
              type: number
              example: '15'
              required: false
              displayName: shipping
            stock:
              description: How many are for sale. Leave out for unlimited.
              type: integer
              example: '7'
              required: false
              displayName: stock
            ship_countries:
              description: 'Physical products: comma-separated ISO country codes to ship to. Empty means anywhere PayPal ships.'
              type: string
              required: false
              displayName: ship_countries
            paypal_email:
              description: The PayPal account that gets paid, if the seller doesn't connect one with `connectPayPal`.
              type: string
              example: seller@example.com
              required: false
              displayName: paypal_email
            seller_email:
              description: Where order notifications go.
              type: string
              example: seller@example.com
              required: false
              displayName: seller_email
            digital_file:
              description: 'Digital products sold as a file: the file buyers download, up to 25 MB. Can also be added later with `uploadDigitalFile`.'
              type: file
              required: false
              displayName: digital_file
      responses:
        '200':
          description: Draft created.
          body:
            application/json:
              schema: |
                {
                  "id": "CreatedShop",
                  "title": "CreatedShop",
                  "description": "The new draft shop and the credentials to manage it.",
                  "example": {
                    "slug": "dragonflight",
                    "token": "3fJ9xQm2LwP8vR1tZk7cN4bY6dHs0aEu",
                    "manageUrl": "/manage/vintageskates?token=3fJ9xQm2LwP8vR1tZk7cN4bY6dHs0aEu"
                  },
                  "type": "object",
                  "properties": {
                    "slug": {
                      "description": "The shop's link name: the page is `https://<host>/<slug>`.",
                      "example": "dragonflight",
                      "type": "string"
                    },
                    "token": {
                      "description": "The admin token. Shown once; store it.",
                      "example": "3fJ9xQm2LwP8vR1tZk7cN4bY6dHs0aEu",
                      "type": "string"
                    },
                    "manageUrl": {
                      "description": "The seller's private manage page (contains the token).",
                      "example": "/manage/vintageskates?token=3fJ9xQm2LwP8vR1tZk7cN4bY6dHs0aEu",
                      "type": "string"
                    }
                  },
                  "required": [
                    "slug",
                    "token",
                    "manageUrl"
                  ]
                }
              example: '{"slug":"vintageskates","token":"3fJ9xQm2LwP8vR1tZk7cN4bY6dHs0aEu","manageUrl":"/manage/vintageskates?token=3fJ9xQm2LwP8vR1tZk7cN4bY6dHs0aEu"}'
        '400':
          description: Something in the request needs fixing; `error` says what.
          body:
            application/json:
              schema: |
                {
                  "id": "ErrorResponse",
                  "title": "ErrorResponse",
                  "description": "An error reply.",
                  "example": {
                    "error": "Choose a photo.",
                    "field": "photo"
                  },
                  "type": "object",
                  "properties": {
                    "error": {
                      "description": "A sentence you can show to a person.",
                      "example": "Order not found.",
                      "type": "string"
                    },
                    "field": {
                      "description": "The form field at fault, when there is one.",
                      "example": "price",
                      "type": "string"
                    },
                    "detail": {
                      "description": "The upstream service's own message, for debugging.",
                      "example": "INSTRUMENT_DECLINED",
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              example: '{"error":"Choose a photo."}'
        '409':
          description: Taken or unavailable (a link name, or a sold-out product).
          body:
            application/json:
              schema: |
                {
                  "id": "ErrorResponse",
                  "title": "ErrorResponse",
                  "description": "An error reply.",
                  "example": {
                    "error": "Choose a photo.",
                    "field": "photo"
                  },
                  "type": "object",
                  "properties": {
                    "error": {
                      "description": "A sentence you can show to a person.",
                      "example": "Order not found.",
                      "type": "string"
                    },
                    "field": {
                      "description": "The form field at fault, when there is one.",
                      "example": "price",
                      "type": "string"
                    },
                    "detail": {
                      "description": "The upstream service's own message, for debugging.",
                      "example": "INSTRUMENT_DECLINED",
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              example: '{"error":"Sold out."}'
        '429':
          description: Over this network's cap for the call (see **Limits**). Retry after `Retry-After` seconds.
          headers:
            Retry-After:
              required: false
          body:
            application/json:
              schema: |
                {
                  "id": "ErrorResponse",
                  "title": "ErrorResponse",
                  "description": "An error reply.",
                  "example": {
                    "error": "Choose a photo.",
                    "field": "photo"
                  },
                  "type": "object",
                  "properties": {
                    "error": {
                      "description": "A sentence you can show to a person.",
                      "example": "Order not found.",
                      "type": "string"
                    },
                    "field": {
                      "description": "The form field at fault, when there is one.",
                      "example": "price",
                      "type": "string"
                    },
                    "detail": {
                      "description": "The upstream service's own message, for debugging.",
                      "example": "INSTRUMENT_DECLINED",
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              example: '{"error":"Too many checkouts from your network. Try again in 7 min."}'
        '502':
          description: Gemini, PayPal or Channel3 failed or isn't configured.
          body:
            application/json:
              schema: |
                {
                  "id": "ErrorResponse",
                  "title": "ErrorResponse",
                  "description": "An error reply.",
                  "example": {
                    "error": "Choose a photo.",
                    "field": "photo"
                  },
                  "type": "object",
                  "properties": {
                    "error": {
                      "description": "A sentence you can show to a person.",
                      "example": "Order not found.",
                      "type": "string"
                    },
                    "field": {
                      "description": "The form field at fault, when there is one.",
                      "example": "price",
                      "type": "string"
                    },
                    "detail": {
                      "description": "The upstream service's own message, for debugging.",
                      "example": "INSTRUMENT_DECLINED",
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              example: "{\"error\":\"PayPal isn't configured on this server.\"}"
  /slugs/check:
    get:
      description: Normalises a proposed link name and says whether a new shop can use it.
      queryParameters:
        name:
          description: Anything; it is normalised (`Raptor Rush` becomes `raptor-rush`).
          type: string
          example: Raptor Rush
          required: true
          displayName: name
      responses:
        '200':
          description: The normalised name and whether it can be used.
          body:
            application/json:
              schema: |
                {
                  "id": "ApiSlugsCheckResponse",
                  "title": "ApiSlugsCheckResponse",
                  "description": "Whether the link name can be used.",
                  "examples": [
                    {
                      "Id": "free",
                      "Name": "Available",
                      "Value": "{\"slug\":\"raptor-rush\",\"available\":true}",
                      "ExternalValue": null,
                      "Description": null
                    },
                    {
                      "Id": "taken",
                      "Name": "Taken",
                      "Value": "{\"slug\":\"raptorrush\",\"available\":false,\"problem\":\"Taken. Try another name.\"}",
                      "ExternalValue": null,
                      "Description": null
                    }
                  ],
                  "example": {
                    "slug": "raptor-rush",
                    "available": true
                  },
                  "type": "object",
                  "properties": {
                    "slug": {
                      "description": "The name, normalised.",
                      "example": "vintageskates",
                      "type": "string"
                    },
                    "available": {
                      "description": "True if no other shop has it and it isn't reserved.",
                      "example": true,
                      "type": "boolean"
                    },
                    "problem": {
                      "description": "Why not, when unavailable.",
                      "example": "Taken. Try another name.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "slug",
                    "available"
                  ]
                }
              example: '{"slug":"raptor-rush","available":true}'
  /channel3/search:
    get:
      description: Searches 100M+ products from 25k+ stores through Channel3. Pass a result's `id` to `createShop` with `source=channel3`.
      queryParameters:
        q:
          description: What to look for, in plain words.
          type: string
          example: trail running vest
          required: true
          displayName: q
          maxLength: '200'
      responses:
        '200':
          description: Up to 12 products.
          body:
            application/json:
              schema: |
                {
                  "id": "ApiChannel3SearchResponse",
                  "title": "ApiChannel3SearchResponse",
                  "description": "The products found.",
                  "example": {
                    "products": [
                      {
                        "id": "ch3_7f2a9c1e",
                        "title": "Trail Running Vest 5L",
                        "brand": "Salomon",
                        "image": "https://images.example.com/vest.jpg",
                        "price": 59.99,
                        "currency": "USD",
                        "retailer": "rei.com",
                        "retailers": 4,
                        "commission": 0.08
                      }
                    ]
                  },
                  "type": "object",
                  "properties": {
                    "products": {
                      "description": "Products, best match first.",
                      "example": [
                        {
                          "id": "ch3_7f2a9c1e",
                          "title": "Trail Running Vest 5L",
                          "brand": "Salomon",
                          "image": "https://images.example.com/vest.jpg",
                          "price": 240,
                          "currency": "USD",
                          "retailer": "rei.com",
                          "retailers": 4,
                          "commission": 0.08
                        }
                      ],
                      "type": "array",
                      "items": {
                        "id": "ProductCard",
                        "title": "ProductCard",
                        "description": "A Channel3 product in search results.",
                        "example": {
                          "id": "ch3_7f2a9c1e",
                          "title": "Trail Running Vest 5L",
                          "brand": "Salomon",
                          "image": "https://images.example.com/vest.jpg",
                          "price": 240,
                          "currency": "USD",
                          "retailer": "rei.com",
                          "retailers": 4,
                          "commission": 0.08
                        },
                        "type": "object",
                        "properties": {
                          "id": {
                            "description": "Channel3's product id: pass it to `createShop` as `productId`.",
                            "example": "ch3_7f2a9c1e",
                            "type": "string"
                          },
                          "title": {
                            "description": "The product's name.",
                            "example": "Trail Running Vest 5L",
                            "type": "string"
                          },
                          "image": {
                            "description": "The product image's URL.",
                            "example": "https://images.example.com/vest.jpg",
                            "type": "string"
                          },
                          "price": {
                            "description": "The best offer's price.",
                            "example": 240,
                            "type": "number"
                          },
                          "currency": {
                            "description": "ISO 4217 currency code.",
                            "example": "USD",
                            "type": "string"
                          },
                          "retailer": {
                            "description": "The store with the best offer.",
                            "example": "rei.com",
                            "type": "string"
                          },
                          "retailers": {
                            "description": "How many stores sell it.",
                            "example": 4,
                            "type": "integer",
                            "format": "int32"
                          },
                          "commission": {
                            "description": "Best commission rate across offers, 0–1.",
                            "example": 0.08,
                            "type": "number"
                          },
                          "brand": {
                            "description": "The brand, when known.",
                            "example": "Salomon",
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        },
                        "required": [
                          "id",
                          "title",
                          "image",
                          "price",
                          "currency",
                          "retailer",
                          "retailers",
                          "commission"
                        ]
                      }
                    }
                  },
                  "required": [
                    "products"
                  ]
                }
              example: '{"products":[{"id":"ch3_7f2a9c1e","title":"Trail Running Vest 5L","brand":"Salomon","image":"https://images.example.com/vest.jpg","price":59.99,"currency":"USD","retailer":"rei.com","retailers":4,"commission":0.08}]}'
        '502':
          description: Gemini, PayPal or Channel3 failed or isn't configured.
          body:
            application/json:
              schema: |
                {
                  "id": "ErrorResponse",
                  "title": "ErrorResponse",
                  "description": "An error reply.",
                  "example": {
                    "error": "Choose a photo.",
                    "field": "photo"
                  },
                  "type": "object",
                  "properties": {
                    "error": {
                      "description": "A sentence you can show to a person.",
                      "example": "Order not found.",
                      "type": "string"
                    },
                    "field": {
                      "description": "The form field at fault, when there is one.",
                      "example": "price",
                      "type": "string"
                    },
                    "detail": {
                      "description": "The upstream service's own message, for debugging.",
                      "example": "INSTRUMENT_DECLINED",
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              example: "{\"error\":\"PayPal isn't configured on this server.\"}"
        '503':
          description: Gemini, PayPal or Channel3 failed or isn't configured.
          body:
            application/json:
              schema: |
                {
                  "id": "ErrorResponse",
                  "title": "ErrorResponse",
                  "description": "An error reply.",
                  "example": {
                    "error": "Choose a photo.",
                    "field": "photo"
                  },
                  "type": "object",
                  "properties": {
                    "error": {
                      "description": "A sentence you can show to a person.",
                      "example": "Order not found.",
                      "type": "string"
                    },
                    "field": {
                      "description": "The form field at fault, when there is one.",
                      "example": "price",
                      "type": "string"
                    },
                    "detail": {
                      "description": "The upstream service's own message, for debugging.",
                      "example": "INSTRUMENT_DECLINED",
                      "type": "string"
                    }
                  },
                  "required": [
