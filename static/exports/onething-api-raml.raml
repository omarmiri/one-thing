      /file:
        uriParameters: {}
        post:
          securedBy:
          - AdminToken
          - PlatformKey
          description: Uploads or replaces a digital product's file, up to 25 MB. Each paid order gets a download link for it.
          body:
            multipart/form-data:
              formParameters:
                file:
                  description: Up to 25 MB.
                  type: file
                  required: true
                  displayName: file
          responses:
            '200':
              description: Uploaded.
              body:
                application/json:
                  schema: |
                    {
                      "id": "ApiShopsFileResponse",
                      "title": "ApiShopsFileResponse",
                      "description": "The uploaded file.",
                      "example": {
                        "ok": true,
                        "filename": "raptor-rush-soundtrack.zip"
                      },
                      "type": "object",
                      "properties": {
                        "ok": {
                          "description": "Always `true`.",
                          "example": true,
                          "type": "boolean"
                        },
                        "filename": {
                          "description": "The file's name, as buyers will download it.",
                          "example": "dragon-flight-presets.zip",
                          "type": "string"
                        }
                      },
                      "required": [
                        "ok",
                        "filename"
                      ]
                    }
                  example: '{"ok":true,"filename":"raptor-rush-soundtrack.zip"}'
            '400':
              description: Something in the request needs fixing; `error` says what.
              body:
                application/json:
                  schema: |
                    {
                      "id": "ErrorResponse",
                      "title": "ErrorResponse",
                      "description": "An error reply.",
                      "example": {
                        "error": "Choose a photo.",
                        "field": "photo"
                      },
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "A sentence you can show to a person.",
                          "example": "Order not found.",
                          "type": "string"
                        },
                        "field": {
                          "description": "The form field at fault, when there is one.",
                          "example": "price",
