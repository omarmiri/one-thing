    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiAccessVerifyRequest",
      "title": "ApiAccessVerifyRequest",
      "description": "The code to check, and which shop it's for.",
      "type": "object",
      "properties": {
        "shop": {
          "description": "The shop's link name.",
          "example": "raptorrush",
          "type": "string"
        },
        "code": {
          "description": "The access code the buyer entered. Case and dashes don't matter.",
          "example": "K7QF-M2XP-9HTD",
          "type": "string"
        }
      },
      "required": [
        "shop",
        "code"
      ]
    }
- ApiAccessVerifyResponse: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiAccessVerifyResponse",
      "title": "ApiAccessVerifyResponse",
      "description": "Whether the code is valid.",
      "type": "object",
      "properties": {
        "valid": {
          "description": "True if the code belongs to a paid, unrefunded order for this shop.",
          "example": true,
          "type": "boolean"
        },
        "product": {
          "description": "The product name, when valid.",
          "example": "Vintage Cream and Red Roller Skates",
          "type": "string"
        }
      },
      "required": [
        "valid"
      ]
    }
- ApiAccountSigninRequest: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiAccountSigninRequest",
      "title": "ApiAccountSigninRequest",
      "description": "Who is signing in.",
      "type": "object",
      "properties": {
        "identifier": {
          "description": "An email address, or a phone number (spaces, dashes and brackets are ignored; keep a leading +).",
          "examples": [
            {
              "Id": "Untitled Example1",
              "Name": null,
              "Value": "maker@example.com",
              "ExternalValue": null,
              "Description": null
            },
            {
              "Id": "Untitled Example2",
              "Name": null,
              "Value": "+1 555 123 4567",
              "ExternalValue": null,
              "Description": null
            }
          ],
          "example": "maker@example.com",
          "type": "string"
        }
      },
      "required": [
        "identifier"
      ]
    }
- ApiAccountSigninResponse: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiAccountSigninResponse",
      "title": "ApiAccountSigninResponse",
      "description": "The signed-in account.",
      "type": "object",
      "properties": {
        "id": {
          "description": "The account's id.",
          "example": "acc_Vq3nN8cT0bLx2YwE",
          "type": "string"
        },
        "email": {
          "description": "Lower-cased.",
          "example": "maker@example.com",
          "type": [
            "string",
            "null"
          ]
        },
        "phone": {
          "description": "Digits, with a leading + if one was given.",
          "example": "+15555550123",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "email",
        "phone"
      ]
    }
- ApiAgentShopsResponse: "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"id\": \"ApiAgentShopsResponse\",\n  \"title\": \"ApiAgentShopsResponse\",\n  \"description\": \"The matching shops, with a reply to show the buyer.\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"show_buyer\": {\n      \"description\": \"A suggested reply to the buyer, in Markdown: each shop's cover photo as an image, its name, price and headline, then \\\"Which one?\\\". Chats that block images from other sites just leave the image lines out.\",\n      \"example\": \"![Vintage Cream and Red Roller Skates](https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X)\\n\\n**Vintage Cream and Red Roller Skates**: $240.00. Classic quad skates crafted with walnut burl heels\\n\\n![Raptor Rush: Browser Edition](https://one-thing-ash0.onrender.com/api/blobs/R9tWc3yN6bJq1zUd)\\n\\n**Raptor Rush: Browser Edition**: $2.99. Grow from Tiny Hatchling to Giant Apex Predator\\n\\nWhich one?\",\n      \"type\": \"string\"\n    },\n    \"shops\": {\n      \"description\": \"Shops, best match first.\",\n      \"example\": [\n        {\n          \"shop\": \"vintageskates\",\n          \"name\": \"Vintage Cream and Red Roller Skates\",\n          \"kind\": \"physical\",\n          \"headline\": \"Classic quad skates crafted with walnut burl heels\",\n          \"price\": \"$240.00\",\n          \"image\": \"https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X\",\n          \"url\": \"https://one-thing-ash0.onrender.com/vintageskates\"\n        }\n      ],\n      \"type\": \"array\",\n      \"items\": {\n        \"id\": \"AgentShopSummary\",\n        \"title\": \"AgentShopSummary\",\n        \"description\": \"A shop in search results.\",\n        \"example\": {\n          \"shop\": \"vintageskates\",\n          \"name\": \"Vintage Cream and Red Roller Skates\",\n          \"kind\": \"physical\",\n          \"headline\": \"Classic quad skates crafted with walnut burl heels\",\n          \"price\": \"$240.00\",\n          \"image\": \"https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X\",\n          \"url\": \"https://one-thing-ash0.onrender.com/vintageskates\"\n        },\n        \"type\": \"object\",\n        \"properties\": {\n          \"shop\": {\n            \"description\": \"The link name, for `getAgentProduct` and the MCP tools.\",\n            \"example\": \"vintageskates\",\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"description\": \"The product's name.\",\n            \"example\": \"Vintage Cream and Red Roller Skates\",\n            \"type\": \"string\"\n          },\n          \"kind\": {\n            \"title\": \"Kind2\",\n            \"description\": \"`physical`, `digital` or `referral`.\",\n            \"example\": \"physical\",\n            \"type\": \"string\",\n            \"additionalProperties\": false,\n            \"enum\": [\n              \"physical\",\n              \"digital\",\n              \"referral\"\n            ]\n          },\n          \"headline\": {\n            \"description\": \"The shop's one-line pitch.\",\n            \"example\": \"Classic quad skates crafted with walnut burl heels\",\n            \"type\": \"string\"\n          },\n          \"price\": {\n            \"description\": \"The price label, e.g. `$2.99`; null for recommendations.\",\n            \"example\": \"$240.00\",\n            \"type\": [\n              \"string\",\n              \"null\"\n            ]\n          },\n          \"image\": {\n            \"description\": \"The cover photo's URL (WebP; the retailer's image for a recommendation), or null when there's none.\",\n            \"example\": \"https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X\",\n            \"type\": [\n              \"string\",\n              \"null\"\n            ]\n          },\n          \"url\": {\n            \"description\": \"The shop page.\",\n            \"example\": \"https://one-thing-ash0.onrender.com/vintageskates\",\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"shop\",\n          \"name\",\n          \"kind\",\n          \"headline\",\n          \"price\",\n          \"image\",\n          \"url\"\n        ]\n      }\n    },\n    \"matched\": {\n      \"description\": \"False when nothing matched the query and `shops` is the newest gallery shops instead; `show_buyer` then starts by saying so.\",\n      \"example\": true,\n      \"type\": \"boolean\"\n    },\n    \"mcp_server\": {\n      \"description\": \"The MCP server to order through.\",\n      \"example\": \"https://one-thing-ash0.onrender.com/api/mcp\",\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"show_buyer\",\n    \"shops\",\n    \"matched\",\n    \"mcp_server\"\n  ]\n}"
- ApiChannel3SearchResponse: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiChannel3SearchResponse",
      "title": "ApiChannel3SearchResponse",
      "description": "The products found.",
      "type": "object",
      "properties": {
        "products": {
          "description": "Products, best match first.",
          "example": [
            {
              "id": "ch3_7f2a9c1e",
              "title": "Trail Running Vest 5L",
              "brand": "Salomon",
              "image": "https://images.example.com/vest.jpg",
              "price": 240,
              "currency": "USD",
              "retailer": "rei.com",
              "retailers": 4,
              "commission": 0.08
            }
          ],
          "type": "array",
          "items": {
            "id": "ProductCard",
            "title": "ProductCard",
            "description": "A Channel3 product in search results.",
            "example": {
              "id": "ch3_7f2a9c1e",
              "title": "Trail Running Vest 5L",
              "brand": "Salomon",
              "image": "https://images.example.com/vest.jpg",
              "price": 240,
              "currency": "USD",
              "retailer": "rei.com",
              "retailers": 4,
              "commission": 0.08
            },
            "type": "object",
            "properties": {
              "id": {
                "description": "Channel3's product id: pass it to `createShop` as `productId`.",
                "example": "ch3_7f2a9c1e",
                "type": "string"
              },
              "title": {
                "description": "The product's name.",
                "example": "Trail Running Vest 5L",
                "type": "string"
              },
              "image": {
                "description": "The product image's URL.",
                "example": "https://images.example.com/vest.jpg",
                "type": "string"
              },
              "price": {
                "description": "The best offer's price.",
                "example": 240,
                "type": "number"
              },
              "currency": {
                "description": "ISO 4217 currency code.",
                "example": "USD",
                "type": "string"
              },
              "retailer": {
                "description": "The store with the best offer.",
                "example": "rei.com",
                "type": "string"
              },
              "retailers": {
                "description": "How many stores sell it.",
                "example": 4,
                "type": "integer",
                "format": "int32"
              },
              "commission": {
                "description": "Best commission rate across offers, 0–1.",
                "example": 0.08,
                "type": "number"
              },
              "brand": {
                "description": "The brand, when known.",
                "example": "Salomon",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "id",
              "title",
              "image",
              "price",
              "currency",
              "retailer",
              "retailers",
              "commission"
            ]
          }
        }
      },
      "required": [
        "products"
      ]
    }
- ApiOrdersCapture409Error1: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiOrdersCapture409Error1",
      "title": "ApiOrdersCapture409Error1",
      "description": "Not approved yet.",
      "example": {
        "status": "pending"
      },
      "type": "object",
      "properties": {
        "status": {
          "title": "Status6",
          "description": "`pending` until the buyer approves at PayPal.",
          "example": "pending",
          "type": "string",
          "additionalProperties": false,
          "enum": [
            "pending"
          ]
        }
      }
    }
- ApiOrdersCaptureResponse: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiOrdersCaptureResponse",
      "title": "ApiOrdersCaptureResponse",
      "description": "The paid order.",
      "type": "object",
      "properties": {
        "orderId": {
          "description": "OneThing's order id; the thank-you page is `/<slug>/thanks?order=<orderId>`.",
          "example": "pX4kR9tVb2nQ7sLe",
          "type": "string"
        },
        "status": {
          "description": "Always `paid`.",
          "example": "paid",
          "type": "string",
          "enum": [
            "paid"
          ]
        }
      },
      "required": [
        "orderId",
        "status"
      ]
    }
- ApiOrdersRequest: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiOrdersRequest",
      "title": "ApiOrdersRequest",
      "description": "The shop to buy from and the buyer's pick.",
      "type": "object",
      "properties": {
        "slug": {
          "description": "The shop's link name.",
          "example": "vintageskates",
          "type": "string"
        },
        "options": {
          "description": "The buyer's pick, one value per option, keyed by option name.",
          "example": {
            "Size": "M",
            "Color": "Black"
          },
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "slug"
      ]
    }
