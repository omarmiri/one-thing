- ApiShopsMatchPhotosRequest: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiShopsMatchPhotosRequest",
      "title": "ApiShopsMatchPhotosRequest",
      "description": "The colours to find photos for.",
      "type": "object",
      "properties": {
        "colors": {
          "description": "The colour option's values.",
          "example": [
            {
              "label": "Ice Blue",
              "hex": "#9fd3e6"
            }
          ],
          "type": "array",
          "items": {
            "id": "Color",
            "title": "Color",
            "description": "One colour.",
            "example": {
              "label": "Ice Blue",
              "hex": "#9fd3e6"
            },
            "type": "object",
            "properties": {
              "label": {
                "description": "The colour's name, as buyers see it.",
                "example": "Forest green",
                "type": "string",
                "maxLength": 30
              },
              "hex": {
                "description": "A colour as `#rrggbb`.",
                "example": "#14171a",
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              }
            },
            "required": [
              "label"
            ]
          },
          "minItems": 1,
          "maxItems": 12
        }
      },
      "required": [
        "colors"
      ]
    }
- ApiShopsMatchPhotosResponse: |
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "ApiShopsMatchPhotosResponse",
      "title": "ApiShopsMatchPhotosResponse",
      "description": "Gemini's matches.",
