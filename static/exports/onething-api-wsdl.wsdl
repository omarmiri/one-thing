      </fault>
      <fault name="POST_markOrderShipped_404" message="wsdl:POST_markOrderShipped_404">
        <documentation>No such shop, or the admin token doesn't match it.</documentation>
      </fault>
    </operation>
    <operation name="GET_listWebhookEvents">
      <documentation>The last 50 PayPal webhook deliveries about this shop's orders, with signature results.</documentation>
      <input message="wsdl:GET_listWebhookEvents_InputMessage" />
      <output message="wsdl:GET_listWebhookEvents_OutputMessage">
        <documentation>Events, newest first.</documentation>
      </output>
      <fault name="GET_listWebhookEvents_404" message="wsdl:GET_listWebhookEvents_404">
        <documentation>No such shop, or the admin token doesn't match it.</documentation>
      </fault>
    </operation>
