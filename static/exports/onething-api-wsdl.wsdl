      <xs:complexType name="ErrorResponse">
        <xs:annotation>
          <xs:documentation>An error reply.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
          <xs:element minOccurs="1" name="error" type="xs:string">
            <xs:annotation>
              <xs:documentation>A sentence you can show to a person.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="field" type="xs:string">
            <xs:annotation>
              <xs:documentation>The form field at fault, when there is one.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="detail" type="xs:string">
            <xs:annotation>
              <xs:documentation>The upstream service's own message, for debugging.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="CreateShopForm">
        <xs:annotation>
          <xs:documentation>What to make a shop from. Only `source` is required; the AI guesses the rest and the seller corrects it with `updateShop`.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
          <xs:element minOccurs="1" name="source" type="schemas:Source">
            <xs:annotation>
              <xs:documentation>What the shop starts from: a photo (with an optional description), a product link, or a Channel3 product to recommend.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="photo" type="xs:hexBinary">
            <xs:annotation>
              <xs:documentation>`source=photo`: the product photo, up to 8 MB.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="description" type="xs:string">
            <xs:annotation>
              <xs:documentation>`source=photo`: a sentence or two about the product. Required if there is no photo.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="url">
            <xs:simpleType>
              <xs:annotation>
                <xs:documentation>`source=link`: a product page, or your own app or game page.</xs:documentation>
              </xs:annotation>
              <xs:restriction base="xs:string" />
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" name="productId" type="xs:string">
            <xs:annotation>
              <xs:documentation>`source=channel3`: a product id from `searchProducts`.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="slug" type="xs:string">
            <xs:annotation>
              <xs:documentation>The link name you want. If omitted, the AI suggests one.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" default="auto" name="type" type="schemas:Type">
            <xs:annotation>
              <xs:documentation>`physical` ships, `digital` is a file or an access code, `auto` lets the AI decide.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="delivery" type="schemas:Delivery">
            <xs:annotation>
              <xs:documentation>For digital products. If omitted, the AI guesses.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="access_url">
            <xs:simpleType>
              <xs:annotation>
                <xs:documentation>Where buyers use an access code.</xs:documentation>
              </xs:annotation>
              <xs:restriction base="xs:string" />
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" name="price" type="xs:double">
            <xs:annotation>
              <xs:documentation>USD. If omitted, the AI suggests a price.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="shipping" type="xs:double">
            <xs:annotation>
              <xs:documentation>Physical products: shipping per order, in USD. If omitted, the AI suggests it.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="stock" type="xs:integer">
            <xs:annotation>
              <xs:documentation>How many are for sale. Leave out for unlimited.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="ship_countries" type="xs:string">
            <xs:annotation>
              <xs:documentation>Physical products: comma-separated ISO country codes to ship to. Empty means anywhere PayPal ships.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="paypal_email">
            <xs:simpleType>
              <xs:annotation>
                <xs:documentation>The PayPal account that gets paid, if the seller doesn't connect one with `connectPayPal`.</xs:documentation>
              </xs:annotation>
              <xs:restriction base="xs:string" />
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" name="seller_email">
            <xs:simpleType>
              <xs:annotation>
                <xs:documentation>Where order notifications go.</xs:documentation>
              </xs:annotation>
              <xs:restriction base="xs:string" />
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" name="digital_file" type="xs:hexBinary">
            <xs:annotation>
              <xs:documentation>Digital products sold as a file: the file buyers download, up to 25 MB. Can also be added later with `uploadDigitalFile`.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="CreatedShop">
        <xs:annotation>
          <xs:documentation>The new draft shop and the credentials to manage it.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
          <xs:element minOccurs="1" name="slug" type="xs:string">
            <xs:annotation>
              <xs:documentation>The shop's link name: the page is `https://&lt;host&gt;/&lt;slug&gt;`.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="token" type="xs:string">
            <xs:annotation>
              <xs:documentation>The admin token. Shown once; store it.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="manageUrl" type="xs:string">
            <xs:annotation>
              <xs:documentation>The seller's private manage page (contains the token).</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ShopUpdate">
        <xs:annotation>
          <xs:documentation>The fields to change. Anything left out stays as it is.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
          <xs:element minOccurs="0" name="slug" type="xs:string">
            <xs:annotation>
              <xs:documentation>A new link name. The old one keeps redirecting.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="status" type="schemas:Status">
            <xs:annotation>
              <xs:documentation>`live` publishes the shop; `draft` takes it down.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="product_type" type="schemas:ProductType">
            <xs:annotation>
              <xs:documentation>`referral` only for shops created from Channel3.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="price">
            <xs:simpleType>
              <xs:annotation>
                <xs:documentation>The price in USD.</xs:documentation>
              </xs:annotation>
              <xs:restriction base="xs:double">
                <xs:maxInclusive value="10000" />
                <xs:minInclusive value="0.5" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" name="shipping">
            <xs:simpleType>
              <xs:annotation>
                <xs:documentation>Shipping per order, in USD.</xs:documentation>
              </xs:annotation>
              <xs:restriction base="xs:double">
                <xs:maxInclusive value="500" />
                <xs:minInclusive value="0" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" name="stock" nillable="true">
            <xs:simpleType>
              <xs:annotation>
                <xs:documentation>How many are for sale; null for unlimited.</xs:documentation>
              </xs:annotation>
              <xs:restriction base="xs:integer">
                <xs:minInclusive value="0" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" name="ship_countries" nillable="true" type="xs:string">
            <xs:annotation>
              <xs:documentation>Comma-separated ISO country codes; null or empty means anywhere PayPal ships.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="delivery" type="schemas:Delivery1">
            <xs:annotation>
              <xs:documentation>Digital products: `file` or `access_code`.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="access_url" nillable="true">
            <xs:simpleType>
              <xs:annotation>
                <xs:documentation>Access-code products: where buyers enter their code.</xs:documentation>
              </xs:annotation>
              <xs:restriction base="xs:string" />
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" name="paypal_email" nillable="true">
            <xs:simpleType>
              <xs:annotation>
                <xs:documentation>The PayPal account paid when no account is connected.</xs:documentation>
              </xs:annotation>
              <xs:restriction base="xs:string" />
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" name="seller_email" nillable="true">
            <xs:simpleType>
              <xs:annotation>
                <xs:documentation>Where order notifications go.</xs:documentation>
              </xs:annotation>
              <xs:restriction base="xs:string" />
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" name="zapier_hook_url" nillable="true">
            <xs:simpleType>
              <xs:annotation>
                <xs:documentation>A Zapier Catch Hook for order events; null removes it.</xs:documentation>
              </xs:annotation>
              <xs:restriction base="xs:string" />
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" name="in_gallery" type="xs:boolean">
            <xs:annotation>
              <xs:documentation>Feature the shop at `/gallery` while it's live. Off by default.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" maxOccurs="unbounded" name="options" type="schemas:ShopOption">
            <xs:annotation>
              <xs:documentation>What the buyer picks (physical products only), replacing the current options; `[]` removes them. With options, stock is counted per combination in `option_stock` and the shop's own `stock` is cleared. At most 60 combinations.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="option_stock">
            <xs:simpleType>
              <xs:annotation>
                <xs:documentation>Stock per combination, keyed by its values in option order joined with ` / ` (e.g. `M / Black`). A missing key or `null` means unlimited; `0` is sold out.</xs:documentation>
              </xs:annotation>
              <xs:restriction base="xs:integer">
                <xs:minInclusive value="0" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" maxOccurs="unbounded" name="facts" type="schemas:Fact">
            <xs:annotation>
              <xs:documentation>Answers to the "buyers will ask" questions in `suggestions.missingFacts`. Each becomes a product detail on the page (replacing one with the same label) and drops off the list.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="Shop">
        <xs:annotation>
          <xs:documentation>A shop, as its seller sees it.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
          <xs:element minOccurs="1" name="id" type="xs:string">
            <xs:annotation>
              <xs:documentation>OneThing's internal shop id.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="slug" type="xs:string">
            <xs:annotation>
              <xs:documentation>The shop's link name.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="status" type="schemas:Status1">
            <xs:annotation>
              <xs:documentation>`draft` until the seller goes live; only `live` shops take orders.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="product_type" type="schemas:ProductType1">
            <xs:annotation>
              <xs:documentation>`physical` ships, `digital` downloads or unlocks, `referral` recommends a Channel3 product.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="price_cents" type="xs:integer">
            <xs:annotation>
              <xs:documentation>The price in cents.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="currency" type="xs:string">
            <xs:annotation>
              <xs:documentation>ISO 4217 currency code.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="shipping_cents" type="xs:integer">
            <xs:annotation>
              <xs:documentation>Shipping per order, in cents.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="ship_countries" nillable="true" type="xs:string">
            <xs:annotation>
              <xs:documentation>Comma-separated ISO country codes; null or empty means anywhere PayPal ships.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="stock" nillable="true" type="xs:integer">
            <xs:annotation>
              <xs:documentation>How many are left; null for unlimited. With options, see `option_stock`.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="delivery" type="schemas:Delivery2">
            <xs:annotation>
              <xs:documentation>Digital products: `file` (a download) or `access_code` (a code that unlocks an app or game).</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="access_url" nillable="true" type="xs:string">
            <xs:annotation>
              <xs:documentation>Access-code products: where buyers enter their code.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="paypal_email" nillable="true" type="xs:string">
            <xs:annotation>
              <xs:documentation>The PayPal account paid when no account is connected.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="seller_email" nillable="true" type="xs:string">
            <xs:annotation>
              <xs:documentation>Where order notifications go.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="paypal_merchant_id" nillable="true" type="xs:string">
            <xs:annotation>
              <xs:documentation>The connected PayPal account (`connectPayPal`). Sales go here when it can receive payments.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="paypal_status" nillable="true" type="schemas:PayPalStatus">
            <xs:annotation>
              <xs:documentation>What PayPal last said about the connected account; null when none is connected.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="zapier_hook_url" nillable="true" type="xs:string">
            <xs:annotation>
              <xs:documentation>A Zapier Catch Hook that gets an `OrderEvent` for each paid, shipped or refunded order.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="in_gallery" type="xs:boolean">
            <xs:annotation>
              <xs:documentation>Whether the shop is featured at `/gallery` while live.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="account_id" nillable="true" type="xs:string">
            <xs:annotation>
              <xs:documentation>The seller account that owns the shop, if it was made while signed in.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" maxOccurs="unbounded" name="options" type="schemas:ShopOption">
            <xs:annotation>
              <xs:documentation>What the buyer picks, such as size or colour.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="option_stock">
            <xs:simpleType>
              <xs:annotation>
                <xs:documentation>Stock per combination, keyed by its values in option order joined with ` / ` (e.g. `M / Black`). A missing key or `null` means unlimited; `0` is sold out.</xs:documentation>
              </xs:annotation>
              <xs:restriction base="xs:integer">
                <xs:minInclusive value="0" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" name="suggestions" nillable="true" type="schemas:Suggestions">
            <xs:annotation>
              <xs:documentation>What the AI thinks buyers will pick or ask; null once handled.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="photo_blob" nillable="true" type="xs:string">
            <xs:annotation>
              <xs:documentation>Image id for `getImage`. The cover photo.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" maxOccurs="unbounded" name="gallery_blobs" type="xs:string">
            <xs:annotation>
              <xs:documentation>The other photos, in order.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="hero_blob" nillable="true" type="xs:string">
            <xs:annotation>
              <xs:documentation>Image id of the AI hero art, when there is one.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="hero_status" type="schemas:HeroStatus">
            <xs:annotation>
              <xs:documentation>Hero art: `pending` while generating, then `ready` or `failed`; `none` if not requested.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="hero_error" nillable="true" type="xs:string">
            <xs:annotation>
              <xs:documentation>Why hero art failed, when it did.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="ai_source" type="schemas:AiSource">
            <xs:annotation>
              <xs:documentation>Who designed the page: `gemini`, or `fallback` when Gemini wasn't available and a plain template was used.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="source_url" nillable="true" type="xs:string">
            <xs:annotation>
              <xs:documentation>The product link the shop was made from, if any.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="referral" nillable="true" type="schemas:Referral">
            <xs:annotation>
              <xs:documentation>Recommendation shops: the Channel3 product; null otherwise.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="spec" type="schemas:DesignSpec">
            <xs:annotation>
              <xs:documentation>What Gemini designed. OneThing's templates render it; Gemini never writes HTML.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="created_at" type="xs:dateTime">
            <xs:annotation>
              <xs:documentation>When the shop was made.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="DesignSpec">
        <xs:annotation>
          <xs:documentation>What Gemini designed. OneThing's templates render it; Gemini never writes HTML.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
          <xs:element minOccurs="1" name="productType" type="schemas:ProductType2">
            <xs:annotation>
              <xs:documentation>What the AI decided the product is.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="productName" type="xs:string">
            <xs:annotation>
              <xs:documentation>The product's name.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="layout" type="schemas:Layout">
            <xs:annotation>
              <xs:documentation>The page template: `bold-hero` (image first, punchy), `editorial` (magazine), `minimal` (quiet, lots of space) or `playful`.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="palette" type="schemas:Palette">
            <xs:annotation>
              <xs:documentation>The page colours, taken from the photo. Text colours are checked for contrast.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="fonts" type="schemas:Fonts">
            <xs:annotation>
              <xs:documentation>Google Fonts for the page.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="eyebrow" type="xs:string">
            <xs:annotation>
              <xs:documentation>A short label above the headline.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="headline" type="xs:string">
            <xs:annotation>
              <xs:documentation>The page's main headline.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="subheadline" type="xs:string">
            <xs:annotation>
              <xs:documentation>A line under the headline.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="story" type="xs:string">
            <xs:annotation>
              <xs:documentation>A short paragraph about the product.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" maxOccurs="unbounded" name="bullets" type="xs:string">
            <xs:annotation>
              <xs:documentation>Short selling points.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" maxOccurs="unbounded" name="details" type="schemas:Detail">
            <xs:annotation>
              <xs:documentation>Product facts shown on the page.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" maxOccurs="unbounded" name="faq" type="schemas:Faq">
            <xs:annotation>
              <xs:documentation>Questions buyers will ask, with answers.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="ctaLabel" type="xs:string">
            <xs:annotation>
              <xs:documentation>The buy button's text.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="suggestedPriceUsd" type="xs:double">
            <xs:annotation>
              <xs:documentation>The AI's price suggestion, in USD.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="suggestedShippingUsd" type="xs:double">
            <xs:annotation>
              <xs:documentation>The AI's shipping suggestion, in USD.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="imageAlt" type="xs:string">
            <xs:annotation>
              <xs:documentation>Alt text for the product photo.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="heroPrompt" type="xs:string">
            <xs:annotation>
              <xs:documentation>The prompt used to generate hero art for the page.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ShopOption">
        <xs:annotation>
          <xs:documentation>Something the buyer picks, such as a size or a colour. The shop still sells one product.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
          <xs:element minOccurs="1" name="name">
            <xs:simpleType>
              <xs:annotation>
                <xs:documentation>What the buyer is choosing.</xs:documentation>
              </xs:annotation>
              <xs:restriction base="xs:string">
                <xs:maxLength value="20" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="1" name="kind" type="schemas:Kind">
            <xs:annotation>
              <xs:documentation>`color` shows swatches, and the photo of the picked colour.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" maxOccurs="unbounded" name="values" type="schemas:OptionValue">
            <xs:annotation>
              <xs:documentation>The values to pick from.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="OptionValue">
        <xs:annotation>
          <xs:documentation>One value of an option.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
          <xs:element minOccurs="1" name="label">
            <xs:simpleType>
              <xs:annotation>
                <xs:documentation>What the buyer sees and picks.</xs:documentation>
              </xs:annotation>
              <xs:restriction base="xs:string">
                <xs:maxLength value="30" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" name="hex">
            <xs:simpleType>
              <xs:annotation>
                <xs:documentation>A colour as `#rrggbb`.</xs:documentation>
              </xs:annotation>
              <xs:restriction base="xs:string">
                <xs:pattern value="^#[0-9a-fA-F]{6}$" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" name="photo" type="xs:string">
            <xs:annotation>
              <xs:documentation>Colours: the shop photo (id) that shows this colour. See `matchColorPhotos`.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="Suggestions">
        <xs:annotation>
          <xs:documentation>What Gemini thinks buyers will want to choose or ask. The seller confirms; nothing is applied on its own.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
          <xs:element minOccurs="1" name="oneOfAKind" type="xs:boolean">
            <xs:annotation>
              <xs:documentation>A single item (vintage, handmade), so options and stock don't apply.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" maxOccurs="unbounded" name="options" type="schemas:Option">
            <xs:annotation>
              <xs:documentation>Options buyers will likely want to pick.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" maxOccurs="unbounded" name="missingFacts" type="schemas:MissingFact">
            <xs:annotation>
              <xs:documentation>Questions buyers will ask that the listing doesn't answer yet.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="PayPalStatus">
        <xs:annotation>
          <xs:documentation>What PayPal last said about a connected seller account.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
          <xs:element minOccurs="1" name="receivable" type="xs:boolean">
            <xs:annotation>
              <xs:documentation>The account can receive payments.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="emailConfirmed" type="xs:boolean">
            <xs:annotation>
              <xs:documentation>The seller has confirmed their email with PayPal.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="checkedAt" type="xs:dateTime">
            <xs:annotation>
              <xs:documentation>When OneThing last asked PayPal.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="AgentProduct">
        <xs:annotation>
          <xs:documentation>A live shop as an AI agent sees it. Recommendations have `offers`; everything else has `price` and is bought with `create_order`.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
          <xs:element minOccurs="0" name="show_buyer" type="xs:string">
            <xs:annotation>
              <xs:documentation>A suggested reply to the buyer, in Markdown with the links already written as links: the product and its options to pick from, the pay link, or what they got with a receipt link. Buyers have the best experience when agents show it as written.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="agent_name" type="xs:string">
            <xs:annotation>
              <xs:documentation>Who this request was credited to in the seller's stats: a recognised user agent, else the name the agent gave itself (`?agent=`, or the MCP client's name), else the user agent's first word.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="shop" type="xs:string">
            <xs:annotation>
              <xs:documentation>The link name, which the MCP tools take as `shop`.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="url" type="xs:string">
            <xs:annotation>
              <xs:documentation>The shop page, where a person can buy it too.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="name" type="xs:string">
            <xs:annotation>
              <xs:documentation>The product's name.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="kind" type="schemas:Kind1">
            <xs:annotation>
              <xs:documentation>`physical` ships, `digital` downloads or unlocks with a code, `referral` is bought at another store.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="headline" type="xs:string">
            <xs:annotation>
              <xs:documentation>The shop's one-line pitch.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="description" type="xs:string">
            <xs:annotation>
              <xs:documentation>What the product is, in a few sentences.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" maxOccurs="unbounded" name="highlights" type="xs:string">
            <xs:annotation>
              <xs:documentation>The product's selling points, one per line.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" maxOccurs="unbounded" name="details" type="schemas:Detail">
            <xs:annotation>
              <xs:documentation>Product facts, such as size, material or format.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" maxOccurs="unbounded" name="faq" type="schemas:Faq">
            <xs:annotation>
              <xs:documentation>Questions buyers ask, answered by the seller's page.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" maxOccurs="unbounded" name="images" type="xs:string">
            <xs:annotation>
              <xs:documentation>Photo URLs, the cover first. Show these rather than generating or searching for images.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="price" type="schemas:AgentMoney">
            <xs:annotation>
              <xs:documentation>An amount of money, as a number and as a label.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="shipping" nillable="true" type="schemas:Shipping">
            <xs:annotation>
              <xs:documentation>Physical products only.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="total" type="schemas:AgentMoney">
            <xs:annotation>
              <xs:documentation>An amount of money, as a number and as a label.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="delivery" type="xs:string">
            <xs:annotation>
              <xs:documentation>How the buyer gets it, in plain words.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="availability" type="xs:string">
            <xs:annotation>
              <xs:documentation>`in_stock`, `in_stock (N left)` or `sold_out`. With options, see `variants`.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" maxOccurs="unbounded" name="options" type="schemas:Option1">
            <xs:annotation>
              <xs:documentation>Pass one value per option to `create_order`.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" maxOccurs="unbounded" name="variants" type="schemas:Variant">
            <xs:annotation>
              <xs:documentation>Products with options: each combination, its stock and its order link.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="order_url" type="xs:string">
            <xs:annotation>
              <xs:documentation>Products without options: `orderByLink`, which orders one unit with a GET. Left out when sold out. With options, each variant has its own.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" maxOccurs="unbounded" name="offers" type="schemas:Offer1">
            <xs:annotation>
              <xs:documentation>Recommendations only. Bought at the retailer.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="how_to_buy" type="xs:string">
            <xs:annotation>
              <xs:documentation>How to buy it, written for an agent: which tool or link to use and what to ask the buyer.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="mcp_server" type="xs:string">
            <xs:annotation>
              <xs:documentation>The MCP server to order through (`getAgentProduct` only).</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="AgentShopSummary">
        <xs:annotation>
          <xs:documentation>A shop in search results.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
          <xs:element minOccurs="1" name="shop" type="xs:string">
            <xs:annotation>
              <xs:documentation>The link name, for `getAgentProduct` and the MCP tools.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="name" type="xs:string">
            <xs:annotation>
              <xs:documentation>The product's name.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="kind" type="schemas:Kind2">
            <xs:annotation>
              <xs:documentation>`physical`, `digital` or `referral`.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="headline" type="xs:string">
            <xs:annotation>
              <xs:documentation>The shop's one-line pitch.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="price" nillable="true" type="xs:string">
            <xs:annotation>
              <xs:documentation>The price label, e.g. `$2.99`; null for recommendations.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="image" nillable="true" type="xs:string">
            <xs:annotation>
              <xs:documentation>The cover photo's URL (WebP; the retailer's image for a recommendation), or null when there's none.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="url" type="xs:string">
            <xs:annotation>
              <xs:documentation>The shop page.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="AgentCreatedOrder">
        <xs:annotation>
          <xs:documentation>A new order, as `create_order` and `orderByLink` return it.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
          <xs:element minOccurs="0" name="show_buyer" type="xs:string">
            <xs:annotation>
              <xs:documentation>A suggested reply to the buyer, in Markdown with the links already written as links: the product and its options to pick from, the pay link, or what they got with a receipt link. Buyers have the best experience when agents show it as written.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="agent_name" type="xs:string">
            <xs:annotation>
              <xs:documentation>Who this request was credited to in the seller's stats: a recognised user agent, else the name the agent gave itself (`?agent=`, or the MCP client's name), else the user agent's first word.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="order_id" type="xs:string">
            <xs:annotation>
              <xs:documentation>The order's id, for `get_order` and `getAgentOrder`.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" fixed="awaiting_buyer_approval" name="status" type="xs:string">
            <xs:annotation>
              <xs:documentation>Always `awaiting_buyer_approval`: nothing is charged until the buyer approves at PayPal.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="total" type="xs:string">
            <xs:annotation>
              <xs:documentation>The total with shipping, as a label.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="options" type="xs:string">
            <xs:annotation>
              <xs:documentation>The buyer's pick, one value per option, keyed by option name.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="pay_url" type="xs:string">
            <xs:annotation>
              <xs:documentation>Where the buyer pays (redirects to PayPal). Safe to show in chat.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="status_url" type="xs:string">
            <xs:annotation>
              <xs:documentation>`getAgentOrder` for this order.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="next_step" type="xs:string">
            <xs:annotation>
              <xs:documentation>What the agent should do next, in plain words: show `pay_url`, then check `status_url` once the buyer says they've paid.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="AgentOrder">
        <xs:annotation>
          <xs:documentation>An order as `get_order` and `getAgentOrder` report it.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
          <xs:element minOccurs="0" name="show_buyer" type="xs:string">
            <xs:annotation>
              <xs:documentation>A suggested reply to the buyer, in Markdown with the links already written as links: the product and its options to pick from, the pay link, or what they got with a receipt link. Buyers have the best experience when agents show it as written.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="agent_name" type="xs:string">
            <xs:annotation>
              <xs:documentation>Who this request was credited to in the seller's stats: a recognised user agent, else the name the agent gave itself (`?agent=`, or the MCP client's name), else the user agent's first word.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="order_id" type="xs:string">
            <xs:annotation>
