      <xs:simpleType name="Status1">
        <xs:annotation>
          <xs:documentation>`draft` until the seller goes live; only `live` shops take orders.</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
          <xs:enumeration value="draft" />
          <xs:enumeration value="live" />
        </xs:restriction>
      </xs:simpleType>
      <xs:simpleType name="Status2">
        <xs:annotation>
          <xs:documentation>`declined`: PayPal declined it, nothing charged, the buyer can open `pay_url` again. `sold_out`: it sold out before the payment was captured. `expired`: the PayPal checkout expired; create a new order. `failed`: PayPal couldn't be reached; ask again.</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
          <xs:enumeration value="awaiting_buyer_approval" />
          <xs:enumeration value="paid" />
