      <xs:simpleType name="ProductType3">
        <xs:annotation>
          <xs:documentation>`physical`, `digital` or `referral`.</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
          <xs:enumeration value="physical" />
          <xs:enumeration value="digital" />
          <xs:enumeration value="referral" />
