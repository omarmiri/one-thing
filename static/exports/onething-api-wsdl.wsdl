            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="params">
            <xs:annotation>
              <xs:documentation>For `tools/call`: `{ name, arguments }`.</xs:documentation>
            </xs:annotation>
            <xs:complexType>
              <xs:sequence>
                <xs:any />
              </xs:sequence>
            </xs:complexType>
          </xs:element>
        </xs:sequence>
