  <portType name="OneThing_x0020_API_PortType">
    <operation name="POST_signIn">
      <documentation>Signs in with an email address or a phone number, creating the account the first time. There's no password and no verification (sandbox). The response sets the `ot_session` cookie; shops created with it belong to the account and are listed on `/account`. Signing in with an email also claims older shops whose seller email matches. In a browser, sellers can instead use Log in with PayPal (`/api/account/paypal`), which also records the PayPal account their sales are paid into.</documentation>
      <input message="wsdl:POST_signIn_InputMessage" />
      <output message="wsdl:POST_signIn_OutputMessage">
        <documentation>Signed in. The `ot_session` cookie is set.</documentation>
      </output>
      <fault name="POST_signIn_400" message="wsdl:POST_signIn_400">
        <documentation>Something in the request needs fixing; `error` says what.</documentation>
      </fault>
    </operation>
    <operation name="POST_signOut">
      <documentation>Ends this browser's session and clears the `ot_session` cookie.</documentation>
      <input message="wsdl:POST_signOut_InputMessage" />
      <output message="wsdl:POST_signOut_OutputMessage">
        <documentation>Done.</documentation>
      </output>
    </operation>
    <operation name="POST_createShop">
      <documentation>Starts a draft shop from one of three sources. Gemini designs the page and guesses the
setup; check it with `getShop`, adjust with `updateShop`, then go live.

Sent with a session cookie from `signIn`, the shop belongs to that account, which also
becomes its seller email (and PayPal email, after Log in with PayPal) unless you give one.

- `source=photo`: a `photo` and/or a `description` of your own product.
- `source=link`: a `url`. If Channel3 recognises it as a store's product page, the shop
  becomes a recommendation (`product_type: referral`); otherwise the page is read and you
  sell the product yourself with PayPal.
- `source=channel3`: a `productId` from `searchProducts` (a recommendation).

Takes 15–40 seconds. Hero art, if available, is generated afterwards (`hero_status`).
</documentation>
      <input message="wsdl:POST_createShop_InputMessage" />
      <output message="wsdl:POST_createShop_OutputMessage">
        <documentation>Draft created.</documentation>
      </output>
      <fault name="POST_createShop_400" message="wsdl:POST_createShop_400">
        <documentation>Something in the request needs fixing; `error` says what.</documentation>
      </fault>
      <fault name="POST_createShop_409" message="wsdl:POST_createShop_409">
        <documentation>Taken or unavailable (a link name, or a sold-out product).</documentation>
      </fault>
      <fault name="POST_createShop_502" message="wsdl:POST_createShop_502">
        <documentation>Gemini, PayPal or Channel3 failed or isn't configured.</documentation>
      </fault>
    </operation>
    <operation name="GET_getShop">
      <documentation>Everything about the shop, including the AI's design spec and guesses.</documentation>
      <input message="wsdl:GET_getShop_InputMessage" />
      <output message="wsdl:GET_getShop_OutputMessage">
        <documentation>The shop.</documentation>
      </output>
      <fault name="GET_getShop_404" message="wsdl:GET_getShop_404">
        <documentation>No such shop, or the admin token doesn't match it.</documentation>
      </fault>
    </operation>
    <operation name="PATCH_updateShop">
      <documentation>Changes only the fields you send. Renaming `slug` keeps the old link working (it
redirects). Set `status: live` to publish; a digital product needs its file (or, for
access codes, `access_url`) first.
</documentation>
      <input message="wsdl:PATCH_updateShop_InputMessage" />
      <output message="wsdl:PATCH_updateShop_OutputMessage">
        <documentation>Saved.</documentation>
      </output>
      <fault name="PATCH_updateShop_400" message="wsdl:PATCH_updateShop_400">
        <documentation>Something in the request needs fixing; `error` says what.</documentation>
      </fault>
      <fault name="PATCH_updateShop_404" message="wsdl:PATCH_updateShop_404">
        <documentation>No such shop, or the admin token doesn't match it.</documentation>
      </fault>
    </operation>
    <operation name="POST_refineShopDesign">
      <documentation>"Make it warmer", "shorter copy", "more premium". Gemini edits the design spec.</documentation>
      <input message="wsdl:POST_refineShopDesign_InputMessage" />
      <output message="wsdl:POST_refineShopDesign_OutputMessage">
        <documentation>The new design.</documentation>
      </output>
      <fault name="POST_refineShopDesign_400" message="wsdl:POST_refineShopDesign_400">
        <documentation>Something in the request needs fixing; `error` says what.</documentation>
      </fault>
      <fault name="POST_refineShopDesign_404" message="wsdl:POST_refineShopDesign_404">
        <documentation>No such shop, or the admin token doesn't match it.</documentation>
      </fault>
      <fault name="POST_refineShopDesign_502" message="wsdl:POST_refineShopDesign_502">
        <documentation>Gemini, PayPal or Channel3 failed or isn't configured.</documentation>
      </fault>
    </operation>
    <operation name="POST_regenerateHeroArt">
      <documentation>Starts generation in the background. Poll `getShop` for `hero_status`.</documentation>
      <input message="wsdl:POST_regenerateHeroArt_InputMessage" />
      <output message="wsdl:POST_regenerateHeroArt_OutputMessage">
        <documentation>Done.</documentation>
      </output>
      <fault name="POST_regenerateHeroArt_400" message="wsdl:POST_regenerateHeroArt_400">
        <documentation>Something in the request needs fixing; `error` says what.</documentation>
      </fault>
      <fault name="POST_regenerateHeroArt_404" message="wsdl:POST_regenerateHeroArt_404">
        <documentation>No such shop, or the admin token doesn't match it.</documentation>
      </fault>
    </operation>
    <operation name="POST_uploadDigitalFile">
      <documentation>Uploads or replaces a digital product's file, up to 25 MB. Each paid order gets a download link for it.</documentation>
      <input message="wsdl:POST_uploadDigitalFile_InputMessage" />
      <output message="wsdl:POST_uploadDigitalFile_OutputMessage">
        <documentation>Uploaded.</documentation>
      </output>
      <fault name="POST_uploadDigitalFile_400" message="wsdl:POST_uploadDigitalFile_400">
        <documentation>Something in the request needs fixing; `error` says what.</documentation>
      </fault>
      <fault name="POST_uploadDigitalFile_404" message="wsdl:POST_uploadDigitalFile_404">
        <documentation>No such shop, or the admin token doesn't match it.</documentation>
      </fault>
    </operation>
    <operation name="POST_addPhotos">
      <documentation>Adds one or more photos after the cover. Each is turned upright, resized to at most 2000 px and stored as WebP. A shop holds up to 8 photos; buyers swipe through them on the shop page. Not for recommendations, which show the retailer's photos.</documentation>
      <input message="wsdl:POST_addPhotos_InputMessage" />
      <output message="wsdl:POST_addPhotos_OutputMessage">
        <documentation>The shop's photos, cover first.</documentation>
      </output>
      <fault name="POST_addPhotos_400" message="wsdl:POST_addPhotos_400">
        <documentation>Something in the request needs fixing; `error` says what.</documentation>
      </fault>
      <fault name="POST_addPhotos_404" message="wsdl:POST_addPhotos_404">
        <documentation>No such shop, or the admin token doesn't match it.</documentation>
      </fault>
    </operation>
    <operation name="PUT_setPhotoOrder">
      <documentation>Sets the photo order; the first becomes the cover. Leaving a photo out removes it.</documentation>
      <input message="wsdl:PUT_setPhotoOrder_InputMessage" />
      <output message="wsdl:PUT_setPhotoOrder_OutputMessage">
        <documentation>The shop's photos, cover first.</documentation>
      </output>
      <fault name="PUT_setPhotoOrder_400" message="wsdl:PUT_setPhotoOrder_400">
        <documentation>Something in the request needs fixing; `error` says what.</documentation>
      </fault>
      <fault name="PUT_setPhotoOrder_404" message="wsdl:PUT_setPhotoOrder_404">
        <documentation>No such shop, or the admin token doesn't match it.</documentation>
      </fault>
    </operation>
    <operation name="GET_checkLinkName">
      <documentation>Normalises a proposed link name and says whether a new shop can use it.</documentation>
      <input message="wsdl:GET_checkLinkName_InputMessage" />
      <output message="wsdl:GET_checkLinkName_OutputMessage">
        <documentation>The normalised name and whether it can be used.</documentation>
      </output>
    </operation>
    <operation name="GET_searchProducts">
      <documentation>Searches 100M+ products from 25k+ stores through Channel3. Pass a result's `id` to `createShop` with `source=channel3`.</documentation>
      <input message="wsdl:GET_searchProducts_InputMessage" />
      <output message="wsdl:GET_searchProducts_OutputMessage">
        <documentation>Up to 12 products.</documentation>
      </output>
      <fault name="GET_searchProducts_502" message="wsdl:GET_searchProducts_502">
        <documentation>Gemini, PayPal or Channel3 failed or isn't configured.</documentation>
      </fault>
      <fault name="GET_searchProducts_503" message="wsdl:GET_searchProducts_503">
        <documentation>Gemini, PayPal or Channel3 failed or isn't configured.</documentation>
      </fault>
    </operation>
    <operation name="GET_getPayPalClientToken">
      <documentation>A browser-safe client token for the PayPal JavaScript SDK v6
(`paypal.createInstance({ clientToken })`), bound to the requesting site's domain.
Shop pages call this before showing the PayPal button.
</documentation>
      <input message="wsdl:GET_getPayPalClientToken_InputMessage" />
      <output message="wsdl:GET_getPayPalClientToken_OutputMessage">
        <documentation>A token for this site's domain.</documentation>
      </output>
      <fault name="GET_getPayPalClientToken_502" message="wsdl:GET_getPayPalClientToken_502">
        <documentation>Gemini, PayPal or Channel3 failed or isn't configured.</documentation>
      </fault>
      <fault name="GET_getPayPalClientToken_503" message="wsdl:GET_getPayPalClientToken_503">
        <documentation>Gemini, PayPal or Channel3 failed or isn't configured.</documentation>
      </fault>
    </operation>
    <operation name="POST_createCheckoutOrder">
      <documentation>Creates the PayPal order for one unit of a live shop's product. The amount always comes
from the shop, never from the caller. Pass the returned `id` to the PayPal JS SDK.
</documentation>
      <input message="wsdl:POST_createCheckoutOrder_InputMessage" />
      <output message="wsdl:POST_createCheckoutOrder_OutputMessage">
        <documentation>PayPal order created.</documentation>
      </output>
      <fault name="POST_createCheckoutOrder_400" message="wsdl:POST_createCheckoutOrder_400">
        <documentation>Something in the request needs fixing; `error` says what.</documentation>
      </fault>
      <fault name="POST_createCheckoutOrder_404" message="wsdl:POST_createCheckoutOrder_404">
        <documentation>No such shop, or the admin token doesn't match it.</documentation>
      </fault>
      <fault name="POST_createCheckoutOrder_409" message="wsdl:POST_createCheckoutOrder_409">
        <documentation>Taken or unavailable (a link name, or a sold-out product).</documentation>
      </fault>
      <fault name="POST_createCheckoutOrder_502" message="wsdl:POST_createCheckoutOrder_502">
        <documentation>Gemini, PayPal or Channel3 failed or isn't configured.</documentation>
      </fault>
      <fault name="POST_createCheckoutOrder_503" message="wsdl:POST_createCheckoutOrder_503">
        <documentation>Gemini, PayPal or Channel3 failed or isn't configured.</documentation>
      </fault>
    </operation>
    <operation name="POST_captureCheckoutOrder">
      <documentation>Call after the buyer approves. Records the sale; digital orders get a download link or access code.
Safe to call repeatedly: before approval it answers 409, so a page can poll it while the PayPal window is open.
</documentation>
      <input message="wsdl:POST_captureCheckoutOrder_InputMessage" />
      <output message="wsdl:POST_captureCheckoutOrder_OutputMessage">
        <documentation>Paid.</documentation>
      </output>
      <fault name="POST_captureCheckoutOrder_402" message="wsdl:POST_captureCheckoutOrder_402">
        <documentation>Something in the request needs fixing; `error` says what.</documentation>
      </fault>
      <fault name="POST_captureCheckoutOrder_404" message="wsdl:POST_captureCheckoutOrder_404">
        <documentation>No such shop, or the admin token doesn't match it.</documentation>
      </fault>
      <fault name="POST_captureCheckoutOrder_409" message="wsdl:POST_captureCheckoutOrder_409">
        <documentation>The buyer hasn't approved the order yet.</documentation>
      </fault>
      <fault name="POST_captureCheckoutOrder_422" message="wsdl:POST_captureCheckoutOrder_422">
        <documentation>The buyer's funding source was declined (`INSTRUMENT_DECLINED`); they can try another.</documentation>
      </fault>
      <fault name="POST_captureCheckoutOrder_502" message="wsdl:POST_captureCheckoutOrder_502">
        <documentation>Gemini, PayPal or Channel3 failed or isn't configured.</documentation>
      </fault>
    </operation>
    <operation name="POST_verifyAccessCode">
      <documentation>For apps and games sold with access codes. Callable from any origin (CORS `*`): it only
answers valid or not for one shop, and counts uses. Accepts the shop's current or former
link names, and codes typed loosely (lower case, spaces, no dashes).
</documentation>
      <input message="wsdl:POST_verifyAccessCode_InputMessage" />
      <output message="wsdl:POST_verifyAccessCode_OutputMessage">
        <documentation>The answer. Invalid codes are also a 200.</documentation>
      </output>
    </operation>
    <operation name="GET_listOrders">
      <documentation>Newest first. Checkouts that were never approved are left out.</documentation>
      <input message="wsdl:GET_listOrders_InputMessage" />
      <output message="wsdl:GET_listOrders_OutputMessage">
        <documentation>Orders.</documentation>
      </output>
      <fault name="GET_listOrders_404" message="wsdl:GET_listOrders_404">
        <documentation>No such shop, or the admin token doesn't match it.</documentation>
      </fault>
    </operation>
    <operation name="POST_markOrderShipped">
      <documentation>Saves the tracking number and pushes it to PayPal, so the buyer sees it in PayPal.</documentation>
      <input message="wsdl:POST_markOrderShipped_InputMessage" />
      <output message="wsdl:POST_markOrderShipped_OutputMessage">
        <documentation>Shipped.</documentation>
      </output>
      <fault name="POST_markOrderShipped_400" message="wsdl:POST_markOrderShipped_400">
