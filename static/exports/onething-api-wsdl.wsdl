        <documentation>No such shop, or the admin token or API key doesn't match it.</documentation>
      </fault>
    </operation>
    <operation name="POST_connectPayPal">
      <documentation>Starts PayPal's seller onboarding (Partner Referrals). Send the seller's browser to the
returned `url`; they sign in to PayPal (or create a business account) and grant OneThing
permission. PayPal brings them back to `/api/shops/&lt;slug&gt;/paypal/return`, which saves the
connection and opens the manage page. From then on, sales are paid to that account.

Without a connection, a shop can still go live with a typed `paypal_email`.

**Platforms:** call it with your API key and a `returnUrl`, and PayPal's flow ends on your own
page instead, as `returnUrl?paypal=connected|incomplete|cancelled|failed&amp;shop=&lt;slug&gt;`. The
URL's origin must be one registered on the key.
</documentation>
      <input message="wsdl:POST_connectPayPal_InputMessage" />
      <output message="wsdl:POST_connectPayPal_OutputMessage">
        <documentation>Where to send the seller.</documentation>
      </output>
      <fault name="POST_connectPayPal_404" message="wsdl:POST_connectPayPal_404">
        <documentation>No such shop, or the admin token or API key doesn't match it.</documentation>
      </fault>
      <fault name="POST_connectPayPal_502" message="wsdl:POST_connectPayPal_502">
        <documentation>Gemini, PayPal or Channel3 failed or isn't configured.</documentation>
      </fault>
      <fault name="POST_connectPayPal_503" message="wsdl:POST_connectPayPal_503">
        <documentation>Gemini, PayPal or Channel3 failed or isn't configured.</documentation>
      </fault>
    </operation>
    <operation name="GET_getPayPalConnection">
      <documentation>Asks PayPal where the seller's connection stands and saves it on the shop. Also finds a connection the seller finished at PayPal without coming back.</documentation>
      <input message="wsdl:GET_getPayPalConnection_InputMessage" />
      <output message="wsdl:GET_getPayPalConnection_OutputMessage">
        <documentation>The connection, or nulls if there is none yet.</documentation>
      </output>
      <fault name="GET_getPayPalConnection_404" message="wsdl:GET_getPayPalConnection_404">
        <documentation>No such shop, or the admin token or API key doesn't match it.</documentation>
      </fault>
      <fault name="GET_getPayPalConnection_502" message="wsdl:GET_getPayPalConnection_502">
        <documentation>Gemini, PayPal or Channel3 failed or isn't configured.</documentation>
      </fault>
      <fault name="GET_getPayPalConnection_503" message="wsdl:GET_getPayPalConnection_503">
        <documentation>Gemini, PayPal or Channel3 failed or isn't configured.</documentation>
      </fault>
    </operation>
    <operation name="DELETE_disconnectPayPal">
      <documentation>Forgets the connected account. Sales go back to the shop's `paypal_email`.</documentation>
      <input message="wsdl:DELETE_disconnectPayPal_InputMessage" />
      <output message="wsdl:DELETE_disconnectPayPal_OutputMessage">
        <documentation>Done.</documentation>
