          <xs:enumeration value="none" />
          <xs:enumeration value="to_ship" />
          <xs:enumeration value="shipped" />
          <xs:enumeration value="digital_sent" />
        </xs:restriction>
      </xs:simpleType>
      <xs:simpleType name="HeroStatus">
