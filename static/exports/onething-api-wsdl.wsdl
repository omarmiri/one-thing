                <xs:pattern value="^#[0-9a-fA-F]{6}$" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="1" name="text">
            <xs:simpleType>
              <xs:annotation>
                <xs:documentation>A colour as `#rrggbb`.</xs:documentation>
              </xs:annotation>
              <xs:restriction base="xs:string">
                <xs:pattern value="^#[0-9a-fA-F]{6}$" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="1" name="muted">
            <xs:simpleType>
              <xs:annotation>
                <xs:documentation>A colour as `#rrggbb`.</xs:documentation>
              </xs:annotation>
              <xs:restriction base="xs:string">
                <xs:pattern value="^#[0-9a-fA-F]{6}$" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="1" name="accent">
            <xs:simpleType>
              <xs:annotation>
                <xs:documentation>A colour as `#rrggbb`.</xs:documentation>
              </xs:annotation>
              <xs:restriction base="xs:string">
                <xs:pattern value="^#[0-9a-fA-F]{6}$" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="1" name="accentText">
            <xs:simpleType>
              <xs:annotation>
