        </xs:annotation>
        <xs:restriction base="xs:string">
          <xs:enumeration value="physical" />
          <xs:enumeration value="digital" />
          <xs:enumeration value="referral" />
        </xs:restriction>
      </xs:simpleType>
      <xs:simpleType name="Kind2">
        <xs:annotation>
          <xs:documentation>`physical`, `digital` or `referral`.</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
          <xs:enumeration value="physical" />
          <xs:enumeration value="digital" />
          <xs:enumeration value="referral" />
        </xs:restriction>
      </xs:simpleType>
      <xs:simpleType name="Layout">
        <xs:annotation>
          <xs:documentation>The page template: `bold-hero` (image first, punchy), `editorial` (magazine), `minimal` (quiet, lots of space) or `playful`.</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
          <xs:enumeration value="bold-hero" />
          <xs:enumeration value="editorial" />
          <xs:enumeration value="minimal" />
          <xs:enumeration value="playful" />
