              <xs:documentation>The body text font.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:simpleType name="Fulfillment">
        <xs:annotation>
          <xs:documentation>`to_ship` until the seller adds tracking, then `shipped`.</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
