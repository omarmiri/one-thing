              <xs:documentation>Colours: the shop photo (id) that shows this colour. See `matchColorPhotos`.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="Suggestions">
