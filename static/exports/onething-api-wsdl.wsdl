            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="receipt_url" type="xs:string">
            <xs:annotation>
              <xs:documentation>Paid orders. The buyer's thank-you page.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="delivery" type="xs:anyType">
            <xs:annotation>
              <xs:documentation>Paid orders. What the buyer got.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
