        </xs:annotation>
        <xs:sequence>
          <xs:element minOccurs="1" fixed="2.0" name="jsonrpc" type="xs:string">
            <xs:annotation>
              <xs:documentation>Always `2.0`.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="id" nillable="true" type="xs:anyType">
            <xs:annotation>
              <xs:documentation>The request's `id`.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="result">
            <xs:annotation>
              <xs:documentation>For `tools/call`: `content` (the answer as JSON text), `structuredContent` (the same object) and `isError`.</xs:documentation>
            </xs:annotation>
            <xs:complexType>
              <xs:sequence>
                <xs:any />
              </xs:sequence>
            </xs:complexType>
          </xs:element>
          <xs:element minOccurs="0" name="error" type="schemas:Error">
            <xs:annotation>
              <xs:documentation>Present when the call failed.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
