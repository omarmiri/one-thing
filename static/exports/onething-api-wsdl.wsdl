      <xs:complexType name="Error">
        <xs:sequence>
          <xs:element minOccurs="1" name="error" type="xs:string">
            <xs:annotation>
              <xs:documentation>A sentence you can show to a person.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="field" type="xs:string">
            <xs:annotation>
              <xs:documentation>The form field at fault, when there is one.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="detail" type="xs:string">
            <xs:annotation>
              <xs:documentation>The upstream service's own message, for debugging.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="CreateShopForm">
        <xs:sequence>
          <xs:element minOccurs="1" name="source" type="schemas:Source" />
          <xs:element minOccurs="0" name="photo" type="xs:hexBinary">
            <xs:annotation>
              <xs:documentation>`source=photo`: the product photo, up to 8 MB.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="description" type="xs:string">
            <xs:annotation>
              <xs:documentation>`source=photo`: a sentence or two about the product. Required if there is no photo.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="url">
            <xs:simpleType>
              <xs:annotation>
                <xs:documentation>`source=link`: a product page, or your own app or game page.</xs:documentation>
              </xs:annotation>
              <xs:restriction base="xs:string" />
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" name="productId" type="xs:string">
            <xs:annotation>
              <xs:documentation>`source=channel3`: a product id from `searchProducts`.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="slug" type="xs:string">
            <xs:annotation>
              <xs:documentation>The link name you want. If omitted, the AI suggests one.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" default="auto" name="type" type="schemas:Type" />
          <xs:element minOccurs="0" name="delivery" type="schemas:Delivery">
            <xs:annotation>
              <xs:documentation>For digital products. If omitted, the AI guesses.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="access_url">
            <xs:simpleType>
              <xs:annotation>
                <xs:documentation>Where buyers use an access code.</xs:documentation>
              </xs:annotation>
              <xs:restriction base="xs:string" />
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" name="price" type="xs:double">
            <xs:annotation>
              <xs:documentation>USD. If omitted, the AI suggests a price.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="shipping" type="xs:double" />
          <xs:element minOccurs="0" name="stock" type="xs:integer" />
          <xs:element minOccurs="0" name="ship_countries" type="xs:string" />
          <xs:element minOccurs="0" name="paypal_email">
            <xs:simpleType>
              <xs:restriction base="xs:string" />
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" name="seller_email">
            <xs:simpleType>
              <xs:restriction base="xs:string" />
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" name="digital_file" type="xs:hexBinary" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="CreatedShop">
        <xs:sequence>
          <xs:element minOccurs="1" name="slug" type="xs:string" />
          <xs:element minOccurs="1" name="token" type="xs:string">
            <xs:annotation>
              <xs:documentation>The admin token. Shown once; store it.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="manageUrl" type="xs:string">
            <xs:annotation>
              <xs:documentation>The seller's private manage page (contains the token).</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ShopUpdate">
        <xs:sequence>
          <xs:element minOccurs="0" name="slug" type="xs:string" />
          <xs:element minOccurs="0" name="status" type="schemas:Status" />
          <xs:element minOccurs="0" name="product_type" type="schemas:ProductType">
            <xs:annotation>
              <xs:documentation>`referral` only for shops created from Channel3.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="price">
            <xs:simpleType>
              <xs:restriction base="xs:double">
                <xs:maxInclusive value="10000" />
                <xs:minInclusive value="0.5" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" name="shipping">
            <xs:simpleType>
              <xs:restriction base="xs:double">
                <xs:maxInclusive value="500" />
                <xs:minInclusive value="0" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" name="stock" nillable="true">
            <xs:simpleType>
              <xs:restriction base="xs:integer">
                <xs:minInclusive value="0" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" name="ship_countries" nillable="true" type="xs:string" />
          <xs:element minOccurs="0" name="delivery" type="schemas:Delivery1" />
          <xs:element minOccurs="0" name="access_url" nillable="true">
            <xs:simpleType>
              <xs:restriction base="xs:string" />
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" name="paypal_email" nillable="true">
            <xs:simpleType>
              <xs:restriction base="xs:string" />
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" name="seller_email" nillable="true">
            <xs:simpleType>
              <xs:restriction base="xs:string" />
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" name="zapier_hook_url" nillable="true">
            <xs:simpleType>
              <xs:restriction base="xs:string" />
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" name="in_gallery" type="xs:boolean">
            <xs:annotation>
              <xs:documentation>Feature the shop at `/gallery` while it's live. Off by default.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="Shop">
        <xs:sequence>
          <xs:element minOccurs="1" name="id" type="xs:string" />
          <xs:element minOccurs="1" name="slug" type="xs:string" />
          <xs:element minOccurs="1" name="status" type="schemas:Status" />
          <xs:element minOccurs="1" name="product_type" type="schemas:ProductType1" />
          <xs:element minOccurs="1" name="price_cents" type="xs:integer" />
