          <xs:element minOccurs="0" name="seller_email" nillable="true" type="xs:string" />
          <xs:element minOccurs="0" name="zapier_hook_url" nillable="true" type="xs:string" />
          <xs:element minOccurs="0" name="in_gallery" type="xs:boolean" />
          <xs:element minOccurs="0" name="photo_blob" nillable="true" type="xs:string">
            <xs:annotation>
              <xs:documentation>Image id for `getImage`.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="hero_blob" nillable="true" type="xs:string" />
          <xs:element minOccurs="0" name="hero_status" type="schemas:HeroStatus" />
          <xs:element minOccurs="0" name="hero_error" nillable="true" type="xs:string" />
          <xs:element minOccurs="0" name="ai_source" type="schemas:AiSource" />
          <xs:element minOccurs="0" name="source_url" nillable="true" type="xs:string" />
          <xs:element minOccurs="0" name="referral" nillable="true" type="schemas:Referral" />
          <xs:element minOccurs="1" name="spec" type="schemas:DesignSpec">
            <xs:annotation>
              <xs:documentation>What Gemini designed. OneThing's templates render it; Gemini never writes HTML.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="created_at" type="xs:dateTime" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="DesignSpec">
        <xs:annotation>
          <xs:documentation>What Gemini designed. OneThing's templates render it; Gemini never writes HTML.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
          <xs:element minOccurs="1" name="productType" type="schemas:ProductType2" />
          <xs:element minOccurs="1" name="productName" type="xs:string" />
          <xs:element minOccurs="1" name="layout" type="schemas:Layout" />
          <xs:element minOccurs="1" name="palette" type="schemas:Palette" />
          <xs:element minOccurs="1" name="fonts" type="schemas:Fonts" />
          <xs:element minOccurs="0" name="eyebrow" type="xs:string" />
          <xs:element minOccurs="1" name="headline" type="xs:string" />
          <xs:element minOccurs="0" name="subheadline" type="xs:string" />
          <xs:element minOccurs="0" name="story" type="xs:string" />
          <xs:element minOccurs="1" maxOccurs="unbounded" name="bullets" type="xs:string" />
          <xs:element minOccurs="0" maxOccurs="unbounded" name="details" type="schemas:Detail" />
          <xs:element minOccurs="1" maxOccurs="unbounded" name="faq" type="schemas:Faq" />
          <xs:element minOccurs="1" name="ctaLabel" type="xs:string" />
          <xs:element minOccurs="0" name="suggestedPriceUsd" type="xs:double" />
          <xs:element minOccurs="0" name="suggestedShippingUsd" type="xs:double" />
          <xs:element minOccurs="0" name="imageAlt" type="xs:string" />
          <xs:element minOccurs="0" name="heroPrompt" type="xs:string" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="Referral">
        <xs:annotation>
          <xs:documentation>A recommended Channel3 product. Buy links are Channel3-tracked, credited to this shop.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
          <xs:element minOccurs="1" name="productId" type="xs:string" />
          <xs:element minOccurs="1" name="title" type="xs:string" />
          <xs:element minOccurs="0" name="brand" nillable="true" type="xs:string" />
          <xs:element minOccurs="0" name="image" nillable="true" type="xs:string" />
          <xs:element minOccurs="1" maxOccurs="unbounded" name="offers" type="schemas:Offer" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ProductCard">
        <xs:sequence>
          <xs:element minOccurs="1" name="id" type="xs:string" />
          <xs:element minOccurs="1" name="title" type="xs:string" />
          <xs:element minOccurs="0" name="brand" nillable="true" type="xs:string" />
          <xs:element minOccurs="1" name="image" type="xs:string" />
          <xs:element minOccurs="1" name="price" type="xs:double" />
          <xs:element minOccurs="1" name="currency" type="xs:string" />
          <xs:element minOccurs="1" name="retailer" type="xs:string">
            <xs:annotation>
              <xs:documentation>The store with the best offer.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="retailers" type="xs:integer" />
          <xs:element minOccurs="1" name="commission" type="xs:double">
            <xs:annotation>
              <xs:documentation>Best commission rate across offers, 0–1.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="Order">
        <xs:sequence>
          <xs:element minOccurs="1" name="id" type="xs:string" />
          <xs:element minOccurs="0" name="paypal_order_id" nillable="true" type="xs:string" />
          <xs:element minOccurs="1" name="status" type="schemas:Status2" />
          <xs:element minOccurs="1" name="amount_cents" type="xs:integer" />
          <xs:element minOccurs="0" name="shipping_cents" type="xs:integer" />
          <xs:element minOccurs="1" name="currency" type="xs:string" />
          <xs:element minOccurs="0" name="buyer_email" nillable="true" type="xs:string" />
          <xs:element minOccurs="0" name="buyer_name" nillable="true" type="xs:string" />
          <xs:element minOccurs="0" name="shipping_address" nillable="true" type="xs:string" />
          <xs:element minOccurs="0" name="capture_id" nillable="true" type="xs:string" />
          <xs:element minOccurs="1" name="fulfillment_status" type="schemas:FulfillmentStatus" />
          <xs:element minOccurs="0" name="carrier" nillable="true" type="xs:string" />
          <xs:element minOccurs="0" name="tracking_number" nillable="true" type="xs:string" />
          <xs:element minOccurs="0" name="tracking_synced" type="xs:boolean" />
          <xs:element minOccurs="0" name="downloads" type="xs:integer" />
          <xs:element minOccurs="0" name="access_code" nillable="true" type="xs:string" />
          <xs:element minOccurs="0" name="code_uses" type="xs:integer" />
          <xs:element minOccurs="0" name="paid_at" nillable="true" type="xs:dateTime" />
          <xs:element minOccurs="0" name="created_at" type="xs:dateTime" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="WebhookEvent">
        <xs:sequence>
          <xs:element minOccurs="1" name="id" type="xs:string">
            <xs:annotation>
              <xs:documentation>PayPal's event id.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="event_type" type="xs:string" />
          <xs:element minOccurs="0" name="paypal_order_id" nillable="true" type="xs:string" />
          <xs:element minOccurs="0" name="summary" nillable="true" type="xs:string" />
          <xs:element minOccurs="1" name="verified" type="xs:boolean">
            <xs:annotation>
              <xs:documentation>Whether PayPal confirmed the delivery's signature.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="outcome" type="xs:string" />
          <xs:element minOccurs="1" name="received_at" type="xs:dateTime" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="OrderEvent">
        <xs:sequence>
          <xs:element minOccurs="1" name="event" type="schemas:Event" />
          <xs:element minOccurs="1" name="shop" type="schemas:Shop1" />
          <xs:element minOccurs="1" name="order" type="schemas:Order1" />
        </xs:sequence>
      </xs:complexType>
      <xs:simpleType name="AiSource">
        <xs:restriction base="xs:string">
          <xs:enumeration value="gemini" />
          <xs:enumeration value="fallback" />
        </xs:restriction>
      </xs:simpleType>
      <xs:complexType name="ApiAccessVerifyRequest">
        <xs:sequence>
          <xs:element minOccurs="1" name="shop" type="xs:string">
