      title:
        required: true
        example:
          value: Trail Running Vest 5L
        displayName: title
        description: The product's name.
        type: string
      brand:
        required: false
        example:
          value: Salomon
        displayName: brand
        description: The brand, when known.
        type:
        - string
        - nil
      image:
        required: false
        example:
          value: https://images.example.com/vest.jpg
        displayName: image
        description: The product image's URL.
        type:
        - string
        - nil
      offers:
        required: true
        example:
          value:
          - domain: rei.com
            url: https://buy.trychannel3.com/r/abc123
            price: 240
            currency: USD
            inStock: true
            commission: 0.08
        displayName: offers
        description: Stores that sell it, with tracked links.
