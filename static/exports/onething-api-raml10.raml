        - string
        - nil
      shipping_address:
        required: false
        example:
          value:
            address_line_1: 1 Main St
            admin_area_2: Springfield
            admin_area_1: IL
            postal_code: '62701'
            country_code: US
        displayName: shipping_address
        description: 'Physical orders: the address from PayPal checkout, by field.'
