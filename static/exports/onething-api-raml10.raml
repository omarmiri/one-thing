#%RAML 1.0
title: OneThing API
version: 1.0.0
baseUri: https://one-thing-ash0.onrender.com
baseUriParameters: {}
protocols:
- HTTPS
- HTTP
documentation:
- title: OneThing API
  content: |
    OneThing turns a photo, a link or a picked product into a live one-product shop that takes

    PayPal payments, or a recommendation page that earns referral commissions through Channel3.


    **How a shop is made**

    1. `createShop`: start from a photo, a link, or a Channel3 product. Gemini guesses what it
       is, how it's delivered, the price, a short link and the page design. You get back the
       shop's link name and an **admin token**.
    2. `updateShop`: correct anything the AI guessed, then set `status: live`.

    3. Buyers pay on `https://<host>/<slug>` with PayPal. Sellers read orders and ship them.


    **Auth.** Seller endpoints take the shop's admin token in the `x-admin-token` header, or a

    **platform API key** (`Authorization: Bearer ot_sk_…`) for marketplaces that make shops for

    their own sellers. Buyer endpoints (checkout, access-code verification, downloads) are public.


    **Access codes.** A digital product can unlock an app or game instead of shipping a file.

    Each paid order gets a code such as `K7QF-M2XP-9HTD`; your app calls `verifyAccessCode`

    before unlocking. Raptor Rush on miriogames.com is a live example.


    **Agent-ready.** Every live shop is also published for AI shopping agents: an MCP server at

    `/api/mcp` with `search_shops`, `get_product`, `create_order` and `get_order`, and the same

    four as plain GETs for assistants that can only fetch URLs (`listAgentShops`,

    `getAgentProduct`, `orderByLink`, `getAgentOrder`), with `/llms.txt` as the starting point.

    Order and status links also have short forms, `/<slug>/buy` and `/o/<order_id>/status`.

    An agent can find and order, but the buyer still approves every payment at PayPal.


    **Limits.** Calls that cost something are capped per network: 120 checkouts per 10 minutes,

    10 new shops an hour and 60 AI requests an hour. Over the cap the reply is a 429 with

    `Retry-After`.


    All money moves through PayPal (sandbox in this deployment). OneThing never holds card data.
securitySchemes:
  AdminToken:
    type: Pass Through
    description: The shop's admin token, returned once by `createShop`. Keep it secret.
    describedBy:
      headers:
        x-admin-token:
          required: true
          displayName: x-admin-token
          description: The shop's admin token, returned once by `createShop`. Keep it secret.
          type: string
securedBy: []
types:
  ErrorResponse:
    example:
      value:
        error: Choose a photo.
        field: photo
    displayName: ErrorResponse
    description: An error reply.
    type: object
    properties:
      error:
        required: true
        example:
          value: Order not found.
        displayName: error
        description: A sentence you can show to a person.
        type: string
      field:
        required: false
        example:
          value: price
        displayName: field
        description: The form field at fault, when there is one.
        type: string
      detail:
        required: false
        example:
          value: INSTRUMENT_DECLINED
        displayName: detail
        description: The upstream service's own message, for debugging.
        type: string
  CreateShopForm:
    example:
      value:
        source: photo
        description: Vintage cream and red quad roller skates with walnut burl heels.
        url: https://one-thing-ash0.onrender.com/vintageskates
        productId: ch3_7f2a9c1e
        slug: vintageskates
        type: auto
        delivery: file
        access_url: https://www.miriogames.com/raptor-rush/
        price: 240
        shipping: 15
        stock: 7
        ship_countries: US
        paypal_email: seller@example.com
        seller_email: seller@example.com
    displayName: CreateShopForm
    description: What to make a shop from. Only `source` is required; the AI guesses the rest and the seller corrects it with `updateShop`.
    type: object
    properties:
      source:
        required: true
        example:
          value: photo
        displayName: source
        description: 'What the shop starts from: a photo (with an optional description), a product link, or a Channel3 product to recommend.'
        type: string
        enum:
        - photo
        - link
        - channel3
      photo:
        required: false
        displayName: photo
        description: '`source=photo`: the product photo, up to 8 MB.'
        type: file
      description:
        required: false
        example:
          value: Vintage cream and red quad roller skates with walnut burl heels.
        displayName: description
        description: '`source=photo`: a sentence or two about the product. Required if there is no photo.'
        type: string
      url:
        required: false
        example:
          value: https://one-thing-ash0.onrender.com/vintageskates
        displayName: url
        description: '`source=link`: a product page, or your own app or game page.'
        type: string
      productId:
        required: false
        example:
          value: ch3_7f2a9c1e
        displayName: productId
        description: '`source=channel3`: a product id from `searchProducts`.'
        type: string
      slug:
        required: false
        example:
          value: vintageskates
        displayName: slug
        description: The link name you want. If omitted, the AI suggests one.
        type: string
      type:
        required: false
        default: auto
        displayName: type
        description: '`physical` ships, `digital` is a file or an access code, `auto` lets the AI decide.'
        type: string
        enum:
        - auto
        - physical
        - digital
      delivery:
        required: false
        example:
          value: file
        displayName: delivery
        description: For digital products. If omitted, the AI guesses.
        type: string
        enum:
        - file
        - access_code
      access_url:
        required: false
        example:
          value: https://www.miriogames.com/raptor-rush/
        displayName: access_url
        description: Where buyers use an access code.
        type: string
      price:
        required: false
        example:
          value: 240
        displayName: price
        description: USD. If omitted, the AI suggests a price.
        type: number
        format: double
      shipping:
        required: false
        example:
          value: 15
        displayName: shipping
        description: 'Physical products: shipping per order, in USD. If omitted, the AI suggests it.'
        type: number
        format: double
      stock:
        required: false
        example:
          value: 7
        displayName: stock
        description: How many are for sale. Leave out for unlimited.
        type: integer
        format: int32
      ship_countries:
        required: false
        examples:
          Untitled Example1:
            value: US
          Untitled Example2:
            value: CA
        displayName: ship_countries
        description: 'Physical products: comma-separated ISO country codes to ship to. Empty means anywhere PayPal ships.'
        type: string
      paypal_email:
        required: false
        example:
          value: seller@example.com
        displayName: paypal_email
        description: The PayPal account that gets paid, if the seller doesn't connect one with `connectPayPal`.
        type: string
      seller_email:
        required: false
        example:
          value: seller@example.com
        displayName: seller_email
        description: Where order notifications go.
        type: string
      digital_file:
        required: false
        displayName: digital_file
        description: 'Digital products sold as a file: the file buyers download, up to 25 MB. Can also be added later with `uploadDigitalFile`.'
        type: file
  CreatedShop:
    example:
      value:
        slug: dragonflight
        token: 3fJ9xQm2LwP8vR1tZk7cN4bY6dHs0aEu
        manageUrl: /manage/vintageskates?token=3fJ9xQm2LwP8vR1tZk7cN4bY6dHs0aEu
    displayName: CreatedShop
    description: The new draft shop and the credentials to manage it.
    type: object
    properties:
      slug:
        required: true
        example:
          value: dragonflight
        displayName: slug
        description: "The shop's link name: the page is `https://<host>/<slug>`."
        type: string
      token:
        required: true
        example:
          value: 3fJ9xQm2LwP8vR1tZk7cN4bY6dHs0aEu
        displayName: token
        description: The admin token. Shown once; store it.
        type: string
      manageUrl:
        required: true
        example:
          value: /manage/vintageskates?token=3fJ9xQm2LwP8vR1tZk7cN4bY6dHs0aEu
        displayName: manageUrl
        description: The seller's private manage page (contains the token).
        type: string
  ShopUpdate:
    example:
      value:
        slug: vintageskates
        status: draft
        product_type: physical
        price: 240
        shipping: 15
        stock: 7
        ship_countries: US,CA
        delivery: file
        access_url: https://www.miriogames.com/raptor-rush/
        paypal_email: seller@example.com
        seller_email: seller@example.com
        zapier_hook_url: https://hooks.zapier.com/hooks/catch/123456/abcdef/
        in_gallery: true
        options:
        - name: Size
          kind: size
          values:
          - label: S
          - label: M
          - label: L
        option_stock:
          M / Black: 4
          L / Black: 0
        facts:
        - label: Size
          value: US women's 8
    displayName: ShopUpdate
    description: The fields to change. Anything left out stays as it is.
    type: object
    properties:
      slug:
        required: false
        example:
          value: vintageskates
        displayName: slug
        description: A new link name. The old one keeps redirecting.
        type: string
      status:
        required: false
        example:
          value: draft
        displayName: status
        description: '`live` publishes the shop; `draft` takes it down.'
        type: string
        enum:
        - draft
        - live
      product_type:
        required: false
        example:
          value: physical
        displayName: product_type
        description: '`referral` only for shops created from Channel3.'
        type: string
        enum:
        - physical
        - digital
        - referral
      price:
        required: false
        example:
          value: 240
        displayName: price
        description: The price in USD.
        type: number
        minimum: 0.5
        maximum: 10000
        format: double
      shipping:
        required: false
        example:
          value: 15
        displayName: shipping
        description: Shipping per order, in USD.
        type: number
        minimum: 0
        maximum: 500
        format: double
      stock:
        required: false
        example:
          value: 7
        displayName: stock
        description: How many are for sale; null for unlimited.
        type:
        - integer
        - nil
        minimum: 0
        format: int32
      ship_countries:
        required: false
        example:
          value: US,CA
        displayName: ship_countries
        description: Comma-separated ISO country codes; null or empty means anywhere PayPal ships.
        type:
        - string
        - nil
      delivery:
        required: false
        example:
          value: file
        displayName: delivery
        description: 'Digital products: `file` or `access_code`.'
        type: string
        enum:
        - file
        - access_code
      access_url:
        required: false
        example:
          value: https://www.miriogames.com/raptor-rush/
        displayName: access_url
        description: 'Access-code products: where buyers enter their code.'
        type:
        - string
        - nil
      paypal_email:
        required: false
        example:
          value: seller@example.com
        displayName: paypal_email
        description: The PayPal account paid when no account is connected.
        type:
        - string
        - nil
      seller_email:
        required: false
        example:
          value: seller@example.com
        displayName: seller_email
        description: Where order notifications go.
        type:
        - string
        - nil
      zapier_hook_url:
        required: false
        example:
          value: https://hooks.zapier.com/hooks/catch/123456/abcdef/
        displayName: zapier_hook_url
        description: A Zapier Catch Hook for order events; null removes it.
        type:
        - string
        - nil
      in_gallery:
        required: false
        example:
          value: true
        displayName: in_gallery
        description: Feature the shop at `/gallery` while it's live. Off by default.
        type: boolean
      options:
        required: false
        example:
          value:
          - name: Size
            kind: size
            values:
            - label: S
            - label: M
            - label: L
        displayName: options
        description: What the buyer picks (physical products only), replacing the current options; `[]` removes them. With options, stock is counted per combination in `option_stock` and the shop's own `stock` is cleared. At most 60 combinations.
        type: array
        uniqueItems: false
        maxItems: 3
        items:
          type: ShopOption
      option_stock:
        required: false
        example:
          value:
            M / Black: 4
            L / Black: 0
        displayName: option_stock
        description: Stock per combination, keyed by its values in option order joined with ` / ` (e.g. `M / Black`). A missing key or `null` means unlimited; `0` is sold out.
        type: object
        additionalProperties: true
        properties:
          //:
            type: integer
      facts:
        required: false
        example:
          value:
          - label: Size
            value: US women's 8
        displayName: facts
        description: Answers to the "buyers will ask" questions in `suggestions.missingFacts`. Each becomes a product detail on the page (replacing one with the same label) and drops off the list.
        type: array
        uniqueItems: false
        maxItems: 5
        items:
          type: Fact
  Shop:
    displayName: Shop
    description: A shop, as its seller sees it.
    type: object
    properties:
      id:
        required: true
        example:
          value: shp_8Hc2LmQ4
        displayName: id
        description: OneThing's internal shop id.
        type: string
      slug:
        required: true
        example:
          value: vintageskates
        displayName: slug
        description: The shop's link name.
        type: string
      status:
        required: true
        example:
          value: draft
        displayName: status
        description: '`draft` until the seller goes live; only `live` shops take orders.'
        type: string
        enum:
        - draft
        - live
      product_type:
        required: true
        example:
          value: physical
        displayName: product_type
        description: '`physical` ships, `digital` downloads or unlocks, `referral` recommends a Channel3 product.'
        type: string
        enum:
        - physical
        - digital
        - referral
      price_cents:
        required: true
        example:
          value: 24000
        displayName: price_cents
        description: The price in cents.
        type: integer
        format: int32
      currency:
        required: true
        example:
          value: USD
        displayName: currency
        description: ISO 4217 currency code.
        type: string
      shipping_cents:
        required: false
        example:
          value: 1500
        displayName: shipping_cents
        description: Shipping per order, in cents.
        type: integer
        format: int32
      ship_countries:
        required: false
        example:
          value: US,CA
        displayName: ship_countries
        description: Comma-separated ISO country codes; null or empty means anywhere PayPal ships.
        type:
        - string
        - nil
      stock:
        required: false
        example:
          value: 7
        displayName: stock
        description: How many are left; null for unlimited. With options, see `option_stock`.
        type:
        - integer
        - nil
        format: int32
      delivery:
        required: false
        example:
          value: file
        displayName: delivery
        description: 'Digital products: `file` (a download) or `access_code` (a code that unlocks an app or game).'
        type: string
        enum:
        - file
        - access_code
      access_url:
        required: false
        example:
          value: https://www.miriogames.com/raptor-rush/
        displayName: access_url
        description: 'Access-code products: where buyers enter their code.'
        type:
        - string
        - nil
      paypal_email:
        required: false
        example:
          value: seller@example.com
        displayName: paypal_email
        description: The PayPal account paid when no account is connected.
        type:
        - string
        - nil
      seller_email:
        required: false
        example:
          value: seller@example.com
        displayName: seller_email
        description: Where order notifications go.
        type:
        - string
        - nil
      paypal_merchant_id:
        required: false
        example:
          value: 7MZJ4QXN8K2LA
        displayName: paypal_merchant_id
        description: The connected PayPal account (`connectPayPal`). Sales go here when it can receive payments.
        type:
        - string
        - nil
      paypal_status:
        required: false
        example:
          value:
            receivable: true
            emailConfirmed: true
            checkedAt: 2026-10-22T02:41:37Z
        displayName: paypal_status
        description: What PayPal last said about the connected account; null when none is connected.
        type: PayPalStatus | nil
      zapier_hook_url:
        required: false
        example:
          value: https://hooks.zapier.com/hooks/catch/123456/abcdef/
        displayName: zapier_hook_url
        description: A Zapier Catch Hook that gets an `OrderEvent` for each paid, shipped or refunded order.
        type:
        - string
        - nil
      in_gallery:
        required: false
        example:
          value: true
        displayName: in_gallery
        description: Whether the shop is featured at `/gallery` while live.
        type: boolean
      account_id:
        required: false
        example:
          value: acc_Vq3nN8cT0bLx2YwE
        displayName: account_id
        description: The seller account that owns the shop, if it was made while signed in.
        type:
        - string
        - nil
      options:
        required: false
        example:
          value:
          - name: Size
            kind: size
            values:
            - label: S
            - label: M
            - label: L
        displayName: options
        description: What the buyer picks, such as size or colour.
        type: array
        items:
          type: ShopOption
      option_stock:
        required: false
        example:
          value:
            M / Black: 4
            L / Black: 0
        displayName: option_stock
        description: Stock per combination, keyed by its values in option order joined with ` / ` (e.g. `M / Black`). A missing key or `null` means unlimited; `0` is sold out.
        type: object
        additionalProperties: true
        properties:
          //:
            type: integer
      suggestions:
        required: false
        example:
          value:
            oneOfAKind: false
            options:
            - name: Size
              kind: size
              values:
              - label: S
              - label: M
              - label: L
            missingFacts:
            - label: Size
              question: What size are the skates?
              placeholder: US women's 8
        displayName: suggestions
        description: What the AI thinks buyers will pick or ask; null once handled.
        type: Suggestions | nil
      photo_blob:
        required: false
        example:
          value: 'LFRvGuTU3D8i334X'
        displayName: photo_blob
        description: Image id for `getImage`. The cover photo.
        type:
        - string
        - nil
      gallery_blobs:
        required: false
        example:
          value:
          - zrySajNyao6_j11x
          - SuqcgNv64HWN8H6e
        displayName: gallery_blobs
        description: The other photos, in order.
        type: array
        items:
          type: string
      hero_blob:
        required: false
        example:
          value: Hn2Kd8sQp4LmZ0vX
        displayName: hero_blob
        description: Image id of the AI hero art, when there is one.
        type:
        - string
        - nil
      hero_status:
        required: false
        example:
          value: none
        displayName: hero_status
        description: 'Hero art: `pending` while generating, then `ready` or `failed`; `none` if not requested.'
        type: string
        enum:
        - none
        - pending
        - ready
        - failed
      hero_error:
        required: false
        example:
          value: No image model on this key returned an image.
        displayName: hero_error
        description: Why hero art failed, when it did.
        type:
        - string
        - nil
      ai_source:
        required: false
        example:
          value: gemini
        displayName: ai_source
        description: "Who designed the page: `gemini`, or `fallback` when Gemini wasn't available and a plain template was used."
        type: string
        enum:
        - gemini
        - fallback
      source_url:
        required: false
        example:
          value: https://example.com/products/roller-skates
        displayName: source_url
        description: The product link the shop was made from, if any.
        type:
        - string
        - nil
      referral:
        required: false
        example:
          value:
            productId: ch3_7f2a9c1e
            title: Trail Running Vest 5L
            brand: Salomon
            image: https://images.example.com/vest.jpg
            offers:
            - domain: rei.com
              url: https://buy.trychannel3.com/r/abc123
              price: 240
              currency: USD
              inStock: true
              commission: 0.08
        displayName: referral
        description: 'Recommendation shops: the Channel3 product; null otherwise.'
        type: Referral | nil
      spec:
        required: true
        example:
          value:
            productType: physical
            productName: Vintage Cream and Red Roller Skates
            layout: bold-hero
            palette:
              background: '#f7f1e8'
              surface: '#ffffff'
              text: '#1f1a17'
              muted: '#6b625b'
              accent: '#b3262d'
              accentText: '#ffffff'
            fonts:
              heading: Playfair Display
              body: Inter
            eyebrow: One pair, restored
            headline: Classic quad skates crafted with walnut burl heels
            subheadline: A vintage pair of skates with cream leather, bold red trim and quad wheels.
            story: Each pair combines soft cream leather with distinct red accents and a sculpted walnut burl heel base.
            bullets:
            - Walnut burl heels
            - Restored vintage leather
            details:
            - label: Material
              value: Leather upper, walnut burl heel, rubber wheels
            faq:
            - q: Are these suitable for outdoor skating?
              a: Yes, on indoor rink floors and paved outdoor paths.
            ctaLabel: Buy the skates
            suggestedPriceUsd: 240
            suggestedShippingUsd: 15
            imageAlt: Cream leather quad roller skates with red trim
            heroPrompt: Cream roller skates on a sunlit boardwalk, in warm cream and red tones
        displayName: spec
        description: What Gemini designed. OneThing's templates render it; Gemini never writes HTML.
        type: DesignSpec
      created_at:
        required: false
        example:
          value: 2026-10-22T02:41:37Z
        displayName: created_at
        description: When the shop was made.
        type: datetime
  DesignSpec:
    example:
      value:
        productType: physical
        productName: Vintage Cream and Red Roller Skates
        layout: bold-hero
        palette:
          background: '#f7f1e8'
          surface: '#ffffff'
          text: '#1f1a17'
          muted: '#6b625b'
          accent: '#b3262d'
          accentText: '#ffffff'
        fonts:
          heading: Playfair Display
          body: Inter
        eyebrow: One pair, restored
        headline: Classic quad skates crafted with walnut burl heels
        subheadline: A vintage pair of skates with cream leather, bold red trim and quad wheels.
        story: Each pair combines soft cream leather with distinct red accents and a sculpted walnut burl heel base.
        bullets:
        - Walnut burl heels
        - Restored vintage leather
        details:
        - label: Material
          value: Leather upper, walnut burl heel, rubber wheels
        faq:
        - q: Are these suitable for outdoor skating?
          a: Yes, on indoor rink floors and paved outdoor paths.
        ctaLabel: Buy the skates
        suggestedPriceUsd: 240
        suggestedShippingUsd: 15
        imageAlt: Cream leather quad roller skates with red trim
        heroPrompt: Cream roller skates on a sunlit boardwalk, in warm cream and red tones
    displayName: DesignSpec
    description: What Gemini designed. OneThing's templates render it; Gemini never writes HTML.
    type: object
    properties:
      productType:
        required: true
        example:
          value: physical
        displayName: productType
        description: What the AI decided the product is.
        type: string
        enum:
        - digital
        - physical
      productName:
        required: true
        example:
          value: Vintage Cream and Red Roller Skates
        displayName: productName
        description: The product's name.
        type: string
      layout:
        required: true
        example:
          value: bold-hero
        displayName: layout
        description: 'The page template: `bold-hero` (image first, punchy), `editorial` (magazine), `minimal` (quiet, lots of space) or `playful`.'
        type: string
        enum:
        - bold-hero
        - editorial
        - minimal
        - playful
      palette:
        required: true
        example:
          value:
            background: '#f7f1e8'
            surface: '#ffffff'
            text: '#1f1a17'
            muted: '#6b625b'
            accent: '#b3262d'
            accentText: '#ffffff'
        displayName: palette
        description: The page colours, taken from the photo. Text colours are checked for contrast.
        type: Palette
      fonts:
        required: true
        example:
          value:
            heading: Playfair Display
            body: Inter
        displayName: fonts
        description: Google Fonts for the page.
        type: Fonts
      eyebrow:
        required: false
        example:
          value: One pair, restored
        displayName: eyebrow
        description: A short label above the headline.
        type: string
      headline:
        required: true
