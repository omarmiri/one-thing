        required: false
        example:
          value: '9400111899223197428490'
        displayName: number
        description: The tracking number.
        type: string
  Variant:
    example:
      value:
        choice:
          Size: M
          Color: Black
        availability: in_stock (3 left)
        order_url: https://one-thing-ash0.onrender.com/vintageskates/buy?Size=9
    displayName: Variant
    description: One combination of option values.
    type: object
    properties:
      choice:
        required: true
        example:
          value:
            Size: M
            Color: Black
        displayName: choice
        description: The buyer's pick, one value per option, keyed by option name.
        type: object
        additionalProperties: true
        properties:
          //:
            type: string
      availability:
        required: true
        example:
          value: in_stock (3 left)
        displayName: availability
        description: '`in_stock`, `in_stock (N left)` or `sold_out`.'
        type: string
      order_url:
        required: false
        example:
          value: https://one-thing-ash0.onrender.com/vintageskates/buy?Size=9
        displayName: order_url
        description: "`orderByLink` for this pick. Left out when it's sold out."
        type: string
/o/{orderId}:
  uriParameters:
    orderId:
      required: true
      example:
        value: pX4kR9tVb2nQ7sLe
      displayName: orderId
      description: The `order_id` from the MCP `create_order` tool.
      type: string
  get:
    displayName: openPayLink
    description: The `pay_url` an agent gives the buyer. It redirects to PayPal's payment page for the order, so PayPal's checkout token never passes through the agent (agent platforms hide such tokens as secrets). A paid order redirects to its thank-you page; an expired checkout goes back to the shop page.
    responses:
      '303':
        description: Redirect to PayPal, the thank-you page or the shop page.
        body: {}
      '404':
        description: No order with that id.
        body:
          text/plain:
            example:
              value: Order not found.
            displayName: response404
            description: A short message.
            type: string
/api:
  /shops:
    post:
      displayName: createShop
      description: >
        Starts a draft shop from one of three sources. Gemini designs the page and guesses the

        setup; check it with `getShop`, adjust with `updateShop`, then go live.


        Sent with a session cookie from `signIn`, the shop belongs to that account, which also

        becomes its seller email (and PayPal email, after Log in with PayPal) unless you give one.


        - `source=photo`: a `photo` and/or a `description` of your own product.

        - `source=link`: a `url`. If Channel3 recognises it as a store's product page, the shop
          becomes a recommendation (`product_type: referral`); otherwise the page is read and you
          sell the product yourself with PayPal.
        - `source=channel3`: a `productId` from `searchProducts` (a recommendation).


        Takes 15–40 seconds. Hero art, if available, is generated afterwards (`hero_status`).


        **Platforms:** sent with a platform API key, the shop belongs to the key's account, so the

        key can manage it from then on (no need to keep the admin token). It's made for one of the

        platform's sellers, so it inherits nothing from the account: set `paypal_email` or call

        `connectPayPal` for that seller.
      body:
        multipart/form-data:
          type: object
          properties:
            source:
              required: true
              examples:
                photo:
                  displayName: Your own product, described
                  value: photo
                link:
                  displayName: An app or game, sold with access codes
                  value: link
                channel3:
                  displayName: A recommendation from searchProducts
                  value: channel3
              displayName: source
              description: 'What the shop starts from: a photo (with an optional description), a product link, or a Channel3 product to recommend.'
              type: string
              enum:
              - photo
              - link
              - channel3
            photo:
              required: false
              displayName: photo
              description: '`source=photo`: the product photo, up to 8 MB.'
              type: file
            description:
              required: false
              example:
                value: Vintage cream and red quad roller skates with walnut burl heels.
              displayName: description
              description: '`source=photo`: a sentence or two about the product. Required if there is no photo.'
              type: string
            url:
              required: false
              example:
                value: https://one-thing-ash0.onrender.com/vintageskates
              displayName: url
              description: '`source=link`: a product page, or your own app or game page.'
              type: string
            productId:
              required: false
              example:
                value: ch3_7f2a9c1e
              displayName: productId
              description: '`source=channel3`: a product id from `searchProducts`.'
              type: string
            slug:
              required: false
              example:
                value: vintageskates
              displayName: slug
              description: The link name you want. If omitted, the AI suggests one.
              type: string
            type:
              required: false
              default: auto
              examples:
                photo:
                  displayName: Your own product, described
                  value: physical
                link:
                  displayName: An app or game, sold with access codes
                  value: digital
              displayName: type
              description: '`physical` ships, `digital` is a file or an access code, `auto` lets the AI decide.'
              type: string
              enum:
              - auto
              - physical
              - digital
            delivery:
              required: false
              examples:
                link:
                  displayName: An app or game, sold with access codes
                  value: access_code
              displayName: delivery
              description: For digital products. If omitted, the AI guesses.
              type: string
              enum:
              - file
              - access_code
            access_url:
              required: false
              example:
                value: https://www.miriogames.com/raptor-rush/
              displayName: access_url
              description: Where buyers use an access code.
              type: string
            price:
              required: false
              example:
                value: 240
              displayName: price
              description: USD. If omitted, the AI suggests a price.
              type: number
              format: double
            shipping:
              required: false
              example:
                value: 15
              displayName: shipping
              description: 'Physical products: shipping per order, in USD. If omitted, the AI suggests it.'
              type: number
              format: double
            stock:
              required: false
              example:
                value: 7
              displayName: stock
              description: How many are for sale. Leave out for unlimited.
              type: integer
              format: int32
            ship_countries:
              required: false
              examples:
                photo:
                  displayName: Your own product, described
                  value: US
              displayName: ship_countries
              description: 'Physical products: comma-separated ISO country codes to ship to. Empty means anywhere PayPal ships.'
              type: string
            paypal_email:
              required: false
              example:
                value: seller@example.com
              displayName: paypal_email
              description: The PayPal account that gets paid, if the seller doesn't connect one with `connectPayPal`.
              type: string
            seller_email:
              required: false
              example:
                value: seller@example.com
              displayName: seller_email
              description: Where order notifications go.
              type: string
            digital_file:
              required: false
              displayName: digital_file
              description: 'Digital products sold as a file: the file buyers download, up to 25 MB. Can also be added later with `uploadDigitalFile`.'
              type: file
      securedBy:
      - null
      - PlatformKey
      responses:
        '200':
          description: Draft created.
          body:
            application/json:
              example:
                value:
                  slug: vintageskates
                  token: 3fJ9xQm2LwP8vR1tZk7cN4bY6dHs0aEu
                  manageUrl: /manage/vintageskates?token=3fJ9xQm2LwP8vR1tZk7cN4bY6dHs0aEu
              displayName: response200
              description: The new draft shop and the credentials to manage it.
              type: CreatedShop
        '400':
          description: Something in the request needs fixing; `error` says what.
          body:
            application/json:
              example:
                value:
                  error: Choose a photo.
              displayName: response400
              description: An error reply.
              type: ErrorResponse
        '409':
          description: Taken or unavailable (a link name, or a sold-out product).
          body:
            application/json:
              example:
                value:
                  error: Sold out.
              displayName: response409
              description: An error reply.
              type: ErrorResponse
        '429':
          description: Over this network's cap for the call (see **Limits**). Retry after `Retry-After` seconds.
          headers:
            Retry-After:
              example:
                value: 420
              displayName: Retry-After
              description: Seconds until the window resets.
              type: integer
              format: int32
          body:
            application/json:
              example:
                value:
                  error: Too many checkouts from your network. Try again in 7 min.
              displayName: response429
              description: An error reply.
              type: ErrorResponse
        '502':
          description: Gemini, PayPal or Channel3 failed or isn't configured.
          body:
            application/json:
              example:
                value:
                  error: PayPal isn't configured on this server.
              displayName: response502
              description: An error reply.
              type: ErrorResponse
    /{slug}:
      uriParameters:
        slug:
          required: true
          example:
            value: vintageskates
          displayName: slug
          description: The shop's link name (current or former).
          type: string
      get:
        displayName: getShop
        description: Everything about the shop, including the AI's design spec and guesses.
        securedBy:
        - AdminToken
        - PlatformKey
        responses:
          '200':
            description: The shop.
            body:
              application/json:
                example:
                  value:
                    id: Hn2c8QvL0xTzR4pW
                    slug: vintageskates
                    status: live
                    product_type: physical
                    price_cents: 24000
                    currency: USD
                    shipping_cents: 1500
                    ship_countries: US
                    stock: null
                    delivery: file
                    access_url: null
                    paypal_email: seller@example.com
                    seller_email: seller@example.com
                    paypal_merchant_id: 7MZJ4QXN8K2LA
                    paypal_status:
                      receivable: true
                      emailConfirmed: true
                      checkedAt: 2026-10-21T18:04:11Z
                    zapier_hook_url: null
                    in_gallery: true
                    account_id: Vq3nN8cT0bLx2YwE
                    options:
                    - name: Size
                      kind: size
                      values:
                      - label: '7'
                      - label: '8'
                      - label: '9'
                    option_stock:
                      '7': 3
                      '8': 0
                      '9': 6
                    suggestions: null
                    photo_blob: 'LFRvGuTU3D8i334X'
                    gallery_blobs:
                    - zrySajNyao6_j11x
                    - SuqcgNv64HWN8H6e
                    hero_blob: null
                    hero_status: none
                    hero_error: null
                    ai_source: gemini
                    source_url: null
                    referral: null
                    spec:
                      productType: physical
                      productName: Vintage Cream and Red Roller Skates
                      layout: editorial
                      palette:
                        background: '#f6efe4'
                        surface: '#fffaf2'
                        text: '#2b1d14'
                        muted: '#7a6455'
                        accent: '#b3261e'
                        accentText: '#ffffff'
                      fonts:
                        heading: Playfair Display
                        body: Inter
                      eyebrow: One pair, restored
                      headline: Classic quad skates crafted with walnut burl heels
                      subheadline: A vintage pair of skates featuring cream leather, bold red trim, and durable quad wheels.
                      story: Each pair combines soft cream leather with distinct red accents and a sculpted walnut burl heel base.
                      bullets:
                      - Handmade cream leather upper with rich red trim
                      - Sculpted walnut burl heel structure for stability
                      details:
                      - label: Materials
                        value: Leather upper, walnut burl heel, rubber wheels
                      faq:
                      - q: Are these suitable for outdoor skating?
                        a: Yes, on indoor rink floors and paved outdoor paths.
                      ctaLabel: Buy the skates
                      suggestedPriceUsd: 240
                      suggestedShippingUsd: 15
                      imageAlt: Cream leather quad roller skates with red trim
                    created_at: 2026-10-19T15:22:08Z
                displayName: response200
                description: A shop, as its seller sees it.
                type: Shop
          '404':
            description: No such shop, or the admin token or API key doesn't match it.
            body:
              application/json:
                example:
                  value:
                    error: Shop not found.
                displayName: response404
                description: An error reply.
                type: ErrorResponse
      patch:
        displayName: updateShop
        description: >
          Changes only the fields you send. Renaming `slug` keeps the old link working (it

          redirects). Set `status: live` to publish; a digital product needs its file (or, for

          access codes, `access_url`) first.
        body:
          application/json:
            examples:
              golive:
                displayName: Go live
                value:
                  status: live
              edit:
                displayName: Fix the AI's guesses
                value:
                  price: 240
                  shipping: 15
                  ship_countries: US,CA
                  in_gallery: true
              sizes:
                displayName: Sizes with stock per size
                value:
                  options:
                  - name: Size
                    kind: size
                    values:
                    - label: '7'
                    - label: '8'
                    - label: '9'
                  option_stock:
                    '7': 3
                    '8': 0
                    '9': 6
              facts:
                displayName: Answer what buyers will ask
                value:
                  facts:
                  - label: Wheel size
                    value: 57 mm
            displayName: body
            description: The fields to change; anything left out stays as it is.
            type: ShopUpdate
        securedBy:
        - AdminToken
        - PlatformKey
        headers:
          Content-Type:
            required: true
            displayName: Content-Type
            type: string
            enum:
            - application/json
        responses:
          '200':
            description: Saved.
            body:
              application/json:
                example:
                  value:
                    ok: true
                    slug: vintageskates
                displayName: response200
                description: The shop was saved.
                type: ApiShopsResponse
          '400':
            description: Something in the request needs fixing; `error` says what.
            body:
              application/json:
                example:
                  value:
                    error: Choose a photo.
                displayName: response400
                description: An error reply.
                type: ErrorResponse
          '404':
            description: No such shop, or the admin token or API key doesn't match it.
            body:
              application/json:
                example:
                  value:
                    error: Shop not found.
                displayName: response404
                description: An error reply.
                type: ErrorResponse
      /refine:
        post:
          displayName: refineShopDesign
          description: '"Make it warmer", "shorter copy", "more premium". Gemini edits the design spec.'
          body:
            application/json:
              example:
                value:
                  instruction: Make it feel more premium
              displayName: body
              description: The design change, in words.
              type: ApiShopsRefineRequest
          securedBy:
          - AdminToken
          - PlatformKey
          headers:
            Content-Type:
              required: true
              displayName: Content-Type
              type: string
              enum:
              - application/json
          responses:
            '200':
              description: The new design.
              body:
                application/json:
                  example:
                    value:
                      spec:
                        productType: physical
                        productName: Vintage Cream and Red Roller Skates
                        layout: editorial
                        palette:
                          background: '#f6efe4'
                          surface: '#fffaf2'
                          text: '#2b1d14'
                          muted: '#7a6455'
                          accent: '#b3261e'
                          accentText: '#ffffff'
                        fonts:
                          heading: Playfair Display
                          body: Inter
                        eyebrow: One pair, restored
                        headline: Classic quad skates crafted with walnut burl heels
                        subheadline: A vintage pair of skates featuring cream leather, bold red trim, and durable quad wheels.
                        story: Each pair combines soft cream leather with distinct red accents and a sculpted walnut burl heel base.
                        bullets:
                        - Handmade cream leather upper with rich red trim
                        - Sculpted walnut burl heel structure for stability
                        details:
                        - label: Materials
                          value: Leather upper, walnut burl heel, rubber wheels
                        faq:
                        - q: Are these suitable for outdoor skating?
                          a: Yes, on indoor rink floors and paved outdoor paths.
                        ctaLabel: Buy the skates
                        suggestedPriceUsd: 240
                        suggestedShippingUsd: 15
                        imageAlt: Cream leather quad roller skates with red trim
                  displayName: response200
                  description: The redesigned page.
                  type: ApiShopsRefineResponse
            '400':
              description: Something in the request needs fixing; `error` says what.
              body:
                application/json:
                  example:
                    value:
                      error: Choose a photo.
                  displayName: response400
                  description: An error reply.
                  type: ErrorResponse
            '404':
              description: No such shop, or the admin token or API key doesn't match it.
              body:
                application/json:
                  example:
                    value:
                      error: Shop not found.
                  displayName: response404
                  description: An error reply.
                  type: ErrorResponse
            '429':
              description: Over this network's cap for the call (see **Limits**). Retry after `Retry-After` seconds.
              headers:
                Retry-After:
                  example:
                    value: 420
                  displayName: Retry-After
                  description: Seconds until the window resets.
                  type: integer
                  format: int32
              body:
                application/json:
                  example:
                    value:
                      error: Too many checkouts from your network. Try again in 7 min.
                  displayName: response429
                  description: An error reply.
                  type: ErrorResponse
            '502':
              description: Gemini, PayPal or Channel3 failed or isn't configured.
              body:
                application/json:
                  example:
                    value:
                      error: PayPal isn't configured on this server.
                  displayName: response502
                  description: An error reply.
                  type: ErrorResponse
      /hero:
        post:
          displayName: regenerateHeroArt
          description: Starts generation in the background. Poll `getShop` for `hero_status`.
          securedBy:
          - AdminToken
          - PlatformKey
          responses:
            '200':
              description: Done.
              body:
                application/json:
                  example:
                    value:
                      ok: true
                  displayName: response200
                  description: Confirms the change.
                  type: Ok
            '400':
              description: Something in the request needs fixing; `error` says what.
              body:
                application/json:
                  example:
                    value:
                      error: Choose a photo.
                  displayName: response400
                  description: An error reply.
                  type: ErrorResponse
            '404':
              description: No such shop, or the admin token or API key doesn't match it.
              body:
                application/json:
                  example:
                    value:
                      error: Shop not found.
                  displayName: response404
                  description: An error reply.
                  type: ErrorResponse
            '429':
              description: Over this network's cap for the call (see **Limits**). Retry after `Retry-After` seconds.
              headers:
                Retry-After:
                  example:
                    value: 420
                  displayName: Retry-After
                  description: Seconds until the window resets.
                  type: integer
                  format: int32
              body:
                application/json:
                  example:
                    value:
                      error: Too many checkouts from your network. Try again in 7 min.
                  displayName: response429
                  description: An error reply.
                  type: ErrorResponse
      /file:
        post:
          displayName: uploadDigitalFile
          description: Uploads or replaces a digital product's file, up to 25 MB. Each paid order gets a download link for it.
          body:
            multipart/form-data:
              type: object
              properties:
                file:
                  required: true
                  displayName: file
                  description: Up to 25 MB.
                  type: file
          securedBy:
          - AdminToken
          - PlatformKey
          responses:
            '200':
              description: Uploaded.
              body:
                application/json:
                  example:
                    value:
                      ok: true
                      filename: raptor-rush-soundtrack.zip
                  displayName: response200
                  description: The uploaded file.
                  type: ApiShopsFileResponse
            '400':
              description: Something in the request needs fixing; `error` says what.
              body:
                application/json:
                  example:
                    value:
                      error: Choose a photo.
                  displayName: response400
                  description: An error reply.
                  type: ErrorResponse
            '404':
              description: No such shop, or the admin token or API key doesn't match it.
              body:
                application/json:
                  example:
                    value:
                      error: Shop not found.
                  displayName: response404
                  description: An error reply.
                  type: ErrorResponse
      /photos:
        post:
          displayName: addPhotos
          description: Adds one or more photos after the cover. Each is turned upright, resized to at most 2000 px and stored as WebP. A shop holds up to 8 photos; buyers swipe through them on the shop page. Not for recommendations, which show the retailer's photos.
          body:
            multipart/form-data:
              type: object
              properties:
                photo:
                  required: true
                  displayName: photo
                  description: An image, up to 15 MB. The endpoint also accepts the field repeated, to add several in one request.
                  type: file
          securedBy:
          - AdminToken
          - PlatformKey
          responses:
            '200':
              description: The shop's photos, cover first.
              body:
                application/json:
                  example:
                    value:
                      photos:
                      - id: 'LFRvGuTU3D8i334X'
                        url: '/api/blobs/LFRvGuTU3D8i334X'
                      - id: zrySajNyao6_j11x
                        url: /api/blobs/zrySajNyao6_j11x
                  displayName: response200
                  description: The shop's photos.
                  type: ShopPhotos
            '400':
              description: Something in the request needs fixing; `error` says what.
              body:
                application/json:
                  example:
                    value:
                      error: Choose a photo.
                  displayName: response400
                  description: An error reply.
                  type: ErrorResponse
            '404':
              description: No such shop, or the admin token or API key doesn't match it.
              body:
                application/json:
                  example:
                    value:
                      error: Shop not found.
                  displayName: response404
                  description: An error reply.
                  type: ErrorResponse
        put:
          displayName: setPhotoOrder
          description: Sets the photo order; the first becomes the cover. Leaving a photo out removes it.
          body:
            application/json:
              example:
                value:
                  photos:
                  - zrySajNyao6_j11x
                  - 'LFRvGuTU3D8i334X'
                  - SuqcgNv64HWN8H6e
              displayName: body
              description: Every photo id, in the new order.
              type: ApiShopsPhotosRequest
          securedBy:
          - AdminToken
          - PlatformKey
          headers:
            Content-Type:
              required: true
              displayName: Content-Type
              type: string
              enum:
              - application/json
          responses:
            '200':
              description: The shop's photos, cover first.
              body:
                application/json:
                  example:
                    value:
                      photos:
                      - id: 'LFRvGuTU3D8i334X'
                        url: '/api/blobs/LFRvGuTU3D8i334X'
                      - id: zrySajNyao6_j11x
                        url: /api/blobs/zrySajNyao6_j11x
                  displayName: response200
                  description: The shop's photos.
                  type: ShopPhotos
            '400':
              description: Something in the request needs fixing; `error` says what.
              body:
                application/json:
                  example:
                    value:
                      error: Choose a photo.
                  displayName: response400
                  description: An error reply.
                  type: ErrorResponse
            '404':
              description: No such shop, or the admin token or API key doesn't match it.
              body:
                application/json:
                  example:
                    value:
                      error: Shop not found.
                  displayName: response404
                  description: An error reply.
                  type: ErrorResponse
      /suggest:
        post:
          displayName: checkMissingDetails
          description: >
            Asks Gemini what buyers will want to choose (sizes, colours) and what they'll ask that the

            listing doesn't say (dimensions, materials). `createShop` already does this once; call it

            again after editing the product. The result is saved as the shop's `suggestions`.


            Nothing changes on the shop page until the seller confirms: save options with `updateShop`

            (`options`), and answer the questions with `updateShop` (`facts`). Not for recommendations.
          securedBy:
          - AdminToken
          - PlatformKey
          responses:
            '200':
              description: The suggestions.
              body:
                application/json:
                  example:
                    value:
                      oneOfAKind: false
                      options:
                      - name: Size
                        kind: size
                        values:
                        - label: '7'
                        - label: '8'
                        - label: '9'
                        fromSeller: false
                      missingFacts:
                      - label: Wheel size
                        question: How big are the wheels?
                        placeholder: 57 mm
                  displayName: response200
                  description: What Gemini thinks buyers will want to choose or ask. The seller confirms; nothing is applied on its own.
                  type: Suggestions
            '400':
              description: Something in the request needs fixing; `error` says what.
              body:
                application/json:
                  example:
                    value:
                      error: Choose a photo.
                  displayName: response400
                  description: An error reply.
                  type: ErrorResponse
            '404':
              description: No such shop, or the admin token or API key doesn't match it.
              body:
                application/json:
                  example:
                    value:
                      error: Shop not found.
                  displayName: response404
                  description: An error reply.
                  type: ErrorResponse
            '429':
              description: Over this network's cap for the call (see **Limits**). Retry after `Retry-After` seconds.
              headers:
                Retry-After:
                  example:
                    value: 420
                  displayName: Retry-After
                  description: Seconds until the window resets.
                  type: integer
                  format: int32
              body:
                application/json:
                  example:
                    value:
                      error: Too many checkouts from your network. Try again in 7 min.
                  displayName: response429
                  description: An error reply.
                  type: ErrorResponse
            '502':
              description: Gemini, PayPal or Channel3 failed or isn't configured.
              body:
                application/json:
                  example:
                    value:
                      error: PayPal isn't configured on this server.
                  displayName: response502
                  description: An error reply.
                  type: ErrorResponse
      /match-photos:
        post:
          displayName: matchColorPhotos
          description: Gemini looks at the shop's photos and says which one shows each colour, so buyers who pick a colour see it. Suggests only; save the matches with `setColorPhotos`. Needs at least two photos.
          body:
            application/json:
              example:
                value:
                  colors:
                  - label: Cream
                    hex: '#f3e9d2'
                  - label: Red
                    hex: '#b3261e'
              displayName: body
              description: The colour option's values.
              type: ApiShopsMatchPhotosRequest
          securedBy:
          - AdminToken
          - PlatformKey
          headers:
            Content-Type:
              required: true
              displayName: Content-Type
              type: string
              enum:
              - application/json
          responses:
            '200':
              description: A photo id for each colour Gemini could match. Colours it couldn't place are left out.
              body:
                application/json:
                  example:
                    value:
                      matches:
                        Cream: 'LFRvGuTU3D8i334X'
                        Red: SuqcgNv64HWN8H6e
                  displayName: response200
                  description: Gemini's matches.
                  type: ApiShopsMatchPhotosResponse
            '400':
              description: Something in the request needs fixing; `error` says what.
              body:
                application/json:
                  example:
                    value:
                      error: Choose a photo.
                  displayName: response400
                  description: An error reply.
                  type: ErrorResponse
            '404':
              description: No such shop, or the admin token or API key doesn't match it.
              body:
                application/json:
                  example:
                    value:
                      error: Shop not found.
                  displayName: response404
                  description: An error reply.
                  type: ErrorResponse
            '429':
              description: Over this network's cap for the call (see **Limits**). Retry after `Retry-After` seconds.
              headers:
                Retry-After:
                  example:
                    value: 420
                  displayName: Retry-After
                  description: Seconds until the window resets.
                  type: integer
                  format: int32
              body:
                application/json:
                  example:
                    value:
                      error: Too many checkouts from your network. Try again in 7 min.
                  displayName: response429
                  description: An error reply.
                  type: ErrorResponse
            '502':
              description: Gemini, PayPal or Channel3 failed or isn't configured.
              body:
                application/json:
                  example:
                    value:
                      error: PayPal isn't configured on this server.
                  displayName: response502
                  description: An error reply.
                  type: ErrorResponse
      /color-photos:
        put:
          displayName: setColorPhotos
          description: Saves which photo shows each colour, and nothing else about the shop. Only colours already saved in the shop's options change; `null` clears a colour's photo. A photo id that isn't one of the shop's photos is ignored.
          body:
            application/json:
              example:
                value:
                  photos:
                    Cream: 'LFRvGuTU3D8i334X'
                    Red: null
              displayName: body
              description: The photo for each colour.
              type: ApiShopsColorPhotosRequest
          securedBy:
          - AdminToken
          - PlatformKey
          headers:
            Content-Type:
              required: true
              displayName: Content-Type
              type: string
              enum:
              - application/json
          responses:
            '200':
              description: The colours that were changed.
              body:
                application/json:
                  example:
                    value:
                      saved:
                      - Cream
                      - Red
                  displayName: response200
                  description: The colours that changed.
                  type: ApiShopsColorPhotosResponse
            '400':
              description: Something in the request needs fixing; `error` says what.
              body:
                application/json:
                  example:
                    value:
                      error: Choose a photo.
                  displayName: response400
                  description: An error reply.
                  type: ErrorResponse
            '404':
              description: No such shop, or the admin token or API key doesn't match it.
              body:
                application/json:
                  example:
                    value:
                      error: Shop not found.
                  displayName: response404
                  description: An error reply.
                  type: ErrorResponse
      /paypal:
        post:
          displayName: connectPayPal
          description: >
            Starts PayPal's seller onboarding (Partner Referrals). Send the seller's browser to the

            returned `url`; they sign in to PayPal (or create a business account) and grant OneThing

            permission. PayPal brings them back to `/api/shops/<slug>/paypal/return`, which saves the

            connection and opens the manage page. From then on, sales are paid to that account.


            Without a connection, a shop can still go live with a typed `paypal_email`.


            **Platforms:** call it with your API key and a `returnUrl`, and PayPal's flow ends on your own

            page instead, as `returnUrl?paypal=connected|incomplete|cancelled|failed&shop=<slug>`. The

            URL's origin must be one registered on the key.
          body:
            application/json:
              example:
                value:
                  returnUrl: https://www.miriogames.com/market/manage/?g=7Hq2
              displayName: body
              description: 'Platform keys only: where PayPal sends the seller back.'
              type: ApiShopsPaypalRequest
          securedBy:
          - AdminToken
          - PlatformKey
          headers:
            Content-Type:
              required: true
              displayName: Content-Type
              type: string
              enum:
              - application/json
          responses:
            '200':
              description: Where to send the seller.
              body:
                application/json:
                  example:
                    value:
                      url: https://www.sandbox.paypal.com/bizsignup/partner/entry?referralToken=EXAMPLE
                  displayName: response200
                  description: The onboarding link.
                  type: ApiShopsPaypalResponse
            '404':
              description: No such shop, or the admin token or API key doesn't match it.
              body:
                application/json:
                  example:
                    value:
                      error: Shop not found.
                  displayName: response404
                  description: An error reply.
                  type: ErrorResponse
            '502':
              description: Gemini, PayPal or Channel3 failed or isn't configured.
              body:
                application/json:
                  example:
                    value:
                      error: PayPal isn't configured on this server.
                  displayName: response502
                  description: An error reply.
                  type: ErrorResponse
            '503':
              description: Gemini, PayPal or Channel3 failed or isn't configured.
              body:
                application/json:
                  example:
                    value:
                      error: PayPal isn't configured on this server.
                  displayName: response503
                  description: An error reply.
                  type: ErrorResponse
        get:
          displayName: getPayPalConnection
          description: Asks PayPal where the seller's connection stands and saves it on the shop. Also finds a connection the seller finished at PayPal without coming back.
          securedBy:
          - AdminToken
          - PlatformKey
          responses:
            '200':
              description: The connection, or nulls if there is none yet.
              body:
                application/json:
                  example:
                    value:
                      merchantId: 7MZJ4QXN8K2LA
                      status:
                        receivable: true
                        emailConfirmed: true
                        checkedAt: 2026-10-21T18:04:11Z
                  displayName: response200
                  description: The shop's PayPal connection.
                  type: ApiShopsPaypalResponse1
            '404':
              description: No such shop, or the admin token or API key doesn't match it.
              body:
                application/json:
                  example:
                    value:
                      error: Shop not found.
                  displayName: response404
                  description: An error reply.
                  type: ErrorResponse
            '502':
              description: Gemini, PayPal or Channel3 failed or isn't configured.
              body:
                application/json:
                  example:
                    value:
                      error: PayPal isn't configured on this server.
                  displayName: response502
                  description: An error reply.
                  type: ErrorResponse
            '503':
              description: Gemini, PayPal or Channel3 failed or isn't configured.
              body:
                application/json:
                  example:
                    value:
                      error: PayPal isn't configured on this server.
                  displayName: response503
                  description: An error reply.
                  type: ErrorResponse
        delete:
          displayName: disconnectPayPal
          description: Forgets the connected account. Sales go back to the shop's `paypal_email`.
          securedBy:
          - AdminToken
          - PlatformKey
          responses:
            '200':
              description: Done.
              body:
                application/json:
                  example:
                    value:
                      ok: true
                  displayName: response200
                  description: Confirms the change.
                  type: Ok
            '404':
              description: No such shop, or the admin token or API key doesn't match it.
              body:
                application/json:
                  example:
                    value:
                      error: Shop not found.
                  displayName: response404
                  description: An error reply.
                  type: ErrorResponse
      /orders:
        get:
          displayName: listOrders
          description: Newest first. Checkouts that were never approved are left out.
          securedBy:
          - AdminToken
          - PlatformKey
          responses:
            '200':
              description: Orders.
              body:
                application/json:
                  example:
                    value:
                    - id: pX4kR9tVb2nQ7sLe
                      paypal_order_id: 5O190127TN364715T
                      status: paid
                      amount_cents: 25500
                      shipping_cents: 1500
                      currency: USD
                      buyer_email: buyer@example.com
                      buyer_name: Sam Rivera
                      shipping_address:
                        address_line_1: 1 Main St
                        admin_area_2: Springfield
                        admin_area_1: IL
                        postal_code: '62701'
                        country_code: US
                      capture_id: 3C679366HH908993F
                      fulfillment_status: to_ship
                      carrier: null
                      tracking_number: null
                      tracking_synced: false
                      downloads: 0
                      access_code: null
                      code_uses: 0
                      channel: agent
                      options:
                        Size: '8'
                      paid_at: 2026-10-22T02:41:37Z
                      created_at: 2026-10-22T02:38:05Z
                  displayName: response200
                  description: Orders, newest first.
                  type: array
                  items:
                    type: Order
            '404':
              description: No such shop, or the admin token or API key doesn't match it.
              body:
                application/json:
                  example:
                    value:
                      error: Shop not found.
                  displayName: response404
                  description: An error reply.
                  type: ErrorResponse
        /{orderId}:
          uriParameters:
            orderId:
              required: true
              example:
                value: pX4kR9tVb2nQ7sLe
              displayName: orderId
              description: OneThing's order id (`Order.id`).
              type: string
          /ship:
            post:
              displayName: markOrderShipped
              description: Saves the tracking number and pushes it to PayPal, so the buyer sees it in PayPal.
              body:
                application/json:
                  examples:
                    usps:
                      displayName: A listed carrier
                      value:
                        carrier: USPS
                        trackingNumber: '9400111899223817362315'
                    other:
                      displayName: Another carrier
                      value:
                        carrier: OTHER
                        carrierName: Canada Post
                        trackingNumber: '7023210039414604'
                  displayName: body
                  description: The carrier and tracking number.
                  type: ApiShopsOrdersShipRequest
              securedBy:
              - AdminToken
              - PlatformKey
              headers:
                Content-Type:
                  required: true
                  displayName: Content-Type
                  type: string
                  enum:
                  - application/json
              responses:
                '200':
                  description: Shipped.
                  body:
                    application/json:
                      example:
                        value:
                          ok: true
                          synced: true
                      displayName: response200
                      description: The order is marked shipped.
                      type: ApiShopsOrdersShipResponse
                '400':
                  description: Something in the request needs fixing; `error` says what.
                  body:
                    application/json:
                      example:
                        value:
                          error: Choose a photo.
                      displayName: response400
                      description: An error reply.
                      type: ErrorResponse
                '404':
                  description: No such shop, or the admin token or API key doesn't match it.
                  body:
                    application/json:
                      example:
                        value:
                          error: Shop not found.
                      displayName: response404
                      description: An error reply.
                      type: ErrorResponse
          /refund:
            post:
              displayName: refundOrder
              description: "Refunds the whole payment through PayPal and marks the order `refunded`. When PayPal only lets the paid account refund it (the money went to a PayPal email the seller typed in, not a connected account), the reply is a 409 with `refundInPayPal: true`. Refund it in your PayPal account, then call this again with `{\"record\": true}`, which only marks it refunded here. Sends the `order.refunded` event to the shop's Zapier hook."
              body:
                application/json:
                  examples:
                    refund:
                      displayName: Refund through PayPal
                      value: {}
                    record:
                      displayName: Already refunded in PayPal
                      value:
                        record: true
                  displayName: body
                  description: 'Optional. `record: true` records a refund made in PayPal.'
                  type: ApiShopsOrdersRefundRequest
              securedBy:
              - AdminToken
              - PlatformKey
              headers:
                Content-Type:
                  required: true
                  displayName: Content-Type
                  type: string
                  enum:
                  - application/json
              responses:
                '200':
                  description: Refunded.
                  body:
                    application/json:
                      example:
                        value:
                          ok: true
                          refundId: 1JU08902781691411
                      displayName: response200
                      description: The refund.
                      type: ApiShopsOrdersRefundResponse
                '404':
                  description: No such shop or order, or the token doesn't match the shop.
                  body:
                    application/json:
                      example:
                        value:
                          error: Order not found.
                      displayName: response404
                      description: An error reply.
                      type: ErrorResponse
                '409':
                  description: Not refundable here; `error` says why.
                  body:
                    application/json:
                      examples:
                        notPaid:
                          displayName: Not a paid order
                          value:
                            error: Only paid orders can be refunded.
                        payee:
                          displayName: Paid to a typed-in PayPal email
                          value:
                            error: PayPal only lets the account that was paid refund this. Refund it in your PayPal account (Activity, then this payment, then Refund), then mark it refunded here.
                            refundInPayPal: true
                      displayName: response409
                      description: Why the order can't be refunded here.
                      type: ApiShopsOrdersRefund409Error1
      /webhooks:
        get:
          displayName: listWebhookEvents
          description: The last 50 PayPal webhook deliveries about this shop's orders, with signature results.
          securedBy:
          - AdminToken
          - PlatformKey
          responses:
            '200':
              description: Events, newest first.
              body:
                application/json:
                  example:
                    value:
                    - id: WH-2WR32451HC0233532-67976317FL4543714
                      event_type: PAYMENT.CAPTURE.COMPLETED
                      paypal_order_id: 5O190127TN364715T
                      summary: 255.00 USD
                      verified: true
                      outcome: 'Confirmed: order already paid'
                      received_at: 2026-10-22T02:41:40Z
                  displayName: response200
                  description: PayPal webhook deliveries, newest first.
                  type: array
                  items:
                    type: WebhookEvent
            '404':
              description: No such shop, or the admin token or API key doesn't match it.
              body:
                application/json:
                  example:
                    value:
                      error: Shop not found.
                  displayName: response404
                  description: An error reply.
                  type: ErrorResponse
  /slugs/check:
    get:
      displayName: checkLinkName
      description: Normalises a proposed link name and says whether a new shop can use it.
      queryParameters:
        name:
          required: true
          example:
            value: Raptor Rush
          displayName: name
          description: Anything; it is normalised (`Raptor Rush` becomes `raptor-rush`).
          type: string
      responses:
        '200':
          description: The normalised name and whether it can be used.
          body:
            application/json:
              examples:
                free:
                  displayName: Available
                  value:
                    slug: raptor-rush
                    available: true
                taken:
                  displayName: Taken
                  value:
                    slug: raptorrush
                    available: false
                    problem: Taken. Try another name.
              displayName: response200
              description: Whether the link name can be used.
              type: ApiSlugsCheckResponse
  /channel3/search:
    get:
      displayName: searchProducts
      description: Searches 100M+ products from 25k+ stores through Channel3. Pass a result's `id` to `createShop` with `source=channel3`.
      queryParameters:
        q:
          required: true
          example:
            value: trail running vest
          displayName: q
          description: What to look for, in plain words.
          type: string
          maxLength: 200
      responses:
        '200':
          description: Up to 12 products.
          body:
            application/json:
              example:
                value:
                  products:
                  - id: ch3_7f2a9c1e
                    title: Trail Running Vest 5L
                    brand: Salomon
                    image: https://images.example.com/vest.jpg
                    price: 59.99
                    currency: USD
                    retailer: rei.com
                    retailers: 4
                    commission: 0.08
              displayName: response200
              description: The products found.
              type: ApiChannel3SearchResponse
        '502':
          description: Gemini, PayPal or Channel3 failed or isn't configured.
          body:
            application/json:
              example:
                value:
                  error: PayPal isn't configured on this server.
              displayName: response502
              description: An error reply.
              type: ErrorResponse
        '503':
          description: Gemini, PayPal or Channel3 failed or isn't configured.
          body:
            application/json:
              example:
                value:
                  error: PayPal isn't configured on this server.
              displayName: response503
              description: An error reply.
              type: ErrorResponse
  /paypal/client-token:
    get:
      displayName: getPayPalClientToken
      description: >
        A browser-safe client token for the PayPal JavaScript SDK v6

        (`paypal.createInstance({ clientToken })`), bound to the requesting site's domain.

        Shop pages call this before showing the PayPal button.
      responses:
        '200':
          description: A token for this site's domain.
          body:
            application/json:
              example:
                value:
                  clientToken: eyJraWQiOiJFWEFNUExFIn0.example.client-token
              displayName: response200
              description: The client token.
              type: ApiPaypalClientTokenResponse
        '502':
          description: Gemini, PayPal or Channel3 failed or isn't configured.
          body:
            application/json:
              example:
                value:
                  error: PayPal isn't configured on this server.
              displayName: response502
              description: An error reply.
              type: ErrorResponse
        '503':
          description: Gemini, PayPal or Channel3 failed or isn't configured.
          body:
            application/json:
              example:
                value:
                  error: PayPal isn't configured on this server.
              displayName: response503
              description: An error reply.
              type: ErrorResponse
  /orders:
    post:
      displayName: createCheckoutOrder
      description: >
        Creates the PayPal order for one unit of a live shop's product. The amount always comes

        from the shop, never from the caller. Pass the returned `id` to the PayPal JS SDK.


        If the shop has buyer `options`, send one value for each. A sold-out combination answers 409.
      body:
        application/json:
          examples:
            plain:
              displayName: A product without options
              value:
                slug: raptorrush
            options:
              displayName: With the buyer's size
              value:
                slug: vintageskates
                options:
                  Size: '9'
          displayName: body
          description: The shop and the buyer's pick.
          type: ApiOrdersRequest
      headers:
        Content-Type:
          required: true
          displayName: Content-Type
          type: string
          enum:
          - application/json
      responses:
        '200':
          description: PayPal order created.
          body:
            application/json:
              example:
                value:
                  id: 5O190127TN364715T
              displayName: response200
              description: The PayPal order to approve.
              type: ApiOrdersResponse
        '400':
          description: Something in the request needs fixing; `error` says what.
          body:
            application/json:
              example:
                value:
                  error: Choose a photo.
              displayName: response400
              description: An error reply.
              type: ErrorResponse
        '404':
          description: No such shop, or the admin token or API key doesn't match it.
          body:
            application/json:
              example:
                value:
                  error: Shop not found.
              displayName: response404
              description: An error reply.
              type: ErrorResponse
        '409':
          description: Taken or unavailable (a link name, or a sold-out product).
          body:
            application/json:
              example:
                value:
                  error: Sold out.
              displayName: response409
              description: An error reply.
              type: ErrorResponse
        '429':
          description: Over this network's cap for the call (see **Limits**). Retry after `Retry-After` seconds.
          headers:
            Retry-After:
              example:
                value: 420
              displayName: Retry-After
              description: Seconds until the window resets.
              type: integer
              format: int32
          body:
            application/json:
              example:
                value:
                  error: Too many checkouts from your network. Try again in 7 min.
              displayName: response429
              description: An error reply.
              type: ErrorResponse
        '502':
          description: Gemini, PayPal or Channel3 failed or isn't configured.
          body:
            application/json:
              example:
                value:
                  error: PayPal isn't configured on this server.
              displayName: response502
              description: An error reply.
              type: ErrorResponse
        '503':
          description: Gemini, PayPal or Channel3 failed or isn't configured.
          body:
            application/json:
              example:
                value:
                  error: PayPal isn't configured on this server.
              displayName: response503
              description: An error reply.
              type: ErrorResponse
    /{paypalOrderId}/capture:
      uriParameters:
        paypalOrderId:
          required: true
          example:
            value: 5O190127TN364715T
          displayName: paypalOrderId
          description: The PayPal order id that `createCheckoutOrder` returned.
          type: string
      post:
        displayName: captureCheckoutOrder
        description: >
          Call after the buyer approves. Records the sale; digital orders get a download link or access code.

          Safe to call repeatedly: before approval it answers 409, so a page can poll it while the PayPal window is open.
        responses:
          '200':
            description: Paid.
            body:
              application/json:
                example:
                  value:
                    orderId: pX4kR9tVb2nQ7sLe
                    status: paid
                displayName: response200
                description: The paid order.
                type: ApiOrdersCaptureResponse
          '402':
            description: Something in the request needs fixing; `error` says what.
            body:
              application/json:
                example:
                  value:
                    error: Choose a photo.
                displayName: response402
                description: An error reply.
                type: ErrorResponse
          '404':
            description: No such shop, or the admin token or API key doesn't match it.
            body:
              application/json:
                example:
                  value:
                    error: Shop not found.
                displayName: response404
                description: An error reply.
                type: ErrorResponse
          '409':
            description: The buyer hasn't approved the order yet.
            body:
              application/json:
                displayName: response409
                description: Not approved yet.
                type: ApiOrdersCapture409Error1
          '410':
            description: The last unit (or the last of the buyer's combination) sold while they were paying, or the PayPal checkout expired before they paid. The payment isn't captured, so the buyer isn't charged.
            body:
              application/json:
                displayName: response410
                description: An error reply.
                type: ErrorResponse
          '422':
            description: The buyer's funding source was declined (`INSTRUMENT_DECLINED`); they can try another.
            body:
              application/json:
                displayName: response422
                description: An error reply.
                type: ErrorResponse
          '502':
            description: Gemini, PayPal or Channel3 failed or isn't configured.
            body:
              application/json:
                example:
                  value:
                    error: PayPal isn't configured on this server.
                displayName: response502
                description: An error reply.
                type: ErrorResponse
  /access/verify:
    post:
      displayName: verifyAccessCode
      description: >
        For apps and games sold with access codes. Callable from any origin (CORS `*`): it only

        answers valid or not for one shop, and counts uses. Accepts the shop's current or former

        link names, and codes typed loosely (lower case, spaces, no dashes).
      body:
        application/json:
          example:
            value:
              shop: raptorrush
              code: K7QF-M2XP-9HTD
          displayName: body
          description: The shop and the code to check.
          type: ApiAccessVerifyRequest
      headers:
        Content-Type:
          required: true
          displayName: Content-Type
          type: string
          enum:
          - application/json
      responses:
        '200':
          description: The answer. Invalid codes are also a 200.
          body:
            application/json:
              examples:
                valid:
                  displayName: A valid code
                  value:
                    valid: true
                    product: 'Raptor Rush: Browser Edition'
                invalid:
                  displayName: A wrong code
                  value:
                    valid: false
              displayName: response200
              description: Whether the code is valid.
              type: ApiAccessVerifyResponse
  /download/{token}:
    uriParameters:
      token:
        required: true
        example:
          value: q2Vd8mLx0RkT4nYb7HcW1sPe
        displayName: token
        description: The download token from a paid order's thank-you page.
        type: string
    get:
      displayName: downloadFile
      description: A paid digital order's private link. Works 5 times within 14 days.
      responses:
        '200':
          description: The file.
          body:
            application/octet-stream:
              displayName: response200
              description: The file's bytes.
              type: file
        '410':
          description: Expired or used up.
          body:
            text/plain:
              example:
                value: This download link has expired.
              displayName: response410
              description: Why the link no longer works.
              type: string
  /blobs/{id}:
    uriParameters:
      id:
        required: true
        example:
          value: 'LFRvGuTU3D8i334X'
        displayName: id
        description: A shop's `photo_blob` or `hero_blob`.
        type: string
    get:
      displayName: getImage
      description: Public images only. Purchased files are never served here.
      responses:
        '200':
          description: The image.
          body:
            text/plain:
              displayName: response200
              description: The image bytes.
              type: any
        '404':
          description: Not a public shop image.
          body: {}
  /mcp:
    post:
      displayName: callMcp
      description: >
        A [Model Context Protocol](https://modelcontextprotocol.io) server, so agents such as

        Claude can shop here. Add `https://<host>/api/mcp` to an MCP client as a Streamable HTTP

        server. It's stateless: each POST carries one JSON-RPC 2.0 message (or a batch) and gets a

        plain JSON reply, with no event stream. The `initialize` reply's `Mcp-Session-Id` header

        carries the client's `clientInfo.name`; send it back on later requests (MCP clients do)

        so the seller's stats show which agent sent the buyer. Nothing else is kept.


        Methods: `initialize`, `ping`, `tools/list`, `tools/call`, and `resources/list`,

        `resources/templates/list` and `resources/read` for the product card. Each tool carries

        `annotations` (only `create_order` isn't `readOnlyHint`). Tools:


        | Tool | Arguments | What it does |

        |---|---|---|

        | `search_shops` | `query?`, `limit?` (1–25) | Live gallery shops, best match first; no match returns the newest with `matched: false` |

        | `get_product` | `shop` | The same object as `getAgentProduct` |

        | `create_order` | `shop`, `options?` | One unit on order; returns `order_id` and `pay_url` |

        | `get_order` | `order_id` | Status and `next_step`; once paid, the receipt and `delivery` |


        **The buyer always approves.** `create_order` charges nothing: the agent shows the buyer

        `pay_url` (`/o/<order_id>`, see `openPayLink`), which opens PayPal. It's a plain link on this

        site, so agent platforms that hide PayPal's checkout tokens can still show it. When the buyer

        says they've paid, the agent calls `get_order`.


        `get_order` status is one of `awaiting_buyer_approval`, `paid`, `declined` (nothing charged;

        the buyer can open `pay_url` again), `sold_out`, `expired` (call `create_order` again) or

        `failed` (PayPal couldn't be reached; try again), with a `next_step` the agent can follow.

        A paid order carries `delivery`: `{type: access_code, access_code, start_url?}`,

        `{type: download, download_url}` or `{type: shipping, ship_to, fulfillment, tracking}`, plus

        `amount` with item, shipping and total. Orders made this way show `channel: agent` in

        `listOrders`.


        **The product card.** Hosts that draw MCP Apps UI (ChatGPT, or a client that declares the

        `io.modelcontextprotocol/ui` extension) get `search_shops`, `get_product` and

        `create_order` results as a card with the real photos, options and a Pay with PayPal button

        (`ui://onething/shop-card-v1.html`). For them `show_buyer` is a one-line note rather than

        Markdown, so the model doesn't repeat or invent what the card shows.


        Tool errors (an unknown shop, a sold-out size, over the checkout cap) come back as results

        with `isError: true`, so the model can read them and try something else.
      body:
        application/json:
          examples:
            search:
              displayName: Find a shop
              value:
                jsonrpc: '2.0'
                id: 1
                method: tools/call
                params:
                  name: search_shops
                  arguments:
                    query: game
            initialize:
              displayName: Start (handshake)
              value:
                jsonrpc: '2.0'
                id: 0
                method: initialize
                params:
                  protocolVersion: 2025-06-18
                  capabilities: {}
                  clientInfo:
                    name: my-agent
                    version: '1.0'
            list:
              displayName: List the tools
              value:
                jsonrpc: '2.0'
                id: 3
                method: tools/list
            product:
              displayName: Read one product
              value:
                jsonrpc: '2.0'
                id: 4
                method: tools/call
                params:
                  name: get_product
                  arguments:
                    shop: vintageskates
            order:
              displayName: Order a size and colour
              value:
                jsonrpc: '2.0'
                id: 2
                method: tools/call
                params:
                  name: create_order
                  arguments:
                    shop: trailtee
                    options:
                      Size: M
                      Color: Black
            status:
              displayName: Check an order
              value:
                jsonrpc: '2.0'
                id: 5
                method: tools/call
                params:
                  name: get_order
                  arguments:
                    order_id: pX4kR9tVb2nQ7sLe
          displayName: body
          description: A JSON-RPC 2.0 request or batch.
          type: JsonRpcRequest | JsonRpcRequest[]
      headers:
        Content-Type:
          required: true
          displayName: Content-Type
          type: string
          enum:
          - application/json
      responses:
        '200':
          description: The JSON-RPC reply (an array for a batch).
          body:
            application/json:
              examples:
                search:
                  displayName: search_shops
                  value:
                    jsonrpc: '2.0'
                    id: 1
                    result:
                      content:
                      - type: text
                        text: "{\n  \"show_buyer\": \"![Vintage Cream and Red Roller Skates](https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X)\\n\\n**Vintage Cream and Red Roller Skates**: $240.00. Classic quad skates crafted with walnut burl heels\\n\\nWant it?\",\n  \"shops\": [\n    {\n      \"shop\": \"vintageskates\",\n      \"name\": \"Vintage Cream and Red Roller Skates\",\n      \"kind\": \"physical\",\n      \"headline\": \"Classic quad skates crafted with walnut burl heels\",\n      \"price\": \"$240.00\",\n      \"image\": \"https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X\",\n      \"url\": \"https://one-thing-ash0.onrender.com/vintageskates\"\n    }\n  ],\n  \"agent_name\": \"Claude\"\n}"
                      structuredContent:
                        show_buyer: '![Vintage Cream and Red Roller Skates](https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X)


                          **Vintage Cream and Red Roller Skates**: $240.00. Classic quad skates crafted with walnut burl heels


                          Want it?'
                        shops:
                        - shop: vintageskates
                          name: Vintage Cream and Red Roller Skates
                          kind: physical
                          headline: Classic quad skates crafted with walnut burl heels
                          price: $240.00
                          image: 'https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X'
                          url: https://one-thing-ash0.onrender.com/vintageskates
                        agent_name: Claude
                      isError: false
                order:
                  displayName: create_order
                  value:
                    jsonrpc: '2.0'
                    id: 2
                    result:
                      content:
                      - type: text
                        text: |
                          {
                            "order_id": "pX4kR9tVb2nQ7sLe",
                            "status": "awaiting_buyer_approval",
                            "total": "$255.00",
                            "options": {
                              "Size": "9"
                            },
                            "pay_url": "https://one-thing-ash0.onrender.com/o/pX4kR9tVb2nQ7sLe",
                            "status_url": "https://one-thing-ash0.onrender.com/o/pX4kR9tVb2nQ7sLe/status",
                            "next_step": "Show pay_url to the buyer as a link. It opens PayPal, where they pay (and enter a shipping address for physical items). When they say they've paid, call get_order with order_id: it returns the access code, download link or shipping details."
                          }
                      structuredContent:
                        order_id: pX4kR9tVb2nQ7sLe
                        status: awaiting_buyer_approval
                        total: $255.00
                        options:
                          Size: '9'
                        pay_url: https://one-thing-ash0.onrender.com/o/pX4kR9tVb2nQ7sLe
                        status_url: https://one-thing-ash0.onrender.com/o/pX4kR9tVb2nQ7sLe/status
                        next_step: "Show pay_url to the buyer as a link. It opens PayPal, where they pay (and enter a shipping address for physical items). When they say they've paid, call get_order with order_id: it returns the access code, download link or shipping details."
                      isError: false
                status:
                  displayName: get_order, paid
                  value:
                    jsonrpc: '2.0'
                    id: 5
                    result:
                      content:
                      - type: text
                        text: |
                          {
                            "order_id": "pX4kR9tVb2nQ7sLe",
                            "status": "paid",
                            "product": "Vintage Cream and Red Roller Skates",
                            "options": {
                              "Size": "9"
                            },
                            "amount": {
                              "item": 240,
                              "shipping": 15,
                              "total": 255,
                              "currency": "USD"
                            },
                            "total": "$255.00",
                            "paid_at": "2026-10-22T02:41:37Z",
                            "receipt_url": "https://one-thing-ash0.onrender.com/vintageskates/thanks?order=pX4kR9tVb2nQ7sLe",
                            "delivery": {
                              "type": "shipping",
                              "ship_to": {
                                "name": "Sam Rivera",
                                "address": "1 Main St, Springfield, IL, 62701, US"
                              },
                              "fulfillment": "to_ship",
                              "tracking": null
                            }
                          }
                      structuredContent:
                        order_id: pX4kR9tVb2nQ7sLe
                        status: paid
                        product: Vintage Cream and Red Roller Skates
                        options:
                          Size: '9'
                        amount:
                          item: 240
                          shipping: 15
                          total: 255
                          currency: USD
                        total: $255.00
                        paid_at: 2026-10-22T02:41:37Z
                        receipt_url: https://one-thing-ash0.onrender.com/vintageskates/thanks?order=pX4kR9tVb2nQ7sLe
                        delivery:
                          type: shipping
                          ship_to:
                            name: Sam Rivera
                            address: 1 Main St, Springfield, IL, 62701, US
                          fulfillment: to_ship
                          tracking: null
                      isError: false
                toolError:
                  displayName: A tool error the model can read
                  value:
                    jsonrpc: '2.0'
                    id: 2
                    result:
                      content:
                      - type: text
                        text: |
                          {
                            "error": "9 / Black is sold out."
                          }
                      isError: true
              displayName: response200
              description: One JSON-RPC reply, or a batch.
              type: JsonRpcResponse | JsonRpcResponse[]
        '202':
          description: Only notifications were sent; there's nothing to reply.
          body: {}
        '400':
          description: Not JSON (JSON-RPC parse error `-32700`).
          body:
            application/json:
              displayName: response400
              description: A JSON-RPC 2.0 reply from the MCP server.
              type: JsonRpcResponse
  /platform/shops:
    get:
      displayName: listMyShops
      description: "Every shop the API key's account owns, newest first, with what a catalog page needs: name, price, cover, link, whether PayPal is connected and how many sales it has."
      securedBy:
      - PlatformKey
      queryParameters:
        status:
          required: false
          example:
            value: live
          displayName: status
          description: Only shops with this status, e.g. `live` for a public catalog.
          type: string
          enum:
          - draft
          - live
      responses:
        '200':
          description: The shops.
          body:
            application/json:
              example:
                value:
                  shops:
                  - slug: raptorrush
                    status: live
                    name: 'Raptor Rush: Browser Edition'
                    headline: Grow from Tiny Hatchling to Giant Apex Predator
                    product_type: digital
                    price:
                      amount: 2.99
                      currency: USD
                    url: https://one-thing-ash0.onrender.com/raptorrush
                    cover: https://one-thing-ash0.onrender.com/api/blobs/KchAi9jwZzo76SKh
                    paypal_connected: true
                    sales: 12
                    created_at: 2026-10-12T20:31:44Z
              displayName: response200
              description: The account's shops.
              type: ApiPlatformShopsResponse
        '401':
          description: No API key, or it's wrong or revoked.
          body:
            application/json:
              displayName: response401
              description: An error reply.
              type: ErrorResponse
  /account:
    /signin:
      post:
        displayName: signIn
        description: Signs in with an email address or a phone number, creating the account the first time. There's no password and no verification (sandbox). The response sets the `ot_session` cookie; shops created with it belong to the account and are listed on `/account`. Signing in with an email also claims older shops whose seller email matches. In a browser, sellers can instead use Log in with PayPal (`/api/account/paypal`), which also records the PayPal account their sales are paid into.
        body:
          application/json:
            examples:
              email:
                displayName: With an email
                value:
                  identifier: maker@example.com
              phone:
                displayName: With a phone number
                value:
                  identifier: +1 555 123 4567
            displayName: body
            description: The email or phone number to sign in with.
            type: ApiAccountSigninRequest
        headers:
          Content-Type:
            required: true
            displayName: Content-Type
            type: string
            enum:
            - application/json
        responses:
          '200':
            description: Signed in. The `ot_session` cookie is set.
            headers:
              Set-Cookie:
                example:
                  value: ot_session=Rk2v9QxN4tLm8pWz0cYb7HsE; Path=/; HttpOnly; SameSite=lax; Max-Age=31536000
                displayName: Set-Cookie
                description: 'The session cookie: `ot_session=<token>`, HttpOnly, for a year.'
                type: string
            body:
              application/json:
                example:
                  value:
                    id: Vq3nN8cT0bLx2YwE
                    email: maker@example.com
                    phone: null
                displayName: response200
                description: The signed-in account.
                type: ApiAccountSigninResponse
          '400':
            description: Something in the request needs fixing; `error` says what.
            body:
              application/json:
                example:
                  value:
                    error: Choose a photo.
                displayName: response400
                description: An error reply.
                type: ErrorResponse
    /signout:
      post:
        displayName: signOut
        description: Ends this browser's session and clears the `ot_session` cookie.
        responses:
          '200':
            description: Done.
            body:
              application/json:
                example:
                  value:
                    ok: true
                displayName: response200
                description: Confirms the change.
                type: Ok
    /paypal:
      get:
        displayName: logInWithPayPal
        description: "A link for a browser, not for code: redirects to PayPal's sign-in page. PayPal sends the seller back to `/api/account/paypal/callback`, which signs them in (creating the account the first time), records the PayPal account their sales are paid into, and redirects to `next`."
        queryParameters:
          next:
            required: false
            example:
              value: /account
            displayName: next
            description: A path on this site to land on afterwards. Defaults to `/account`.
            type: string
        responses:
          '302':
            description: To PayPal's sign-in page.
            body: {}
          '503':
            description: Log in with PayPal isn't switched on for this server.
            body:
              application/json:
                displayName: response503
                description: An error reply.
                type: ErrorResponse
  /agent:
    /shops:
      get:
        displayName: listAgentShops
        description: "The gallery's live shops for a query: shops matching more of its words first, newest first among equals. Browsing words (\"something interesting to buy\") are ignored, and a query that matches nothing returns the newest shops with `matched: false` rather than an empty list. The GET twin of the MCP `search_shops` tool, for agents that can only fetch URLs. Public. Read a shop with `getAgentProduct`; buy through the MCP server in `mcp_server`, or send the buyer to the shop's `url`."
        queryParameters:
          q:
            required: false
            example:
              value: skates
            displayName: q
            description: Keywords. Leave out to list the newest shops.
            type: string
            maxLength: 200
          limit:
            required: false
            default: '10'
            example:
              value: 10
            displayName: limit
            description: How many shops, 1–25.
            type: integer
            minimum: 1
            maximum: 25
            format: int32
        responses:
          '200':
            description: The matching shops.
            body:
              application/json:
                example:
                  value:
                    show_buyer: '![Vintage Cream and Red Roller Skates](https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X)


                      **Vintage Cream and Red Roller Skates**: $240.00. Classic quad skates crafted with walnut burl heels


                      ![Raptor Rush: Browser Edition](https://one-thing-ash0.onrender.com/api/blobs/R9tWc3yN6bJq1zUd)


                      **Raptor Rush: Browser Edition**: $2.99. Grow from Tiny Hatchling to Giant Apex Predator


                      Which one?'
                    shops:
                    - shop: vintageskates
                      name: Vintage Cream and Red Roller Skates
                      kind: physical
                      headline: Classic quad skates crafted with walnut burl heels
                      price: $240.00
                      image: 'https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X'
                      url: https://one-thing-ash0.onrender.com/vintageskates
                    - shop: raptorrush
                      name: 'Raptor Rush: Browser Edition'
                      kind: digital
                      headline: Grow from Tiny Hatchling to Giant Apex Predator
                      price: $2.99
                      image: https://one-thing-ash0.onrender.com/api/blobs/R9tWc3yN6bJq1zUd
                      url: https://one-thing-ash0.onrender.com/raptorrush
                    matched: true
                    mcp_server: https://one-thing-ash0.onrender.com/api/mcp
                displayName: response200
                description: The matching shops, with a reply to show the buyer.
                type: ApiAgentShopsResponse
      /{slug}:
        uriParameters:
          slug:
            required: true
            example:
              value: vintageskates
            displayName: slug
            description: The shop's link name (current or former).
            type: string
        get:
          displayName: getAgentProduct
          description: 'Everything an AI shopping agent needs to describe the product and decide to buy it: price, shipping, delivery, availability, options, images and FAQ. Public. Buying goes through the MCP server named in `mcp_server`, or the `order_url` links. Shop pages also carry the same facts as schema.org `Product` JSON-LD. A person clicking the link in a browser (`Sec-Fetch-User: ?1`) is redirected instead; known assistants and headless browsers always get JSON. It goes to the shop page, unless the link has `?view=json`.'
          queryParameters:
            agent:
              required: false
              example:
                value: ChatGPT
              displayName: agent
              description: "Optional: the agent's name (`ChatGPT`, `Gemini`, `my-shopping-bot`), so the seller's stats show which agent sent the buyer. Only used when the user agent doesn't already say."
              type: string
              maxLength: 30
            view:
              required: false
              example:
                value: json
              displayName: view
              description: '`json` keeps the JSON for a person opening the link in a browser.'
              type: string
              enum:
              - json
          responses:
            '200':
              description: The product.
              body:
                application/json:
                  example:
                    value:
                      show_buyer: '![Vintage Cream and Red Roller Skates](https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X)


                        **Vintage Cream and Red Roller Skates**: $240.00 + $15.00 shipping

                        Classic quad skates crafted with walnut burl heels

                        Size: 7 · 8 · 9

                        Which size?'
                      shop: vintageskates
                      url: https://one-thing-ash0.onrender.com/vintageskates
                      name: Vintage Cream and Red Roller Skates
                      kind: physical
                      headline: Classic quad skates crafted with walnut burl heels
                      description: A vintage pair of skates featuring cream leather, bold red trim, and durable quad wheels.
                      highlights:
                      - Handmade cream leather upper with rich red trim
                      - Sculpted walnut burl heel structure for stability
                      details:
                      - label: Materials
                        value: Leather upper, walnut burl heel, rubber wheels
                      faq:
                      - q: What is the return policy?
                        a: Unworn skates in original condition can be returned within 30 days of delivery.
                      images:
                      - 'https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X'
                      - https://one-thing-ash0.onrender.com/api/blobs/zrySajNyao6_j11x
                      price:
                        amount: 240
                        currency: USD
                        label: $240.00
                      shipping:
                        amount: 15
                        currency: USD
                        ships_to:
                        - US
                      total:
                        amount: 255
                        currency: USD
                      delivery: Shipped. PayPal collects the buyer's address at checkout.
                      options:
                      - name: Size
                        values:
                        - '7'
                        - '8'
                        - '9'
                      variants:
                      - choice:
                          Size: '7'
                        availability: in_stock (3 left)
                        order_url: https://one-thing-ash0.onrender.com/vintageskates/buy?Size=7
                      - choice:
                          Size: '8'
                        availability: sold_out
                      - choice:
                          Size: '9'
                        availability: in_stock (6 left)
                        order_url: https://one-thing-ash0.onrender.com/vintageskates/buy?Size=9
                      availability: in_stock
                      how_to_buy: Show show_buyer to the buyer exactly as written, photo included (it's Markdown, so the photo displays and the links stay clickable), and keep your own words to a minimum. Once the buyer has picked and said to buy, open the order_url of their variant (or call create_order on the OneThing MCP server with shop and options). Either returns show_buyer with the pay link.
                      mcp_server: https://one-thing-ash0.onrender.com/api/mcp
                      agent_name: ChatGPT
                  displayName: response200
                  description: A live shop as an AI agent sees it. Recommendations have `offers`; everything else has `price` and is bought with `create_order`.
                  type: AgentProduct
            '303':
              description: A person clicked the link. Redirect to the shop page (`/<slug>`).
              body: {}
            '404':
              description: No live shop with that link name.
              body:
                application/json:
                  displayName: response404
                  description: An error reply.
                  type: ErrorResponse
        /order:
          get:
            displayName: orderByLink
            description: >
              Orders one unit with a GET: the MCP `create_order` tool for AI assistants that can only

              fetch URLs, such as free-tier ChatGPT or Grok. Nothing is charged. The reply has `pay_url`,

              where the buyer pays at PayPal, and `status_url` (`getAgentOrder`), which says when they

              have and what they got.


              For a product with options, pass the buyer's pick as query parameters named after the

              options (`?Size=9`, or `?Color=Ice+Blue&Size=L`); names and values are matched without

              regard to case. You rarely build this URL yourself: `getAgentProduct` and `/llms.txt`

              write it out in full (`order_url`, or `variants[].order_url`), because some assistants

              only open URLs they have been shown.


              Every request makes a new order, so open it once, after the buyer says to buy. Known

              crawlers and link previewers get a 403 (and are kept out by `robots.txt`); any other

              leaves an unpaid order at most, since stock is only taken when a payment is captured.

              Replies are `no-store` and `X-Robots-Tag: noindex, nofollow`.


              `/<slug>/buy` is the same endpoint at a short URL, and the one `order_url` uses.

              A person clicking the link in a browser (`Sec-Fetch-User: ?1`) is redirected instead; known assistants and headless browsers always get JSON. It goes straight to `pay_url`, or to the shop page when an option is missing

              or unknown.
            queryParameters:
              agent:
                required: false
                example:
                  value: ChatGPT
                displayName: agent
                description: "Optional: the agent's name (`ChatGPT`, `Gemini`, `my-shopping-bot`), so the seller's stats show which agent sent the buyer. Only used when the user agent doesn't already say."
                type: string
                maxLength: 30
              Size:
                required: false
                example:
                  value: '9'
                displayName: Size
                description: An example option. The real parameter names are the product's option names from `getAgentProduct` (`options[].name`), one per option.
                type: string
            responses:
              '200':
                description: The order, waiting for the buyer to pay.
                body:
                  application/json:
                    example:
                      value:
                        show_buyer: '![Vintage Cream and Red Roller Skates](https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X)


                          Vintage Cream and Red Roller Skates (9): $255.00 total.

                          **[Pay $255.00 with PayPal](https://one-thing-ash0.onrender.com/o/pX4kR9tVb2nQ7sLe)**

                          Tell me once you''ve paid and I''ll get you the shipping confirmation.'
                        order_id: pX4kR9tVb2nQ7sLe
                        status: awaiting_buyer_approval
                        total: $255.00
                        options:
                          Size: '9'
                        pay_url: https://one-thing-ash0.onrender.com/o/pX4kR9tVb2nQ7sLe
                        status_url: https://one-thing-ash0.onrender.com/o/pX4kR9tVb2nQ7sLe/status
                        next_step: "Show pay_url to the buyer as a link. It opens PayPal, where they pay (and enter a shipping address for physical items). When they say they've paid, open status_url (or with MCP, call get_order with order_id): it returns the access code, download link or shipping details."
                    displayName: response200
                    description: A new order, as `create_order` and `orderByLink` return it.
                    type: AgentCreatedOrder
              '303':
                description: A person clicked the link. Redirect to PayPal (`pay_url`), or to the shop page to pick an option.
                headers:
                  Location:
                    example:
                      value: https://one-thing-ash0.onrender.com/o/pX4kR9tVb2nQ7sLe
                    displayName: Location
                    description: Where the buyer goes next.
                    type: string
                body: {}
              '400':
                description: A missing or unknown option value, or sold out. `error` names the valid values.
                body:
                  application/json:
                    example:
                      value:
                        error: 'Unknown Size "12". Size: one of 7, 8, 9.'
                    displayName: response400
                    description: An error reply.
                    type: ErrorResponse
              '403':
                description: A known crawler or link previewer. They don't place orders.
                body:
                  application/json:
                    example:
                      value:
                        error: Crawlers and link previews don't place orders. Read the product at the shop's page.
                    displayName: response403
                    description: An error reply.
                    type: ErrorResponse
              '404':
                description: No live shop with that link name.
                body:
                  application/json:
                    example:
                      value:
                        error: No live shop called "skatez". Try search_shops.
                    displayName: response404
                    description: An error reply.
                    type: ErrorResponse
              '429':
                description: Over this network's cap for the call (see **Limits**). Retry after `Retry-After` seconds.
                headers:
                  Retry-After:
                    example:
                      value: 420
                    displayName: Retry-After
                    description: Seconds until the window resets.
                    type: integer
                    format: int32
                body:
                  application/json:
                    example:
                      value:
                        error: Too many checkouts from your network. Try again in 7 min.
                    displayName: response429
                    description: An error reply.
                    type: ErrorResponse
    /orders/{orderId}:
      uriParameters:
        orderId:
          required: true
          example:
            value: pX4kR9tVb2nQ7sLe
          displayName: orderId
          description: The `order_id` from the MCP `create_order` tool, or from a thank-you page link (`?order=`).
          type: string
      get:
        displayName: getAgentOrder
        description: "Where an order stands and, once paid, what the buyer got: the access code, the download link, or the shipping address and tracking. The GET twin of the MCP `get_order` tool (and the `status_url` that `create_order` returns), for agents that can only fetch URLs. Public: anyone with the order id can already open its thank-you page. If the buyer has approved at PayPal but nothing has captured the payment yet, this captures it. `/o/<order_id>/status` is the same endpoint at a short URL, and the one `status_url` uses. A person clicking the link in a browser (`Sec-Fetch-User: ?1`) is redirected instead; known assistants and headless browsers always get JSON. It goes to the order's receipt page."
        queryParameters:
          agent:
            required: false
            example:
              value: ChatGPT
            displayName: agent
            description: "Optional: the agent's name (`ChatGPT`, `Gemini`, `my-shopping-bot`), so the seller's stats show which agent sent the buyer. Only used when the user agent doesn't already say."
            type: string
            maxLength: 30
        responses:
          '200':
            description: The order.
            body:
              application/json:
                examples:
                  waiting:
                    displayName: Waiting for the buyer
                    value:
                      order_id: pX4kR9tVb2nQ7sLe
                      status: awaiting_buyer_approval
                      product: Vintage Cream and Red Roller Skates
                      options:
                        Size: '9'
                      amount:
                        item: 240
                        shipping: 15
                        total: 255
                        currency: USD
                      total: $255.00
                      pay_url: https://one-thing-ash0.onrender.com/o/pX4kR9tVb2nQ7sLe
                      next_step: The buyer hasn't paid yet. Give them pay_url; when they say they've paid, call get_order again.
                  code:
                    displayName: 'Paid: an access code'
                    value:
                      show_buyer: |
                        Paid: Raptor Rush: Browser Edition, $2.99.

                        Your access code: `K7QF-M2XP-9HTD` · [Start now](https://www.miriogames.com/raptor-rush/play/?code=K7QF-M2XP-9HTD)

                        [Your receipt](https://one-thing-ash0.onrender.com/raptorrush/thanks?order=a9KQqS7zAY5dWv89)
                      order_id: a9KQqS7zAY5dWv89
                      status: paid
                      product: 'Raptor Rush: Browser Edition'
                      amount:
                        item: 2.99
                        shipping: 0
                        total: 2.99
                        currency: USD
                      total: $2.99
                      paid_at: 2026-10-22T03:12:50Z
                      receipt_url: https://one-thing-ash0.onrender.com/raptorrush/thanks?order=a9KQqS7zAY5dWv89
                      delivery:
                        type: access_code
                        access_code: K7QF-M2XP-9HTD
                        start_url: https://www.miriogames.com/raptor-rush/play/?code=K7QF-M2XP-9HTD
                  shipping:
                    displayName: 'Paid: shipped to the buyer'
                    value:
                      order_id: pX4kR9tVb2nQ7sLe
                      status: paid
                      product: Vintage Cream and Red Roller Skates
                      options:
                        Size: '9'
                      amount:
                        item: 240
                        shipping: 15
                        total: 255
                        currency: USD
                      total: $255.00
                      paid_at: 2026-10-22T02:41:37Z
                      receipt_url: https://one-thing-ash0.onrender.com/vintageskates/thanks?order=pX4kR9tVb2nQ7sLe
                      delivery:
                        type: shipping
                        ship_to:
                          name: Sam Rivera
                          address: 1 Main St, Springfield, IL, 62701, US
                        fulfillment: to_ship
                        tracking: null
                  expired:
                    displayName: Expired before payment
                    value:
                      order_id: pX4kR9tVb2nQ7sLe
                      status: expired
                      product: Vintage Cream and Red Roller Skates
                      options:
                        Size: '9'
                      amount:
                        item: 240
                        shipping: 15
                        total: 255
                        currency: USD
                      total: $255.00
                      next_step: This checkout expired at PayPal. Nothing was charged. Call create_order for a new one.
                displayName: response200
                description: An order as `get_order` and `getAgentOrder` report it.
                type: AgentOrder
          '303':
            description: A person clicked the link. Redirect to the order's page (`/o/<order_id>`).
            body: {}
          '404':
            description: No order with that id.
            body:
              application/json:
                displayName: response404
                description: An error reply.
                type: ErrorResponse
