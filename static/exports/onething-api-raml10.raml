            item: 240
            shipping: 15
            total: 255
            currency: USD
        displayName: amount
        description: What the order costs, as numbers.
        type: Amount
      total:
        required: true
        example:
          value: $255.00
        displayName: total
        description: The total as a label, e.g. `$255.00`.
        type: string
      pay_url:
        required: false
        example:
          value: https://one-thing-ash0.onrender.com/o/pX4kR9tVb2nQ7sLe
        displayName: pay_url
        description: Unpaid orders (waiting or declined). The buyer pays here; safe to show in chat.
        type: string
      next_step:
        required: false
        example:
          value: Show pay_url to the buyer as a link. When they say they've paid, call get_order with order_id.
        displayName: next_step
        description: Unpaid orders. What the agent should do next, in plain words.
        type: string
      paid_at:
        required: false
        example:
          value: 2026-10-22T02:41:37Z
        displayName: paid_at
        description: Paid orders. When PayPal captured the payment.
        type: datetime
      receipt_url:
        required: false
        example:
          value: https://one-thing-ash0.onrender.com/vintageskates/thanks?order=pX4kR9tVb2nQ7sLe
        displayName: receipt_url
        description: Paid orders. The buyer's thank-you page.
        type: string
      delivery:
        required: false
        example:
          value:
            type: access_code
            access_code: K7QF-M2XP-9HTD
            start_url: https://www.miriogames.com/raptor-rush/?code=K7QF-M2XP-9HTD
        displayName: delivery
        description: Paid orders. What the buyer got.
        type: AgentDeliveryAccessCode | AgentDeliveryDownload | AgentDeliveryShipping
  AgentDeliveryAccessCode:
    example:
      value:
        type: access_code
        access_code: K7QF-M2XP-9HTD
        start_url: https://www.miriogames.com/raptor-rush/?code=K7QF-M2XP-9HTD
    displayName: AgentDeliveryAccessCode
    description: A digital product unlocked with an access code.
    type: object
    properties:
      type:
        required: true
        example:
          value: access_code
        displayName: type
        description: Always `access_code`.
        type: string
        enum:
        - access_code
      access_code:
        required: true
        example:
          value: K7QF-M2XP-9HTD
        displayName: access_code
        description: The buyer's code, which unlocks the seller's app or game.
        type: string
      start_url:
        required: false
        example:
          value: https://www.miriogames.com/raptor-rush/?code=K7QF-M2XP-9HTD
        displayName: start_url
        description: The seller's app with the code filled in.
        type: string
  AgentDeliveryDownload:
    example:
      value:
        type: download
        download_url: https://one-thing-ash0.onrender.com/api/download/dl_4mQ8sT2vX9
        note: Works 5 times over 14 days.
    displayName: AgentDeliveryDownload
    description: A digital file to download.
    type: object
    properties:
      type:
        required: true
        example:
          value: download
        displayName: type
        description: Always `download`.
        type: string
        enum:
        - download
      download_url:
        required: true
        example:
          value: https://one-thing-ash0.onrender.com/api/download/dl_4mQ8sT2vX9
        displayName: download_url
        description: A private link to the file. It works 5 times over 14 days.
        type: string
      note:
        required: false
        example:
          value: Works 5 times over 14 days.
        displayName: note
        description: How long the link lasts and how many downloads it allows, in words.
        type: string
  AgentDeliveryShipping:
    example:
      value:
        type: shipping
        ship_to:
          name: Sam Rivera
          address: 1 Main St, Springfield, IL, 62701, US
        fulfillment: to_ship
        tracking:
          carrier: USPS
          number: '9400111899223197428490'
    displayName: AgentDeliveryShipping
    description: A physical product shipped to the buyer.
    type: object
    properties:
      type:
        required: true
        example:
          value: shipping
        displayName: type
        description: Always `shipping`.
        type: string
        enum:
        - shipping
      ship_to:
        required: false
        example:
          value:
            name: Sam Rivera
            address: 1 Main St, Springfield, IL, 62701, US
        displayName: ship_to
        description: Where it ships, from the buyer's PayPal checkout. Null if PayPal didn't share it.
        type:
        - ShipTo
        - nil
      fulfillment:
        required: true
        example:
          value: to_ship
        displayName: fulfillment
        description: '`to_ship` until the seller adds tracking, then `shipped`.'
        type: string
        enum:
        - to_ship
        - shipped
      tracking:
        required: false
        example:
          value:
            carrier: USPS
            number: '9400111899223197428490'
        displayName: tracking
        description: The carrier and tracking number once shipped; null before.
        type:
        - Tracking
        - nil
  PlatformShop:
    example:
      value:
        slug: vintageskates
        status: draft
        name: Vintage Cream and Red Roller Skates
        headline: Classic quad skates crafted with walnut burl heels
        product_type: physical
        price:
          amount: 240
          currency: USD
          label: $240.00
        url: https://one-thing-ash0.onrender.com/vintageskates
        cover: 'https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X'
        paypal_connected: true
        sales: 12
        created_at: 2026-10-22T02:41:37Z
    displayName: PlatformShop
    description: A shop as a platform API key lists it.
    type: object
    properties:
      slug:
        required: true
        example:
          value: vintageskates
        displayName: slug
        description: The shop's link name.
        type: string
      status:
        required: true
        example:
          value: draft
        displayName: status
        description: '`draft` until the seller goes live.'
        type: string
        enum:
        - draft
        - live
      name:
        required: true
        example:
          value: Vintage Cream and Red Roller Skates
        displayName: name
        description: The product's name.
        type: string
      headline:
        required: false
        example:
          value: Classic quad skates crafted with walnut burl heels
        displayName: headline
        description: The shop's one-line pitch.
        type: string
      product_type:
        required: true
        example:
          value: physical
        displayName: product_type
        description: '`physical`, `digital` or `referral`.'
        type: string
        enum:
        - physical
        - digital
        - referral
      price:
        required: true
        example:
          value:
            amount: 240
            currency: USD
            label: $240.00
        displayName: price
        description: An amount of money, as a number and as a label.
        type: AgentMoney
      url:
        required: true
        example:
          value: https://one-thing-ash0.onrender.com/vintageskates
        displayName: url
        description: The shop page buyers pay on.
        type: string
      cover:
        required: false
        example:
          value: 'https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X'
        displayName: cover
        description: The cover image's URL.
        type:
        - string
        - nil
      paypal_connected:
        required: true
        example:
          value: true
        displayName: paypal_connected
        description: The seller connected a PayPal account that can be paid.
        type: boolean
      sales:
        required: true
        example:
          value: 12
        displayName: sales
        description: Paid orders.
        type: integer
        format: int32
      created_at:
        required: true
        example:
          value: 2026-10-22T02:41:37Z
        displayName: created_at
        description: When the shop was made.
        type: datetime
  AgentMoney:
    example:
      value:
        amount: 240
        currency: USD
        label: $240.00
    displayName: AgentMoney
    description: An amount of money, as a number and as a label.
    type: object
    properties:
      amount:
        required: true
        example:
          value: 48.5
        displayName: amount
        description: The amount in the currency's main unit (dollars, not cents).
        type: number
        format: double
      currency:
        required: true
        example:
          value: USD
        displayName: currency
        description: ISO 4217 currency code.
        type: string
      label:
        required: false
        example:
          value: $48.50
        displayName: label
        description: The amount formatted for people.
        type: string
  JsonRpcRequest:
    example:
      value:
        jsonrpc: '2.0'
        id: 1
        method: tools/call
        params:
          name: get_product
          arguments:
            shop: vintageskates
    displayName: JsonRpcRequest
    description: A JSON-RPC 2.0 request to the MCP server.
    type: object
    properties:
      jsonrpc:
        required: true
        example:
          value: '2.0'
        displayName: jsonrpc
        description: Always `2.0`.
        type: string
        enum:
        - '2.0'
      id:
        required: false
        example:
          value: '1'
        displayName: id
        description: Leave out for a notification.
        type: string | integer | nil
      method:
        required: true
        example:
          value: tools/call
        displayName: method
        description: The MCP method. `tools/call` runs a tool; `tools/list` lists them.
        type: string
        enum:
        - initialize
        - ping
        - tools/list
        - tools/call
        - notifications/initialized
      params:
        required: false
        example:
          value:
            name: get_product
            arguments:
              shop: vintageskates
        displayName: params
        description: 'For `tools/call`: `{ name, arguments }`.'
        type: object
        properties: {}
  JsonRpcResponse:
    example:
      value:
        jsonrpc: '2.0'
        id: 1
        result:
          content:
          - type: text
            text: '{"shop": "vintageskates"}'
          isError: false
    displayName: JsonRpcResponse
    description: A JSON-RPC 2.0 reply from the MCP server.
    type: object
    properties:
      jsonrpc:
        required: true
        example:
          value: '2.0'
        displayName: jsonrpc
        description: Always `2.0`.
        type: string
        enum:
        - '2.0'
      id:
        required: true
        example:
          value: '1'
        displayName: id
        description: The request's `id`.
        type: string | integer | nil
      result:
        required: false
        example:
          value:
            isError: false
        displayName: result
        description: 'For `tools/call`: `content` (the answer as JSON text), `structuredContent` (the same object) and `isError`.'
        type: object
        properties: {}
      error:
        required: false
        example:
          value:
            code: -32601
            message: Method not found
        displayName: error
        description: Present when the call failed.
        type: Error
  Referral:
