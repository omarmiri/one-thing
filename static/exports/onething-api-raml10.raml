        uniqueItems: false
        minItems: 1
        maxItems: 12
        items:
          type: OptionValue
      fromSeller:
        required: false
        example:
          value: false
        displayName: fromSeller
        description: The seller's description or photo named these values; otherwise they're a guess.
        type: boolean
  Option1:
    example:
