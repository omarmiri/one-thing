#%RAML 1.0
title: OneThing API
version: 1.0.0
baseUri: https://one-thing-ash0.onrender.com
baseUriParameters: {}
protocols:
- HTTPS
- HTTP
documentation:
- title: OneThing API
  content: |
    OneThing turns a photo, a link or a picked product into a live one-product shop that takes

    PayPal payments, or a recommendation page that earns referral commissions through Channel3.


    **How a shop is made**

    1. `createShop`: start from a photo, a link, or a Channel3 product. Gemini guesses what it
       is, how it's delivered, the price, a short link and the page design. You get back the
       shop's link name and an **admin token**.
    2. `updateShop`: correct anything the AI guessed, then set `status: live`.

    3. Buyers pay on `https://<host>/<slug>` with PayPal. Sellers read orders and ship them.


    **Auth.** Seller endpoints take the shop's admin token in the `x-admin-token` header, or a

    **platform API key** (`Authorization: Bearer ot_sk_…`) for marketplaces that make shops for

    their own sellers. Buyer endpoints (checkout, access-code verification, downloads) are public.


    **Access codes.** A digital product can unlock an app or game instead of shipping a file.

    Each paid order gets a code such as `K7QF-M2XP-9HTD`; your app calls `verifyAccessCode`

    before unlocking. Raptor Rush on miriogames.com is a live example.


    **Agent-ready.** Every live shop is also published for AI shopping agents: an MCP server at

    `/api/mcp` with `search_shops`, `get_product`, `create_order` and `get_order`, and the same

    four as plain GETs for assistants that can only fetch URLs (`listAgentShops`,

    `getAgentProduct`, `orderByLink`, `getAgentOrder`), with `/llms.txt` as the starting point.

    An agent can find and order, but the buyer still approves every payment at PayPal.


    All money moves through PayPal (sandbox in this deployment). OneThing never holds card data.
securitySchemes:
  AdminToken:
    type: Pass Through
    description: The shop's admin token, returned once by `createShop`. Keep it secret.
    describedBy:
      headers:
        x-admin-token:
          required: true
          displayName: x-admin-token
          description: The shop's admin token, returned once by `createShop`. Keep it secret.
          type: string
securedBy: []
types:
  Error:
    displayName: Error
    type: object
    properties:
      error:
        required: true
        displayName: error
        description: A sentence you can show to a person.
        type: string
      field:
        required: false
        displayName: field
        description: The form field at fault, when there is one.
        type: string
      detail:
        required: false
        displayName: detail
        description: The upstream service's own message, for debugging.
        type: string
  CreateShopForm:
    displayName: CreateShopForm
    type: object
    properties:
      source:
        required: true
        displayName: source
        type: string
        enum:
        - photo
        - link
        - channel3
      photo:
        required: false
        displayName: photo
        description: '`source=photo`: the product photo, up to 8 MB.'
        type: file
      description:
        required: false
        displayName: description
        description: '`source=photo`: a sentence or two about the product. Required if there is no photo.'
        type: string
      url:
        required: false
        displayName: url
        description: '`source=link`: a product page, or your own app or game page.'
        type: string
      productId:
        required: false
        displayName: productId
        description: '`source=channel3`: a product id from `searchProducts`.'
        type: string
      slug:
        required: false
        displayName: slug
        description: The link name you want. If omitted, the AI suggests one.
        type: string
      type:
        required: false
        default: auto
        displayName: type
        type: string
        enum:
        - auto
        - physical
        - digital
      delivery:
        required: false
        displayName: delivery
        description: For digital products. If omitted, the AI guesses.
        type: string
        enum:
        - file
        - access_code
      access_url:
        required: false
        displayName: access_url
        description: Where buyers use an access code.
        type: string
      price:
        required: false
        displayName: price
        description: USD. If omitted, the AI suggests a price.
        type: number
        format: double
      shipping:
        required: false
        displayName: shipping
        type: number
        format: double
      stock:
        required: false
        displayName: stock
        type: integer
        format: int32
      ship_countries:
        required: false
        examples:
          Untitled Example1:
            value: US
          Untitled Example2:
            value: CA
        displayName: ship_countries
        type: string
      paypal_email:
        required: false
        displayName: paypal_email
        type: string
      seller_email:
        required: false
        displayName: seller_email
        type: string
      digital_file:
        required: false
        displayName: digital_file
        type: file
  CreatedShop:
    displayName: CreatedShop
    type: object
    properties:
      slug:
        required: true
        example:
          value: dragonflight
        displayName: slug
        type: string
      token:
        required: true
        displayName: token
        description: The admin token. Shown once; store it.
        type: string
      manageUrl:
        required: true
        displayName: manageUrl
        description: The seller's private manage page (contains the token).
        type: string
  ShopUpdate:
    displayName: ShopUpdate
    type: object
    properties:
      slug:
        required: false
        displayName: slug
        type: string
      status:
        required: false
        displayName: status
        type: string
        enum:
        - draft
        - live
      product_type:
        required: false
        displayName: product_type
        description: '`referral` only for shops created from Channel3.'
        type: string
        enum:
        - physical
        - digital
        - referral
      price:
        required: false
        displayName: price
        type: number
        minimum: 0.5
        maximum: 10000
        format: double
      shipping:
        required: false
        displayName: shipping
        type: number
        minimum: 0
        maximum: 500
        format: double
      stock:
        required: false
        displayName: stock
        type:
        - integer
        - nil
        minimum: 0
        format: int32
      ship_countries:
        required: false
        displayName: ship_countries
        type:
        - string
        - nil
      delivery:
        required: false
        displayName: delivery
        type: string
        enum:
        - file
        - access_code
      access_url:
        required: false
        displayName: access_url
        type:
        - string
        - nil
      paypal_email:
        required: false
        displayName: paypal_email
        type:
        - string
        - nil
      seller_email:
        required: false
        displayName: seller_email
        type:
        - string
        - nil
      zapier_hook_url:
        required: false
        displayName: zapier_hook_url
        type:
        - string
        - nil
      in_gallery:
        required: false
        displayName: in_gallery
        description: Feature the shop at `/gallery` while it's live. Off by default.
        type: boolean
      options:
        required: false
        displayName: options
        description: What the buyer picks (physical products only), replacing the current options; `[]` removes them. With options, stock is counted per combination in `option_stock` and the shop's own `stock` is cleared. At most 60 combinations.
        type: array
        uniqueItems: false
        maxItems: 3
        items:
          type: ShopOption
      option_stock:
        required: false
        example:
          value:
            M / Black: 4
            L / Black: 0
        displayName: option_stock
        description: Stock per combination, keyed by its values in option order joined with ` / ` (e.g. `M / Black`). A missing key or `null` means unlimited; `0` is sold out.
        type: object
        additionalProperties: true
        properties:
          //:
            type: integer
      facts:
        required: false
        displayName: facts
        description: Answers to the "buyers will ask" questions in `suggestions.missingFacts`. Each becomes a product detail on the page (replacing one with the same label) and drops off the list.
        type: array
        uniqueItems: false
        maxItems: 5
        items:
          type: Fact
  Shop:
    displayName: Shop
    type: object
    properties:
      id:
        required: true
        displayName: id
        type: string
      slug:
        required: true
        displayName: slug
        type: string
      status:
        required: true
        displayName: status
        type: string
        enum:
        - draft
        - live
      product_type:
        required: true
        displayName: product_type
        type: string
        enum:
        - physical
        - digital
        - referral
      price_cents:
        required: true
        displayName: price_cents
        type: integer
        format: int32
      currency:
        required: true
        example:
          value: USD
        displayName: currency
        type: string
      shipping_cents:
        required: false
        displayName: shipping_cents
        type: integer
        format: int32
      ship_countries:
        required: false
        displayName: ship_countries
        type:
        - string
        - nil
      stock:
        required: false
        displayName: stock
        type:
        - integer
        - nil
        format: int32
      delivery:
        required: false
        displayName: delivery
        type: string
        enum:
        - file
        - access_code
      access_url:
        required: false
        displayName: access_url
        type:
        - string
        - nil
      paypal_email:
        required: false
        displayName: paypal_email
        type:
        - string
        - nil
      seller_email:
        required: false
        displayName: seller_email
        type:
        - string
        - nil
      paypal_merchant_id:
        required: false
        displayName: paypal_merchant_id
        description: The connected PayPal account (`connectPayPal`). Sales go here when it can receive payments.
        type:
        - string
        - nil
      paypal_status:
        required: false
        displayName: paypal_status
        type: PayPalStatus | nil
      zapier_hook_url:
        required: false
        displayName: zapier_hook_url
        type:
        - string
        - nil
      in_gallery:
        required: false
        displayName: in_gallery
        type: boolean
      account_id:
        required: false
        displayName: account_id
        description: The seller account that owns the shop, if it was made while signed in.
        type:
        - string
        - nil
      options:
        required: false
        displayName: options
        type: array
        items:
          type: ShopOption
      option_stock:
        required: false
        example:
          value:
            M / Black: 4
            L / Black: 0
        displayName: option_stock
        description: Stock per combination, keyed by its values in option order joined with ` / ` (e.g. `M / Black`). A missing key or `null` means unlimited; `0` is sold out.
        type: object
        additionalProperties: true
        properties:
          //:
            type: integer
      suggestions:
        required: false
        displayName: suggestions
        type: Suggestions | nil
      photo_blob:
        required: false
        displayName: photo_blob
        description: Image id for `getImage`. The cover photo.
        type:
        - string
        - nil
      gallery_blobs:
        required: false
        displayName: gallery_blobs
        description: The other photos, in order.
        type: array
        items:
          type: string
      hero_blob:
        required: false
        displayName: hero_blob
        type:
        - string
        - nil
      hero_status:
        required: false
        displayName: hero_status
        type: string
        enum:
        - none
        - pending
        - ready
        - failed
      hero_error:
        required: false
        displayName: hero_error
        type:
        - string
        - nil
      ai_source:
        required: false
        displayName: ai_source
        type: string
        enum:
        - gemini
        - fallback
      source_url:
        required: false
        displayName: source_url
        type:
        - string
        - nil
      referral:
        required: false
        displayName: referral
        type: Referral | nil
      spec:
        required: true
        displayName: spec
        description: What Gemini designed. OneThing's templates render it; Gemini never writes HTML.
        type: DesignSpec
      created_at:
        required: false
        displayName: created_at
        type: datetime
  DesignSpec:
    displayName: DesignSpec
    description: What Gemini designed. OneThing's templates render it; Gemini never writes HTML.
    type: object
    properties:
      productType:
        required: true
        displayName: productType
        type: string
        enum:
        - digital
        - physical
      productName:
        required: true
        displayName: productName
        type: string
      layout:
        required: true
        displayName: layout
        type: string
        enum:
        - bold-hero
        - editorial
        - minimal
        - playful
      palette:
        required: true
        displayName: palette
        type: Palette
      fonts:
        required: true
        displayName: fonts
        type: Fonts
      eyebrow:
        required: false
        displayName: eyebrow
        type: string
      headline:
        required: true
        displayName: headline
        type: string
      subheadline:
        required: false
        displayName: subheadline
        type: string
      story:
        required: false
        displayName: story
        type: string
      bullets:
        required: true
        displayName: bullets
        type: array
        items:
          type: string
      details:
        required: false
        displayName: details
        type: array
        items:
          type: Detail
      faq:
        required: true
        displayName: faq
        type: array
        items:
          type: Faq
      ctaLabel:
        required: true
        displayName: ctaLabel
        type: string
      suggestedPriceUsd:
        required: false
        displayName: suggestedPriceUsd
        type: number
        format: double
      suggestedShippingUsd:
        required: false
        displayName: suggestedShippingUsd
        type: number
        format: double
      imageAlt:
        required: false
        displayName: imageAlt
        type: string
      heroPrompt:
        required: false
        displayName: heroPrompt
        type: string
  ShopOption:
    displayName: ShopOption
    description: Something the buyer picks, such as a size or a colour. The shop still sells one product.
    type: object
    properties:
      name:
        required: true
        example:
          value: Size
        displayName: name
        type: string
        maxLength: 20
      kind:
        required: true
        displayName: kind
        description: '`color` shows swatches, and the photo of the picked colour.'
        type: string
        enum:
        - size
        - color
        - other
      values:
        required: true
        displayName: values
        type: array
        uniqueItems: false
        minItems: 1
        maxItems: 12
        items:
          type: OptionValue
  OptionValue:
    displayName: OptionValue
    type: object
    properties:
      label:
        required: true
        example:
          value: M
        displayName: label
        type: string
        maxLength: 30
      hex:
        required: false
        example:
          value: '#14171a'
        displayName: hex
        type: string
        pattern: ^#[0-9a-fA-F]{6}$
      photo:
        required: false
        displayName: photo
        description: 'Colours: the shop photo (id) that shows this colour. See `matchColorPhotos`.'
        type: string
  Suggestions:
    displayName: Suggestions
    description: What Gemini thinks buyers will want to choose or ask. The seller confirms; nothing is applied on its own.
    type: object
    properties:
      oneOfAKind:
        required: true
        displayName: oneOfAKind
        description: A single item (vintage, handmade), so options and stock don't apply.
        type: boolean
      options:
        required: true
        displayName: options
        type: array
        items:
          type: Option
      missingFacts:
        required: true
        displayName: missingFacts
        type: array
        items:
          type: MissingFact
  PayPalStatus:
    displayName: PayPalStatus
    description: What PayPal last said about a connected seller account.
    type: object
    properties:
      receivable:
        required: true
        displayName: receivable
        description: The account can receive payments.
        type: boolean
      emailConfirmed:
        required: true
        displayName: emailConfirmed
        description: The seller has confirmed their email with PayPal.
        type: boolean
      checkedAt:
        required: true
        displayName: checkedAt
        type: datetime
  AgentProduct:
    displayName: AgentProduct
    description: A live shop as an AI agent sees it. Recommendations have `offers`; everything else has `price` and is bought with `create_order`.
    type: object
    properties:
      shop:
        required: true
        displayName: shop
        description: The link name, which the MCP tools take as `shop`.
        type: string
      url:
        required: true
        displayName: url
        type: string
      name:
        required: true
        displayName: name
        type: string
      kind:
        required: true
        displayName: kind
        type: string
        enum:
        - physical
        - digital
        - referral
      headline:
        required: true
        displayName: headline
        type: string
      description:
        required: true
        displayName: description
        type: string
      highlights:
        required: true
        displayName: highlights
        type: array
        items:
          type: string
      details:
        required: true
        displayName: details
        type: array
        items:
          type: Detail
      faq:
        required: true
        displayName: faq
        type: array
        items:
          type: Faq
      images:
        required: true
        displayName: images
        type: array
        items:
          type: string
      price:
        required: false
        displayName: price
        type: AgentMoney
      shipping:
        required: false
        displayName: shipping
        description: Physical products only.
        type: Shipping | nil
      total:
        required: false
        displayName: total
        type: AgentMoney
      delivery:
        required: false
        example:
          value: Shipped. PayPal collects the buyer's address at checkout.
        displayName: delivery
        type: string
      availability:
        required: false
        examples:
          Untitled Example1:
            value: in_stock
          Untitled Example2:
            value: in_stock (3 left)
          Untitled Example3:
            value: sold_out
        displayName: availability
        type: string
      options:
        required: false
        displayName: options
        description: Pass one value per option to `create_order`.
        type: array
        items:
          type: Option1
      variants:
        required: false
        displayName: variants
        type: array
        items:
          type: Variant
      order_url:
        required: false
        displayName: order_url
        description: 'Products without options: `orderByLink`, which orders one unit with a GET. Left out when sold out. With options, each variant has its own.'
        type: string
      offers:
        required: false
        displayName: offers
        description: Recommendations only. Bought at the retailer.
        type: array
        items:
          type: Offer1
      how_to_buy:
        required: true
        displayName: how_to_buy
        type: string
      mcp_server:
        required: false
        displayName: mcp_server
        description: The MCP server to order through (`getAgentProduct` only).
        type: string
  AgentShopSummary:
    displayName: AgentShopSummary
    type: object
    properties:
      shop:
        required: true
        displayName: shop
        description: The link name, for `getAgentProduct` and the MCP tools.
        type: string
      name:
        required: true
        displayName: name
        type: string
      kind:
        required: true
        displayName: kind
        type: string
        enum:
        - physical
        - digital
        - referral
      headline:
        required: true
        displayName: headline
        type: string
      price:
        required: true
        displayName: price
        description: The price label, e.g. `$2.99`; null for recommendations.
        type:
        - string
        - nil
      url:
        required: true
        displayName: url
        description: The shop page.
        type: string
  AgentCreatedOrder:
    displayName: AgentCreatedOrder
    description: A new order, as `create_order` and `orderByLink` return it.
    type: object
    properties:
      order_id:
        required: true
        displayName: order_id
        type: string
      status:
        required: true
        displayName: status
        type: string
        enum:
        - awaiting_buyer_approval
      total:
        required: true
        displayName: total
        description: The total with shipping, as a label.
        type: string
      options:
        required: false
        example:
          value:
            Size: M
            Color: Black
        displayName: options
        description: The buyer's pick, one value per option, keyed by option name.
        type: object
        additionalProperties: true
        properties:
          //:
            type: string
      pay_url:
        required: true
        displayName: pay_url
        description: Where the buyer pays (redirects to PayPal). Safe to show in chat.
        type: string
      status_url:
        required: true
        displayName: status_url
        description: '`getAgentOrder` for this order.'
        type: string
      next_step:
        required: true
        displayName: next_step
        type: string
  AgentOrder:
    displayName: AgentOrder
    description: An order as `get_order` and `getAgentOrder` report it.
    type: object
    properties:
      order_id:
        required: true
        displayName: order_id
        type: string
      status:
        required: true
        displayName: status
        description: "`declined`: PayPal declined it, nothing charged, the buyer can open `pay_url` again. `sold_out`: it sold out before the payment was captured. `expired`: the PayPal checkout expired; create a new order. `failed`: PayPal couldn't be reached; ask again."
        type: string
        enum:
        - awaiting_buyer_approval
        - paid
        - declined
        - sold_out
        - expired
        - failed
      product:
        required: true
        displayName: product
        type: string
      options:
        required: false
        example:
          value:
            Size: M
            Color: Black
        displayName: options
        description: The buyer's pick, one value per option, keyed by option name.
        type: object
        additionalProperties: true
        properties:
          //:
            type: string
      amount:
        required: true
        displayName: amount
        type: Amount
      total:
        required: true
        displayName: total
        description: The total as a label, e.g. `$255.00`.
        type: string
      pay_url:
        required: false
        displayName: pay_url
        description: Unpaid orders (waiting or declined). The buyer pays here; safe to show in chat.
        type: string
      next_step:
        required: false
        displayName: next_step
        description: Unpaid orders. What the agent should do next, in plain words.
        type: string
      paid_at:
        required: false
        displayName: paid_at
        type: datetime
      receipt_url:
        required: false
        displayName: receipt_url
        description: Paid orders. The buyer's thank-you page.
        type: string
      delivery:
        required: false
        displayName: delivery
        description: Paid orders. What the buyer got.
        type: AgentDeliveryAccessCode | AgentDeliveryDownload | AgentDeliveryShipping
  AgentDeliveryAccessCode:
    displayName: AgentDeliveryAccessCode
    description: A digital product unlocked with an access code.
    type: object
    properties:
      type:
        required: true
        displayName: type
        type: string
        enum:
        - access_code
      access_code:
        required: true
        displayName: access_code
        type: string
      start_url:
        required: false
        displayName: start_url
        description: The seller's app with the code filled in.
        type: string
  AgentDeliveryDownload:
    displayName: AgentDeliveryDownload
    description: A digital file to download.
    type: object
    properties:
      type:
        required: true
        displayName: type
        type: string
        enum:
        - download
      download_url:
        required: true
        displayName: download_url
        type: string
      note:
        required: false
        displayName: note
        type: string
  AgentDeliveryShipping:
    displayName: AgentDeliveryShipping
    description: A physical product shipped to the buyer.
    type: object
    properties:
      type:
        required: true
        displayName: type
        type: string
        enum:
        - shipping
      ship_to:
        required: false
        displayName: ship_to
        type:
        - ShipTo
        - nil
      fulfillment:
        required: true
        displayName: fulfillment
        type: string
        enum:
        - to_ship
        - shipped
      tracking:
        required: false
        displayName: tracking
        type:
        - Tracking
        - nil
  PlatformShop:
    displayName: PlatformShop
    type: object
    properties:
      slug:
        required: true
        displayName: slug
        type: string
      status:
        required: true
        displayName: status
        type: string
        enum:
        - draft
        - live
      name:
        required: true
        displayName: name
        type: string
      headline:
        required: false
        displayName: headline
        type: string
      product_type:
        required: true
        displayName: product_type
        type: string
        enum:
        - physical
        - digital
        - referral
      price:
        required: true
        displayName: price
        type: AgentMoney
      url:
        required: true
        displayName: url
        description: The shop page buyers pay on.
        type: string
      cover:
        required: false
        displayName: cover
        description: The cover image's URL.
        type:
        - string
        - nil
      paypal_connected:
        required: true
        displayName: paypal_connected
        description: The seller connected a PayPal account that can be paid.
