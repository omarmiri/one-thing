            shipping_address:
              address_line_1: 1 Main St
              admin_area_2: Springfield
              admin_area_1: IL
              postal_code: '62701'
              country_code: US
            fulfillment_status: to_ship
            tracking_number: '9400111899223197428490'
            carrier: USPS
        displayName: order
        description: The order.
        type: Order1
  Amount:
    example:
      value:
        item: 240
        shipping: 15
        total: 255
        currency: USD
    displayName: Amount
    description: What the order costs, as numbers.
    type: object
    properties:
      item:
        required: true
        example:
          value: 240
        displayName: item
        description: The product's price.
        type: number
        format: double
      shipping:
        required: true
        example:
          value: 15
        displayName: shipping
        description: Shipping; 0 for digital products.
        type: number
        format: double
      total:
        required: true
        example:
          value: 255
        displayName: total
        description: 'Product plus shipping: what the buyer pays.'
        type: number
        format: double
      currency:
        required: true
        example:
          value: USD
        displayName: currency
        description: ISO 4217 currency code.
        type: string
  ApiAccessVerifyRequest:
    displayName: ApiAccessVerifyRequest
    description: The code to check, and which shop it's for.
    type: object
    properties:
      shop:
        required: true
        example:
          value: raptorrush
        displayName: shop
        description: The shop's link name.
        type: string
      code:
        required: true
        example:
          value: K7QF-M2XP-9HTD
        displayName: code
        description: The access code the buyer entered. Case and dashes don't matter.
        type: string
  ApiAccessVerifyResponse:
    displayName: ApiAccessVerifyResponse
    description: Whether the code is valid.
    type: object
    properties:
      valid:
        required: true
        example:
          value: true
        displayName: valid
        description: True if the code belongs to a paid, unrefunded order for this shop.
        type: boolean
      product:
        required: false
        example:
          value: Vintage Cream and Red Roller Skates
        displayName: product
        description: The product name, when valid.
        type: string
  ApiAccountSigninRequest:
    displayName: ApiAccountSigninRequest
    description: Who is signing in.
    type: object
    properties:
      identifier:
        required: true
        examples:
          Untitled Example1:
            value: maker@example.com
          Untitled Example2:
            value: +1 555 123 4567
        displayName: identifier
        description: An email address, or a phone number (spaces, dashes and brackets are ignored; keep a leading +).
        type: string
  ApiAccountSigninResponse:
    displayName: ApiAccountSigninResponse
    description: The signed-in account.
    type: object
    properties:
      id:
        required: true
        example:
          value: acc_Vq3nN8cT0bLx2YwE
        displayName: id
        description: The account's id.
        type: string
      email:
        required: true
        example:
          value: maker@example.com
        displayName: email
        description: Lower-cased.
        type:
        - string
        - nil
      phone:
        required: true
        example:
          value: '+15555550123'
        displayName: phone
        description: Digits, with a leading + if one was given.
        type:
        - string
        - nil
  ApiAgentShopsResponse:
    displayName: ApiAgentShopsResponse
    description: The matching shops, with a reply to show the buyer.
    type: object
    properties:
      show_buyer:
        required: true
        example:
          value: '![Vintage Cream and Red Roller Skates](https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X)


            **Vintage Cream and Red Roller Skates**: $240.00. Classic quad skates crafted with walnut burl heels


            ![Raptor Rush: Browser Edition](https://one-thing-ash0.onrender.com/api/blobs/R9tWc3yN6bJq1zUd)


            **Raptor Rush: Browser Edition**: $2.99. Grow from Tiny Hatchling to Giant Apex Predator


            Which one?'
        displayName: show_buyer
        description: "A suggested reply to the buyer, in Markdown: each shop's cover photo as an image, its name, price and headline, then \"Which one?\". Chats that block images from other sites just leave the image lines out."
        type: string
      shops:
        required: true
        example:
          value:
          - shop: vintageskates
            name: Vintage Cream and Red Roller Skates
            kind: physical
            headline: Classic quad skates crafted with walnut burl heels
            price: $240.00
            image: 'https://one-thing-ash0.onrender.com/api/blobs/LFRvGuTU3D8i334X'
            url: https://one-thing-ash0.onrender.com/vintageskates
        displayName: shops
        description: Shops, best match first.
        type: array
        items:
          type: AgentShopSummary
      matched:
        required: true
        example:
          value: true
        displayName: matched
        description: False when nothing matched the query and `shops` is the newest gallery shops instead; `show_buyer` then starts by saying so.
        type: boolean
      mcp_server:
        required: true
        example:
          value: https://one-thing-ash0.onrender.com/api/mcp
        displayName: mcp_server
        description: The MCP server to order through.
        type: string
  ApiChannel3SearchResponse:
    displayName: ApiChannel3SearchResponse
    description: The products found.
    type: object
    properties:
      products:
        required: true
        example:
          value:
          - id: ch3_7f2a9c1e
            title: Trail Running Vest 5L
            brand: Salomon
            image: https://images.example.com/vest.jpg
            price: 240
            currency: USD
            retailer: rei.com
            retailers: 4
            commission: 0.08
        displayName: products
        description: Products, best match first.
        type: array
        items:
          type: ProductCard
  ApiOrdersCapture409Error1:
    example:
      value:
        status: pending
