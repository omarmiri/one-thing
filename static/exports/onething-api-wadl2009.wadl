      <xs:complexType name="Error">
        <xs:sequence>
          <xs:element minOccurs="1" name="error" type="xs:string">
            <xs:annotation>
              <xs:documentation>A sentence you can show to a person.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="field" type="xs:string">
            <xs:annotation>
              <xs:documentation>The form field at fault, when there is one.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="detail" type="xs:string">
            <xs:annotation>
              <xs:documentation>The upstream service's own message, for debugging.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="CreateShopForm">
        <xs:sequence>
          <xs:element minOccurs="1" name="source" type="schemas:Source" />
          <xs:element minOccurs="0" name="photo" type="xs:hexBinary">
            <xs:annotation>
              <xs:documentation>`source=photo`: the product photo, up to 8 MB.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="description" type="xs:string">
            <xs:annotation>
              <xs:documentation>`source=photo`: a sentence or two about the product. Required if there is no photo.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="url">
            <xs:simpleType>
              <xs:annotation>
                <xs:documentation>`source=link`: a product page, or your own app or game page.</xs:documentation>
              </xs:annotation>
              <xs:restriction base="xs:string" />
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" name="productId" type="xs:string">
            <xs:annotation>
              <xs:documentation>`source=channel3`: a product id from `searchProducts`.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="slug" type="xs:string">
            <xs:annotation>
              <xs:documentation>The link name you want. If omitted, the AI suggests one.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" default="auto" name="type" type="schemas:Type" />
          <xs:element minOccurs="0" name="delivery" type="schemas:Delivery">
            <xs:annotation>
              <xs:documentation>For digital products. If omitted, the AI guesses.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="access_url">
            <xs:simpleType>
              <xs:annotation>
                <xs:documentation>Where buyers use an access code.</xs:documentation>
              </xs:annotation>
              <xs:restriction base="xs:string" />
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" name="price" type="xs:double">
            <xs:annotation>
              <xs:documentation>USD. If omitted, the AI suggests a price.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="shipping" type="xs:double" />
          <xs:element minOccurs="0" name="stock" type="xs:integer" />
          <xs:element minOccurs="0" name="ship_countries" type="xs:string" />
          <xs:element minOccurs="0" name="paypal_email">
            <xs:simpleType>
              <xs:restriction base="xs:string" />
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" name="seller_email">
            <xs:simpleType>
              <xs:restriction base="xs:string" />
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" name="digital_file" type="xs:hexBinary" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="CreatedShop">
        <xs:sequence>
          <xs:element minOccurs="1" name="slug" type="xs:string" />
          <xs:element minOccurs="1" name="token" type="xs:string">
            <xs:annotation>
              <xs:documentation>The admin token. Shown once; store it.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="manageUrl" type="xs:string">
            <xs:annotation>
              <xs:documentation>The seller's private manage page (contains the token).</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ShopUpdate">
        <xs:sequence>
          <xs:element minOccurs="0" name="slug" type="xs:string" />
          <xs:element minOccurs="0" name="status" type="schemas:Status" />
          <xs:element minOccurs="0" name="product_type" type="schemas:ProductType">
            <xs:annotation>
              <xs:documentation>`referral` only for shops created from Channel3.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="price">
            <xs:simpleType>
              <xs:restriction base="xs:double">
                <xs:maxInclusive value="10000" />
                <xs:minInclusive value="0.5" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" name="shipping">
            <xs:simpleType>
              <xs:restriction base="xs:double">
                <xs:maxInclusive value="500" />
                <xs:minInclusive value="0" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" name="stock" nillable="true">
            <xs:simpleType>
              <xs:restriction base="xs:integer">
                <xs:minInclusive value="0" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" name="ship_countries" nillable="true" type="xs:string" />
          <xs:element minOccurs="0" name="delivery" type="schemas:Delivery1" />
          <xs:element minOccurs="0" name="access_url" nillable="true">
            <xs:simpleType>
              <xs:restriction base="xs:string" />
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" name="paypal_email" nillable="true">
            <xs:simpleType>
              <xs:restriction base="xs:string" />
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" name="seller_email" nillable="true">
            <xs:simpleType>
              <xs:restriction base="xs:string" />
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" name="zapier_hook_url" nillable="true">
            <xs:simpleType>
              <xs:restriction base="xs:string" />
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" name="in_gallery" type="xs:boolean">
            <xs:annotation>
              <xs:documentation>Feature the shop at `/gallery` while it's live. Off by default.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" maxOccurs="unbounded" name="options" type="schemas:ShopOption">
            <xs:annotation>
              <xs:documentation>What the buyer picks (physical products only), replacing the current options; `[]` removes them. With options, stock is counted per combination in `option_stock` and the shop's own `stock` is cleared. At most 60 combinations.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="option_stock">
            <xs:simpleType>
              <xs:annotation>
                <xs:documentation>Stock per combination, keyed by its values in option order joined with ` / ` (e.g. `M / Black`). A missing key or `null` means unlimited; `0` is sold out.</xs:documentation>
              </xs:annotation>
              <xs:restriction base="xs:integer">
                <xs:minInclusive value="0" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" maxOccurs="unbounded" name="facts" type="schemas:Fact">
            <xs:annotation>
              <xs:documentation>Answers to the "buyers will ask" questions in `suggestions.missingFacts`. Each becomes a product detail on the page (replacing one with the same label) and drops off the list.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="Shop">
        <xs:sequence>
          <xs:element minOccurs="1" name="id" type="xs:string" />
          <xs:element minOccurs="1" name="slug" type="xs:string" />
          <xs:element minOccurs="1" name="status" type="schemas:Status" />
          <xs:element minOccurs="1" name="product_type" type="schemas:ProductType1" />
          <xs:element minOccurs="1" name="price_cents" type="xs:integer" />
          <xs:element minOccurs="1" name="currency" type="xs:string" />
          <xs:element minOccurs="0" name="shipping_cents" type="xs:integer" />
          <xs:element minOccurs="0" name="ship_countries" nillable="true" type="xs:string" />
          <xs:element minOccurs="0" name="stock" nillable="true" type="xs:integer" />
          <xs:element minOccurs="0" name="delivery" type="schemas:Delivery1" />
          <xs:element minOccurs="0" name="access_url" nillable="true" type="xs:string" />
          <xs:element minOccurs="0" name="paypal_email" nillable="true" type="xs:string" />
          <xs:element minOccurs="0" name="seller_email" nillable="true" type="xs:string" />
          <xs:element minOccurs="0" name="paypal_merchant_id" nillable="true" type="xs:string">
            <xs:annotation>
              <xs:documentation>The connected PayPal account (`connectPayPal`). Sales go here when it can receive payments.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="paypal_status" nillable="true" type="schemas:PayPalStatus" />
          <xs:element minOccurs="0" name="zapier_hook_url" nillable="true" type="xs:string" />
          <xs:element minOccurs="0" name="in_gallery" type="xs:boolean" />
          <xs:element minOccurs="0" name="account_id" nillable="true" type="xs:string">
            <xs:annotation>
              <xs:documentation>The seller account that owns the shop, if it was made while signed in.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" maxOccurs="unbounded" name="options" type="schemas:ShopOption" />
          <xs:element minOccurs="0" name="option_stock">
            <xs:simpleType>
              <xs:annotation>
                <xs:documentation>Stock per combination, keyed by its values in option order joined with ` / ` (e.g. `M / Black`). A missing key or `null` means unlimited; `0` is sold out.</xs:documentation>
              </xs:annotation>
              <xs:restriction base="xs:integer">
                <xs:minInclusive value="0" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" name="suggestions" nillable="true" type="schemas:Suggestions" />
          <xs:element minOccurs="0" name="photo_blob" nillable="true" type="xs:string">
            <xs:annotation>
              <xs:documentation>Image id for `getImage`. The cover photo.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" maxOccurs="unbounded" name="gallery_blobs" type="xs:string">
            <xs:annotation>
              <xs:documentation>The other photos, in order.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="hero_blob" nillable="true" type="xs:string" />
          <xs:element minOccurs="0" name="hero_status" type="schemas:HeroStatus" />
          <xs:element minOccurs="0" name="hero_error" nillable="true" type="xs:string" />
          <xs:element minOccurs="0" name="ai_source" type="schemas:AiSource" />
          <xs:element minOccurs="0" name="source_url" nillable="true" type="xs:string" />
          <xs:element minOccurs="0" name="referral" nillable="true" type="schemas:Referral" />
          <xs:element minOccurs="1" name="spec" type="schemas:DesignSpec">
            <xs:annotation>
              <xs:documentation>What Gemini designed. OneThing's templates render it; Gemini never writes HTML.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="created_at" type="xs:dateTime" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="DesignSpec">
        <xs:annotation>
          <xs:documentation>What Gemini designed. OneThing's templates render it; Gemini never writes HTML.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
          <xs:element minOccurs="1" name="productType" type="schemas:ProductType2" />
          <xs:element minOccurs="1" name="productName" type="xs:string" />
          <xs:element minOccurs="1" name="layout" type="schemas:Layout" />
          <xs:element minOccurs="1" name="palette" type="schemas:Palette" />
          <xs:element minOccurs="1" name="fonts" type="schemas:Fonts" />
          <xs:element minOccurs="0" name="eyebrow" type="xs:string" />
          <xs:element minOccurs="1" name="headline" type="xs:string" />
          <xs:element minOccurs="0" name="subheadline" type="xs:string" />
          <xs:element minOccurs="0" name="story" type="xs:string" />
          <xs:element minOccurs="1" maxOccurs="unbounded" name="bullets" type="xs:string" />
          <xs:element minOccurs="0" maxOccurs="unbounded" name="details" type="schemas:Detail" />
          <xs:element minOccurs="1" maxOccurs="unbounded" name="faq" type="schemas:Faq" />
          <xs:element minOccurs="1" name="ctaLabel" type="xs:string" />
          <xs:element minOccurs="0" name="suggestedPriceUsd" type="xs:double" />
          <xs:element minOccurs="0" name="suggestedShippingUsd" type="xs:double" />
          <xs:element minOccurs="0" name="imageAlt" type="xs:string" />
          <xs:element minOccurs="0" name="heroPrompt" type="xs:string" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ShopOption">
        <xs:annotation>
          <xs:documentation>Something the buyer picks, such as a size or a colour. The shop still sells one product.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
          <xs:element minOccurs="1" name="name">
            <xs:simpleType>
              <xs:restriction base="xs:string">
                <xs:maxLength value="20" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="1" name="kind" type="schemas:Kind">
            <xs:annotation>
              <xs:documentation>`color` shows swatches, and the photo of the picked colour.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" maxOccurs="unbounded" name="values" type="schemas:OptionValue" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="OptionValue">
        <xs:sequence>
          <xs:element minOccurs="1" name="label">
            <xs:simpleType>
              <xs:restriction base="xs:string">
                <xs:maxLength value="30" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" name="hex">
            <xs:simpleType>
              <xs:restriction base="xs:string">
                <xs:pattern value="^#[0-9a-fA-F]{6}$" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" name="photo" type="xs:string">
            <xs:annotation>
              <xs:documentation>Colours: the shop photo (id) that shows this colour. See `matchColorPhotos`.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="Suggestions">
        <xs:annotation>
          <xs:documentation>What Gemini thinks buyers will want to choose or ask. The seller confirms; nothing is applied on its own.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
          <xs:element minOccurs="1" name="oneOfAKind" type="xs:boolean">
            <xs:annotation>
              <xs:documentation>A single item (vintage, handmade), so options and stock don't apply.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" maxOccurs="unbounded" name="options" type="schemas:Option" />
          <xs:element minOccurs="1" maxOccurs="unbounded" name="missingFacts" type="schemas:MissingFact" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="PayPalStatus">
        <xs:annotation>
          <xs:documentation>What PayPal last said about a connected seller account.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
          <xs:element minOccurs="1" name="receivable" type="xs:boolean">
            <xs:annotation>
              <xs:documentation>The account can receive payments.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="emailConfirmed" type="xs:boolean">
            <xs:annotation>
              <xs:documentation>The seller has confirmed their email with PayPal.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="checkedAt" type="xs:dateTime" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="AgentProduct">
        <xs:annotation>
          <xs:documentation>A live shop as an AI agent sees it. Recommendations have `offers`; everything else has `price` and is bought with `create_order`.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
          <xs:element minOccurs="0" name="show_buyer" type="xs:string">
            <xs:annotation>
              <xs:documentation>A suggested reply to the buyer, in Markdown with the links already written as links: the product and its options to pick from, the pay link, or what they got with a receipt link. Buyers have the best experience when agents show it as written.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="agent_name" type="xs:string">
            <xs:annotation>
              <xs:documentation>Who this request was credited to in the seller's stats: a recognised user agent, else the name the agent gave itself (`?agent=`, or the MCP client's name), else the user agent's first word.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="shop" type="xs:string">
            <xs:annotation>
              <xs:documentation>The link name, which the MCP tools take as `shop`.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="url" type="xs:string" />
          <xs:element minOccurs="1" name="name" type="xs:string" />
          <xs:element minOccurs="1" name="kind" type="schemas:Kind1" />
          <xs:element minOccurs="1" name="headline" type="xs:string" />
          <xs:element minOccurs="1" name="description" type="xs:string" />
          <xs:element minOccurs="1" maxOccurs="unbounded" name="highlights" type="xs:string" />
          <xs:element minOccurs="1" maxOccurs="unbounded" name="details" type="schemas:Detail" />
          <xs:element minOccurs="1" maxOccurs="unbounded" name="faq" type="schemas:Faq" />
          <xs:element minOccurs="1" maxOccurs="unbounded" name="images" type="xs:string" />
          <xs:element minOccurs="0" name="price" type="schemas:AgentMoney" />
          <xs:element minOccurs="0" name="shipping" nillable="true" type="schemas:Shipping">
            <xs:annotation>
              <xs:documentation>Physical products only.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="total" type="schemas:AgentMoney" />
          <xs:element minOccurs="0" name="delivery" type="xs:string" />
          <xs:element minOccurs="0" name="availability" type="xs:string" />
          <xs:element minOccurs="0" maxOccurs="unbounded" name="options" type="schemas:Option1">
            <xs:annotation>
              <xs:documentation>Pass one value per option to `create_order`.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" maxOccurs="unbounded" name="variants" type="schemas:Variant" />
          <xs:element minOccurs="0" name="order_url" type="xs:string">
            <xs:annotation>
              <xs:documentation>Products without options: `orderByLink`, which orders one unit with a GET. Left out when sold out. With options, each variant has its own.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" maxOccurs="unbounded" name="offers" type="schemas:Offer1">
            <xs:annotation>
              <xs:documentation>Recommendations only. Bought at the retailer.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="how_to_buy" type="xs:string" />
          <xs:element minOccurs="0" name="mcp_server" type="xs:string">
            <xs:annotation>
              <xs:documentation>The MCP server to order through (`getAgentProduct` only).</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="AgentShopSummary">
        <xs:sequence>
          <xs:element minOccurs="1" name="shop" type="xs:string">
            <xs:annotation>
              <xs:documentation>The link name, for `getAgentProduct` and the MCP tools.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="name" type="xs:string" />
          <xs:element minOccurs="1" name="kind" type="schemas:Kind1" />
          <xs:element minOccurs="1" name="headline" type="xs:string" />
          <xs:element minOccurs="1" name="price" nillable="true" type="xs:string">
            <xs:annotation>
              <xs:documentation>The price label, e.g. `$2.99`; null for recommendations.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="image" nillable="true" type="xs:string">
            <xs:annotation>
              <xs:documentation>The cover photo's URL (WebP; the retailer's image for a recommendation), or null when there's none.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="url" type="xs:string">
            <xs:annotation>
              <xs:documentation>The shop page.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="AgentCreatedOrder">
        <xs:annotation>
          <xs:documentation>A new order, as `create_order` and `orderByLink` return it.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
          <xs:element minOccurs="0" name="show_buyer" type="xs:string">
            <xs:annotation>
              <xs:documentation>A suggested reply to the buyer, in Markdown with the links already written as links: the product and its options to pick from, the pay link, or what they got with a receipt link. Buyers have the best experience when agents show it as written.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="agent_name" type="xs:string">
            <xs:annotation>
              <xs:documentation>Who this request was credited to in the seller's stats: a recognised user agent, else the name the agent gave itself (`?agent=`, or the MCP client's name), else the user agent's first word.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="order_id" type="xs:string" />
          <xs:element minOccurs="1" fixed="awaiting_buyer_approval" name="status" type="xs:string" />
          <xs:element minOccurs="1" name="total" type="xs:string">
            <xs:annotation>
              <xs:documentation>The total with shipping, as a label.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="options" type="xs:string">
            <xs:annotation>
              <xs:documentation>The buyer's pick, one value per option, keyed by option name.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="pay_url" type="xs:string">
            <xs:annotation>
              <xs:documentation>Where the buyer pays (redirects to PayPal). Safe to show in chat.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="status_url" type="xs:string">
            <xs:annotation>
              <xs:documentation>`getAgentOrder` for this order.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="next_step" type="xs:string" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="AgentOrder">
        <xs:annotation>
          <xs:documentation>An order as `get_order` and `getAgentOrder` report it.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
          <xs:element minOccurs="0" name="show_buyer" type="xs:string">
            <xs:annotation>
              <xs:documentation>A suggested reply to the buyer, in Markdown with the links already written as links: the product and its options to pick from, the pay link, or what they got with a receipt link. Buyers have the best experience when agents show it as written.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="agent_name" type="xs:string">
            <xs:annotation>
              <xs:documentation>Who this request was credited to in the seller's stats: a recognised user agent, else the name the agent gave itself (`?agent=`, or the MCP client's name), else the user agent's first word.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="order_id" type="xs:string" />
          <xs:element minOccurs="1" name="status" type="schemas:Status2">
            <xs:annotation>
              <xs:documentation>`declined`: PayPal declined it, nothing charged, the buyer can open `pay_url` again. `sold_out`: it sold out before the payment was captured. `expired`: the PayPal checkout expired; create a new order. `failed`: PayPal couldn't be reached; ask again.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="product" type="xs:string" />
          <xs:element minOccurs="0" name="options" type="xs:string">
            <xs:annotation>
              <xs:documentation>The buyer's pick, one value per option, keyed by option name.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="amount" type="schemas:Amount" />
          <xs:element minOccurs="1" name="total" type="xs:string">
            <xs:annotation>
              <xs:documentation>The total as a label, e.g. `$255.00`.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="pay_url" type="xs:string">
            <xs:annotation>
              <xs:documentation>Unpaid orders (waiting or declined). The buyer pays here; safe to show in chat.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="next_step" type="xs:string">
            <xs:annotation>
              <xs:documentation>Unpaid orders. What the agent should do next, in plain words.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="paid_at" type="xs:dateTime" />
          <xs:element minOccurs="0" name="receipt_url" type="xs:string">
            <xs:annotation>
              <xs:documentation>Paid orders. The buyer's thank-you page.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="delivery" type="xs:anyType">
            <xs:annotation>
              <xs:documentation>Paid orders. What the buyer got.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="AgentDeliveryAccessCode">
        <xs:annotation>
          <xs:documentation>A digital product unlocked with an access code.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
          <xs:element minOccurs="1" fixed="access_code" name="type" type="xs:string" />
          <xs:element minOccurs="1" name="access_code" type="xs:string" />
          <xs:element minOccurs="0" name="start_url" type="xs:string">
            <xs:annotation>
              <xs:documentation>The seller's app with the code filled in.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="AgentDeliveryDownload">
        <xs:annotation>
          <xs:documentation>A digital file to download.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
          <xs:element minOccurs="1" fixed="download" name="type" type="xs:string" />
          <xs:element minOccurs="1" name="download_url" type="xs:string" />
          <xs:element minOccurs="0" name="note" type="xs:string" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="AgentDeliveryShipping">
        <xs:annotation>
          <xs:documentation>A physical product shipped to the buyer.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
          <xs:element minOccurs="1" fixed="shipping" name="type" type="xs:string" />
          <xs:element minOccurs="0" name="ship_to" nillable="true" type="schemas:ShipTo" />
          <xs:element minOccurs="1" name="fulfillment" type="schemas:Fulfillment" />
          <xs:element minOccurs="0" name="tracking" nillable="true" type="schemas:Tracking" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="PlatformShop">
        <xs:sequence>
          <xs:element minOccurs="1" name="slug" type="xs:string" />
          <xs:element minOccurs="1" name="status" type="schemas:Status" />
          <xs:element minOccurs="1" name="name" type="xs:string" />
          <xs:element minOccurs="0" name="headline" type="xs:string" />
          <xs:element minOccurs="1" name="product_type" type="schemas:ProductType1" />
          <xs:element minOccurs="1" name="price" type="schemas:AgentMoney" />
          <xs:element minOccurs="1" name="url" type="xs:string">
            <xs:annotation>
              <xs:documentation>The shop page buyers pay on.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="cover" nillable="true" type="xs:string">
            <xs:annotation>
              <xs:documentation>The cover image's URL.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="paypal_connected" type="xs:boolean">
            <xs:annotation>
              <xs:documentation>The seller connected a PayPal account that can be paid.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="sales" type="xs:integer">
            <xs:annotation>
              <xs:documentation>Paid orders.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="created_at" type="xs:dateTime" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="AgentMoney">
        <xs:sequence>
          <xs:element minOccurs="1" name="amount" type="xs:double" />
          <xs:element minOccurs="1" name="currency" type="xs:string" />
          <xs:element minOccurs="0" name="label" type="xs:string" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="JsonRpcRequest">
        <xs:sequence>
          <xs:element minOccurs="1" fixed="2.0" name="jsonrpc" type="xs:string" />
          <xs:element minOccurs="0" name="id" nillable="true" type="xs:anyType">
            <xs:annotation>
              <xs:documentation>Leave out for a notification.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="method" type="schemas:Method" />
          <xs:element minOccurs="0" name="params">
            <xs:annotation>
              <xs:documentation>For `tools/call`: `{ name, arguments }`.</xs:documentation>
            </xs:annotation>
            <xs:complexType>
              <xs:sequence>
                <xs:any />
              </xs:sequence>
            </xs:complexType>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="JsonRpcResponse">
        <xs:sequence>
          <xs:element minOccurs="1" fixed="2.0" name="jsonrpc" type="xs:string" />
          <xs:element minOccurs="1" name="id" nillable="true" type="xs:anyType" />
          <xs:element minOccurs="0" name="result">
            <xs:annotation>
              <xs:documentation>For `tools/call`: `content` (the answer as JSON text), `structuredContent` (the same object) and `isError`.</xs:documentation>
            </xs:annotation>
            <xs:complexType>
              <xs:sequence>
                <xs:any />
              </xs:sequence>
            </xs:complexType>
          </xs:element>
          <xs:element minOccurs="0" name="error" type="schemas:Error1" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="Referral">
        <xs:annotation>
          <xs:documentation>A recommended Channel3 product. Buy links are Channel3-tracked, credited to this shop.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
          <xs:element minOccurs="1" name="productId" type="xs:string" />
          <xs:element minOccurs="1" name="title" type="xs:string" />
          <xs:element minOccurs="0" name="brand" nillable="true" type="xs:string" />
          <xs:element minOccurs="0" name="image" nillable="true" type="xs:string" />
          <xs:element minOccurs="1" maxOccurs="unbounded" name="offers" type="schemas:Offer" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ProductCard">
        <xs:sequence>
          <xs:element minOccurs="1" name="id" type="xs:string" />
          <xs:element minOccurs="1" name="title" type="xs:string" />
          <xs:element minOccurs="0" name="brand" nillable="true" type="xs:string" />
          <xs:element minOccurs="1" name="image" type="xs:string" />
          <xs:element minOccurs="1" name="price" type="xs:double" />
          <xs:element minOccurs="1" name="currency" type="xs:string" />
          <xs:element minOccurs="1" name="retailer" type="xs:string">
            <xs:annotation>
              <xs:documentation>The store with the best offer.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="retailers" type="xs:integer" />
          <xs:element minOccurs="1" name="commission" type="xs:double">
            <xs:annotation>
              <xs:documentation>Best commission rate across offers, 0–1.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="Order">
        <xs:sequence>
          <xs:element minOccurs="1" name="id" type="xs:string" />
          <xs:element minOccurs="0" name="paypal_order_id" nillable="true" type="xs:string" />
          <xs:element minOccurs="1" name="status" type="schemas:Status4" />
          <xs:element minOccurs="1" name="amount_cents" type="xs:integer" />
          <xs:element minOccurs="0" name="shipping_cents" type="xs:integer" />
          <xs:element minOccurs="1" name="currency" type="xs:string" />
          <xs:element minOccurs="0" name="buyer_email" nillable="true" type="xs:string" />
          <xs:element minOccurs="0" name="buyer_name" nillable="true" type="xs:string" />
          <xs:element minOccurs="0" name="shipping_address" nillable="true" type="xs:string" />
          <xs:element minOccurs="0" name="capture_id" nillable="true" type="xs:string" />
          <xs:element minOccurs="1" name="fulfillment_status" type="schemas:FulfillmentStatus" />
          <xs:element minOccurs="0" name="carrier" nillable="true" type="xs:string" />
          <xs:element minOccurs="0" name="tracking_number" nillable="true" type="xs:string" />
          <xs:element minOccurs="0" name="tracking_synced" type="xs:boolean" />
          <xs:element minOccurs="0" name="downloads" type="xs:integer" />
          <xs:element minOccurs="0" name="access_code" nillable="true" type="xs:string" />
          <xs:element minOccurs="0" name="code_uses" type="xs:integer" />
          <xs:element minOccurs="0" name="code_last_used_at" nillable="true" type="xs:dateTime" />
          <xs:element minOccurs="0" name="channel" type="schemas:Channel">
            <xs:annotation>
              <xs:documentation>`agent` for orders an AI agent placed (MCP or an order link).</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="agent" nillable="true" type="xs:string">
            <xs:annotation>
              <xs:documentation>The agent credited with an agent order, such as `Grok`.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="refund_id" nillable="true" type="xs:string">
            <xs:annotation>
              <xs:documentation>PayPal's refund id, once refunded through OneThing.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="refunded_at" nillable="true" type="xs:dateTime" />
          <xs:element minOccurs="0" name="options" nillable="true" type="xs:string">
            <xs:annotation>
              <xs:documentation>The buyer's pick, one value per option, keyed by option name (see `Choice`).</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="paid_at" nillable="true" type="xs:dateTime" />
          <xs:element minOccurs="0" name="created_at" type="xs:dateTime" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="WebhookEvent">
        <xs:sequence>
          <xs:element minOccurs="1" name="id" type="xs:string">
            <xs:annotation>
              <xs:documentation>PayPal's event id.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="event_type" type="xs:string" />
          <xs:element minOccurs="0" name="paypal_order_id" nillable="true" type="xs:string" />
          <xs:element minOccurs="0" name="summary" nillable="true" type="xs:string" />
          <xs:element minOccurs="1" name="verified" type="xs:boolean">
            <xs:annotation>
              <xs:documentation>Whether PayPal confirmed the delivery's signature.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="outcome" type="xs:string" />
          <xs:element minOccurs="1" name="received_at" type="xs:dateTime" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="OrderEvent">
        <xs:sequence>
          <xs:element minOccurs="1" name="event" type="schemas:Event" />
          <xs:element minOccurs="1" name="shop" type="schemas:Shop1" />
          <xs:element minOccurs="1" name="order" type="schemas:Order1" />
        </xs:sequence>
      </xs:complexType>
      <xs:simpleType name="AiSource">
        <xs:restriction base="xs:string">
          <xs:enumeration value="gemini" />
          <xs:enumeration value="fallback" />
        </xs:restriction>
      </xs:simpleType>
      <xs:complexType name="Amount">
        <xs:sequence>
          <xs:element minOccurs="1" name="item" type="xs:double" />
          <xs:element minOccurs="1" name="shipping" type="xs:double" />
          <xs:element minOccurs="1" name="total" type="xs:double" />
          <xs:element minOccurs="1" name="currency" type="xs:string" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ApiAccessVerifyRequest">
        <xs:sequence>
          <xs:element minOccurs="1" name="shop" type="xs:string">
            <xs:annotation>
              <xs:documentation>The shop's link name.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="code" type="xs:string" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ApiAccessVerifyResponse">
        <xs:sequence>
          <xs:element minOccurs="1" name="valid" type="xs:boolean" />
          <xs:element minOccurs="0" name="product" type="xs:string">
            <xs:annotation>
              <xs:documentation>The product name, when valid.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ApiAccountSigninRequest">
        <xs:sequence>
          <xs:element minOccurs="1" name="identifier" type="xs:string">
            <xs:annotation>
              <xs:documentation>An email address, or a phone number (spaces, dashes and brackets are ignored; keep a leading +).</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ApiAccountSigninResponse">
        <xs:sequence>
          <xs:element minOccurs="1" name="id" type="xs:string" />
          <xs:element minOccurs="1" name="email" nillable="true" type="xs:string">
            <xs:annotation>
              <xs:documentation>Lower-cased.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="phone" nillable="true" type="xs:string">
            <xs:annotation>
              <xs:documentation>Digits, with a leading + if one was given.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ApiAgentShopsResponse">
        <xs:sequence>
          <xs:element minOccurs="1" name="show_buyer" type="xs:string">
            <xs:annotation>
              <xs:documentation>A suggested reply to the buyer, in Markdown: each shop's cover photo as an image, its name, price and headline, then "Which one?". Chats that block images from other sites just leave the image lines out.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" maxOccurs="unbounded" name="shops" type="schemas:AgentShopSummary" />
          <xs:element minOccurs="1" name="matched" type="xs:boolean">
            <xs:annotation>
              <xs:documentation>False when nothing matched the query and `shops` is the newest gallery shops instead; `show_buyer` then starts by saying so.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="mcp_server" type="xs:string">
            <xs:annotation>
              <xs:documentation>The MCP server to order through.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ApiChannel3SearchResponse">
        <xs:sequence>
          <xs:element minOccurs="1" maxOccurs="unbounded" name="products" type="schemas:ProductCard" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ApiOrdersCapture409Error1">
        <xs:sequence>
          <xs:element minOccurs="0" name="status" type="schemas:Status6" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ApiOrdersCaptureResponse">
        <xs:sequence>
          <xs:element minOccurs="1" name="orderId" type="xs:string">
            <xs:annotation>
              <xs:documentation>OneThing's order id; the thank-you page is `/&lt;slug&gt;/thanks?order=&lt;orderId&gt;`.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" fixed="paid" name="status" type="xs:string" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ApiOrdersRequest">
        <xs:sequence>
          <xs:element minOccurs="1" name="slug" type="xs:string" />
          <xs:element minOccurs="0" name="options" type="xs:string">
            <xs:annotation>
              <xs:documentation>The buyer's pick, one value per option, keyed by option name.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ApiOrdersResponse">
        <xs:sequence>
          <xs:element minOccurs="1" name="id" type="xs:string">
            <xs:annotation>
              <xs:documentation>PayPal order id.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ApiPaypalClientTokenResponse">
        <xs:sequence>
          <xs:element minOccurs="1" name="clientToken" type="xs:string">
            <xs:annotation>
              <xs:documentation>Pass to `createInstance` in the PayPal JavaScript SDK v6.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ApiPlatformShopsResponse">
        <xs:sequence>
          <xs:element minOccurs="1" maxOccurs="unbounded" name="shops" type="schemas:PlatformShop" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ApiShopsColorPhotosRequest">
        <xs:sequence>
          <xs:element minOccurs="1" name="photos" type="xs:string">
            <xs:annotation>
              <xs:documentation>Colour label → photo id, or `null`.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ApiShopsColorPhotosResponse">
        <xs:sequence>
          <xs:element minOccurs="1" maxOccurs="unbounded" name="saved" type="xs:string" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ApiShopsFileResponse">
        <xs:sequence>
          <xs:element minOccurs="1" name="ok" type="xs:boolean" />
          <xs:element minOccurs="1" name="filename" type="xs:string" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ApiShopsMatchPhotosRequest">
        <xs:sequence>
          <xs:element minOccurs="1" maxOccurs="unbounded" name="colors" type="schemas:Color" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ApiShopsMatchPhotosResponse">
        <xs:sequence>
          <xs:element minOccurs="1" name="matches" type="xs:string" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ApiShopsOrdersRefund409Error1">
        <xs:sequence>
          <xs:element minOccurs="1" name="error" type="xs:string">
            <xs:annotation>
              <xs:documentation>A sentence you can show to a person.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="field" type="xs:string">
            <xs:annotation>
              <xs:documentation>The form field at fault, when there is one.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="detail" type="xs:string">
            <xs:annotation>
              <xs:documentation>The upstream service's own message, for debugging.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="refundInPayPal" type="xs:boolean">
            <xs:annotation>
              <xs:documentation>Refund it in PayPal yourself, then call again with `record: true`.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ApiShopsOrdersRefundRequest">
        <xs:sequence>
          <xs:element minOccurs="0" default="false" name="record" type="xs:boolean">
            <xs:annotation>
              <xs:documentation>`true`: don't contact PayPal, just record that the seller refunded it themselves.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ApiShopsOrdersRefundResponse">
        <xs:sequence>
          <xs:element minOccurs="1" name="ok" type="xs:boolean" />
          <xs:element minOccurs="0" name="refundId" nillable="true" type="xs:string">
            <xs:annotation>
              <xs:documentation>PayPal's refund id; null when `record` was used.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ApiShopsOrdersShipRequest">
        <xs:sequence>
          <xs:element minOccurs="1" name="carrier" type="schemas:Carrier" />
          <xs:element minOccurs="0" name="carrierName">
            <xs:simpleType>
              <xs:annotation>
                <xs:documentation>Required when `carrier` is `OTHER`.</xs:documentation>
              </xs:annotation>
              <xs:restriction base="xs:string">
                <xs:maxLength value="60" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="1" name="trackingNumber">
            <xs:simpleType>
              <xs:restriction base="xs:string">
                <xs:maxLength value="64" />
                <xs:minLength value="4" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ApiShopsOrdersShipResponse">
        <xs:sequence>
          <xs:element minOccurs="1" name="ok" type="xs:boolean" />
          <xs:element minOccurs="1" name="synced" type="xs:boolean">
            <xs:annotation>
              <xs:documentation>Whether PayPal accepted the tracking number.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ApiShopsPaypalRequest">
        <xs:sequence>
          <xs:element minOccurs="0" name="returnUrl">
            <xs:simpleType>
              <xs:annotation>
                <xs:documentation>Platform key only. Where to send the seller after PayPal.</xs:documentation>
              </xs:annotation>
              <xs:restriction base="xs:string" />
            </xs:simpleType>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ApiShopsPaypalResponse">
        <xs:sequence>
          <xs:element minOccurs="1" name="url" type="xs:string">
            <xs:annotation>
              <xs:documentation>PayPal's onboarding page for this shop.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ApiShopsPaypalResponse1">
        <xs:sequence>
          <xs:element minOccurs="1" name="merchantId" nillable="true" type="xs:string">
            <xs:annotation>
              <xs:documentation>The seller's PayPal merchant id.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="status" nillable="true" type="schemas:PayPalStatus" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ApiShopsPhotosRequest">
        <xs:sequence>
          <xs:element minOccurs="1" maxOccurs="unbounded" name="photos" type="xs:string">
            <xs:annotation>
              <xs:documentation>Photo ids, in order.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ApiShopsRefineRequest">
        <xs:sequence>
          <xs:element minOccurs="1" name="instruction">
            <xs:simpleType>
              <xs:restriction base="xs:string">
                <xs:maxLength value="500" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ApiShopsRefineResponse">
        <xs:sequence>
          <xs:element minOccurs="1" name="spec" type="schemas:DesignSpec">
            <xs:annotation>
              <xs:documentation>What Gemini designed. OneThing's templates render it; Gemini never writes HTML.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ApiShopsResponse">
        <xs:sequence>
          <xs:element minOccurs="1" name="ok" type="xs:boolean" />
          <xs:element minOccurs="1" name="slug" type="xs:string">
            <xs:annotation>
              <xs:documentation>The shop's link name after this change.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ApiSlugsCheckResponse">
        <xs:sequence>
          <xs:element minOccurs="1" name="slug" type="xs:string" />
          <xs:element minOccurs="1" name="available" type="xs:boolean" />
          <xs:element minOccurs="0" name="problem" type="xs:string">
            <xs:annotation>
              <xs:documentation>Why not, when unavailable.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:simpleType name="Carrier">
        <xs:restriction base="xs:string">
          <xs:enumeration value="USPS" />
          <xs:enumeration value="UPS" />
          <xs:enumeration value="FEDEX" />
          <xs:enumeration value="DHL" />
          <xs:enumeration value="OTHER" />
        </xs:restriction>
      </xs:simpleType>
      <xs:simpleType name="Channel">
        <xs:annotation>
          <xs:documentation>`agent` for orders an AI agent placed (MCP or an order link).</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
          <xs:enumeration value="web" />
          <xs:enumeration value="agent" />
        </xs:restriction>
      </xs:simpleType>
      <xs:complexType name="Color">
        <xs:sequence>
          <xs:element minOccurs="1" name="label">
            <xs:simpleType>
              <xs:restriction base="xs:string">
                <xs:maxLength value="30" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" name="hex">
            <xs:simpleType>
              <xs:restriction base="xs:string">
                <xs:pattern value="^#[0-9a-fA-F]{6}$" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:simpleType name="Delivery">
        <xs:annotation>
          <xs:documentation>For digital products. If omitted, the AI guesses.</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
          <xs:enumeration value="file" />
          <xs:enumeration value="access_code" />
        </xs:restriction>
      </xs:simpleType>
      <xs:simpleType name="Delivery1">
        <xs:restriction base="xs:string">
          <xs:enumeration value="file" />
          <xs:enumeration value="access_code" />
        </xs:restriction>
      </xs:simpleType>
      <xs:complexType name="Detail">
        <xs:sequence>
          <xs:element minOccurs="1" name="label" type="xs:string" />
          <xs:element minOccurs="1" name="value" type="xs:string" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="Error1">
        <xs:sequence>
          <xs:element minOccurs="1" name="code" type="xs:integer" />
          <xs:element minOccurs="1" name="message" type="xs:string" />
        </xs:sequence>
      </xs:complexType>
      <xs:simpleType name="Event">
        <xs:restriction base="xs:string">
          <xs:enumeration value="order.paid" />
          <xs:enumeration value="order.shipped" />
          <xs:enumeration value="order.refunded" />
        </xs:restriction>
      </xs:simpleType>
      <xs:complexType name="Fact">
        <xs:sequence>
          <xs:element minOccurs="1" name="label">
            <xs:simpleType>
              <xs:restriction base="xs:string">
                <xs:maxLength value="30" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="1" name="value">
            <xs:simpleType>
              <xs:restriction base="xs:string">
                <xs:maxLength value="100" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="Faq">
        <xs:sequence>
          <xs:element minOccurs="1" name="q" type="xs:string" />
          <xs:element minOccurs="1" name="a" type="xs:string" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="Fonts">
        <xs:sequence>
          <xs:element minOccurs="1" name="heading" type="xs:string" />
          <xs:element minOccurs="1" name="body" type="xs:string" />
        </xs:sequence>
      </xs:complexType>
      <xs:simpleType name="Fulfillment">
        <xs:restriction base="xs:string">
          <xs:enumeration value="to_ship" />
          <xs:enumeration value="shipped" />
        </xs:restriction>
      </xs:simpleType>
      <xs:simpleType name="FulfillmentStatus">
        <xs:restriction base="xs:string">
          <xs:enumeration value="none" />
          <xs:enumeration value="to_ship" />
          <xs:enumeration value="shipped" />
          <xs:enumeration value="digital_sent" />
        </xs:restriction>
      </xs:simpleType>
      <xs:simpleType name="HeroStatus">
        <xs:restriction base="xs:string">
          <xs:enumeration value="none" />
          <xs:enumeration value="pending" />
          <xs:enumeration value="ready" />
          <xs:enumeration value="failed" />
        </xs:restriction>
      </xs:simpleType>
      <xs:simpleType name="Kind">
        <xs:annotation>
          <xs:documentation>`color` shows swatches, and the photo of the picked colour.</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
          <xs:enumeration value="size" />
          <xs:enumeration value="color" />
          <xs:enumeration value="other" />
        </xs:restriction>
      </xs:simpleType>
      <xs:simpleType name="Kind1">
        <xs:restriction base="xs:string">
          <xs:enumeration value="physical" />
          <xs:enumeration value="digital" />
          <xs:enumeration value="referral" />
        </xs:restriction>
      </xs:simpleType>
      <xs:simpleType name="Layout">
        <xs:restriction base="xs:string">
          <xs:enumeration value="bold-hero" />
          <xs:enumeration value="editorial" />
          <xs:enumeration value="minimal" />
          <xs:enumeration value="playful" />
        </xs:restriction>
      </xs:simpleType>
      <xs:simpleType name="Method">
        <xs:restriction base="xs:string">
          <xs:enumeration value="initialize" />
          <xs:enumeration value="ping" />
          <xs:enumeration value="tools/list" />
          <xs:enumeration value="tools/call" />
          <xs:enumeration value="notifications/initialized" />
        </xs:restriction>
      </xs:simpleType>
      <xs:complexType name="MissingFact">
        <xs:sequence>
          <xs:element minOccurs="1" name="label" type="xs:string" />
          <xs:element minOccurs="1" name="question" type="xs:string" />
          <xs:element minOccurs="1" name="placeholder" type="xs:string" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="Offer">
        <xs:sequence>
          <xs:element minOccurs="1" name="domain" type="xs:string" />
          <xs:element minOccurs="1" name="url" type="xs:string" />
          <xs:element minOccurs="1" name="price" type="xs:double" />
          <xs:element minOccurs="1" name="currency" type="xs:string" />
          <xs:element minOccurs="1" name="inStock" type="xs:boolean" />
          <xs:element minOccurs="1" name="commission" type="xs:double">
            <xs:annotation>
              <xs:documentation>Maximum commission rate, 0–1 (0.08 = 8%).</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="Offer1">
        <xs:sequence>
          <xs:element minOccurs="1" name="retailer" type="xs:string" />
          <xs:element minOccurs="1" name="price" type="xs:double" />
          <xs:element minOccurs="1" name="currency" type="xs:string" />
          <xs:element minOccurs="1" name="in_stock" type="xs:boolean" />
          <xs:element minOccurs="1" name="url" type="xs:string" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="Ok">
        <xs:sequence>
          <xs:element minOccurs="1" name="ok" type="xs:boolean" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="Option">
        <xs:sequence>
          <xs:element minOccurs="1" name="name">
            <xs:simpleType>
              <xs:restriction base="xs:string">
                <xs:maxLength value="20" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="1" name="kind" type="schemas:Kind">
            <xs:annotation>
              <xs:documentation>`color` shows swatches, and the photo of the picked colour.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" maxOccurs="unbounded" name="values" type="schemas:OptionValue" />
          <xs:element minOccurs="0" name="fromSeller" type="xs:boolean">
            <xs:annotation>
              <xs:documentation>The seller's description or photo named these values; otherwise they're a guess.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="Option1">
        <xs:sequence>
          <xs:element minOccurs="1" name="name" type="xs:string" />
          <xs:element minOccurs="1" maxOccurs="unbounded" name="values" type="xs:string" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="Order1">
        <xs:sequence>
          <xs:element minOccurs="0" name="id" type="xs:string" />
          <xs:element minOccurs="0" name="paypal_order_id" nillable="true" type="xs:string" />
          <xs:element minOccurs="0" name="amount" type="xs:string" />
          <xs:element minOccurs="0" name="currency" type="xs:string" />
          <xs:element minOccurs="0" name="buyer_name" nillable="true" type="xs:string" />
          <xs:element minOccurs="0" name="buyer_email" nillable="true" type="xs:string" />
          <xs:element minOccurs="0" name="shipping_address" nillable="true">
            <xs:complexType>
              <xs:sequence>
                <xs:any />
              </xs:sequence>
            </xs:complexType>
          </xs:element>
          <xs:element minOccurs="0" name="fulfillment_status" type="xs:string" />
          <xs:element minOccurs="0" name="tracking_number" nillable="true" type="xs:string" />
          <xs:element minOccurs="0" name="carrier" nillable="true" type="xs:string" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="Palette">
        <xs:sequence>
          <xs:element minOccurs="1" name="background">
            <xs:simpleType>
              <xs:restriction base="xs:string">
                <xs:pattern value="^#[0-9a-fA-F]{6}$" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="1" name="surface">
            <xs:simpleType>
              <xs:restriction base="xs:string">
                <xs:pattern value="^#[0-9a-fA-F]{6}$" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="1" name="text">
            <xs:simpleType>
              <xs:restriction base="xs:string">
                <xs:pattern value="^#[0-9a-fA-F]{6}$" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="1" name="muted">
            <xs:simpleType>
              <xs:restriction base="xs:string">
                <xs:pattern value="^#[0-9a-fA-F]{6}$" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="1" name="accent">
            <xs:simpleType>
              <xs:restriction base="xs:string">
                <xs:pattern value="^#[0-9a-fA-F]{6}$" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="1" name="accentText">
            <xs:simpleType>
              <xs:restriction base="xs:string">
                <xs:pattern value="^#[0-9a-fA-F]{6}$" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="Photo">
        <xs:sequence>
          <xs:element minOccurs="1" name="id" type="xs:string" />
          <xs:element minOccurs="1" name="url" type="xs:string">
            <xs:annotation>
              <xs:documentation>Public image URL on this site.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:simpleType name="ProductType">
        <xs:annotation>
          <xs:documentation>`referral` only for shops created from Channel3.</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
          <xs:enumeration value="physical" />
          <xs:enumeration value="digital" />
          <xs:enumeration value="referral" />
        </xs:restriction>
      </xs:simpleType>
      <xs:simpleType name="ProductType1">
        <xs:restriction base="xs:string">
          <xs:enumeration value="physical" />
          <xs:enumeration value="digital" />
          <xs:enumeration value="referral" />
        </xs:restriction>
      </xs:simpleType>
      <xs:simpleType name="ProductType2">
        <xs:restriction base="xs:string">
          <xs:enumeration value="digital" />
          <xs:enumeration value="physical" />
        </xs:restriction>
      </xs:simpleType>
      <xs:complexType name="Shipping">
        <xs:sequence>
          <xs:element minOccurs="1" name="amount" type="xs:double" />
          <xs:element minOccurs="1" name="currency" type="xs:string" />
          <xs:element minOccurs="1" maxOccurs="unbounded" name="ships_to" type="xs:string">
            <xs:annotation>
              <xs:documentation>Country codes; empty means anywhere PayPal ships.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ShipTo">
        <xs:sequence>
          <xs:element minOccurs="0" name="name" nillable="true" type="xs:string" />
          <xs:element minOccurs="0" name="address" type="xs:string" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="Shop1">
        <xs:sequence>
          <xs:element minOccurs="0" name="slug" type="xs:string" />
          <xs:element minOccurs="0" name="name" type="xs:string" />
          <xs:element minOccurs="0" name="url" type="xs:string" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ShopPhotos">
        <xs:sequence>
          <xs:element minOccurs="1" maxOccurs="unbounded" name="photos" type="schemas:Photo" />
        </xs:sequence>
      </xs:complexType>
      <xs:simpleType name="Source">
        <xs:restriction base="xs:string">
          <xs:enumeration value="photo" />
          <xs:enumeration value="link" />
          <xs:enumeration value="channel3" />
        </xs:restriction>
      </xs:simpleType>
      <xs:simpleType name="Status">
        <xs:restriction base="xs:string">
          <xs:enumeration value="draft" />
          <xs:enumeration value="live" />
        </xs:restriction>
      </xs:simpleType>
      <xs:simpleType name="Status2">
        <xs:annotation>
          <xs:documentation>`declined`: PayPal declined it, nothing charged, the buyer can open `pay_url` again. `sold_out`: it sold out before the payment was captured. `expired`: the PayPal checkout expired; create a new order. `failed`: PayPal couldn't be reached; ask again.</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
          <xs:enumeration value="awaiting_buyer_approval" />
          <xs:enumeration value="paid" />
          <xs:enumeration value="declined" />
          <xs:enumeration value="sold_out" />
          <xs:enumeration value="expired" />
          <xs:enumeration value="failed" />
        </xs:restriction>
      </xs:simpleType>
      <xs:simpleType name="Status4">
        <xs:restriction base="xs:string">
          <xs:enumeration value="created" />
          <xs:enumeration value="paid" />
          <xs:enumeration value="failed" />
          <xs:enumeration value="refunded" />
        </xs:restriction>
      </xs:simpleType>
      <xs:simpleType name="Status6">
        <xs:restriction base="xs:string">
          <xs:enumeration value="pending" />
        </xs:restriction>
      </xs:simpleType>
      <xs:complexType name="Tracking">
        <xs:sequence>
          <xs:element minOccurs="0" name="carrier" type="xs:string" />
          <xs:element minOccurs="0" name="number" type="xs:string" />
        </xs:sequence>
      </xs:complexType>
      <xs:simpleType name="Type">
        <xs:restriction base="xs:string">
          <xs:enumeration value="auto" />
          <xs:enumeration value="physical" />
          <xs:enumeration value="digital" />
        </xs:restriction>
      </xs:simpleType>
      <xs:complexType name="Variant">
        <xs:sequence>
          <xs:element minOccurs="1" name="choice" type="xs:string">
            <xs:annotation>
              <xs:documentation>The buyer's pick, one value per option, keyed by option name.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="availability" type="xs:string" />
          <xs:element minOccurs="0" name="order_url" type="xs:string">
            <xs:annotation>
              <xs:documentation>`orderByLink` for this pick. Left out when it's sold out.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:simpleType name="view">
        <xs:restriction base="xs:string">
          <xs:enumeration value="json" />
        </xs:restriction>
      </xs:simpleType>
