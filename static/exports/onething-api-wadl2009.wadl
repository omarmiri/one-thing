          <xs:element minOccurs="1" name="response404" type="schemas:Error">
            <xs:annotation>
              <xs:documentation>No live shop with that link name.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="orderByLink429_Response0">
        <xs:sequence>
          <xs:element minOccurs="1" name="response429" type="schemas:Error">
            <xs:annotation>
              <xs:documentation>Over this network's cap for the call (see **Limits**). Retry after `Retry-After` seconds.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="getAgentOrder200_Response0">
        <xs:sequence>
          <xs:element minOccurs="1" name="response200" type="schemas:AgentOrder">
            <xs:annotation>
              <xs:documentation>An order as `get_order` and `getAgentOrder` report it.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="getAgentOrder404_Response0">
        <xs:sequence>
          <xs:element minOccurs="1" name="response404" type="schemas:Error">
            <xs:annotation>
              <xs:documentation>No order with that id.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="getAgentProduct200_Response0">
        <xs:sequence>
          <xs:element minOccurs="1" name="response200" type="schemas:AgentProduct">
            <xs:annotation>
              <xs:documentation>A live shop as an AI agent sees it. Recommendations have `offers`; everything else has `price` and is bought with `create_order`.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="getAgentProduct404_Response0">
        <xs:sequence>
          <xs:element minOccurs="1" name="response404" type="schemas:Error">
            <xs:annotation>
              <xs:documentation>No live shop with that link name.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="callMcp400_Response0">
        <xs:sequence>
          <xs:element minOccurs="1" name="response400" type="schemas:JsonRpcResponse">
            <xs:annotation>
              <xs:documentation>Not JSON (JSON-RPC parse error `-32700`).</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="listMyShops200_Response0">
        <xs:sequence>
          <xs:element minOccurs="1" name="response200" type="schemas:ApiPlatformShopsResponse">
            <xs:annotation>
              <xs:documentation>The shops.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="listMyShops401_Response0">
        <xs:sequence>
          <xs:element minOccurs="1" name="response401" type="schemas:Error">
            <xs:annotation>
              <xs:documentation>No API key, or it's wrong or revoked.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
    </xs:schema>
  </grammars>
  <resources base="https://one-thing-ash0.onrender.com">
    <resource id="_apiaccountsignin" path="/api/account/signin">
      <method id="signIn" name="POST">
        <doc title="signIn" xml:lang="en">Signs in with an email address or a phone number, creating the account the first time. There's no password and no verification (sandbox). The response sets the `ot_session` cookie; shops created with it belong to the account and are listed on `/account`. Signing in with an email also claims older shops whose seller email matches. In a browser, sellers can instead use Log in with PayPal (`/api/account/paypal`), which also records the PayPal account their sales are paid into.</doc>
        <request>
          <param name="Content-Type" style="header" type="xsd:string" default="application/json" required="true" fixed="application/json">
            <doc title="Content-Type" xml:lang="en" />
          </param>
          <representation element="schemas:signIn_Request" mediaType="application/json" />
        </request>
        <response status="200">
          <doc title="200" xml:lang="en">Signed in. The `ot_session` cookie is set.</doc>
          <param name="Set-Cookie" style="plain" type="xsd:string" required="true">
            <doc title="Set-Cookie" xml:lang="en">The session cookie: `ot_session=&lt;token&gt;`, HttpOnly, for a year.</doc>
          </param>
          <representation element="schemas:signIn200_Response0" mediaType="application/json" />
        </response>
        <response status="400">
          <doc title="400" xml:lang="en">Something in the request needs fixing; `error` says what.</doc>
          <representation element="schemas:signIn400_Response0" mediaType="application/json" />
        </response>
      </method>
    </resource>
    <resource id="_apiaccountsignout" path="/api/account/signout">
      <method id="signOut" name="POST">
        <doc title="signOut" xml:lang="en">Ends this browser's session and clears the `ot_session` cookie.</doc>
        <request />
        <response status="200">
          <doc title="200" xml:lang="en">Done.</doc>
          <representation element="schemas:signOut200_Response0" mediaType="application/json" />
        </response>
      </method>
    </resource>
    <resource id="_apiaccountpaypal" path="/api/account/paypal">
      <method id="logInWithPayPal" name="GET">
        <doc title="logInWithPayPal" xml:lang="en">A link for a browser, not for code: redirects to PayPal's sign-in page. PayPal sends the seller back to `/api/account/paypal/callback`, which signs them in (creating the account the first time), records the PayPal account their sales are paid into, and redirects to `next`.</doc>
        <request>
          <param name="next" style="query" type="xsd:string">
            <doc title="next" xml:lang="en">A path on this site to land on afterwards. Defaults to `/account`.</doc>
          </param>
        </request>
        <response status="302">
          <doc title="302" xml:lang="en">To PayPal's sign-in page.</doc>
        </response>
        <response status="503">
          <doc title="503" xml:lang="en">Log in with PayPal isn't switched on for this server.</doc>
          <representation element="schemas:logInWithPayPal503_Response0" mediaType="application/json" />
        </response>
      </method>
    </resource>
    <resource id="_apishops" path="/api/shops">
      <method id="createShop" name="POST">
        <doc title="createShop" xml:lang="en">Starts a draft shop from one of three sources. Gemini designs the page and guesses the
setup; check it with `getShop`, adjust with `updateShop`, then go live.

Sent with a session cookie from `signIn`, the shop belongs to that account, which also
becomes its seller email (and PayPal email, after Log in with PayPal) unless you give one.

- `source=photo`: a `photo` and/or a `description` of your own product.
- `source=link`: a `url`. If Channel3 recognises it as a store's product page, the shop
  becomes a recommendation (`product_type: referral`); otherwise the page is read and you
  sell the product yourself with PayPal.
- `source=channel3`: a `productId` from `searchProducts` (a recommendation).

Takes 15–40 seconds. Hero art, if available, is generated afterwards (`hero_status`).

**Platforms:** sent with a platform API key, the shop belongs to the key's account, so the
key can manage it from then on (no need to keep the admin token). It's made for one of the
platform's sellers, so it inherits nothing from the account: set `paypal_email` or call
`connectPayPal` for that seller.
</doc>
        <request>
          <representation mediaType="multipart/form-data">
            <param name="source" style="query" required="true">
              <doc title="source" xml:lang="en" />
              <option value="photo">
                <doc title="photo" xml:lang="en" />
              </option>
              <option value="link">
                <doc title="link" xml:lang="en" />
              </option>
              <option value="channel3">
                <doc title="channel3" xml:lang="en" />
              </option>
            </param>
            <param name="photo" style="query" type="xsd:hexBinary">
              <doc title="photo" xml:lang="en">`source=photo`: the product photo, up to 8 MB.</doc>
            </param>
            <param name="description" style="query" type="xsd:string">
              <doc title="description" xml:lang="en">`source=photo`: a sentence or two about the product. Required if there is no photo.</doc>
            </param>
            <param name="url" style="query" type="xsd:string">
              <doc title="url" xml:lang="en">`source=link`: a product page, or your own app or game page.</doc>
            </param>
            <param name="productId" style="query" type="xsd:string">
              <doc title="productId" xml:lang="en">`source=channel3`: a product id from `searchProducts`.</doc>
            </param>
            <param name="slug" style="query" type="xsd:string">
              <doc title="slug" xml:lang="en">The link name you want. If omitted, the AI suggests one.</doc>
            </param>
            <param name="type" style="query" default="auto">
              <doc title="type" xml:lang="en" />
              <option value="auto">
                <doc title="auto" xml:lang="en" />
              </option>
              <option value="physical">
                <doc title="physical" xml:lang="en" />
              </option>
              <option value="digital">
                <doc title="digital" xml:lang="en" />
              </option>
            </param>
            <param name="delivery" style="query">
              <doc title="delivery" xml:lang="en">For digital products. If omitted, the AI guesses.</doc>
              <option value="file">
                <doc title="file" xml:lang="en" />
              </option>
              <option value="access_code">
                <doc title="access_code" xml:lang="en" />
              </option>
            </param>
            <param name="access_url" style="query" type="xsd:string">
              <doc title="access_url" xml:lang="en">Where buyers use an access code.</doc>
            </param>
            <param name="price" style="query" type="xsd:double">
              <doc title="price" xml:lang="en">USD. If omitted, the AI suggests a price.</doc>
            </param>
            <param name="shipping" style="query" type="xsd:double">
              <doc title="shipping" xml:lang="en" />
            </param>
            <param name="stock" style="query" type="xsd:integer">
              <doc title="stock" xml:lang="en" />
            </param>
            <param name="ship_countries" style="query" type="xsd:string">
              <doc title="ship_countries" xml:lang="en" />
            </param>
            <param name="paypal_email" style="query" type="xsd:string">
              <doc title="paypal_email" xml:lang="en" />
            </param>
            <param name="seller_email" style="query" type="xsd:string">
              <doc title="seller_email" xml:lang="en" />
            </param>
            <param name="digital_file" style="query" type="xsd:hexBinary">
              <doc title="digital_file" xml:lang="en" />
            </param>
          </representation>
        </request>
        <response status="200">
          <doc title="200" xml:lang="en">Draft created.</doc>
          <representation element="schemas:createShop200_Response0" mediaType="application/json" />
        </response>
        <response status="400">
          <doc title="400" xml:lang="en">Something in the request needs fixing; `error` says what.</doc>
          <representation element="schemas:createShop400_Response0" mediaType="application/json" />
        </response>
        <response status="409">
          <doc title="409" xml:lang="en">Taken or unavailable (a link name, or a sold-out product).</doc>
          <representation element="schemas:createShop409_Response0" mediaType="application/json" />
        </response>
        <response status="502">
          <doc title="502" xml:lang="en">Gemini, PayPal or Channel3 failed or isn't configured.</doc>
          <representation element="schemas:createShop502_Response0" mediaType="application/json" />
        </response>
        <response status="429">
          <doc title="429" xml:lang="en">Over this network's cap for the call (see **Limits**). Retry after `Retry-After` seconds.</doc>
          <param name="Retry-After" style="plain" type="xsd:integer" required="true">
            <doc title="Retry-After" xml:lang="en">Seconds until the window resets.</doc>
          </param>
          <representation element="schemas:createShop429_Response0" mediaType="application/json" />
        </response>
      </method>
    </resource>
    <resource id="_apishopsslug" path="/api/shops/{slug}">
      <param name="slug" style="template" type="xsd:string" required="true">
        <doc title="slug" xml:lang="en">The shop's link name (current or former).</doc>
      </param>
      <param name="slug" style="template" type="xsd:string" required="true">
        <doc title="slug" xml:lang="en">The shop's link name (current or former).</doc>
      </param>
      <method id="getShop" name="GET">
        <doc title="getShop" xml:lang="en">Everything about the shop, including the AI's design spec and guesses.</doc>
        <request />
        <response status="200">
          <doc title="200" xml:lang="en">The shop.</doc>
          <representation element="schemas:getShop200_Response0" mediaType="application/json" />
        </response>
        <response status="404">
          <doc title="404" xml:lang="en">No such shop, or the admin token or API key doesn't match it.</doc>
          <representation element="schemas:getShop404_Response0" mediaType="application/json" />
        </response>
      </method>
      <method id="updateShop" name="PATCH">
        <doc title="updateShop" xml:lang="en">Changes only the fields you send. Renaming `slug` keeps the old link working (it
redirects). Set `status: live` to publish; a digital product needs its file (or, for
access codes, `access_url`) first.
</doc>
        <request>
          <param name="Content-Type" style="header" type="xsd:string" default="application/json" required="true" fixed="application/json">
            <doc title="Content-Type" xml:lang="en" />
          </param>
          <representation element="schemas:updateShop_Request" mediaType="application/json" />
        </request>
        <response status="200">
          <doc title="200" xml:lang="en">Saved.</doc>
          <representation element="schemas:updateShop200_Response0" mediaType="application/json" />
        </response>
        <response status="400">
          <doc title="400" xml:lang="en">Something in the request needs fixing; `error` says what.</doc>
          <representation element="schemas:updateShop400_Response0" mediaType="application/json" />
        </response>
        <response status="404">
          <doc title="404" xml:lang="en">No such shop, or the admin token or API key doesn't match it.</doc>
          <representation element="schemas:updateShop404_Response0" mediaType="application/json" />
        </response>
      </method>
    </resource>
    <resource id="_apishopsslugrefine" path="/api/shops/{slug}/refine">
      <param name="slug" style="template" type="xsd:string" required="true">
        <doc title="slug" xml:lang="en">The shop's link name (current or former).</doc>
      </param>
      <method id="refineShopDesign" name="POST">
        <doc title="refineShopDesign" xml:lang="en">"Make it warmer", "shorter copy", "more premium". Gemini edits the design spec.</doc>
        <request>
          <param name="Content-Type" style="header" type="xsd:string" default="application/json" required="true" fixed="application/json">
            <doc title="Content-Type" xml:lang="en" />
          </param>
          <representation element="schemas:refineShopDesign_Request" mediaType="application/json" />
        </request>
        <response status="200">
          <doc title="200" xml:lang="en">The new design.</doc>
          <representation element="schemas:refineShopDesign200_Response0" mediaType="application/json" />
        </response>
        <response status="400">
          <doc title="400" xml:lang="en">Something in the request needs fixing; `error` says what.</doc>
          <representation element="schemas:refineShopDesign400_Response0" mediaType="application/json" />
        </response>
        <response status="404">
          <doc title="404" xml:lang="en">No such shop, or the admin token or API key doesn't match it.</doc>
          <representation element="schemas:refineShopDesign404_Response0" mediaType="application/json" />
        </response>
        <response status="502">
          <doc title="502" xml:lang="en">Gemini, PayPal or Channel3 failed or isn't configured.</doc>
          <representation element="schemas:refineShopDesign502_Response0" mediaType="application/json" />
        </response>
        <response status="429">
          <doc title="429" xml:lang="en">Over this network's cap for the call (see **Limits**). Retry after `Retry-After` seconds.</doc>
          <param name="Retry-After" style="plain" type="xsd:integer" required="true">
            <doc title="Retry-After" xml:lang="en">Seconds until the window resets.</doc>
          </param>
          <representation element="schemas:refineShopDesign429_Response0" mediaType="application/json" />
        </response>
      </method>
    </resource>
    <resource id="_apishopsslughero" path="/api/shops/{slug}/hero">
      <param name="slug" style="template" type="xsd:string" required="true">
        <doc title="slug" xml:lang="en">The shop's link name (current or former).</doc>
      </param>
      <method id="regenerateHeroArt" name="POST">
        <doc title="regenerateHeroArt" xml:lang="en">Starts generation in the background. Poll `getShop` for `hero_status`.</doc>
        <request />
        <response status="200">
          <doc title="200" xml:lang="en">Done.</doc>
          <representation element="schemas:regenerateHeroArt200_Response0" mediaType="application/json" />
        </response>
        <response status="400">
          <doc title="400" xml:lang="en">Something in the request needs fixing; `error` says what.</doc>
          <representation element="schemas:regenerateHeroArt400_Response0" mediaType="application/json" />
        </response>
        <response status="404">
          <doc title="404" xml:lang="en">No such shop, or the admin token or API key doesn't match it.</doc>
          <representation element="schemas:regenerateHeroArt404_Response0" mediaType="application/json" />
        </response>
        <response status="429">
          <doc title="429" xml:lang="en">Over this network's cap for the call (see **Limits**). Retry after `Retry-After` seconds.</doc>
          <param name="Retry-After" style="plain" type="xsd:integer" required="true">
            <doc title="Retry-After" xml:lang="en">Seconds until the window resets.</doc>
          </param>
          <representation element="schemas:regenerateHeroArt429_Response0" mediaType="application/json" />
        </response>
      </method>
    </resource>
    <resource id="_apishopsslugfile" path="/api/shops/{slug}/file">
      <param name="slug" style="template" type="xsd:string" required="true">
        <doc title="slug" xml:lang="en">The shop's link name (current or former).</doc>
      </param>
      <method id="uploadDigitalFile" name="POST">
        <doc title="uploadDigitalFile" xml:lang="en">Uploads or replaces a digital product's file, up to 25 MB. Each paid order gets a download link for it.</doc>
        <request>
          <representation mediaType="multipart/form-data">
            <param name="file" style="query" type="xsd:hexBinary" required="true">
              <doc title="file" xml:lang="en">Up to 25 MB.</doc>
            </param>
          </representation>
        </request>
        <response status="200">
          <doc title="200" xml:lang="en">Uploaded.</doc>
          <representation element="schemas:uploadDigitalFile200_Response0" mediaType="application/json" />
        </response>
        <response status="400">
          <doc title="400" xml:lang="en">Something in the request needs fixing; `error` says what.</doc>
          <representation element="schemas:uploadDigitalFile400_Response0" mediaType="application/json" />
        </response>
        <response status="404">
          <doc title="404" xml:lang="en">No such shop, or the admin token or API key doesn't match it.</doc>
          <representation element="schemas:uploadDigitalFile404_Response0" mediaType="application/json" />
        </response>
      </method>
    </resource>
    <resource id="_apishopsslugphotos" path="/api/shops/{slug}/photos">
      <param name="slug" style="template" type="xsd:string" required="true">
        <doc title="slug" xml:lang="en">The shop's link name (current or former).</doc>
      </param>
      <param name="slug" style="template" type="xsd:string" required="true">
        <doc title="slug" xml:lang="en">The shop's link name (current or former).</doc>
      </param>
      <method id="addPhotos" name="POST">
        <doc title="addPhotos" xml:lang="en">Adds one or more photos after the cover. Each is turned upright, resized to at most 2000 px and stored as WebP. A shop holds up to 8 photos; buyers swipe through them on the shop page. Not for recommendations, which show the retailer's photos.</doc>
        <request>
          <representation mediaType="multipart/form-data">
            <param name="photo" style="query" type="xsd:hexBinary" required="true">
              <doc title="photo" xml:lang="en">An image, up to 15 MB. The endpoint also accepts the field repeated, to add several in one request.</doc>
            </param>
          </representation>
        </request>
        <response status="200">
          <doc title="200" xml:lang="en">The shop's photos, cover first.</doc>
          <representation element="schemas:addPhotos200_Response0" mediaType="application/json" />
        </response>
        <response status="400">
          <doc title="400" xml:lang="en">Something in the request needs fixing; `error` says what.</doc>
          <representation element="schemas:addPhotos400_Response0" mediaType="application/json" />
        </response>
        <response status="404">
          <doc title="404" xml:lang="en">No such shop, or the admin token or API key doesn't match it.</doc>
          <representation element="schemas:addPhotos404_Response0" mediaType="application/json" />
        </response>
      </method>
      <method id="setPhotoOrder" name="PUT">
        <doc title="setPhotoOrder" xml:lang="en">Sets the photo order; the first becomes the cover. Leaving a photo out removes it.</doc>
        <request>
          <param name="Content-Type" style="header" type="xsd:string" default="application/json" required="true" fixed="application/json">
            <doc title="Content-Type" xml:lang="en" />
          </param>
          <representation element="schemas:setPhotoOrder_Request" mediaType="application/json" />
        </request>
        <response status="200">
          <doc title="200" xml:lang="en">The shop's photos, cover first.</doc>
          <representation element="schemas:setPhotoOrder200_Response0" mediaType="application/json" />
        </response>
        <response status="400">
          <doc title="400" xml:lang="en">Something in the request needs fixing; `error` says what.</doc>
          <representation element="schemas:setPhotoOrder400_Response0" mediaType="application/json" />
        </response>
        <response status="404">
          <doc title="404" xml:lang="en">No such shop, or the admin token or API key doesn't match it.</doc>
          <representation element="schemas:setPhotoOrder404_Response0" mediaType="application/json" />
        </response>
      </method>
    </resource>
    <resource id="_apishopsslugsuggest" path="/api/shops/{slug}/suggest">
      <param name="slug" style="template" type="xsd:string" required="true">
        <doc title="slug" xml:lang="en">The shop's link name (current or former).</doc>
      </param>
      <method id="checkMissingDetails" name="POST">
        <doc title="checkMissingDetails" xml:lang="en">Asks Gemini what buyers will want to choose (sizes, colours) and what they'll ask that the
listing doesn't say (dimensions, materials). `createShop` already does this once; call it
again after editing the product. The result is saved as the shop's `suggestions`.

Nothing changes on the shop page until the seller confirms: save options with `updateShop`
(`options`), and answer the questions with `updateShop` (`facts`). Not for recommendations.
</doc>
        <request />
        <response status="200">
          <doc title="200" xml:lang="en">The suggestions.</doc>
          <representation element="schemas:checkMissingDetails200_Response0" mediaType="application/json" />
        </response>
        <response status="400">
          <doc title="400" xml:lang="en">Something in the request needs fixing; `error` says what.</doc>
          <representation element="schemas:checkMissingDetails400_Response0" mediaType="application/json" />
        </response>
        <response status="404">
          <doc title="404" xml:lang="en">No such shop, or the admin token or API key doesn't match it.</doc>
          <representation element="schemas:checkMissingDetails404_Response0" mediaType="application/json" />
        </response>
        <response status="502">
          <doc title="502" xml:lang="en">Gemini, PayPal or Channel3 failed or isn't configured.</doc>
          <representation element="schemas:checkMissingDetails502_Response0" mediaType="application/json" />
        </response>
        <response status="429">
          <doc title="429" xml:lang="en">Over this network's cap for the call (see **Limits**). Retry after `Retry-After` seconds.</doc>
          <param name="Retry-After" style="plain" type="xsd:integer" required="true">
            <doc title="Retry-After" xml:lang="en">Seconds until the window resets.</doc>
          </param>
          <representation element="schemas:checkMissingDetails429_Response0" mediaType="application/json" />
        </response>
      </method>
    </resource>
    <resource id="_apishopsslugmatch-photos" path="/api/shops/{slug}/match-photos">
      <param name="slug" style="template" type="xsd:string" required="true">
        <doc title="slug" xml:lang="en">The shop's link name (current or former).</doc>
      </param>
      <method id="matchColorPhotos" name="POST">
        <doc title="matchColorPhotos" xml:lang="en">Gemini looks at the shop's photos and says which one shows each colour, so buyers who pick a colour see it. Suggests only; save the matches with `setColorPhotos`. Needs at least two photos.</doc>
        <request>
          <param name="Content-Type" style="header" type="xsd:string" default="application/json" required="true" fixed="application/json">
            <doc title="Content-Type" xml:lang="en" />
          </param>
          <representation element="schemas:matchColorPhotos_Request" mediaType="application/json" />
        </request>
        <response status="200">
          <doc title="200" xml:lang="en">A photo id for each colour Gemini could match. Colours it couldn't place are left out.</doc>
          <representation element="schemas:matchColorPhotos200_Response0" mediaType="application/json" />
        </response>
        <response status="400">
          <doc title="400" xml:lang="en">Something in the request needs fixing; `error` says what.</doc>
          <representation element="schemas:matchColorPhotos400_Response0" mediaType="application/json" />
        </response>
        <response status="404">
          <doc title="404" xml:lang="en">No such shop, or the admin token or API key doesn't match it.</doc>
          <representation element="schemas:matchColorPhotos404_Response0" mediaType="application/json" />
        </response>
        <response status="502">
          <doc title="502" xml:lang="en">Gemini, PayPal or Channel3 failed or isn't configured.</doc>
          <representation element="schemas:matchColorPhotos502_Response0" mediaType="application/json" />
        </response>
        <response status="429">
          <doc title="429" xml:lang="en">Over this network's cap for the call (see **Limits**). Retry after `Retry-After` seconds.</doc>
          <param name="Retry-After" style="plain" type="xsd:integer" required="true">
            <doc title="Retry-After" xml:lang="en">Seconds until the window resets.</doc>
          </param>
          <representation element="schemas:matchColorPhotos429_Response0" mediaType="application/json" />
        </response>
      </method>
    </resource>
    <resource id="_apishopsslugcolor-photos" path="/api/shops/{slug}/color-photos">
      <param name="slug" style="template" type="xsd:string" required="true">
        <doc title="slug" xml:lang="en">The shop's link name (current or former).</doc>
      </param>
      <method id="setColorPhotos" name="PUT">
        <doc title="setColorPhotos" xml:lang="en">Saves which photo shows each colour, and nothing else about the shop. Only colours already saved in the shop's options change; `null` clears a colour's photo. A photo id that isn't one of the shop's photos is ignored.</doc>
        <request>
          <param name="Content-Type" style="header" type="xsd:string" default="application/json" required="true" fixed="application/json">
            <doc title="Content-Type" xml:lang="en" />
          </param>
          <representation element="schemas:setColorPhotos_Request" mediaType="application/json" />
        </request>
        <response status="200">
          <doc title="200" xml:lang="en">The colours that were changed.</doc>
          <representation element="schemas:setColorPhotos200_Response0" mediaType="application/json" />
        </response>
        <response status="400">
          <doc title="400" xml:lang="en">Something in the request needs fixing; `error` says what.</doc>
          <representation element="schemas:setColorPhotos400_Response0" mediaType="application/json" />
        </response>
        <response status="404">
          <doc title="404" xml:lang="en">No such shop, or the admin token or API key doesn't match it.</doc>
          <representation element="schemas:setColorPhotos404_Response0" mediaType="application/json" />
        </response>
      </method>
    </resource>
    <resource id="_apishopsslugpaypal" path="/api/shops/{slug}/paypal">
      <param name="slug" style="template" type="xsd:string" required="true">
        <doc title="slug" xml:lang="en">The shop's link name (current or former).</doc>
      </param>
      <param name="slug" style="template" type="xsd:string" required="true">
        <doc title="slug" xml:lang="en">The shop's link name (current or former).</doc>
      </param>
      <param name="slug" style="template" type="xsd:string" required="true">
        <doc title="slug" xml:lang="en">The shop's link name (current or former).</doc>
      </param>
      <method id="connectPayPal" name="POST">
        <doc title="connectPayPal" xml:lang="en">Starts PayPal's seller onboarding (Partner Referrals). Send the seller's browser to the
returned `url`; they sign in to PayPal (or create a business account) and grant OneThing
permission. PayPal brings them back to `/api/shops/&lt;slug&gt;/paypal/return`, which saves the
connection and opens the manage page. From then on, sales are paid to that account.

Without a connection, a shop can still go live with a typed `paypal_email`.

**Platforms:** call it with your API key and a `returnUrl`, and PayPal's flow ends on your own
page instead, as `returnUrl?paypal=connected|incomplete|cancelled|failed&amp;shop=&lt;slug&gt;`. The
URL's origin must be one registered on the key.
</doc>
        <request>
          <param name="Content-Type" style="header" type="xsd:string" default="application/json" required="true" fixed="application/json">
            <doc title="Content-Type" xml:lang="en" />
          </param>
          <representation element="schemas:connectPayPal_Request" mediaType="application/json" />
        </request>
        <response status="200">
          <doc title="200" xml:lang="en">Where to send the seller.</doc>
          <representation element="schemas:connectPayPal200_Response0" mediaType="application/json" />
        </response>
        <response status="404">
          <doc title="404" xml:lang="en">No such shop, or the admin token or API key doesn't match it.</doc>
          <representation element="schemas:connectPayPal404_Response0" mediaType="application/json" />
        </response>
        <response status="502">
          <doc title="502" xml:lang="en">Gemini, PayPal or Channel3 failed or isn't configured.</doc>
          <representation element="schemas:connectPayPal502_Response0" mediaType="application/json" />
        </response>
        <response status="503">
          <doc title="503" xml:lang="en">Gemini, PayPal or Channel3 failed or isn't configured.</doc>
          <representation element="schemas:connectPayPal503_Response0" mediaType="application/json" />
        </response>
      </method>
      <method id="getPayPalConnection" name="GET">
        <doc title="getPayPalConnection" xml:lang="en">Asks PayPal where the seller's connection stands and saves it on the shop. Also finds a connection the seller finished at PayPal without coming back.</doc>
        <request />
        <response status="200">
          <doc title="200" xml:lang="en">The connection, or nulls if there is none yet.</doc>
          <representation element="schemas:getPayPalConnection200_Response0" mediaType="application/json" />
        </response>
        <response status="404">
          <doc title="404" xml:lang="en">No such shop, or the admin token or API key doesn't match it.</doc>
          <representation element="schemas:getPayPalConnection404_Response0" mediaType="application/json" />
        </response>
        <response status="502">
          <doc title="502" xml:lang="en">Gemini, PayPal or Channel3 failed or isn't configured.</doc>
          <representation element="schemas:getPayPalConnection502_Response0" mediaType="application/json" />
        </response>
        <response status="503">
          <doc title="503" xml:lang="en">Gemini, PayPal or Channel3 failed or isn't configured.</doc>
          <representation element="schemas:getPayPalConnection503_Response0" mediaType="application/json" />
        </response>
      </method>
      <method id="disconnectPayPal" name="DELETE">
        <doc title="disconnectPayPal" xml:lang="en">Forgets the connected account. Sales go back to the shop's `paypal_email`.</doc>
        <request />
        <response status="200">
          <doc title="200" xml:lang="en">Done.</doc>
          <representation element="schemas:disconnectPayPal200_Response0" mediaType="application/json" />
        </response>
        <response status="404">
          <doc title="404" xml:lang="en">No such shop, or the admin token or API key doesn't match it.</doc>
          <representation element="schemas:disconnectPayPal404_Response0" mediaType="application/json" />
        </response>
      </method>
    </resource>
    <resource id="_apislugscheck" path="/api/slugs/check">
      <method id="checkLinkName" name="GET">
        <doc title="checkLinkName" xml:lang="en">Normalises a proposed link name and says whether a new shop can use it.</doc>
        <request>
          <param name="name" style="query" type="xsd:string" required="true">
            <doc title="name" xml:lang="en">Anything; it is normalised (`Raptor Rush` becomes `raptor-rush`).</doc>
          </param>
        </request>
        <response status="200">
          <doc title="200" xml:lang="en">The normalised name and whether it can be used.</doc>
          <representation element="schemas:checkLinkName200_Response0" mediaType="application/json" />
        </response>
      </method>
    </resource>
    <resource id="_apichannel3search" path="/api/channel3/search">
      <method id="searchProducts" name="GET">
        <doc title="searchProducts" xml:lang="en">Searches 100M+ products from 25k+ stores through Channel3. Pass a result's `id` to `createShop` with `source=channel3`.</doc>
        <request>
          <param name="q" style="query" type="xsd:string" required="true">
            <doc title="q" xml:lang="en">What to look for, in plain words.</doc>
          </param>
        </request>
        <response status="200">
          <doc title="200" xml:lang="en">Up to 12 products.</doc>
          <representation element="schemas:searchProducts200_Response0" mediaType="application/json" />
        </response>
        <response status="502">
          <doc title="502" xml:lang="en">Gemini, PayPal or Channel3 failed or isn't configured.</doc>
          <representation element="schemas:searchProducts502_Response0" mediaType="application/json" />
        </response>
        <response status="503">
          <doc title="503" xml:lang="en">Gemini, PayPal or Channel3 failed or isn't configured.</doc>
          <representation element="schemas:searchProducts503_Response0" mediaType="application/json" />
        </response>
      </method>
    </resource>
    <resource id="_apipaypalclient-token" path="/api/paypal/client-token">
      <method id="getPayPalClientToken" name="GET">
        <doc title="getPayPalClientToken" xml:lang="en">A browser-safe client token for the PayPal JavaScript SDK v6
(`paypal.createInstance({ clientToken })`), bound to the requesting site's domain.
Shop pages call this before showing the PayPal button.
</doc>
        <request />
        <response status="200">
          <doc title="200" xml:lang="en">A token for this site's domain.</doc>
          <representation element="schemas:getPayPalClientToken200_Response0" mediaType="application/json" />
        </response>
        <response status="502">
          <doc title="502" xml:lang="en">Gemini, PayPal or Channel3 failed or isn't configured.</doc>
          <representation element="schemas:getPayPalClientToken502_Response0" mediaType="application/json" />
        </response>
        <response status="503">
          <doc title="503" xml:lang="en">Gemini, PayPal or Channel3 failed or isn't configured.</doc>
          <representation element="schemas:getPayPalClientToken503_Response0" mediaType="application/json" />
        </response>
      </method>
    </resource>
    <resource id="_apiorders" path="/api/orders">
      <method id="createCheckoutOrder" name="POST">
        <doc title="createCheckoutOrder" xml:lang="en">Creates the PayPal order for one unit of a live shop's product. The amount always comes
from the shop, never from the caller. Pass the returned `id` to the PayPal JS SDK.

If the shop has buyer `options`, send one value for each. A sold-out combination answers 409.
</doc>
        <request>
          <param name="Content-Type" style="header" type="xsd:string" default="application/json" required="true" fixed="application/json">
            <doc title="Content-Type" xml:lang="en" />
          </param>
          <representation element="schemas:createCheckoutOrder_Request" mediaType="application/json" />
        </request>
        <response status="200">
          <doc title="200" xml:lang="en">PayPal order created.</doc>
          <representation element="schemas:createCheckoutOrder200_Response0" mediaType="application/json" />
        </response>
        <response status="400">
          <doc title="400" xml:lang="en">Something in the request needs fixing; `error` says what.</doc>
          <representation element="schemas:createCheckoutOrder400_Response0" mediaType="application/json" />
        </response>
        <response status="404">
          <doc title="404" xml:lang="en">No such shop, or the admin token or API key doesn't match it.</doc>
          <representation element="schemas:createCheckoutOrder404_Response0" mediaType="application/json" />
        </response>
        <response status="409">
          <doc title="409" xml:lang="en">Taken or unavailable (a link name, or a sold-out product).</doc>
          <representation element="schemas:createCheckoutOrder409_Response0" mediaType="application/json" />
        </response>
        <response status="502">
          <doc title="502" xml:lang="en">Gemini, PayPal or Channel3 failed or isn't configured.</doc>
          <representation element="schemas:createCheckoutOrder502_Response0" mediaType="application/json" />
        </response>
        <response status="503">
          <doc title="503" xml:lang="en">Gemini, PayPal or Channel3 failed or isn't configured.</doc>
          <representation element="schemas:createCheckoutOrder503_Response0" mediaType="application/json" />
        </response>
        <response status="429">
          <doc title="429" xml:lang="en">Over this network's cap for the call (see **Limits**). Retry after `Retry-After` seconds.</doc>
          <param name="Retry-After" style="plain" type="xsd:integer" required="true">
            <doc title="Retry-After" xml:lang="en">Seconds until the window resets.</doc>
          </param>
          <representation element="schemas:createCheckoutOrder429_Response0" mediaType="application/json" />
        </response>
      </method>
    </resource>
    <resource id="_apiorderspaypalOrderIdcapture" path="/api/orders/{paypalOrderId}/capture">
      <param name="paypalOrderId" style="template" type="xsd:string" required="true">
        <doc title="paypalOrderId" xml:lang="en">The PayPal order id that `createCheckoutOrder` returned.</doc>
      </param>
      <method id="captureCheckoutOrder" name="POST">
        <doc title="captureCheckoutOrder" xml:lang="en">Call after the buyer approves. Records the sale; digital orders get a download link or access code.
Safe to call repeatedly: before approval it answers 409, so a page can poll it while the PayPal window is open.
</doc>
        <request />
        <response status="200">
          <doc title="200" xml:lang="en">Paid.</doc>
          <representation element="schemas:captureCheckoutOrder200_Response0" mediaType="application/json" />
        </response>
        <response status="402">
          <doc title="402" xml:lang="en">Something in the request needs fixing; `error` says what.</doc>
          <representation element="schemas:captureCheckoutOrder402_Response0" mediaType="application/json" />
        </response>
        <response status="404">
          <doc title="404" xml:lang="en">No such shop, or the admin token or API key doesn't match it.</doc>
          <representation element="schemas:captureCheckoutOrder404_Response0" mediaType="application/json" />
        </response>
        <response status="409">
          <doc title="409" xml:lang="en">The buyer hasn't approved the order yet.</doc>
          <representation element="schemas:captureCheckoutOrder409_Response0" mediaType="application/json" />
        </response>
        <response status="410">
          <doc title="410" xml:lang="en">The last unit (or the last of the buyer's combination) sold while they were paying, or the PayPal checkout expired before they paid. The payment isn't captured, so the buyer isn't charged.</doc>
          <representation element="schemas:captureCheckoutOrder410_Response0" mediaType="application/json" />
        </response>
        <response status="422">
          <doc title="422" xml:lang="en">The buyer's funding source was declined (`INSTRUMENT_DECLINED`); they can try another.</doc>
          <representation element="schemas:captureCheckoutOrder422_Response0" mediaType="application/json" />
        </response>
        <response status="502">
          <doc title="502" xml:lang="en">Gemini, PayPal or Channel3 failed or isn't configured.</doc>
          <representation element="schemas:captureCheckoutOrder502_Response0" mediaType="application/json" />
        </response>
      </method>
    </resource>
    <resource id="_apiaccessverify" path="/api/access/verify">
      <method id="verifyAccessCode" name="POST">
        <doc title="verifyAccessCode" xml:lang="en">For apps and games sold with access codes. Callable from any origin (CORS `*`): it only
answers valid or not for one shop, and counts uses. Accepts the shop's current or former
link names, and codes typed loosely (lower case, spaces, no dashes).
</doc>
        <request>
          <param name="Content-Type" style="header" type="xsd:string" default="application/json" required="true" fixed="application/json">
            <doc title="Content-Type" xml:lang="en" />
          </param>
          <representation element="schemas:verifyAccessCode_Request" mediaType="application/json" />
        </request>
        <response status="200">
          <doc title="200" xml:lang="en">The answer. Invalid codes are also a 200.</doc>
          <representation element="schemas:verifyAccessCode200_Response0" mediaType="application/json" />
        </response>
      </method>
    </resource>
    <resource id="_apishopsslugorders" path="/api/shops/{slug}/orders">
      <param name="slug" style="template" type="xsd:string" required="true">
        <doc title="slug" xml:lang="en">The shop's link name (current or former).</doc>
      </param>
      <method id="listOrders" name="GET">
        <doc title="listOrders" xml:lang="en">Newest first. Checkouts that were never approved are left out.</doc>
        <request />
        <response status="200">
          <doc title="200" xml:lang="en">Orders.</doc>
          <representation element="schemas:listOrders200_Response0" mediaType="application/json" />
        </response>
        <response status="404">
          <doc title="404" xml:lang="en">No such shop, or the admin token or API key doesn't match it.</doc>
          <representation element="schemas:listOrders404_Response0" mediaType="application/json" />
        </response>
      </method>
    </resource>
    <resource id="_apishopsslugordersorderIdship" path="/api/shops/{slug}/orders/{orderId}/ship">
      <param name="slug" style="template" type="xsd:string" required="true">
        <doc title="slug" xml:lang="en">The shop's link name (current or former).</doc>
      </param>
      <param name="orderId" style="template" type="xsd:string" required="true">
        <doc title="orderId" xml:lang="en">OneThing's order id (`Order.id`).</doc>
      </param>
      <method id="markOrderShipped" name="POST">
        <doc title="markOrderShipped" xml:lang="en">Saves the tracking number and pushes it to PayPal, so the buyer sees it in PayPal.</doc>
        <request>
          <param name="Content-Type" style="header" type="xsd:string" default="application/json" required="true" fixed="application/json">
            <doc title="Content-Type" xml:lang="en" />
          </param>
          <representation element="schemas:markOrderShipped_Request" mediaType="application/json" />
        </request>
        <response status="200">
          <doc title="200" xml:lang="en">Shipped.</doc>
          <representation element="schemas:markOrderShipped200_Response0" mediaType="application/json" />
        </response>
        <response status="400">
          <doc title="400" xml:lang="en">Something in the request needs fixing; `error` says what.</doc>
          <representation element="schemas:markOrderShipped400_Response0" mediaType="application/json" />
        </response>
        <response status="404">
          <doc title="404" xml:lang="en">No such shop, or the admin token or API key doesn't match it.</doc>
          <representation element="schemas:markOrderShipped404_Response0" mediaType="application/json" />
        </response>
      </method>
    </resource>
    <resource id="_apishopsslugordersorderIdrefund" path="/api/shops/{slug}/orders/{orderId}/refund">
      <param name="slug" style="template" type="xsd:string" required="true">
        <doc title="slug" xml:lang="en">The shop's link name (current or former).</doc>
      </param>
      <param name="orderId" style="template" type="xsd:string" required="true">
        <doc title="orderId" xml:lang="en">OneThing's order id (`Order.id`).</doc>
      </param>
      <method id="refundOrder" name="POST">
        <doc title="refundOrder" xml:lang="en">Refunds the whole payment through PayPal and marks the order `refunded`. When PayPal only lets the paid account refund it (the money went to a PayPal email the seller typed in, not a connected account), the reply is a 409 with `refundInPayPal: true`. Refund it in your PayPal account, then call this again with `{"record": true}`, which only marks it refunded here. Sends the `order.refunded` event to the shop's Zapier hook.</doc>
        <request>
          <param name="Content-Type" style="header" type="xsd:string" default="application/json" required="true" fixed="application/json">
            <doc title="Content-Type" xml:lang="en" />
          </param>
          <representation element="schemas:refundOrder_Request" mediaType="application/json" />
        </request>
        <response status="200">
          <doc title="200" xml:lang="en">Refunded.</doc>
          <representation element="schemas:refundOrder200_Response0" mediaType="application/json" />
        </response>
        <response status="404">
          <doc title="404" xml:lang="en">No such shop or order, or the token doesn't match the shop.</doc>
          <representation element="schemas:refundOrder404_Response0" mediaType="application/json" />
        </response>
        <response status="409">
          <doc title="409" xml:lang="en">Not refundable here; `error` says why.</doc>
          <representation element="schemas:refundOrder409_Response0" mediaType="application/json" />
        </response>
      </method>
    </resource>
    <resource id="_apishopsslugwebhooks" path="/api/shops/{slug}/webhooks">
      <param name="slug" style="template" type="xsd:string" required="true">
        <doc title="slug" xml:lang="en">The shop's link name (current or former).</doc>
      </param>
      <method id="listWebhookEvents" name="GET">
        <doc title="listWebhookEvents" xml:lang="en">The last 50 PayPal webhook deliveries about this shop's orders, with signature results.</doc>
        <request />
        <response status="200">
          <doc title="200" xml:lang="en">Events, newest first.</doc>
          <representation element="schemas:listWebhookEvents200_Response0" mediaType="application/json" />
        </response>
        <response status="404">
          <doc title="404" xml:lang="en">No such shop, or the admin token or API key doesn't match it.</doc>
          <representation element="schemas:listWebhookEvents404_Response0" mediaType="application/json" />
        </response>
      </method>
    </resource>
    <resource id="_apidownloadtoken" path="/api/download/{token}">
      <param name="token" style="template" type="xsd:string" required="true">
        <doc title="token" xml:lang="en">The download token from a paid order's thank-you page.</doc>
      </param>
      <method id="downloadFile" name="GET">
        <doc title="downloadFile" xml:lang="en">A paid digital order's private link. Works 5 times within 14 days.</doc>
        <request />
        <response status="200">
          <doc title="200" xml:lang="en">The file.</doc>
          <representation element="schemas:response200" mediaType="application/octet-stream" />
        </response>
        <response status="410">
          <doc title="410" xml:lang="en">Expired or used up.</doc>
          <representation element="schemas:response410" mediaType="text/plain" />
        </response>
      </method>
    </resource>
    <resource id="_apiblobsid" path="/api/blobs/{id}">
      <param name="id" style="template" type="xsd:string" required="true">
        <doc title="id" xml:lang="en">A shop's `photo_blob` or `hero_blob`.</doc>
      </param>
      <method id="getImage" name="GET">
        <doc title="getImage" xml:lang="en">Public images only. Purchased files are never served here.</doc>
        <request />
        <response status="200">
          <doc title="200" xml:lang="en">The image.</doc>
          <representation element="schemas:response2001" mediaType="image/*" />
        </response>
        <response status="404">
          <doc title="404" xml:lang="en">Not a public shop image.</doc>
        </response>
      </method>
    </resource>
    <resource id="_oorderId" path="/o/{orderId}">
      <param name="orderId" style="template" type="xsd:string" required="true">
        <doc title="orderId" xml:lang="en">The `order_id` from the MCP `create_order` tool.</doc>
      </param>
      <method id="openPayLink" name="GET">
        <doc title="openPayLink" xml:lang="en">The `pay_url` an agent gives the buyer. It redirects to PayPal's payment page for the order, so PayPal's checkout token never passes through the agent (agent platforms hide such tokens as secrets). A paid order redirects to its thank-you page; an expired checkout goes back to the shop page.</doc>
        <request />
        <response status="303">
          <doc title="303" xml:lang="en">Redirect to PayPal, the thank-you page or the shop page.</doc>
        </response>
        <response status="404">
          <doc title="404" xml:lang="en">No order with that id.</doc>
          <representation element="schemas:response404" mediaType="text/plain" />
        </response>
      </method>
    </resource>
    <resource id="_apiagentshops" path="/api/agent/shops">
      <method id="listAgentShops" name="GET">
        <doc title="listAgentShops" xml:lang="en">The gallery's live shops for a query: shops matching more of its words first, newest first among equals. Browsing words ("something interesting to buy") are ignored, and a query that matches nothing returns the newest shops with `matched: false` rather than an empty list. The GET twin of the MCP `search_shops` tool, for agents that can only fetch URLs. Public. Read a shop with `getAgentProduct`; buy through the MCP server in `mcp_server`, or send the buyer to the shop's `url`.</doc>
        <request>
          <param name="q" style="query" type="xsd:string">
            <doc title="q" xml:lang="en">Keywords. Leave out to list the newest shops.</doc>
          </param>
          <param name="limit" style="query" type="xsd:integer" default="10">
            <doc title="limit" xml:lang="en">How many shops, 1–25.</doc>
          </param>
        </request>
        <response status="200">
          <doc title="200" xml:lang="en">The matching shops.</doc>
          <representation element="schemas:listAgentShops200_Response0" mediaType="application/json" />
        </response>
      </method>
    </resource>
    <resource id="_apiagentshopsslugorder" path="/api/agent/shops/{slug}/order">
      <param name="slug" style="template" type="xsd:string" required="true">
        <doc title="slug" xml:lang="en">The shop's link name (current or former).</doc>
      </param>
      <method id="orderByLink" name="GET">
        <doc title="orderByLink" xml:lang="en">Orders one unit with a GET: the MCP `create_order` tool for AI assistants that can only
fetch URLs, such as free-tier ChatGPT or Grok. Nothing is charged. The reply has `pay_url`,
where the buyer pays at PayPal, and `status_url` (`getAgentOrder`), which says when they
have and what they got.

For a product with options, pass the buyer's pick as query parameters named after the
options (`?Size=9`, or `?Color=Ice+Blue&amp;Size=L`); names and values are matched without
regard to case. You rarely build this URL yourself: `getAgentProduct` and `/llms.txt`
write it out in full (`order_url`, or `variants[].order_url`), because some assistants
only open URLs they have been shown.

Every request makes a new order, so open it once, after the buyer says to buy. Known
crawlers and link previewers get a 403 (and are kept out by `robots.txt`); any other
leaves an unpaid order at most, since stock is only taken when a payment is captured.
Replies are `no-store` and `X-Robots-Tag: noindex, nofollow`.

`/&lt;slug&gt;/buy` is the same endpoint at a short URL, and the one `order_url` uses.
A person clicking the link in a browser (`Sec-Fetch-User: ?1`) is redirected instead; known assistants and headless browsers always get JSON. It goes straight to `pay_url`, or to the shop page when an option is missing
or unknown.
</doc>
        <request>
          <param name="agent" style="query" type="xsd:string">
            <doc title="agent" xml:lang="en">Optional: the agent's name (`ChatGPT`, `Gemini`, `my-shopping-bot`), so the seller's stats show which agent sent the buyer. Only used when the user agent doesn't already say.</doc>
          </param>
          <param name="Size" style="query" type="xsd:string">
            <doc title="Size" xml:lang="en">An example option. The real parameter names are the product's option names from `getAgentProduct` (`options[].name`), one per option.</doc>
          </param>
        </request>
        <response status="200">
          <doc title="200" xml:lang="en">The order, waiting for the buyer to pay.</doc>
          <representation element="schemas:orderByLink200_Response0" mediaType="application/json" />
        </response>
        <response status="303">
          <doc title="303" xml:lang="en">A person clicked the link. Redirect to PayPal (`pay_url`), or to the shop page to pick an option.</doc>
          <param name="Location" style="plain" type="xsd:string" required="true">
            <doc title="Location" xml:lang="en">Where the buyer goes next.</doc>
          </param>
        </response>
        <response status="400">
          <doc title="400" xml:lang="en">A missing or unknown option value, or sold out. `error` names the valid values.</doc>
          <representation element="schemas:orderByLink400_Response0" mediaType="application/json" />
        </response>
        <response status="403">
          <doc title="403" xml:lang="en">A known crawler or link previewer. They don't place orders.</doc>
          <representation element="schemas:orderByLink403_Response0" mediaType="application/json" />
        </response>
        <response status="404">
          <doc title="404" xml:lang="en">No live shop with that link name.</doc>
          <representation element="schemas:orderByLink404_Response0" mediaType="application/json" />
        </response>
        <response status="429">
          <doc title="429" xml:lang="en">Over this network's cap for the call (see **Limits**). Retry after `Retry-After` seconds.</doc>
          <param name="Retry-After" style="plain" type="xsd:integer" required="true">
            <doc title="Retry-After" xml:lang="en">Seconds until the window resets.</doc>
          </param>
          <representation element="schemas:orderByLink429_Response0" mediaType="application/json" />
        </response>
      </method>
    </resource>
    <resource id="_apiagentordersorderId" path="/api/agent/orders/{orderId}">
      <param name="orderId" style="template" type="xsd:string" required="true">
        <doc title="orderId" xml:lang="en">The `order_id` from the MCP `create_order` tool, or from a thank-you page link (`?order=`).</doc>
      </param>
      <method id="getAgentOrder" name="GET">
        <doc title="getAgentOrder" xml:lang="en">Where an order stands and, once paid, what the buyer got: the access code, the download link, or the shipping address and tracking. The GET twin of the MCP `get_order` tool (and the `status_url` that `create_order` returns), for agents that can only fetch URLs. Public: anyone with the order id can already open its thank-you page. If the buyer has approved at PayPal but nothing has captured the payment yet, this captures it. `/o/&lt;order_id&gt;/status` is the same endpoint at a short URL, and the one `status_url` uses. A person clicking the link in a browser (`Sec-Fetch-User: ?1`) is redirected instead; known assistants and headless browsers always get JSON. It goes to the order's receipt page.</doc>
        <request>
          <param name="agent" style="query" type="xsd:string">
            <doc title="agent" xml:lang="en">Optional: the agent's name (`ChatGPT`, `Gemini`, `my-shopping-bot`), so the seller's stats show which agent sent the buyer. Only used when the user agent doesn't already say.</doc>
          </param>
        </request>
        <response status="200">
          <doc title="200" xml:lang="en">The order.</doc>
          <representation element="schemas:getAgentOrder200_Response0" mediaType="application/json" />
        </response>
        <response status="303">
          <doc title="303" xml:lang="en">A person clicked the link. Redirect to the order's page (`/o/&lt;order_id&gt;`).</doc>
        </response>
        <response status="404">
          <doc title="404" xml:lang="en">No order with that id.</doc>
          <representation element="schemas:getAgentOrder404_Response0" mediaType="application/json" />
        </response>
      </method>
    </resource>
    <resource id="_apiagentshopsslug" path="/api/agent/shops/{slug}">
      <param name="slug" style="template" type="xsd:string" required="true">
        <doc title="slug" xml:lang="en">The shop's link name (current or former).</doc>
      </param>
      <method id="getAgentProduct" name="GET">
        <doc title="getAgentProduct" xml:lang="en">Everything an AI shopping agent needs to describe the product and decide to buy it: price, shipping, delivery, availability, options, images and FAQ. Public. Buying goes through the MCP server named in `mcp_server`, or the `order_url` links. Shop pages also carry the same facts as schema.org `Product` JSON-LD. A person clicking the link in a browser (`Sec-Fetch-User: ?1`) is redirected instead; known assistants and headless browsers always get JSON. It goes to the shop page, unless the link has `?view=json`.</doc>
        <request>
          <param name="agent" style="query" type="xsd:string">
            <doc title="agent" xml:lang="en">Optional: the agent's name (`ChatGPT`, `Gemini`, `my-shopping-bot`), so the seller's stats show which agent sent the buyer. Only used when the user agent doesn't already say.</doc>
          </param>
          <param name="view" style="query" default="">
            <doc title="view" xml:lang="en">`json` keeps the JSON for a person opening the link in a browser.</doc>
            <option value="json">
              <doc title="json" xml:lang="en" />
            </option>
          </param>
        </request>
        <response status="200">
          <doc title="200" xml:lang="en">The product.</doc>
          <representation element="schemas:getAgentProduct200_Response0" mediaType="application/json" />
        </response>
        <response status="303">
          <doc title="303" xml:lang="en">A person clicked the link. Redirect to the shop page (`/&lt;slug&gt;`).</doc>
        </response>
        <response status="404">
          <doc title="404" xml:lang="en">No live shop with that link name.</doc>
          <representation element="schemas:getAgentProduct404_Response0" mediaType="application/json" />
        </response>
      </method>
    </resource>
    <resource id="_apimcp" path="/api/mcp">
      <method id="callMcp" name="POST">
        <doc title="callMcp" xml:lang="en">A [Model Context Protocol](https://modelcontextprotocol.io) server, so agents such as
Claude can shop here. Add `https://&lt;host&gt;/api/mcp` to an MCP client as a Streamable HTTP
server. It's stateless: each POST carries one JSON-RPC 2.0 message (or a batch) and gets a
plain JSON reply, with no event stream. The `initialize` reply's `Mcp-Session-Id` header
carries the client's `clientInfo.name`; send it back on later requests (MCP clients do)
so the seller's stats show which agent sent the buyer. Nothing else is kept.

Methods: `initialize`, `ping`, `tools/list`, `tools/call`, and `resources/list`,
`resources/templates/list` and `resources/read` for the product card. Each tool carries
`annotations` (only `create_order` isn't `readOnlyHint`). Tools:

| Tool | Arguments | What it does |
|---|---|---|
| `search_shops` | `query?`, `limit?` (1–25) | Live gallery shops, best match first; no match returns the newest with `matched: false` |
| `get_product` | `shop` | The same object as `getAgentProduct` |
| `create_order` | `shop`, `options?` | One unit on order; returns `order_id` and `pay_url` |
| `get_order` | `order_id` | Status and `next_step`; once paid, the receipt and `delivery` |

**The buyer always approves.** `create_order` charges nothing: the agent shows the buyer
`pay_url` (`/o/&lt;order_id&gt;`, see `openPayLink`), which opens PayPal. It's a plain link on this
site, so agent platforms that hide PayPal's checkout tokens can still show it. When the buyer
says they've paid, the agent calls `get_order`.

`get_order` status is one of `awaiting_buyer_approval`, `paid`, `declined` (nothing charged;
the buyer can open `pay_url` again), `sold_out`, `expired` (call `create_order` again) or
`failed` (PayPal couldn't be reached; try again), with a `next_step` the agent can follow.
A paid order carries `delivery`: `{type: access_code, access_code, start_url?}`,
`{type: download, download_url}` or `{type: shipping, ship_to, fulfillment, tracking}`, plus
`amount` with item, shipping and total. Orders made this way show `channel: agent` in
`listOrders`.

**The product card.** Hosts that draw MCP Apps UI (ChatGPT, or a client that declares the
`io.modelcontextprotocol/ui` extension) get `search_shops`, `get_product` and
`create_order` results as a card with the real photos, options and a Pay with PayPal button
(`ui://onething/shop-card-v1.html`). For them `show_buyer` is a one-line note rather than
Markdown, so the model doesn't repeat or invent what the card shows.

Tool errors (an unknown shop, a sold-out size, over the checkout cap) come back as results
with `isError: true`, so the model can read them and try something else.
</doc>
        <request>
          <param name="Content-Type" style="header" type="xsd:string" default="application/json" required="true" fixed="application/json">
            <doc title="Content-Type" xml:lang="en" />
          </param>
          <representation element="schemas:body" mediaType="application/json" />
        </request>
        <response status="200">
          <doc title="200" xml:lang="en">The JSON-RPC reply (an array for a batch).</doc>
          <representation element="schemas:response2002" mediaType="application/json" />
        </response>
        <response status="202">
          <doc title="202" xml:lang="en">Only notifications were sent; there's nothing to reply.</doc>
        </response>
        <response status="400">
          <doc title="400" xml:lang="en">Not JSON (JSON-RPC parse error `-32700`).</doc>
          <representation element="schemas:callMcp400_Response0" mediaType="application/json" />
        </response>
      </method>
    </resource>
    <resource id="_apiplatformshops" path="/api/platform/shops">
      <method id="listMyShops" name="GET">
        <doc title="listMyShops" xml:lang="en">Every shop the API key's account owns, newest first, with what a catalog page needs: name, price, cover, link, whether PayPal is connected and how many sales it has.</doc>
        <request>
          <param name="status" style="query" default="">
            <doc title="status" xml:lang="en">Only shops with this status, e.g. `live` for a public catalog.</doc>
            <option value="draft">
              <doc title="draft" xml:lang="en" />
            </option>
            <option value="live">
              <doc title="live" xml:lang="en" />
            </option>
          </param>
        </request>
        <response status="200">
          <doc title="200" xml:lang="en">The shops.</doc>
          <representation element="schemas:listMyShops200_Response0" mediaType="application/json" />
        </response>
        <response status="401">
          <doc title="401" xml:lang="en">No API key, or it's wrong or revoked.</doc>
          <representation element="schemas:listMyShops401_Response0" mediaType="application/json" />
        </response>
      </method>
    </resource>
  </resources>
</application>