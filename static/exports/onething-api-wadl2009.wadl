  <resources base="https://one-thing-ash0.onrender.com">
    <resource id="_apiaccountsignin" path="/api/account/signin">
      <method id="signIn" name="POST">
        <doc title="signIn" xml:lang="en">Signs in with an email address or a phone number, creating the account the first time. There's no password and no verification (sandbox). The response sets the `ot_session` cookie; shops created with it belong to the account and are listed on `/account`. Signing in with an email also claims older shops whose seller email matches. In a browser, sellers can instead use Log in with PayPal (`/api/account/paypal`), which also records the PayPal account their sales are paid into.</doc>
        <request>
          <param name="Content-Type" style="header" type="xsd:string" default="application/json" required="true" fixed="application/json">
            <doc title="Content-Type" xml:lang="en" />
          </param>
          <representation element="schemas:signIn_Request" mediaType="application/json" />
        </request>
        <response status="200">
          <doc title="200" xml:lang="en">Signed in. The `ot_session` cookie is set.</doc>
          <param name="Set-Cookie" style="plain" type="xsd:string" required="true">
            <doc title="Set-Cookie" xml:lang="en">The session cookie: `ot_session=&lt;token&gt;`, HttpOnly, for a year.</doc>
          </param>
          <representation element="schemas:signIn200_Response0" mediaType="application/json" />
        </response>
        <response status="400">
          <doc title="400" xml:lang="en">Something in the request needs fixing; `error` says what.</doc>
          <representation element="schemas:signIn400_Response0" mediaType="application/json" />
        </response>
      </method>
    </resource>
    <resource id="_apiaccountsignout" path="/api/account/signout">
      <method id="signOut" name="POST">
        <doc title="signOut" xml:lang="en">Ends this browser's session and clears the `ot_session` cookie.</doc>
        <request />
        <response status="200">
          <doc title="200" xml:lang="en">Done.</doc>
          <representation element="schemas:signOut200_Response0" mediaType="application/json" />
        </response>
      </method>
    </resource>
    <resource id="_apishops" path="/api/shops">
      <method id="createShop" name="POST">
        <doc title="createShop" xml:lang="en">Starts a draft shop from one of three sources. Gemini designs the page and guesses the
setup; check it with `getShop`, adjust with `updateShop`, then go live.

Sent with a session cookie from `signIn`, the shop belongs to that account, which also
becomes its seller email (and PayPal email, after Log in with PayPal) unless you give one.

- `source=photo`: a `photo` and/or a `description` of your own product.
- `source=link`: a `url`. If Channel3 recognises it as a store's product page, the shop
  becomes a recommendation (`product_type: referral`); otherwise the page is read and you
  sell the product yourself with PayPal.
- `source=channel3`: a `productId` from `searchProducts` (a recommendation).

Takes 15–40 seconds. Hero art, if available, is generated afterwards (`hero_status`).
</doc>
        <request>
          <representation mediaType="multipart/form-data">
            <param name="source" style="query" required="true">
              <doc title="source" xml:lang="en" />
              <option value="photo">
                <doc title="photo" xml:lang="en" />
              </option>
              <option value="link">
                <doc title="link" xml:lang="en" />
              </option>
              <option value="channel3">
                <doc title="channel3" xml:lang="en" />
              </option>
            </param>
            <param name="photo" style="query" type="xsd:hexBinary">
              <doc title="photo" xml:lang="en">`source=photo`: the product photo, up to 8 MB.</doc>
            </param>
            <param name="description" style="query" type="xsd:string">
              <doc title="description" xml:lang="en">`source=photo`: a sentence or two about the product. Required if there is no photo.</doc>
            </param>
            <param name="url" style="query" type="xsd:string">
              <doc title="url" xml:lang="en">`source=link`: a product page, or your own app or game page.</doc>
            </param>
            <param name="productId" style="query" type="xsd:string">
              <doc title="productId" xml:lang="en">`source=channel3`: a product id from `searchProducts`.</doc>
            </param>
            <param name="slug" style="query" type="xsd:string">
              <doc title="slug" xml:lang="en">The link name you want. If omitted, the AI suggests one.</doc>
            </param>
            <param name="type" style="query" default="auto">
              <doc title="type" xml:lang="en" />
              <option value="auto">
                <doc title="auto" xml:lang="en" />
              </option>
              <option value="physical">
                <doc title="physical" xml:lang="en" />
              </option>
              <option value="digital">
                <doc title="digital" xml:lang="en" />
              </option>
            </param>
            <param name="delivery" style="query">
              <doc title="delivery" xml:lang="en">For digital products. If omitted, the AI guesses.</doc>
              <option value="file">
                <doc title="file" xml:lang="en" />
              </option>
              <option value="access_code">
                <doc title="access_code" xml:lang="en" />
              </option>
            </param>
            <param name="access_url" style="query" type="xsd:string">
              <doc title="access_url" xml:lang="en">Where buyers use an access code.</doc>
            </param>
            <param name="price" style="query" type="xsd:double">
              <doc title="price" xml:lang="en">USD. If omitted, the AI suggests a price.</doc>
            </param>
            <param name="shipping" style="query" type="xsd:double">
              <doc title="shipping" xml:lang="en" />
            </param>
            <param name="stock" style="query" type="xsd:integer">
              <doc title="stock" xml:lang="en" />
            </param>
            <param name="ship_countries" style="query" type="xsd:string">
              <doc title="ship_countries" xml:lang="en" />
            </param>
            <param name="paypal_email" style="query" type="xsd:string">
              <doc title="paypal_email" xml:lang="en" />
            </param>
            <param name="seller_email" style="query" type="xsd:string">
              <doc title="seller_email" xml:lang="en" />
            </param>
            <param name="digital_file" style="query" type="xsd:hexBinary">
              <doc title="digital_file" xml:lang="en" />
            </param>
          </representation>
        </request>
        <response status="200">
          <doc title="200" xml:lang="en">Draft created.</doc>
          <representation element="schemas:createShop200_Response0" mediaType="application/json" />
        </response>
        <response status="400">
          <doc title="400" xml:lang="en">Something in the request needs fixing; `error` says what.</doc>
          <representation element="schemas:createShop400_Response0" mediaType="application/json" />
        </response>
        <response status="409">
          <doc title="409" xml:lang="en">Taken or unavailable (a link name, or a sold-out product).</doc>
          <representation element="schemas:createShop409_Response0" mediaType="application/json" />
        </response>
        <response status="502">
          <doc title="502" xml:lang="en">Gemini, PayPal or Channel3 failed or isn't configured.</doc>
          <representation element="schemas:createShop502_Response0" mediaType="application/json" />
        </response>
      </method>
    </resource>
    <resource id="_apishopsslug" path="/api/shops/{slug}">
      <param name="slug" style="template" type="xsd:string" required="true">
        <doc title="slug" xml:lang="en">The shop's link name (current or former).</doc>
      </param>
      <param name="slug" style="template" type="xsd:string" required="true">
        <doc title="slug" xml:lang="en">The shop's link name (current or former).</doc>
      </param>
      <method id="getShop" name="GET">
        <doc title="getShop" xml:lang="en">Everything about the shop, including the AI's design spec and guesses.</doc>
        <request />
        <response status="200">
          <doc title="200" xml:lang="en">The shop.</doc>
          <representation element="schemas:getShop200_Response0" mediaType="application/json" />
        </response>
        <response status="404">
          <doc title="404" xml:lang="en">No such shop, or the admin token doesn't match it.</doc>
          <representation element="schemas:getShop404_Response0" mediaType="application/json" />
        </response>
      </method>
      <method id="updateShop" name="PATCH">
        <doc title="updateShop" xml:lang="en">Changes only the fields you send. Renaming `slug` keeps the old link working (it
redirects). Set `status: live` to publish; a digital product needs its file (or, for
access codes, `access_url`) first.
</doc>
        <request>
          <param name="Content-Type" style="header" type="xsd:string" default="application/json" required="true" fixed="application/json">
            <doc title="Content-Type" xml:lang="en" />
          </param>
          <representation element="schemas:updateShop_Request" mediaType="application/json" />
        </request>
        <response status="200">
          <doc title="200" xml:lang="en">Saved.</doc>
          <representation element="schemas:updateShop200_Response0" mediaType="application/json" />
        </response>
        <response status="400">
          <doc title="400" xml:lang="en">Something in the request needs fixing; `error` says what.</doc>
          <representation element="schemas:updateShop400_Response0" mediaType="application/json" />
        </response>
        <response status="404">
          <doc title="404" xml:lang="en">No such shop, or the admin token doesn't match it.</doc>
          <representation element="schemas:updateShop404_Response0" mediaType="application/json" />
        </response>
      </method>
    </resource>
    <resource id="_apishopsslugrefine" path="/api/shops/{slug}/refine">
      <param name="slug" style="template" type="xsd:string" required="true">
        <doc title="slug" xml:lang="en">The shop's link name (current or former).</doc>
      </param>
      <method id="refineShopDesign" name="POST">
        <doc title="refineShopDesign" xml:lang="en">"Make it warmer", "shorter copy", "more premium". Gemini edits the design spec.</doc>
        <request>
          <param name="Content-Type" style="header" type="xsd:string" default="application/json" required="true" fixed="application/json">
            <doc title="Content-Type" xml:lang="en" />
          </param>
          <representation element="schemas:refineShopDesign_Request" mediaType="application/json" />
        </request>
        <response status="200">
          <doc title="200" xml:lang="en">The new design.</doc>
          <representation element="schemas:refineShopDesign200_Response0" mediaType="application/json" />
        </response>
        <response status="400">
          <doc title="400" xml:lang="en">Something in the request needs fixing; `error` says what.</doc>
          <representation element="schemas:refineShopDesign400_Response0" mediaType="application/json" />
        </response>
        <response status="404">
          <doc title="404" xml:lang="en">No such shop, or the admin token doesn't match it.</doc>
          <representation element="schemas:refineShopDesign404_Response0" mediaType="application/json" />
        </response>
        <response status="502">
          <doc title="502" xml:lang="en">Gemini, PayPal or Channel3 failed or isn't configured.</doc>
          <representation element="schemas:refineShopDesign502_Response0" mediaType="application/json" />
        </response>
      </method>
    </resource>
    <resource id="_apishopsslughero" path="/api/shops/{slug}/hero">
      <param name="slug" style="template" type="xsd:string" required="true">
        <doc title="slug" xml:lang="en">The shop's link name (current or former).</doc>
      </param>
      <method id="regenerateHeroArt" name="POST">
        <doc title="regenerateHeroArt" xml:lang="en">Starts generation in the background. Poll `getShop` for `hero_status`.</doc>
        <request />
        <response status="200">
          <doc title="200" xml:lang="en">Done.</doc>
          <representation element="schemas:regenerateHeroArt200_Response0" mediaType="application/json" />
        </response>
        <response status="400">
          <doc title="400" xml:lang="en">Something in the request needs fixing; `error` says what.</doc>
          <representation element="schemas:regenerateHeroArt400_Response0" mediaType="application/json" />
        </response>
        <response status="404">
          <doc title="404" xml:lang="en">No such shop, or the admin token doesn't match it.</doc>
          <representation element="schemas:regenerateHeroArt404_Response0" mediaType="application/json" />
        </response>
      </method>
    </resource>
    <resource id="_apishopsslugfile" path="/api/shops/{slug}/file">
      <param name="slug" style="template" type="xsd:string" required="true">
        <doc title="slug" xml:lang="en">The shop's link name (current or former).</doc>
      </param>
      <method id="uploadDigitalFile" name="POST">
        <doc title="uploadDigitalFile" xml:lang="en">Uploads or replaces a digital product's file, up to 25 MB. Each paid order gets a download link for it.</doc>
        <request>
          <representation mediaType="multipart/form-data">
            <param name="file" style="query" type="xsd:hexBinary" required="true">
              <doc title="file" xml:lang="en">Up to 25 MB.</doc>
            </param>
          </representation>
        </request>
        <response status="200">
          <doc title="200" xml:lang="en">Uploaded.</doc>
          <representation element="schemas:uploadDigitalFile200_Response0" mediaType="application/json" />
        </response>
        <response status="400">
          <doc title="400" xml:lang="en">Something in the request needs fixing; `error` says what.</doc>
          <representation element="schemas:uploadDigitalFile400_Response0" mediaType="application/json" />
        </response>
        <response status="404">
          <doc title="404" xml:lang="en">No such shop, or the admin token doesn't match it.</doc>
          <representation element="schemas:uploadDigitalFile404_Response0" mediaType="application/json" />
        </response>
      </method>
    </resource>
    <resource id="_apishopsslugphotos" path="/api/shops/{slug}/photos">
      <param name="slug" style="template" type="xsd:string" required="true">
        <doc title="slug" xml:lang="en">The shop's link name (current or former).</doc>
      </param>
      <param name="slug" style="template" type="xsd:string" required="true">
        <doc title="slug" xml:lang="en">The shop's link name (current or former).</doc>
      </param>
      <method id="addPhotos" name="POST">
        <doc title="addPhotos" xml:lang="en">Adds one or more photos after the cover. Each is turned upright, resized to at most 2000 px and stored as WebP. A shop holds up to 8 photos; buyers swipe through them on the shop page. Not for recommendations, which show the retailer's photos.</doc>
        <request>
          <representation mediaType="multipart/form-data">
            <param name="photo" style="query" type="xsd:hexBinary" required="true">
              <doc title="photo" xml:lang="en">An image, up to 15 MB. The endpoint also accepts the field repeated, to add several in one request.</doc>
            </param>
          </representation>
        </request>
        <response status="200">
          <doc title="200" xml:lang="en">The shop's photos, cover first.</doc>
          <representation element="schemas:addPhotos200_Response0" mediaType="application/json" />
        </response>
        <response status="400">
          <doc title="400" xml:lang="en">Something in the request needs fixing; `error` says what.</doc>
          <representation element="schemas:addPhotos400_Response0" mediaType="application/json" />
        </response>
        <response status="404">
          <doc title="404" xml:lang="en">No such shop, or the admin token doesn't match it.</doc>
          <representation element="schemas:addPhotos404_Response0" mediaType="application/json" />
        </response>
      </method>
      <method id="setPhotoOrder" name="PUT">
        <doc title="setPhotoOrder" xml:lang="en">Sets the photo order; the first becomes the cover. Leaving a photo out removes it.</doc>
        <request>
          <param name="Content-Type" style="header" type="xsd:string" default="application/json" required="true" fixed="application/json">
            <doc title="Content-Type" xml:lang="en" />
          </param>
          <representation element="schemas:setPhotoOrder_Request" mediaType="application/json" />
        </request>
        <response status="200">
          <doc title="200" xml:lang="en">The shop's photos, cover first.</doc>
          <representation element="schemas:setPhotoOrder200_Response0" mediaType="application/json" />
        </response>
        <response status="400">
          <doc title="400" xml:lang="en">Something in the request needs fixing; `error` says what.</doc>
          <representation element="schemas:setPhotoOrder400_Response0" mediaType="application/json" />
        </response>
        <response status="404">
          <doc title="404" xml:lang="en">No such shop, or the admin token doesn't match it.</doc>
          <representation element="schemas:setPhotoOrder404_Response0" mediaType="application/json" />
        </response>
      </method>
    </resource>
    <resource id="_apislugscheck" path="/api/slugs/check">
      <method id="checkLinkName" name="GET">
        <doc title="checkLinkName" xml:lang="en">Normalises a proposed link name and says whether a new shop can use it.</doc>
        <request>
          <param name="name" style="query" type="xsd:string" required="true">
            <doc title="name" xml:lang="en">Anything; it is normalised (`Raptor Rush` becomes `raptor-rush`).</doc>
          </param>
        </request>
        <response status="200">
          <doc title="200" xml:lang="en">The normalised name and whether it can be used.</doc>
          <representation element="schemas:checkLinkName200_Response0" mediaType="application/json" />
        </response>
      </method>
    </resource>
    <resource id="_apichannel3search" path="/api/channel3/search">
      <method id="searchProducts" name="GET">
        <doc title="searchProducts" xml:lang="en">Searches 100M+ products from 25k+ stores through Channel3. Pass a result's `id` to `createShop` with `source=channel3`.</doc>
        <request>
          <param name="q" style="query" type="xsd:string" required="true">
            <doc title="q" xml:lang="en">What to look for, in plain words.</doc>
          </param>
        </request>
        <response status="200">
          <doc title="200" xml:lang="en">Up to 12 products.</doc>
          <representation element="schemas:searchProducts200_Response0" mediaType="application/json" />
        </response>
        <response status="502">
          <doc title="502" xml:lang="en">Gemini, PayPal or Channel3 failed or isn't configured.</doc>
          <representation element="schemas:searchProducts502_Response0" mediaType="application/json" />
        </response>
        <response status="503">
          <doc title="503" xml:lang="en">Gemini, PayPal or Channel3 failed or isn't configured.</doc>
          <representation element="schemas:searchProducts503_Response0" mediaType="application/json" />
        </response>
      </method>
    </resource>
    <resource id="_apipaypalclient-token" path="/api/paypal/client-token">
      <method id="getPayPalClientToken" name="GET">
        <doc title="getPayPalClientToken" xml:lang="en">A browser-safe client token for the PayPal JavaScript SDK v6
(`paypal.createInstance({ clientToken })`), bound to the requesting site's domain.
Shop pages call this before showing the PayPal button.
</doc>
        <request />
        <response status="200">
          <doc title="200" xml:lang="en">A token for this site's domain.</doc>
          <representation element="schemas:getPayPalClientToken200_Response0" mediaType="application/json" />
        </response>
        <response status="502">
          <doc title="502" xml:lang="en">Gemini, PayPal or Channel3 failed or isn't configured.</doc>
          <representation element="schemas:getPayPalClientToken502_Response0" mediaType="application/json" />
        </response>
        <response status="503">
          <doc title="503" xml:lang="en">Gemini, PayPal or Channel3 failed or isn't configured.</doc>
          <representation element="schemas:getPayPalClientToken503_Response0" mediaType="application/json" />
        </response>
      </method>
    </resource>
    <resource id="_apiorders" path="/api/orders">
      <method id="createCheckoutOrder" name="POST">
        <doc title="createCheckoutOrder" xml:lang="en">Creates the PayPal order for one unit of a live shop's product. The amount always comes
from the shop, never from the caller. Pass the returned `id` to the PayPal JS SDK.
</doc>
        <request>
          <param name="Content-Type" style="header" type="xsd:string" default="application/json" required="true" fixed="application/json">
            <doc title="Content-Type" xml:lang="en" />
          </param>
          <representation element="schemas:createCheckoutOrder_Request" mediaType="application/json" />
        </request>
        <response status="200">
          <doc title="200" xml:lang="en">PayPal order created.</doc>
          <representation element="schemas:createCheckoutOrder200_Response0" mediaType="application/json" />
        </response>
        <response status="400">
          <doc title="400" xml:lang="en">Something in the request needs fixing; `error` says what.</doc>
          <representation element="schemas:createCheckoutOrder400_Response0" mediaType="application/json" />
        </response>
        <response status="404">
          <doc title="404" xml:lang="en">No such shop, or the admin token doesn't match it.</doc>
          <representation element="schemas:createCheckoutOrder404_Response0" mediaType="application/json" />
        </response>
        <response status="409">
          <doc title="409" xml:lang="en">Taken or unavailable (a link name, or a sold-out product).</doc>
          <representation element="schemas:createCheckoutOrder409_Response0" mediaType="application/json" />
        </response>
        <response status="502">
          <doc title="502" xml:lang="en">Gemini, PayPal or Channel3 failed or isn't configured.</doc>
          <representation element="schemas:createCheckoutOrder502_Response0" mediaType="application/json" />
        </response>
        <response status="503">
          <doc title="503" xml:lang="en">Gemini, PayPal or Channel3 failed or isn't configured.</doc>
          <representation element="schemas:createCheckoutOrder503_Response0" mediaType="application/json" />
        </response>
      </method>
    </resource>
    <resource id="_apiorderspaypalOrderIdcapture" path="/api/orders/{paypalOrderId}/capture">
      <param name="paypalOrderId" style="template" type="xsd:string" required="true">
        <doc title="paypalOrderId" xml:lang="en">The PayPal order id that `createCheckoutOrder` returned.</doc>
      </param>
      <method id="captureCheckoutOrder" name="POST">
        <doc title="captureCheckoutOrder" xml:lang="en">Call after the buyer approves. Records the sale; digital orders get a download link or access code.
Safe to call repeatedly: before approval it answers 409, so a page can poll it while the PayPal window is open.
</doc>
        <request />
        <response status="200">
          <doc title="200" xml:lang="en">Paid.</doc>
          <representation element="schemas:captureCheckoutOrder200_Response0" mediaType="application/json" />
        </response>
        <response status="402">
          <doc title="402" xml:lang="en">Something in the request needs fixing; `error` says what.</doc>
          <representation element="schemas:captureCheckoutOrder402_Response0" mediaType="application/json" />
        </response>
        <response status="404">
          <doc title="404" xml:lang="en">No such shop, or the admin token doesn't match it.</doc>
          <representation element="schemas:captureCheckoutOrder404_Response0" mediaType="application/json" />
        </response>
        <response status="409">
          <doc title="409" xml:lang="en">The buyer hasn't approved the order yet.</doc>
          <representation element="schemas:captureCheckoutOrder409_Response0" mediaType="application/json" />
        </response>
        <response status="422">
          <doc title="422" xml:lang="en">The buyer's funding source was declined (`INSTRUMENT_DECLINED`); they can try another.</doc>
          <representation element="schemas:captureCheckoutOrder422_Response0" mediaType="application/json" />
        </response>
        <response status="502">
          <doc title="502" xml:lang="en">Gemini, PayPal or Channel3 failed or isn't configured.</doc>
          <representation element="schemas:captureCheckoutOrder502_Response0" mediaType="application/json" />
        </response>
      </method>
    </resource>
    <resource id="_apiaccessverify" path="/api/access/verify">
      <method id="verifyAccessCode" name="POST">
        <doc title="verifyAccessCode" xml:lang="en">For apps and games sold with access codes. Callable from any origin (CORS `*`): it only
answers valid or not for one shop, and counts uses. Accepts the shop's current or former
link names, and codes typed loosely (lower case, spaces, no dashes).
</doc>
        <request>
          <param name="Content-Type" style="header" type="xsd:string" default="application/json" required="true" fixed="application/json">
            <doc title="Content-Type" xml:lang="en" />
          </param>
          <representation element="schemas:verifyAccessCode_Request" mediaType="application/json" />
        </request>
        <response status="200">
          <doc title="200" xml:lang="en">The answer. Invalid codes are also a 200.</doc>
          <representation element="schemas:verifyAccessCode200_Response0" mediaType="application/json" />
        </response>
      </method>
    </resource>
    <resource id="_apishopsslugorders" path="/api/shops/{slug}/orders">
      <param name="slug" style="template" type="xsd:string" required="true">
        <doc title="slug" xml:lang="en">The shop's link name (current or former).</doc>
      </param>
      <method id="listOrders" name="GET">
        <doc title="listOrders" xml:lang="en">Newest first. Checkouts that were never approved are left out.</doc>
        <request />
        <response status="200">
          <doc title="200" xml:lang="en">Orders.</doc>
          <representation element="schemas:listOrders200_Response0" mediaType="application/json" />
        </response>
        <response status="404">
          <doc title="404" xml:lang="en">No such shop, or the admin token doesn't match it.</doc>
          <representation element="schemas:listOrders404_Response0" mediaType="application/json" />
        </response>
      </method>
    </resource>
    <resource id="_apishopsslugordersorderIdship" path="/api/shops/{slug}/orders/{orderId}/ship">
      <param name="slug" style="template" type="xsd:string" required="true">
        <doc title="slug" xml:lang="en">The shop's link name (current or former).</doc>
      </param>
      <param name="orderId" style="template" type="xsd:string" required="true">
        <doc title="orderId" xml:lang="en">OneThing's order id (`Order.id`).</doc>
      </param>
      <method id="markOrderShipped" name="POST">
        <doc title="markOrderShipped" xml:lang="en">Saves the tracking number and pushes it to PayPal, so the buyer sees it in PayPal.</doc>
        <request>
          <param name="Content-Type" style="header" type="xsd:string" default="application/json" required="true" fixed="application/json">
            <doc title="Content-Type" xml:lang="en" />
          </param>
          <representation element="schemas:markOrderShipped_Request" mediaType="application/json" />
        </request>
        <response status="200">
          <doc title="200" xml:lang="en">Shipped.</doc>
          <representation element="schemas:markOrderShipped200_Response0" mediaType="application/json" />
        </response>
        <response status="400">
          <doc title="400" xml:lang="en">Something in the request needs fixing; `error` says what.</doc>
          <representation element="schemas:markOrderShipped400_Response0" mediaType="application/json" />
        </response>
        <response status="404">
          <doc title="404" xml:lang="en">No such shop, or the admin token doesn't match it.</doc>
          <representation element="schemas:markOrderShipped404_Response0" mediaType="application/json" />
        </response>
      </method>
    </resource>
    <resource id="_apishopsslugwebhooks" path="/api/shops/{slug}/webhooks">
      <param name="slug" style="template" type="xsd:string" required="true">
        <doc title="slug" xml:lang="en">The shop's link name (current or former).</doc>
      </param>
      <method id="listWebhookEvents" name="GET">
        <doc title="listWebhookEvents" xml:lang="en">The last 50 PayPal webhook deliveries about this shop's orders, with signature results.</doc>
        <request />
        <response status="200">
          <doc title="200" xml:lang="en">Events, newest first.</doc>
          <representation element="schemas:listWebhookEvents200_Response0" mediaType="application/json" />
        </response>
        <response status="404">
          <doc title="404" xml:lang="en">No such shop, or the admin token doesn't match it.</doc>
          <representation element="schemas:listWebhookEvents404_Response0" mediaType="application/json" />
        </response>
      </method>
    </resource>
    <resource id="_apidownloadtoken" path="/api/download/{token}">
      <param name="token" style="template" type="xsd:string" required="true">
        <doc title="token" xml:lang="en">The download token from a paid order's thank-you page.</doc>
      </param>
      <method id="downloadFile" name="GET">
        <doc title="downloadFile" xml:lang="en">A paid digital order's private link. Works 5 times within 14 days.</doc>
        <request />
        <response status="200">
          <doc title="200" xml:lang="en">The file.</doc>
          <representation element="schemas:response200" mediaType="application/octet-stream" />
        </response>
        <response status="410">
          <doc title="410" xml:lang="en">Expired or used up.</doc>
          <representation element="schemas:response410" mediaType="text/plain" />
        </response>
      </method>
    </resource>
    <resource id="_apiblobsid" path="/api/blobs/{id}">
      <param name="id" style="template" type="xsd:string" required="true">
        <doc title="id" xml:lang="en">A shop's `photo_blob` or `hero_blob`.</doc>
      </param>
      <method id="getImage" name="GET">
        <doc title="getImage" xml:lang="en">Public images only. Purchased files are never served here.</doc>
        <request />
        <response status="200">
          <doc title="200" xml:lang="en">The image.</doc>
          <representation element="schemas:response2001" mediaType="image/*" />
        </response>
        <response status="404">
          <doc title="404" xml:lang="en">Not a public shop image.</doc>
        </response>
      </method>
    </resource>
  </resources>
</application>