      <xs:element name="listWebhookEvents404_Response0" type="schemas:listWebhookEvents404_Response0" />
      <xs:element name="response200" type="xs:hexBinary">
        <xs:annotation>
          <xs:documentation>The file.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="response410" type="xs:string">
        <xs:annotation>
          <xs:documentation>Expired or used up.</xs:documentation>
        </xs:annotation>
