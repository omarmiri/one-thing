              <xs:documentation>OneThing's order id; the thank-you page is `/&lt;slug&gt;/thanks?order=&lt;orderId&gt;`.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" fixed="paid" name="status" type="xs:string" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ApiOrdersRequest">
        <xs:sequence>
          <xs:element minOccurs="1" name="slug" type="xs:string" />
