            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ApiAccountSigninRequest">
        <xs:sequence>
          <xs:element minOccurs="1" name="identifier" type="xs:string">
            <xs:annotation>
              <xs:documentation>An email address, or a phone number (spaces, dashes and brackets are ignored; keep a leading +).</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ApiAccountSigninResponse">
        <xs:sequence>
          <xs:element minOccurs="1" name="id" type="xs:string" />
          <xs:element minOccurs="1" name="email" nillable="true" type="xs:string">
            <xs:annotation>
              <xs:documentation>Lower-cased.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="phone" nillable="true" type="xs:string">
            <xs:annotation>
              <xs:documentation>Digits, with a leading + if one was given.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ApiChannel3SearchResponse">
        <xs:sequence>
          <xs:element minOccurs="1" maxOccurs="unbounded" name="products" type="schemas:ProductCard" />
