              <xs:documentation>Photo ids, in order.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ApiShopsRefineRequest">
        <xs:sequence>
          <xs:element minOccurs="1" name="instruction">
