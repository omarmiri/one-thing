          <xs:element minOccurs="1" name="code" type="xs:string" />
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ApiAccessVerifyResponse">
        <xs:sequence>
          <xs:element minOccurs="1" name="valid" type="xs:boolean" />
