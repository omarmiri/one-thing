# Copy to .env.local and fill in. Everything is optional for a first run:
# without keys the app still works end to end with a placeholder design and checkout disabled.

# --- Gemini (designs each shop) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model ids vary by key; `npm run gemini:models` lists the ones yours can use.
# GEMINI_MODEL=gemini-flash-latest
# Tried in order when GEMINI_MODEL is out of quota, overloaded (503) or stalls. Each model has its
# own free-tier quota; one that's out is skipped until Google says it's back.
# GEMINI_FALLBACK_MODEL=gemini-3.6-flash,gemini-3.5-flash-lite
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- PayPal (sandbox) — https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Dashboard → your app → Webhooks → add <APP_URL>/api/paypal/webhook with PAYMENT.CAPTURE.COMPLETED
PAYPAL_WEBHOOK_ID=
# Log in with PayPal: tick it on the app and add <APP_URL>/api/account/paypal/callback as a Return URL, then
# PAYPAL_LOGIN=on

# --- Channel3 (find a product / paste a store link) — https://trychannel3.com/developers
CHANNEL3_API_KEY=

# --- App: public origin for share links, PayPal return URLs and og:image.
# On Render it falls back to RENDER_EXTERNAL_URL when unset.
APP_URL=http://localhost:3000

# --- Database: leave unset to use the built-in PGlite database (node_modules/.cache/one-thing-pglite)
# DATABASE_URL=postgres://user:pass@host:5432/one_thing
# DATABASE_SSL=true
