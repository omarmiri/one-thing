{
  "$schema": "https://titan.apimatic.io/api/build/schema",
  "buildFileVersion": "1",
  "generatePortal": {
    "debug": {
      "publishReport": true
    },
    "pageTitle": "OneThing API",
    "navTitle": "OneThing Developers",
    "logoUrl": "static/images/logo.png",
    "logoLink": "https://one-thing-ash0.onrender.com",
    "languageConfig": {
      "typescript": {
        "packageRepository": "Npm",
        "packageSettings": {
          "PackageName": "one-thing-sdk",
          "Version": "1.0.0"
        }
      },
      "python": {
        "packageRepository": "PyPI",
        "packageSettings": {
          "PackageName": "one-thing-sdk",
          "Version": "1.0.0"
        }
      },
      "http": {}
    },
    "portalSettings": {
      "enableHttpVerbsForAllLangs": true,
      "enableExport": true,
      "enableConsoleCalls": true,
      "theme": {
        "baseTheme": "cosmos",
        "colorMode": {
          "defaultMode": "light",
          "disableSwitch": false
        },
        "colors": {
          "primaryColor": {
            "light": "#1F4FD8",
            "dark": "#8EA8FF"
          },
          "linkColor": {
            "light": "#1F4FD8",
            "dark": "#A9BDFF"
          }
        }
      }
    }
  },
  "apiCopilotConfig": {
    "isEnabled": true,
    "key": "ae7006fb-3f66-4dec-bf23-816ce3465697",
    "welcomeMessage": "Hi there! I'm your API Integration Assistant, here to help you learn and integrate with this API.\n\nAsk me anything about this API or try one of these example prompts:\n\n- `What authentication methods does this API support?`\n- `What is this API about?`\n"
  },
  "recipes": {
    "workflows": [
      {
        "name": "An AI agent buys a product",
        "permalink": "page:recipes/AnAiAgentBuysAProduct",
        "functionName": "AnAiAgentBuysAProduct",
        "scriptPath": "./static/scripts/recipes/AnAiAgentBuysAProduct.js"
      }
    ]
  }
}
